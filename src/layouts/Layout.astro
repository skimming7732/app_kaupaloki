---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Kaupaloki - Plataforma Contable y Cambiaria (Horizon UI)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>
    <style is:global>
      :root {
        /* Horizon UI Light Theme */
        --bg-main: #F4F7FE;
        --bg-card: #FFFFFF;
        --bg-card-secondary: #F7FAFC;
        --bg-sidebar: #FFFFFF;
        --border-main: #E0E5F2;
        --text-primary: #2B3674;
        --text-secondary: #707EAE;
        --text-muted: #A3AED0;
        --brand-primary: #4318FF;
        --brand-primary-light: rgba(67, 24, 255, 0.08);
        --success: #05CD99;
        --success-light: rgba(5, 205, 153, 0.1);
        --warning: #FFB547;
        --warning-light: rgba(255, 181, 71, 0.1);
        --danger: #EE5D50;
        --danger-light: rgba(238, 93, 80, 0.1);
        --info: #38BDF8;
        --info-light: rgba(56, 189, 248, 0.1);
        --shadow-card: 0px 18px 40px rgba(112, 144, 176, 0.12);
        --shadow-nav: 0px 10px 30px rgba(112, 144, 176, 0.1);
      }

      html.dark {
        /* Horizon UI Dark Theme */
        --bg-main: #0B1437;
        --bg-card: #111C44;
        --bg-card-secondary: #1B254B;
        --bg-sidebar: #111C44;
        --border-main: #1B254B;
        --text-primary: #FFFFFF;
        --text-secondary: #A3AED0;
        --text-muted: #707EAE;
        --brand-primary: #7551FF;
        --brand-primary-light: rgba(117, 81, 255, 0.15);
        --success: #05CD99;
        --success-light: rgba(5, 205, 153, 0.15);
        --warning: #FFB547;
        --warning-light: rgba(255, 181, 71, 0.15);
        --danger: #EE5D50;
        --danger-light: rgba(238, 93, 80, 0.15);
        --info: #38BDF8;
        --info-light: rgba(56, 189, 248, 0.15);
        --shadow-card: 0px 18px 40px rgba(0, 0, 0, 0.35);
        --shadow-nav: 0px 10px 30px rgba(0, 0, 0, 0.3);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: var(--bg-main);
        color: var(--text-primary);
        transition: background-color 0.25s ease, color 0.25s ease;
        -webkit-font-smoothing: antialiased;
      }

      .font-mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Courier New", monospace;
      }

      /* Custom scrollbar Horizon style */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: var(--text-muted);
        border-radius: 9999px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--text-secondary);
      }

      /* Theme logo toggle */
      html.dark .theme-logo-dark {
        display: block !important;
      }
      html.dark .theme-logo-light {
        display: none !important;
      }
      html:not(.dark) .theme-logo-dark {
        display: none !important;
      }
      html:not(.dark) .theme-logo-light {
        display: block !important;
      }
    </style>
  </head>
  <body class="min-h-screen">
    <slot />

    <script is:inline>
      // Control de tema oscuro/claro persistente
      const savedTheme = localStorage.getItem('kaupaloki_theme');
      if (savedTheme) {
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      } else {
        // Por defecto usar dark mode como en Horizon UI Dark
        document.documentElement.classList.add('dark');
      }
    </script>
  </body>
</html>
