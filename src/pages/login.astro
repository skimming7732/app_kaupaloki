---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión - Kaupaloki">
  <div class="auth-container" style="min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px; position: relative;">
    
    <!-- Theme Toggle Button top right -->
    <div style="position: absolute; top: 24px; right: 24px;">
      <button id="theme-toggle-btn" title="Cambiar tema" style="width: 42px; height: 42px; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--border-main); color: var(--text-primary); display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow-card); transition: all 0.2s;">
        <svg id="theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>

    <!-- Login Card -->
    <div class="auth-card" style="width: 100%; max-width: 440px; background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 40px; box-shadow: var(--shadow-card);">
      
      <!-- Brand Logo -->
      <div style="text-align: center; margin-bottom: 32px;">
        <img src="/logo.png" alt="Kaupaloki" class="theme-logo-dark" style="max-height: 42px; margin: 0 auto; object-fit: contain;" />
        <img src="/logo-blue.png" alt="Kaupaloki" class="theme-logo-light" style="max-height: 42px; margin: 0 auto; object-fit: contain;" />
        <p style="font-size: 13px; color: var(--text-secondary); margin-top: 10px; font-weight: 500;">
          Plataforma de Control Financiero y Cambiario
        </p>
      </div>

      <!-- Auth Method Selector Tabs -->
      <div style="display: flex; background: var(--bg-card-secondary); border-radius: 14px; padding: 4px; margin-bottom: 24px; border: 1px solid var(--border-main);">
        <button id="tab-password-btn" class="auth-tab-btn active" style="flex: 1; padding: 10px; border-radius: 10px; border: none; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s;">
          Contraseña
        </button>
        <button id="tab-magic-btn" class="auth-tab-btn" style="flex: 1; padding: 10px; border-radius: 10px; border: none; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s;">
          Magic Link
        </button>
      </div>

      <!-- Alert Message Box -->
      <div id="alert-box" style="display: none; padding: 12px 16px; border-radius: 12px; font-size: 13px; font-weight: 600; margin-bottom: 20px; align-items: center; gap: 10px;">
        <svg id="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></svg>
        <span id="alert-text"></span>
      </div>

      <!-- Form 1: Password Login -->
      <form id="password-form" style="display: flex; flex-direction: column; gap: 18px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Correo Electrónico
          </label>
          <div style="position: relative;">
            <input type="email" id="email-input" required placeholder="nombre@correo.com" style="width: 100%; padding: 13px 16px 13px 42px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.2s;" />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 14px; color: var(--text-muted);">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <label style="font-size: 12px; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em;">
              Contraseña
            </label>
            <a href="/forgot-password" style="font-size: 12px; color: var(--brand-primary); font-weight: 600; text-decoration: none;">
              ¿Olvidaste tu contraseña?
            </a>
          </div>
          <div style="position: relative;">
            <input type="password" id="password-input" required placeholder="••••••••••••" style="width: 100%; padding: 13px 16px 13px 42px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.2s;" />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 14px; color: var(--text-muted);">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
        </div>

        <button type="submit" id="btn-submit-password" style="margin-top: 8px; width: 100%; padding: 14px; border-radius: 12px; border: none; background: var(--brand-primary); color: #FFFFFF; font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0px 8px 16px rgba(67, 24, 255, 0.25); transition: opacity 0.2s;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
          <span>Iniciar Sesión</span>
        </button>
      </form>

      <!-- Form 2: Magic Link Login -->
      <form id="magic-form" style="display: none; flex-direction: column; gap: 18px;">
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin: 0 0 8px 0;">
          Ingresa tu correo institucional y te enviaremos un enlace de acceso seguro sin necesidad de contraseña.
        </p>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Correo Electrónico
          </label>
          <div style="position: relative;">
            <input type="email" id="magic-email-input" required placeholder="nombre@correo.com" style="width: 100%; padding: 13px 16px 13px 42px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.2s;" />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 14px; color: var(--text-muted);">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
        </div>

        <button type="submit" id="btn-submit-magic" style="margin-top: 8px; width: 100%; padding: 14px; border-radius: 12px; border: none; background: var(--brand-primary); color: #FFFFFF; font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0px 8px 16px rgba(67, 24, 255, 0.25); transition: opacity 0.2s;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          <span>Enviar Magic Link</span>
        </button>
      </form>

      <!-- Security note -->
      <div style="margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border-main); text-align: center;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--text-muted); font-weight: 600;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Conexión segura cifrada con Supabase RBAC</span>
        </div>
      </div>

    </div>
  </div>

  <style>
    .auth-tab-btn {
      background: transparent;
      color: var(--text-secondary);
    }
    .auth-tab-btn.active {
      background: var(--bg-card);
      color: var(--text-primary);
      box-shadow: 0px 2px 6px rgba(0,0,0,0.06);
    }
    .theme-logo-light {
      display: none;
    }
    .theme-logo-dark {
      display: block;
    }
    :global(html:not(.dark)) .theme-logo-light {
      display: block !important;
    }
    :global(html:not(.dark)) .theme-logo-dark {
      display: none !important;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase';

    // Theme Toggle Logic
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function updateThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (sunIcon && moonIcon) {
        if (isDark) {
          sunIcon.style.display = 'block';
          moonIcon.style.display = 'none';
        } else {
          sunIcon.style.display = 'none';
          moonIcon.style.display = 'block';
        }
      }
    }
    updateThemeIcons();

    themeBtn?.addEventListener('click', () => {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('kaupaloki_theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('kaupaloki_theme', 'dark');
      }
      updateThemeIcons();
    });

    // Tab Switching
    const tabPasswordBtn = document.getElementById('tab-password-btn');
    const tabMagicBtn = document.getElementById('tab-magic-btn');
    const passwordForm = document.getElementById('password-form');
    const magicForm = document.getElementById('magic-form');

    tabPasswordBtn?.addEventListener('click', () => {
      tabPasswordBtn.classList.add('active');
      tabMagicBtn?.classList.remove('active');
      if (passwordForm) passwordForm.style.display = 'flex';
      if (magicForm) magicForm.style.display = 'none';
      hideAlert();
    });

    tabMagicBtn?.addEventListener('click', () => {
      tabMagicBtn.classList.add('active');
      tabPasswordBtn?.classList.remove('active');
      if (magicForm) magicForm.style.display = 'flex';
      if (passwordForm) passwordForm.style.display = 'none';
      hideAlert();
    });

    // Alert helper
    const alertBox = document.getElementById('alert-box');
    const alertText = document.getElementById('alert-text');
    const alertIcon = document.getElementById('alert-icon');

    function showAlert(message: string, type: 'error' | 'success') {
      if (!alertBox || !alertText || !alertIcon) return;
      alertBox.style.display = 'flex';
      alertText.textContent = message;
      if (type === 'error') {
        alertBox.style.background = 'var(--danger-light)';
        alertBox.style.color = 'var(--danger)';
        alertBox.style.border = '1px solid var(--danger)';
        alertIcon.innerHTML = '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>';
      } else {
        alertBox.style.background = 'var(--success-light)';
        alertBox.style.color = 'var(--success)';
        alertBox.style.border = '1px solid var(--success)';
        alertIcon.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
      }
    }

    function hideAlert() {
      if (alertBox) alertBox.style.display = 'none';
    }

    // Check if user is already logged in or arriving via Magic Link (token_hash / hash)
    async function routeAuthenticatedUser(user: any) {
      if (!user) return;
      const { data: profile } = await supabase
        .from('profiles')
        .select('*')
        .eq('email', (user.email || '').toLowerCase())
        .maybeSingle();

      const urlParams = new URLSearchParams(window.location.search);
      const redirectTarget = urlParams.get('redirect') || '/';

      if (profile && !profile.onboarding_completed) {
        window.location.href = `/onboarding?email=${encodeURIComponent(user.email || '')}`;
      } else {
        window.location.href = redirectTarget;
      }
    }

    async function checkExistingSession() {
      const urlParams = new URLSearchParams(window.location.search);
      const tokenHash = urlParams.get('token_hash') || urlParams.get('token');
      const otpType = (urlParams.get('type') as any) || 'magiclink';
      const errorDesc = urlParams.get('error_description');

      if (errorDesc) {
        showAlert(decodeURIComponent(errorDesc.replace(/\+/g, ' ')), 'error');
      }

      if (tokenHash) {
        showAlert('Verificando enlace mágico seguro...', 'success');
        const { data, error } = await supabase.auth.verifyOtp({
          token_hash: tokenHash,
          type: otpType
        });
        if (error) {
          showAlert('El enlace mágico expiró o ya fue utilizado. Solicita uno nuevo.', 'error');
        } else if (data?.user) {
          await routeAuthenticatedUser(data.user);
          return;
        }
      }

      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user) {
        await routeAuthenticatedUser(session.user);
      }
    }

    supabase.auth.onAuthStateChange(async (event, session) => {
      if ((event === 'SIGNED_IN' || event === 'TOKEN_REFRESHED' || event === 'USER_UPDATED') && session?.user) {
        await routeAuthenticatedUser(session.user);
      }
    });

    checkExistingSession();

    // Submit Password Login
    passwordForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();
      const email = (document.getElementById('email-input') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password-input') as HTMLInputElement).value;
      const submitBtn = document.getElementById('btn-submit-password') as HTMLButtonElement;

      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.6';

      try {
        const { data, error } = await supabase.auth.signInWithPassword({
          email,
          password
        });

        if (error) {
          showAlert(error.message === 'Invalid login credentials' 
            ? 'Credenciales inválidas. Verifica tu correo y contraseña.' 
            : error.message, 'error');
          return;
        }

        if (data.user) {
          await routeAuthenticatedUser(data.user);
        }
      } catch (err: any) {
        showAlert(err.message || 'Error inesperado al iniciar sesión', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });

    // Submit Magic Link Login
    magicForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();
      const email = (document.getElementById('magic-email-input') as HTMLInputElement).value.trim().toLowerCase();
      const submitBtn = document.getElementById('btn-submit-magic') as HTMLButtonElement;

      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.6';

      try {
        const { error } = await supabase.auth.signInWithOtp({
          email,
          options: {
            emailRedirectTo: 'https://app.kaupaloki.co/login'
          }
        });

        if (error) {
          showAlert(error.message, 'error');
          return;
        }

        showAlert('¡Enlace mágico enviado! Revisa tu bandeja de entrada o spam para acceder a Kaupaloki.', 'success');
      } catch (err: any) {
        showAlert(err.message || 'Error al enviar magic link', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });
  </script>
</Layout>
