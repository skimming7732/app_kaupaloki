                    <td style="padding: 12px 16px; text-align: center;">
                      {tienePendiente ? (
                        <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                          COMPRA PENDIENTE
                        </span>
                      ) : (
                        <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: rgba(16, 185, 129, 0.1); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.25);">
                          CUBIERTA AL 100%
