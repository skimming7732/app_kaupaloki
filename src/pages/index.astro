              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 700; color: var(--text-primary);">${fmtNumClient(usdtVend, 2)} USDT</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-secondary);">${fmtCopClient(tasaVal, 2)}</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--success);">${fmtCopClient(totalCopVal, 2)}</td>
            </tr>
          `;
        }).join('');
      }
      const ventasTfoot = document.getElementById('ventas-table-tfoot');
      if (ventasTfoot) {
        const totVentaUsdt = ventasUsdt.reduce((acc: number, v: any) => acc + (Number(v.usdtVendido ?? v.cantidadUsdt) || 0), 0);
        const totVentaCop = ventasUsdt.reduce((acc: number, v: any) => acc + (Number(v.totalCop ?? v.montoNetoRecibidoCop) || 0), 0);
        ventasTfoot.innerHTML = `
          <tr style="background: var(--bg-main); border-top: 2px solid var(--border-main); font-weight: 800;">
            <td colspan="3" style="padding: 16px 20px;">TOTAL MONETIZADO (${ventasUsdt.length} VENTAS USDT)</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--danger);">-${fmtNumClient(totVentaUsdt, 2)} USDT</td>
            <td></td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success);">+${fmtCopClient(totVentaCop, 2)}</td>
          </tr>
        `;
      }
    }

    // 11. Actualizar Divisas (2 decimales + Banderas, Nombre y País en vivo desde Airtable)
    if (divisas.length > 0) {
      divisas.forEach((div: any) => {
        const code = div.codigo || div.divisa || '';
        if (code && AIRTABLE_CURRENCIES_META[code]) {
          if (div.id) AIRTABLE_CURRENCIES_META[code].id = div.id;
          if (div.banderaUrl) AIRTABLE_CURRENCIES_META[code].banderaUrl = div.banderaUrl;
          if (div.nombreDivisa) AIRTABLE_CURRENCIES_META[code].name = div.nombreDivisa;
          if (div.pais) AIRTABLE_CURRENCIES_META[code].pais = div.pais;
        } else if (code) {
          AIRTABLE_CURRENCIES_META[code] = {
            id: div.id || code,
            name: div.nombreDivisa || code,
            pais: div.pais || '',
            flag: '🌐',
            banderaUrl: div.banderaUrl || '',
            fallbackBanderaUrl: 'https://flagcdn.com/w80/un.png'
          };
        }
      });

      // Sincronizar en vivo los selectores de divisas en Invitar Usuario y Editar Permisos
      const renderCurrencyChipsHtml = (inputName: string, checkedSet: Set<string>) => {
        return divisas.map((div: any) => {
          const code = div.codigo || div.divisa || '';
          if (!code) return '';
          const meta = AIRTABLE_CURRENCIES_META[code] || ({} as any);
          const flagImg = div.banderaUrl || meta.banderaUrl || meta.fallbackBanderaUrl || 'https://flagcdn.com/w80/un.png';
          const fallbackImg = meta.fallbackBanderaUrl || 'https://flagcdn.com/w80/un.png';
          const nombreDivisa = div.nombreDivisa || meta.name || code;
          const isChecked = checkedSet.has(code);
          return `
            <label class="currency-check-chip" style="display: flex; align-items: center; gap: 7px; padding: 7px 9px; border-radius: 9px; background: var(--bg-card); border: 1px solid var(--border-main); cursor: pointer; font-size: 12px; font-weight: 700; color: var(--text-primary); user-select: none;">
              <input type="checkbox" name="${inputName}" value="${code}" ${isChecked ? 'checked' : ''} style="accent-color: var(--brand-primary); width: 14px; height: 14px; cursor: pointer; flex-shrink: 0;" />
              <img 
                src="${flagImg}" 
                alt="${code}" 
                onerror="this.onerror=null;this.src='${fallbackImg}';"
                style="width: 18px; height: 18px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border-main); flex-shrink: 0;"
              />
              <div style="display: flex; flex-direction: column; line-height: 1.1; overflow: hidden;">
                <span style="font-family: ui-monospace, monospace; font-size: 11.5px; font-weight: 800;">${code}</span>
                <span style="font-size: 9px; color: var(--text-muted); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${nombreDivisa}</span>
              </div>
            </label>
          `;
        }).join('');
      };

      const inviteGrid = document.getElementById('invite-currencies-grid');
      if (inviteGrid) {
        const currentChecked = new Set(
          Array.from(inviteGrid.querySelectorAll('input[name="authorized_currency"]:checked')).map((el: any) => String(el.value))
        );
        const setToUse = currentChecked.size > 0 ? currentChecked : new Set(divisas.map((d: any) => d.codigo || d.divisa));
        inviteGrid.innerHTML = renderCurrencyChipsHtml('authorized_currency', setToUse);
      }

      const editGrid = document.getElementById('edit-user-currencies-grid');
      if (editGrid) {
        const currentCheckedEdit = new Set(
          Array.from(editGrid.querySelectorAll('input[name="edit_authorized_currency"]:checked')).map((el: any) => String(el.value))
        );
        editGrid.innerHTML = renderCurrencyChipsHtml('edit_authorized_currency', currentCheckedEdit);
