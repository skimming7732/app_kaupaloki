                <div style="text-align: right;">
                  <div style="font-size: 10px; opacity: 0.8;">▲ ${fmtCopClient(a.ingresosCop)}</div>
                  <div style="font-size: 10px; opacity: 0.8;">▼ ${fmtCopClient(a.egresosCop)}</div>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      const activosTableTbody = document.getElementById('activos-table-tbody');
      if (activosTableTbody) {
        activosTableTbody.innerHTML = activosLiq.map((a: any) => `
