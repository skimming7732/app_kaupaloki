---
import Layout from '../layouts/Layout.astro';
import { 
  CLIENTES, 
  NEGOCIOS, 
  PAGOS, 
  DIVISAS, 
  COMPRAS_USDT, 
  ADMINS, 
  getMetricasContables 
} from '../data/airtableData';

const metricas = getMetricasContables();

function formatCop(amount: number): string {
  return new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    maximumFractionDigits: 0
  }).format(amount);
}

function formatDecimal(amount: number, digits = 2): string {
  return new Intl.NumberFormat('es-CO', {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits
  }).format(amount);
}
---

<Layout title="Kaupaloki - Plataforma Contable y Cambiaria">
  <!-- Container principal -->
  <div style="max-width: 1440px; margin: 0 auto; padding: 24px 20px;">
    
    <!-- Encabezado Contable -->
    <header style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 28px; padding-bottom: 20px; border-bottom: 1px solid #1f2937;">
      <div>
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
          <!-- Icono Contable SVG -->
          <div style="display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 8px; background: #0f172a; border: 1px solid #38bdf8;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/>
              <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/>
              <path d="M12 6V4"/>
              <path d="M12 18v2"/>
            </svg>
          </div>
          <div>
            <h1 style="margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.02em; color: #f8fafc;">
              KAUPALOKI
            </h1>
          </div>
          <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 3px 8px; border-radius: 4px; background: rgba(56, 189, 248, 0.12); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
            SISTEMA CONTABLE
          </span>
        </div>
        <p style="margin: 0; font-size: 13px; color: #94a3b8; font-family: ui-monospace, monospace;">
          Base de Datos: <span style="color: #cbd5e1;">appncUKgTkDojFj4B</span> (KAUPALOKI) &bull; Conexión Activa
        </p>
      </div>

      <!-- Acciones de cabecera -->
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px;">
        <div id="sync-status" style="display: flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 6px; background: #0f172a; border: 1px solid #1e293b; font-size: 12px; color: #10b981;">
          <span id="sync-dot" style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981;"></span>
          <span id="sync-text">En vivo: Conectado</span>
        </div>

        <button id="btn-sync-now" style="display: flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: 6px; background: #0369a1; border: 1px solid #38bdf8; color: #f0f9ff; font-size: 13px; font-weight: 600; cursor: pointer; transition: background 0.15s ease;">
          <svg id="sync-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 2v6h-6"></path>
            <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
            <path d="M3 22v-6h6"></path>
            <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
          </svg>
          <span id="btn-sync-label">Sincronizar ahora</span>
        </button>

        <button id="btn-export-csv" style="display: flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 6px; background: #1e293b; border: 1px solid #334155; color: #f1f5f9; font-size: 13px; font-weight: 500; cursor: pointer; transition: background 0.15s ease;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Exportar Tabla (CSV)
        </button>
      </div>
    </header>

    <!-- Tarjetas de Métricas Contables -->
    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-bottom: 28px;">
      <!-- Tarjeta 1: Total Ingresos -->
      <div style="background: #0f172a; border: 1px solid #1e293b; border-radius: 8px; padding: 18px 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8;">
            Total Ingresos (COP)
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <div style="font-size: 24px; font-weight: 700; color: #f8fafc; font-family: ui-monospace, monospace; margin-bottom: 6px;">
          {formatCop(metricas.totalIngresosCop)}
        </div>
        <div style="font-size: 12px; color: #64748b;">
          Consolidado en {metricas.numNegocios} operaciones registradas
        </div>
      </div>

      <!-- Tarjeta 2: Total Pagado -->
      <div style="background: #0f172a; border: 1px solid #1e293b; border-radius: 8px; padding: 18px 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8;">
            Total Pagos Recibidos
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <div style="font-size: 24px; font-weight: 700; color: #10b981; font-family: ui-monospace, monospace; margin-bottom: 6px;">
          {formatCop(metricas.totalPagadoCop)}
        </div>
        <div style="font-size: 12px; color: #64748b;">
          {metricas.numPagosCompletados} pagos verificados con estado COMPLETADO
        </div>
      </div>

      <!-- Tarjeta 3: Saldo Pendiente -->
      <div style="background: #0f172a; border: 1px solid #1e293b; border-radius: 8px; padding: 18px 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8;">
            Saldo Pendiente Neto
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <div style="font-size: 24px; font-weight: 700; color: #f59e0b; font-family: ui-monospace, monospace; margin-bottom: 6px;">
          {formatCop(metricas.saldoPendienteNeto)}
        </div>
        <div style="font-size: 12px; color: #64748b;">
          Diferencia neta (Ingresos - Pagos acreditados)
        </div>
      </div>

      <!-- Tarjeta 4: USDT Comprado -->
      <div style="background: #0f172a; border: 1px solid #1e293b; border-radius: 8px; padding: 18px 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8;">
            Total USDT Comprado
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
        </div>
        <div style="font-size: 24px; font-weight: 700; color: #c084fc; font-family: ui-monospace, monospace; margin-bottom: 6px;">
          {formatDecimal(metricas.totalUsdtComprado, 2)} USDT
        </div>
        <div style="font-size: 12px; color: #64748b;">
          Acumulado en {metricas.numComprasUsdt} compras ejecutadas
        </div>
      </div>
    </section>

    <!-- Controles y Pestañas de Tablas -->
    <div style="background: #0d1424; border: 1px solid #1e293b; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);">
      
      <!-- Barra Superior de Navegación por Pestañas -->
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e293b; background: #0b1120; padding: 6px 12px; gap: 12px;">
        <!-- Tabs -->
        <nav style="display: flex; flex-wrap: wrap; gap: 4px;" role="tablist">
          <button class="nav-tab active" data-target="tab-clientes" style="display: flex; align-items: center; gap: 8px; padding: 9px 16px; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s ease;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            CLIENTES ({CLIENTES.length})
          </button>

          <button class="nav-tab" data-target="tab-negocios" style="display: flex; align-items: center; gap: 8px; padding: 9px 16px; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s ease;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            NEGOCIOS ({NEGOCIOS.length})
          </button>

          <button class="nav-tab" data-target="tab-pagos" style="display: flex; align-items: center; gap: 8px; padding: 9px 16px; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s ease;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
            PAGOS ({PAGOS.length})
          </button>

          <button class="nav-tab" data-target="tab-divisas" style="display: flex; align-items: center; gap: 8px; padding: 9px 16px; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s ease;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            DIVISAS ({DIVISAS.length})
          </button>

          <button class="nav-tab" data-target="tab-compras" style="display: flex; align-items: center; gap: 8px; padding: 9px 16px; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s ease;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
            COMPRA-USDT ({COMPRAS_USDT.length})
          </button>

          <button class="nav-tab" data-target="tab-admins" style="display: flex; align-items: center; gap: 8px; padding: 9px 16px; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s ease;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            ADMINS ({ADMINS.length})
          </button>
        </nav>

        <!-- Buscador en tiempo real -->
        <div style="display: flex; align-items: center; background: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 0 10px; width: 280px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="table-search" 
            placeholder="Filtrar registros..." 
            style="background: transparent; border: none; color: #f8fafc; font-size: 13px; padding: 7px 8px; outline: none; width: 100%;"
          />
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 1: CLIENTES -->
      <!-- ========================================== -->
      <div id="tab-clientes" class="tab-pane active" style="padding: 0;">
        <div style="overflow-x: auto;">
          <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
            <thead>
              <tr style="background: #090e1a; border-bottom: 1px solid #1e293b; color: #94a3b8; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">
                <th style="padding: 12px 16px;">#</th>
                <th style="padding: 12px 16px;">Código Cliente</th>
                <th style="padding: 12px 16px;">Nombre</th>
                <th style="padding: 12px 16px; text-align: right;">Ingresos Totales (COP)</th>
                <th style="padding: 12px 16px; text-align: right;">Pagado (COP)</th>
                <th style="padding: 12px 16px; text-align: right;">Saldo Pendiente (COP)</th>
                <th style="padding: 12px 16px; text-align: center;">Estado Contable</th>
              </tr>
            </thead>
            <tbody>
              {CLIENTES.map((c) => {
                const tieneSaldo = c.pendienteCop > 0;
                const saldoAFavor = c.pendienteCop < 0;
                return (
                  <tr class="table-row" style="border-bottom: 1px solid #172033; transition: background 0.1s ease;">
                    <td style="padding: 12px 16px; color: #64748b; font-family: ui-monospace, monospace;">{c.numero}</td>
                    <td style="padding: 12px 16px; font-weight: 600; color: #38bdf8; font-family: ui-monospace, monospace;">{c.codigo}</td>
                    <td style="padding: 12px 16px; font-weight: 500; color: #f1f5f9;">{c.nombre}</td>
                    <td style="padding: 12px 16px; text-align: right; font-family: ui-monospace, monospace; color: #e2e8f0;">
                      {formatCop(c.ingresosCop)}
                    </td>
                    <td style="padding: 12px 16px; text-align: right; font-family: ui-monospace, monospace; color: #10b981;">
                      {formatCop(c.pagadoCop)}
                    </td>
                    <td style="padding: 12px 16px; text-align: right; font-family: ui-monospace, monospace; font-weight: 700; color: {tieneSaldo ? '#f59e0b' : saldoAFavor ? '#38bdf8' : '#94a3b8'};">
                      {formatCop(c.pendienteCop)}
                    </td>
                    <td style="padding: 12px 16px; text-align: center;">
                      {tieneSaldo && (
                        <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                          POR COBRAR
                        </span>
                      )}
                      {saldoAFavor && (
                        <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: rgba(56, 189, 248, 0.12); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                          SALDO A FAVOR
                        </span>
                      )}
                      {!tieneSaldo && !saldoAFavor && (
                        <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: rgba(16, 185, 129, 0.1); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.25);">
                          AL DÍA
                        </span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
            <tfoot>
              <tr style="background: #090e1a; font-weight: 700; font-family: ui-monospace, monospace; border-top: 2px solid #1e293b; color: #f8fafc;">
                <td colspan="3" style="padding: 14px 16px; text-transform: uppercase; font-size: 12px; color: #94a3b8;">TOTALES CONSOLIDADOS:</td>
                <td style="padding: 14px 16px; text-align: right; color: #f8fafc;">
                  {formatCop(CLIENTES.reduce((a, b) => a + b.ingresosCop, 0))}
                </td>
                <td style="padding: 14px 16px; text-align: right; color: #10b981;">
                  {formatCop(CLIENTES.reduce((a, b) => a + b.pagadoCop, 0))}
                </td>
                <td style="padding: 14px 16px; text-align: right; color: #f59e0b;">
                  {formatCop(CLIENTES.reduce((a, b) => a + b.pendienteCop, 0))}
                </td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 2: NEGOCIOS -->
      <!-- ========================================== -->
      <div id="tab-negocios" class="tab-pane" style="display: none; padding: 0;">
        <div style="overflow-x: auto;">
          <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
            <thead>
              <tr style="background: #090e1a; border-bottom: 1px solid #1e293b; color: #94a3b8; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">
                <th style="padding: 12px 14px;">#</th>
                <th style="padding: 12px 14px;">Código Negocio</th>
                <th style="padding: 12px 14px;">Fecha</th>
                <th style="padding: 12px 14px;">Cliente</th>
                <th style="padding: 12px 14px; text-align: center;">Divisa</th>
                <th style="padding: 12px 14px; text-align: right;">Monto Divisa</th>
                <th style="padding: 12px 14px; text-align: right;">Tasa</th>
                <th style="padding: 12px 14px; text-align: right;">Ingreso (COP)</th>
                <th style="padding: 12px 14px;">Compra Rel</th>
                <th style="padding: 12px 14px; text-align: right;">USDT x Divisa</th>
                <th style="padding: 12px 14px; text-align: right;">Precio Compra</th>
              </tr>
            </thead>
            <tbody>
              {NEGOCIOS.map((n) => (
                <tr class="table-row" style="border-bottom: 1px solid #172033; transition: background 0.1s ease;">
                  <td style="padding: 11px 14px; color: #64748b; font-family: ui-monospace, monospace;">{n.numero}</td>
                  <td style="padding: 11px 14px; font-weight: 600; color: #38bdf8; font-family: ui-monospace, monospace;">{n.codigo}</td>
                  <td style="padding: 11px 14px; color: #94a3b8; font-family: ui-monospace, monospace;">{n.fechaRegistro}</td>
                  <td style="padding: 11px 14px; font-weight: 500; color: #f1f5f9;">{n.clienteNombre}</td>
                  <td style="padding: 11px 14px; text-align: center;">
                    <span style="font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 4px; background: #1e293b; color: #e2e8f0; border: 1px solid #334155;">
                      {n.divisaCodigo}
                    </span>
                  </td>
                  <td style="padding: 11px 14px; text-align: right; font-family: ui-monospace, monospace; color: #f8fafc;">
                    {formatDecimal(n.montoDivisa, 0)}
                  </td>
                  <td style="padding: 11px 14px; text-align: right; font-family: ui-monospace, monospace; color: #94a3b8;">
                    ${formatDecimal(n.tasa, 2)}
                  </td>
                  <td style="padding: 11px 14px; text-align: right; font-family: ui-monospace, monospace; font-weight: 600; color: #10b981;">
                    {formatCop(n.ingresoCop)}
                  </td>
                  <td style="padding: 11px 14px; font-family: ui-monospace, monospace; color: #cbd5e1; font-size: 12px;">
                    {n.compraRelCodigo || <span style="color: #64748b;">—</span>}
                  </td>
                  <td style="padding: 11px 14px; text-align: right; font-family: ui-monospace, monospace; color: #c084fc;">
                    {n.usdtPorDivisa > 0 ? formatDecimal(n.usdtPorDivisa, 2) : <span style="color: #64748b;">0</span>}
                  </td>
                  <td style="padding: 11px 14px; text-align: right; font-family: ui-monospace, monospace; color: #e2e8f0;">
                    {n.precioCompra ? `$${formatDecimal(n.precioCompra, 2)}` : <span style="color: #64748b;">—</span>}
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr style="background: #090e1a; font-weight: 700; font-family: ui-monospace, monospace; border-top: 2px solid #1e293b; color: #f8fafc;">
                <td colspan="7" style="padding: 14px 14px; text-transform: uppercase; font-size: 12px; color: #94a3b8;">TOTALES CONSOLIDADOS:</td>
                <td style="padding: 14px 14px; text-align: right; color: #10b981;">
                  {formatCop(NEGOCIOS.reduce((a, b) => a + b.ingresoCop, 0))}
                </td>
                <td></td>
                <td style="padding: 14px 14px; text-align: right; color: #c084fc;">
