              <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); line-height: 1.1; margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">Con Comprobante</div>
              <div style="font-size: 16px; font-weight: 800; color: var(--text-primary); font-family: ui-monospace, monospace; line-height: 1.2;">{numPagosConComprobante} Listos</div>
              <div style="font-size: 10px; font-weight: 700; color: var(--success); margin-top: 1px;">Formato 9:16 vertical</div>
            </div>
          </div>

          <div class="kpi-mini-card" style="background: var(--bg-card); border-radius: 16px; padding: 12px 14px; box-shadow: var(--shadow-card); display: flex; align-items: center; gap: 12px; border: 1px solid var(--border-main); min-height: 64px; box-sizing: border-box; overflow: hidden;">
            <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--warning-light); color: var(--warning); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <div style="overflow: hidden; flex: 1; min-width: 0;">
              <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); line-height: 1.1; margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">Por Adjuntar</div>
              <div style="font-size: 16px; font-weight: 800; color: var(--warning); font-family: ui-monospace, monospace; line-height: 1.2;">{numPagosPendientes} Pendientes</div>
              <div style="font-size: 10px; font-weight: 600; color: var(--text-secondary); margin-top: 1px;">Soporte pendiente</div>
            </div>
          </div>

          <div class="kpi-mini-card" style="background: var(--bg-card); border-radius: 16px; padding: 12px 14px; box-shadow: var(--shadow-card); display: flex; align-items: center; gap: 12px; border: 1px solid var(--border-main); min-height: 64px; box-sizing: border-box; overflow: hidden;">
            <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--info-light); color: var(--info); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <div style="overflow: hidden; flex: 1; min-width: 0;">
              <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); line-height: 1.1; margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">Tasa de Entrega</div>
              <div style="font-size: 16px; font-weight: 800; color: var(--text-primary); font-family: ui-monospace, monospace; line-height: 1.2;">100%</div>
              <div style="font-size: 10px; font-weight: 700; color: var(--success); margin-top: 1px;">Sin devoluciones</div>
            </div>
          </div>
        </div>

      </section>

      <!-- ============================================================== -->
      <!-- DATA TABLE CARD (HORIZON UI "COMPLEX TABLE" STYLE) -->
      <!-- ============================================================== -->
      <div style="background: var(--bg-card); border-radius: 20px; border: 1px solid var(--border-main); box-shadow: var(--shadow-card); overflow: hidden;">
        
        <!-- Table Action Header -->
        <div style="padding: 22px 26px; border-bottom: 1px solid var(--border-main); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px;">
          <div>
            <h2 id="active-table-title" style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">
              Panel Control Financiero
            </h2>
            <p style="margin: 3px 0 0 0; font-size: 12px; color: var(--text-muted);">
              Visualización contable sincronizada directamente desde Airtable
            </p>
          </div>

          <div style="display: flex; align-items: center; gap: 10px;">
            <!-- Botón Agregar Usuario antes del icono CSV -->
            <button 
              id="btn-open-create-user-modal"
              class="btn-open-add-user"
              type="button"
              title="Agregar nuevo usuario"
              style="display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 12px; border: none; background: var(--brand-primary); color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 4px 14px rgba(67, 24, 255, 0.25);"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>+ Agregar Usuario</span>
            </button>

            <!-- Solo icono de CSV -->
            <button 
              id="btn-export-csv" 
              title="Descargar tabla en formato CSV" 
              style="display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 12px; background: var(--bg-main); border: 1px solid var(--border-main); color: var(--text-primary); cursor: pointer; transition: all 0.2s ease;"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- TAB 0: PANEL CONTROL (EXECUTIVE MACRO OVERVIEW) -->
        <!-- ============================================================ -->
        <div id="tab-dashboard" class="tab-pane active" style="padding: 24px;">
          
          <!-- Section 1: Posición de Activos Líquidos (Caja y Bancos) -->
          <div style="margin-bottom: 26px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
              <div>
                <h3 style="margin: 0; font-size: 15px; font-weight: 800; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.04em;">
                  Activos Líquidos en Custodia (Caja y Bancos)
                </h3>
                <p style="margin: 2px 0 0 0; font-size: 12px; color: var(--text-muted);">
                  Total de dinero disponible en cuentas institucionales y efectivo
                </p>
              </div>
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-activos"
                style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--brand-primary); background: transparent; border: none; cursor: pointer;"
              >
                Ver tarjetas de activos →
              </button>
            </div>

            <!-- Mini Horizon Cards Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px;">
              {ACTIVOS_LIQUIDOS.map((a) => (
                <div style="background: var(--bg-card-secondary); border: 1px solid var(--border-main); border-radius: 18px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px;">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                      <span style="font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 3px 8px; border-radius: 6px; background: rgba(67, 24, 255, 0.12); color: var(--brand-primary);">
                        {a.institucion}
                      </span>
                      <div style="font-size: 14px; font-weight: 800; color: var(--text-primary); margin-top: 6px;">
                        {a.activo}
                      </div>
                      <div style="font-size: 11px; color: var(--text-muted);">
                        Titular: {a.empresa}
                      </div>
                    </div>
                    <div style="width: 36px; height: 36px; border-radius: 10px; background: var(--bg-card); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-main); color: var(--success);">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        <line x1="6" y1="12" x2="18" y2="12"></line>
                        <circle cx="12" cy="12" r="2"></circle>
                      </svg>
                    </div>
                  </div>

                  <div style="border-top: 1px solid var(--border-main); padding-top: 10px;">
                    <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 2px;">
                      Saldo Disponible (COP)
                    </div>
                    <div style="font-size: 20px; font-weight: 800; color: var(--success); font-family: ui-monospace, monospace;">
                      {formatCop(a.saldoCop)}
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 10px; color: var(--text-muted); margin-top: 6px; font-family: ui-monospace, monospace;">
                      <span>+ {formatCop(a.ingresosCop)}</span>
                      <span>- {formatCop(a.egresosCop)}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Section 2: Custodia de Divisas & Falta por Liquidar -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 24px;">
            
            <!-- Box 1: Custodia Divisas & USDT -->
            <div style="border: 1px solid var(--border-main); border-radius: 18px; padding: 20px; background: var(--bg-card);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(67, 24, 255, 0.12); color: var(--brand-primary); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="2" y1="12" x2="22" y2="12"></line>
                    </svg>
                  </div>
                  <div>
                    <h4 style="margin: 0; font-size: 14px; font-weight: 800; color: var(--text-primary);">
                      Custodia de Divisas y USDT
                    </h4>
                    <p style="margin: 0; font-size: 11px; color: var(--text-muted);">
                      Saldo retenido para cobertura y arbitraje
                    </p>
                  </div>
                </div>
                <button 
                  type="button"
                  class="btn-switch-tab-shortcut" 
                  data-shortcut="tab-divisas"
                  style="font-size: 11px; font-weight: 700; color: var(--brand-primary); background: transparent; border: none; cursor: pointer;"
                >
                  Ver todas →
                </button>
              </div>

              <div style="display: flex; flex-direction: column; gap: 8px;">
                {DIVISAS.map((d) => (
                  <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-radius: 12px; background: var(--bg-card-secondary); border: 1px solid var(--border-main);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                      <span style="font-size: 12px; font-weight: 800; padding: 2px 7px; border-radius: 6px; background: var(--bg-card); color: var(--brand-primary); border: 1px solid var(--border-main);">
                        {d.codigo}
                      </span>
                      <span style="font-size: 12px; color: var(--text-secondary); font-family: ui-monospace, monospace;">
                        Recibido: {formatDecimal(d.totalRecibido, 0)}
                      </span>
                    </div>
                    <div style="text-align: right;">
                      <div style="font-size: 13px; font-weight: 800; font-family: ui-monospace, monospace; color: {d.totalPendiente > 0 ? 'var(--warning)' : 'var(--text-muted)'};">
                        {formatDecimal(d.totalPendiente, 2)} <span style="font-size: 10px;">en custodia</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Box 2: Cuánto Falta Liquidar a Clientes -->
            <div style="border: 1px solid var(--border-main); border-radius: 18px; padding: 20px; background: var(--bg-card);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div style="width: 36px; height: 36px; border-radius: 10px; background: var(--warning-light); color: var(--warning); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="12" y1="8" x2="12" y2="12"></line>
                    </svg>
                  </div>
                  <div>
                    <h4 style="margin: 0; font-size: 14px; font-weight: 800; color: var(--text-primary);">
                      Clientes por Liquidar
                    </h4>
                    <p style="margin: 0; font-size: 11px; color: var(--text-muted);">
                      Saldos COP pendientes de dispersión
                    </p>
                  </div>
                </div>
                <button 
                  type="button"
                  class="btn-switch-tab-shortcut" 
                  data-shortcut="tab-clientes"
                  style="font-size: 11px; font-weight: 700; color: var(--brand-primary); background: transparent; border: none; cursor: pointer;"
                >
                  Ver clientes →
                </button>
              </div>

              <div style="display: flex; flex-direction: column; gap: 8px;">
                {CLIENTES.filter(c => c.pendienteCop > 0).slice(0, 5).map((c) => (
                  <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-radius: 12px; background: var(--bg-card-secondary); border: 1px solid var(--border-main);">
                    <div>
                      <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">
                        {c.nombre}
                      </div>
                      <span style="font-size: 10px; font-family: ui-monospace, monospace; color: var(--text-muted);">
                        {c.codigo}
                      </span>
                    </div>
                    <div style="text-align: right;">
                      <div style="font-size: 13px; font-weight: 800; font-family: ui-monospace, monospace; color: var(--warning);">
                        {formatCop(c.pendienteCop)}
                      </div>
                      <span style="font-size: 10px; color: var(--text-muted);">
                        Pendiente
                      </span>
                    </div>
                  </div>
                ))}
              </div>

              <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border-main); display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">
                  Total Pasivo Clientes:
                </span>
                <span style="font-size: 16px; font-weight: 800; color: var(--warning); font-family: ui-monospace, monospace;">
                  {formatCop(metricas.totalFaltaLiquidarClientes)}
                </span>
              </div>
            </div>

          </div>

          <!-- Section 3: Accesos Rápidos Contables -->
          <div style="background: var(--bg-card-secondary); border: 1px solid var(--border-main); border-radius: 18px; padding: 18px 22px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px;">
            <div>
              <div style="font-size: 14px; font-weight: 800; color: var(--text-primary);">
                Módulos Operativos y Cambiarios
              </div>
              <div style="font-size: 12px; color: var(--text-muted);">
                Accede rápidamente a las tablas transaccionales de compra, venta y control de usuarios
              </div>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 10px;">
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-compras"
                style="padding: 8px 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border-main); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer;"
              >
                Compra USDT ({COMPRAS_USDT.length})
              </button>
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-ventas"
                style="padding: 8px 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border-main); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer;"
              >
                Venta USDT ({VENTAS_USDT.length})
              </button>
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-activos"
                style="padding: 8px 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border-main); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer;"
              >
                Activos Líquidos ({ACTIVOS_LIQUIDOS.length})
              </button>
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-usuarios"
                style="padding: 8px 14px; border-radius: 10px; background: var(--brand-primary); color: #fff; border: none; font-size: 12px; font-weight: 700; cursor: pointer;"
              >
                Usuarios & Divisas
              </button>
            </div>
          </div>

        </div>
        <!-- ============================================================ -->
        <!-- TAB 1: CLIENTES -->
        <!-- ============================================================ -->
        <div id="tab-clientes" class="tab-pane" style="display: none; overflow-x: auto;">
          <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-main);">
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Código</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Nombre</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Ingresos Totales (COP)</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Dispersado (COP)</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Saldo Pendiente (COP)</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Estado</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {CLIENTES.map((c) => {
                const tieneSaldo = c.pendienteCop > 0;
                const saldoAFavor = c.pendienteCop < 0;
                const clientSlug = `c-${c.codigo.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '')}`;
                return (
                  <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
                    <td style="padding: 16px 20px;">
                      <span style="font-size: 11px; font-weight: 700; font-family: ui-monospace, monospace; padding: 3px 8px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--brand-primary); border: 1px solid var(--border-main);">
                        {c.codigo}
                      </span>
                    </td>
                    <td style="padding: 16px 20px; font-weight: 600; color: var(--text-primary); font-size: 14px;">{c.nombre}</td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-primary); font-size: 14px;">{formatCop(c.ingresosCop)}</td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success); font-weight: 600; font-size: 14px;">{formatCop(c.pagadoCop)}</td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; font-size: 14px; color: {tieneSaldo ? 'var(--warning)' : saldoAFavor ? 'var(--info)' : 'var(--text-muted)'};">
                      {formatCop(c.pendienteCop)}
                    </td>
                    <td style="padding: 16px 20px; text-align: center;">
                      {tieneSaldo && (
                        <span class="status-pill status-warning">POR COBRAR</span>
                      )}
                      {saldoAFavor && (
                        <span class="status-pill status-info">SALDO A FAVOR</span>
                      )}
                      {!tieneSaldo && !saldoAFavor && (
                        <span class="status-pill status-success">AL DÍA</span>
                      )}
                    </td>
                    <td style="padding: 16px 20px; text-align: center;">
                      <div style="display: inline-flex; align-items: center; gap: 8px;">
                        <!-- Acción 1: Ver portal cliente /cliente/[id] (Acceso interno sin PIN) -->
                        <a 
                          href={`/cliente/${clientSlug}?from=dashboard`} 
                          class="btn-view-portal"
                          title={`Ver portal contable de ${c.nombre} (Sin PIN)`}
                          style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); cursor: pointer; transition: all 0.2s;"
                        >
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                          </svg>
                        </a>

                        <!-- Acción 2: Compartir con PIN de 4 dígitos -->
                        <button 
                          class="btn-share-client" 
                          data-codigo={c.codigo} 
                          data-nombre={c.nombre}
                          data-id={c.id}
                          title="Compartir enlace seguro con PIN de 4 dígitos"
                          style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--brand-primary-light); color: var(--brand-primary); cursor: pointer; transition: all 0.2s;"
                        >
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
