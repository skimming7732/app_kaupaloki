<style is:global>
  /* Sidebar styles Horizon */
  .sidebar-link {
    background: transparent;
    color: var(--text-secondary);
    position: relative;
  }
  .sidebar-link:hover {
    background: var(--bg-card-secondary);
    color: var(--text-primary);
  }
  .sidebar-link.active {
    background: var(--brand-primary-light);
    color: var(--brand-primary);
    font-weight: 700;
  }
  .sidebar-link.active::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 24px;
    background: var(--brand-primary);
    border-radius: 4px 0 0 4px;
  }

  /* Navbar toggle button (oculto en PC) */
  #btn-navbar-sidebar-toggle,
  .mobile-only-toggle {
    display: none !important;
  }

  /* Header Responsive Compact Mobile (Una sola línea garantizada sin saltos) */
  @media (max-width: 900px) {
    #btn-navbar-sidebar-toggle,
    .mobile-only-toggle {
      display: flex !important;
    }
    .horizon-header {
      flex-wrap: nowrap !important;
      justify-content: space-between !important;
      align-items: center !important;
      gap: 8px !important;
      margin-bottom: 14px !important;
      padding: 0 !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .header-left-box {
      gap: 8px !important;
      min-width: 0 !important;
      flex: 1 1 auto !important;
      overflow: hidden !important;
    }
    #btn-navbar-sidebar-toggle {
      width: 36px !important;
      height: 36px !important;
      border-radius: 10px !important;
      flex-shrink: 0 !important;
    }
    .header-titles-box {
      min-width: 0 !important;
      overflow: hidden !important;
    }
    .header-breadcrumb {
      display: none !important;
    }
    #page-heading {
      font-size: 18px !important;
      line-height: 1.15 !important;
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
    }
    .horizon-capsule {
      padding: 3px 6px !important;
      gap: 4px !important;
      border-radius: 9999px !important;
      flex-shrink: 0 !important;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05) !important;
    }
    #btn-sync-now {
      padding: 4px 7px !important;
      border-radius: 12px !important;
      gap: 4px !important;
      font-size: 10px !important;
    }
    #sync-text {
      display: none !important;
    }
    #sync-dot {
      width: 6px !important;
      height: 6px !important;
    }
    #btn-open-airtable-config,
    #btn-theme-toggle {
      width: 28px !important;
      height: 28px !important;
    }
    #btn-open-airtable-config svg,
    #btn-theme-toggle svg {
      width: 14px !important;
      height: 14px !important;
    }
    #header-info-icon {
      display: none !important;
    }
    #user-avatar-btn {
      width: 32px !important;
      height: 32px !important;
      font-size: 12px !important;
    }
  }

  /* Compact Responsive KPI Cards: evita truncamientos en mobile */
  @media (max-width: 640px) {
    #kpis-tab-dashboard {
      grid-template-columns: 1fr !important;
      gap: 10px !important;
    }
