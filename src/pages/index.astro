        negociosTfoot.innerHTML = `
          <tr style="background: var(--bg-main); border-top: 2px solid var(--border-main); font-weight: 800;">
            <td colspan="7" style="padding: 14px 18px; color: var(--text-primary);">TOTALES (${negocios.length} OPERACIONES)</td>
            <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace;">${fmtCopClient(totalVolumenCop)}</td>
            <td></td>
            <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; color: var(--success);">${fmtCopClient(totalComisionesCop)}</td>
            <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; color: var(--brand-primary);">${fmtCopClient(totPagar)}</td>
          </tr>
        `;
      }
    }

    // 9. Actualizar Dispersiones
    if (dispersiones.length > 0) {
      const dispTbody = document.getElementById('dispersiones-table-tbody');
      if (dispTbody) {
        dispTbody.innerHTML = dispersiones.map((d: any) => `
          <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main);">
            <td style="padding: 16px 20px; font-weight: 700; font-family: ui-monospace, monospace; color: var(--brand-primary);">${d.idDispersion}</td>
            <td style="padding: 16px 20px; color: var(--text-secondary);">${d.fecha}</td>
            <td style="padding: 16px 20px; font-weight: 700;">${d.clienteNombre}</td>
            <td style="padding: 16px 20px;">
              <span style="font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 8px; background: var(--bg-main); border: 1px solid var(--border-main);">${d.medioPagoNombre}</span>
            </td>
            <td style="padding: 16px 20px; color: var(--text-secondary); font-size: 13px;">${d.concepto}</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--danger);">${fmtCopClient(d.valorTotalDispersion)}</td>
            <td style="padding: 16px 20px; text-align: center;">
              ${d.tieneComprobante
                ? '<span style="font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 20px; background: rgba(5, 205, 153, 0.12); color: var(--success);">✓ Adjunto</span>'
                : '<span style="font-size: 11px; color: var(--text-muted);">Sin adjunto</span>'}
            </td>
          </tr>
        `).join('');
      }
      const dispTfoot = document.getElementById('dispersiones-table-tfoot');
      if (dispTfoot) {
        const totDisp = dispersiones.reduce((acc: number, d: any) => acc + (Number(d.valorTotalDispersion) || 0), 0);
        dispTfoot.innerHTML = `
          <tr style="background: var(--bg-main); border-top: 2px solid var(--border-main); font-weight: 800;">
            <td colspan="5" style="padding: 16px 20px;">TOTAL DISPERSADO</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--danger);">${fmtCopClient(totDisp)}</td>
            <td></td>
          </tr>
        `;
      }
    }

    // 10. Actualizar Compras USDT y Ventas USDT
    if (comprasUsdt.length > 0) {
      const comprasTbody = document.getElementById('compras-table-tbody');
      if (comprasTbody) {
        comprasTbody.innerHTML = comprasUsdt.map((c: any) => `
          <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main);">
            <td style="padding: 16px 20px; font-weight: 700; font-family: ui-monospace, monospace; color: var(--brand-primary); font-size: 13px;">${c.idTransaccion}</td>
            <td style="padding: 16px 20px; color: var(--text-secondary); font-size: 13px;">${c.fecha}</td>
            <td style="padding: 16px 20px;">
              <span style="font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 8px; background: var(--bg-main); border: 1px solid var(--border-main);">${c.divisaNombre}</span>
            </td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 600;">${fmtNumClient(c.montoDivisa, 2)}</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-secondary);">${fmtNumClient(c.tasaUsdt, 4)}</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--success);">+${fmtNumClient(c.totalRecibidoUsdt, 2)} USDT</td>
            <td style="padding: 16px 20px;">
              <span style="font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 8px; background: rgba(5, 205, 153, 0.12); color: var(--success);">${c.walletDestino}</span>
            </td>
            <td style="padding: 16px 20px; font-family: ui-monospace, monospace; font-size: 12px; color: var(--text-secondary);">${c.negocioVinculado}</td>
          </tr>
        `).join('');
      }
      const comprasTfoot = document.getElementById('compras-table-tfoot');
      if (comprasTfoot) {
        const totCompUsdt = comprasUsdt.reduce((acc: number, c: any) => acc + (Number(c.totalRecibidoUsdt) || 0), 0);
        comprasTfoot.innerHTML = `
          <tr style="background: var(--bg-main); border-top: 2px solid var(--border-main); font-weight: 800;">
            <td colspan="5" style="padding: 16px 20px;">TOTAL COMPRADO EN USDT (${comprasUsdt.length} OPERACIONES)</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success);">+${fmtNumClient(totCompUsdt, 2)} USDT</td>
            <td colspan="2"></td>
          </tr>
        `;
      }
    }

    if (ventasUsdt.length > 0) {
      const ventasTbody = document.getElementById('ventas-table-tbody');
      if (ventasTbody) {
        ventasTbody.innerHTML = ventasUsdt.map((v: any) => `
          <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main);">
            <td style="padding: 16px 20px; font-weight: 700; font-family: ui-monospace, monospace; color: var(--brand-primary); font-size: 13px;">${v.idTransaccion}</td>
            <td style="padding: 16px 20px; color: var(--text-secondary); font-size: 13px;">${v.fecha}</td>
            <td style="padding: 16px 20px;">
              <span style="font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 8px; background: rgba(238, 93, 80, 0.12); color: var(--danger);">${v.walletOrigen}</span>
            </td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 700; color: var(--danger);">-${fmtNumClient(v.cantidadUsdt, 2)} USDT</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-secondary);">${fmtCopClient(v.tasaVentaCop)}</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--warning);">${fmtCopClient(v.impuestos)}</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--success);">+${fmtCopClient(v.montoNetoRecibidoCop)}</td>
            <td style="padding: 16px 20px;">
              <span style="font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 8px; background: rgba(57, 101, 255, 0.12); color: var(--brand-primary);">${v.cuentaDestinoNombre}</span>
            </td>
          </tr>
        `).join('');
      }
      const ventasTfoot = document.getElementById('ventas-table-tfoot');
      if (ventasTfoot) {
        const totVentaUsdt = ventasUsdt.reduce((acc: number, v: any) => acc + (Number(v.cantidadUsdt) || 0), 0);
        const totVentaImp = ventasUsdt.reduce((acc: number, v: any) => acc + (Number(v.impuestos) || 0), 0);
        const totVentaCop = ventasUsdt.reduce((acc: number, v: any) => acc + (Number(v.montoNetoRecibidoCop) || 0), 0);
        ventasTfoot.innerHTML = `
          <tr style="background: var(--bg-main); border-top: 2px solid var(--border-main); font-weight: 800;">
            <td colspan="3" style="padding: 16px 20px;">TOTAL MONETIZADO (${ventasUsdt.length} VENTAS USDT)</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--danger);">-${fmtNumClient(totVentaUsdt, 2)} USDT</td>
            <td></td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--warning);">${fmtCopClient(totVentaImp)}</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success);">+${fmtCopClient(totVentaCop)}</td>
            <td></td>
          </tr>
        `;
      }
    }

    // 11. Actualizar Divisas
    if (divisas.length > 0) {
      const divisasTbody = document.getElementById('divisas-table-tbody');
      if (divisasTbody) {
        divisasTbody.innerHTML = divisas.map((div: any) => `
          <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main);">
            <td style="padding: 16px 20px; font-weight: 800; font-family: ui-monospace, monospace; color: var(--brand-primary);">${div.divisa}</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success);">+${fmtNumClient(div.ingresoEnDivisa, 2)}</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--danger);">-${fmtNumClient(div.egresoEnDivisa, 2)}</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: ${(Number(div.saldo) || 0) > 0 ? 'var(--brand-primary)' : 'var(--text-muted)'};">${fmtNumClient(div.saldo, 2)}</td>
            <td style="padding: 16px 20px; text-align: center;">
              ${(Number(div.saldo) || 0) > 0
                ? '<span style="font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 20px; background: rgba(5, 205, 153, 0.12); color: var(--success);">En Custodia</span>'
                : '<span style="font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 20px; background: var(--bg-main); color: var(--text-muted);">Liquidado (0)</span>'}
            </td>
          </tr>
        `).join('');
      }
    }
  }

  async function syncAllFromAirtable(manual = false) {
    const savedPat = localStorage.getItem(PAT_STORAGE_KEY) || '';
    if (manual) {
      setSyncIndicator('syncing', 'Sincronizando con Airtable...');
      if (btnSyncNow) {
        btnSyncNow.disabled = true;
        btnSyncNow.style.opacity = '0.6';
      }
    }

    try {
      const res = await fetch(EDGE_SYNC_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pat: savedPat || undefined, baseId: AIRTABLE_BASE_ID }),
      });

      if (res.ok) {
        const data = await res.json();
        if (data?.snapshot) {
          applyAirtableSnapshot(data.snapshot);
          const timeStr = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          setSyncIndicator('live', `En vivo con Airtable • ${timeStr}`);
          return true;
        }
      } else {
        const errData = await res.json().catch(() => ({}));
        if (errData?.needsPat && manual) {
          setSyncIndicator('cached', 'Conecta tu PAT de Airtable');
          openAirtableModal();
          return false;
        }
      }
    } catch (err) {
      console.warn('Edge sync warning:', err);
    } finally {
      if (btnSyncNow) {
        btnSyncNow.disabled = false;
        btnSyncNow.style.opacity = '1';
      }
    }

    // Si no hay PAT en el servidor pero hay un snapshot guardado en Supabase, leerlo
    try {
      const { data: row } = await supabase
        .from('airtable_sync_state')
        .select('snapshot, updated_at, airtable_pat')
        .eq('id', 'main')
        .maybeSingle();

      if (row?.snapshot && Object.keys(row.snapshot).length > 0) {
        applyAirtableSnapshot(row.snapshot);
        const t = row.updated_at ? new Date(row.updated_at).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' }) : 'ahora';
        setSyncIndicator('live', `Sincronizado • ${t}`);
        return true;
      }
    } catch (_) {}

    return false;
  }

  airtablePatForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const patVal = airtablePatInput?.value.trim() || '';
    if (!patVal) return;
    localStorage.setItem(PAT_STORAGE_KEY, patVal);
    closeAirtableModal();
    await syncAllFromAirtable(true);
  });

  btnSyncNow?.addEventListener('click', (e) => {
    e.stopPropagation();
    syncAllFromAirtable(true);
  });

  // Suscripción a Supabase Realtime para recibir cambios de Airtable al instante en todas las pestañas abiertas
  try {
    supabase
      .channel('public:airtable-sync-state')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'airtable_sync_state' }, (payload: any) => {
        const newSnap = payload?.new?.snapshot;
        if (newSnap && Object.keys(newSnap).length > 0) {
          applyAirtableSnapshot(newSnap);
          const timeStr = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          setSyncIndicator('live', `En vivo (Realtime) • ${timeStr}`);
        }
      })
      .subscribe();
  } catch (rtSyncErr) {
    console.warn('Realtime airtable_sync_state warning:', rtSyncErr);
  }

  // Sincronización inicial y polling automático cada 15 segundos + al enfocar ventana
  syncAllFromAirtable(false);
  setInterval(() => {
    if (document.visibilityState === 'visible') {
      syncAllFromAirtable(false);
    }
  }, 15000);
  window.addEventListener('focus', () => {
    syncAllFromAirtable(false);
  });
</script>
