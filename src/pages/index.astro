---
import Layout from '../layouts/Layout.astro';
import { 
  CLIENTES, 
  NEGOCIOS, 
  PAGOS, 
  DIVISAS, 
  COMPRAS_USDT, 
  VENTAS_USDT,
  ACTIVOS_LIQUIDOS,
  ACTIVOS_DIGITALES,
  USUARIOS_AIRTABLE,
  ADMINS, 
  CURRENCY_FLAGS,
  getCurrencyFlag,
  formatCurrencyWithFlag,
  getMetricasContables 
} from '../data/airtableData';

const metricas = getMetricasContables();

const totalNegociosCop = NEGOCIOS.reduce((acc, n) => acc + (n.ingresoCop || 0), 0);
const tasaMediaNegocios = NEGOCIOS.length ? Math.round(NEGOCIOS.reduce((acc, n) => acc + (n.tasa || 0), 0) / NEGOCIOS.length) : 0;

const totalInversionComprasCop = COMPRAS_USDT.reduce((acc, c) => acc + (c.costo || 0), 0);
const tasaMediaCompras = COMPRAS_USDT.length ? Math.round(COMPRAS_USDT.reduce((acc, c) => acc + (c.tasa || 0), 0) / COMPRAS_USDT.length) : 0;

const totalRecaudoVentasCop = VENTAS_USDT.reduce((acc, v) => acc + (v.totalCop || 0), 0);
const tasaMediaVentas = VENTAS_USDT.length ? Math.round(VENTAS_USDT.reduce((acc, v) => acc + (v.tasa || 0), 0) / VENTAS_USDT.length) : 0;

const totalPagosDispersionesCop = PAGOS.reduce((acc, p) => acc + (p.montoCop || 0), 0);
const numPagosConComprobante = PAGOS.filter(p => p.comprobanteUrl || (p.comprobantes && p.comprobantes.length)).length;
const numPagosPendientes = Math.max(0, PAGOS.length - numPagosConComprobante);
const saldoMaximoCliente = Math.max(...CLIENTES.map(c => c.saldoCop || 0), 0);
const promedioSaldoCliente = CLIENTES.length ? Math.round(metricas.totalFaltaLiquidarClientes / CLIENTES.length) : 0;

function formatCop(amount: number): string {
  return new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    maximumFractionDigits: 0
  }).format(amount);
}

function formatDecimal(amount: number, digits = 2): string {
  return new Intl.NumberFormat('es-CO', {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits
  }).format(amount);
}
---

<Layout title="Kaupaloki - Horizon UI Dashboard Contable">
  <div class="layout-wrapper" style="display: flex; min-height: 100vh;">
    
    <!-- ============================================================== -->
    <!-- ============================================================== -->
    <!-- SIDEBAR (HORIZON UI STYLE - COLLAPSIBLE) -->
    <!-- ============================================================== -->
    <aside id="main-sidebar" style="width: 290px; background: var(--bg-sidebar); border-right: 1px solid var(--border-main); display: flex; flex-direction: column; position: fixed; top: 0; bottom: 0; left: 0; z-index: 40; transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
      
      <!-- Logo Container with Collapse Button -->
      <div class="sidebar-logo-container" style="padding: 22px 20px 18px 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-main); min-height: 74px; box-sizing: border-box;">
        <div class="sidebar-brand-wrapper" style="display: flex; align-items: center; gap: 10px; overflow: hidden;">
          <img src="/logo.png" alt="Kaupaloki" class="theme-logo-dark logo-full" style="max-height: 34px; width: auto; object-fit: contain;" />
          <img src="/logo-blue.png" alt="Kaupaloki" class="theme-logo-light logo-full" style="max-height: 34px; width: auto; object-fit: contain;" />
          <div class="logo-mini" style="display: none; width: 38px; height: 38px; border-radius: 12px; background: var(--brand-primary); color: #ffffff; font-weight: 800; font-size: 19px; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(67, 24, 255, 0.3);">
            K
          </div>
        </div>
        <button id="btn-toggle-sidebar" title="Comprimir menú" style="background: var(--bg-card); border: 1px solid var(--border-main); width: 32px; height: 32px; border-radius: 10px; color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; flex-shrink: 0; box-shadow: var(--shadow-card);">
          <svg id="collapse-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Navigation Links -->
      <div style="padding: 20px 14px; flex: 1; overflow-y: auto; overflow-x: hidden;">
        <div class="sidebar-nav-title" style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); padding: 0 16px 12px 16px;">
          Navegación Contable
        </div>

        <nav style="display: flex; flex-direction: column; gap: 6px;">
          <!-- 1. Panel Control -->
          <button class="sidebar-link active" data-target="tab-dashboard" title="Panel Control" style="display: flex; align-items: center; gap: 14px; padding: 13px 18px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; width: 100%; transition: all 0.2s ease;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span class="sidebar-text" style="flex: 1;">Panel Control</span>
            <span class="count-badge" style="font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 9999px; background: rgba(67, 24, 255, 0.12); color: var(--brand-primary); letter-spacing: 0.04em;">
              EN VIVO
            </span>
          </button>

          <!-- 2. Clientes -->
          <button class="sidebar-link" data-target="tab-clientes" title="Clientes" style="display: flex; align-items: center; gap: 14px; padding: 13px 18px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; width: 100%; transition: all 0.2s ease;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span class="sidebar-text" style="flex: 1;">Clientes</span>
            <span class="count-badge" id="badge-count-clientes" style="font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 9999px; background: var(--bg-card-secondary); color: var(--text-secondary);">
              {CLIENTES.length}
            </span>
          </button>

          <!-- 3. Negocios -->
          <button class="sidebar-link" data-target="tab-negocios" title="Negocios" style="display: flex; align-items: center; gap: 14px; padding: 13px 18px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; width: 100%; transition: all 0.2s ease;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span class="sidebar-text" style="flex: 1;">Negocios</span>
            <span class="count-badge" id="badge-count-negocios" style="font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 9999px; background: var(--bg-card-secondary); color: var(--text-secondary);">
              {NEGOCIOS.length}
            </span>
          </button>

          <!-- 4. COMPRA USDT -->
          <button class="sidebar-link" data-target="tab-compras" title="Compra USDT" style="display: flex; align-items: center; gap: 14px; padding: 13px 18px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; width: 100%; transition: all 0.2s ease;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
            <span class="sidebar-text" style="flex: 1;">Compra USDT</span>
            <span class="count-badge" id="badge-count-compras" style="font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 9999px; background: var(--bg-card-secondary); color: var(--text-secondary);">
              {COMPRAS_USDT.length}
            </span>
          </button>

          <!-- 5. VENTA USDT -->
          <button class="sidebar-link" data-target="tab-ventas" title="Venta USDT" style="display: flex; align-items: center; gap: 14px; padding: 13px 18px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; width: 100%; transition: all 0.2s ease;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
              <polyline points="17 18 23 18 23 12"></polyline>
            </svg>
            <span class="sidebar-text" style="flex: 1;">Venta USDT</span>
            <span class="count-badge" id="badge-count-ventas" style="font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 9999px; background: var(--bg-card-secondary); color: var(--text-secondary);">
              {VENTAS_USDT.length}
            </span>
          </button>

          <!-- 6. ACTIVO LIQUIDOS (TIPO TARJETAS) -->
          <button class="sidebar-link" data-target="tab-activos" title="Activos Líquidos" style="display: flex; align-items: center; gap: 14px; padding: 13px 18px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; width: 100%; transition: all 0.2s ease;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
              <circle cx="6" cy="15" r="1"></circle>
            </svg>
            <span class="sidebar-text" style="flex: 1;">Activos Líquidos</span>
            <span class="count-badge" id="badge-count-activos" style="font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 9999px; background: var(--bg-card-secondary); color: var(--text-secondary);">
              {ACTIVOS_LIQUIDOS.length}
            </span>
          </button>

          <!-- 6.1 ACTIVOS DIGITALES (WALLETS USDT) -->
          <button class="sidebar-link" data-target="tab-activos-digitales" title="Activos Digitales" style="display: flex; align-items: center; gap: 14px; padding: 13px 18px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; width: 100%; transition: all 0.2s ease;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
              <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
              <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path>
            </svg>
            <span class="sidebar-text" style="flex: 1;">Activos Digitales</span>
            <span class="count-badge" id="badge-count-activos-digitales" style="font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 9999px; background: var(--bg-card-secondary); color: var(--text-secondary);">
              {ACTIVOS_DIGITALES.length}
            </span>
          </button>

          <!-- 7. DIVISAS -->
          <button class="sidebar-link" data-target="tab-divisas" title="Divisas" style="display: flex; align-items: center; gap: 14px; padding: 13px 18px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; width: 100%; transition: all 0.2s ease;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span class="sidebar-text" style="flex: 1;">Divisas</span>
            <span class="count-badge" id="badge-count-divisas" style="font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 9999px; background: var(--bg-card-secondary); color: var(--text-secondary);">
              {DIVISAS.length}
            </span>
          </button>

          <!-- 8. USUARIOS -->
          <button class="sidebar-link" data-target="tab-usuarios" title="Usuarios" style="display: flex; align-items: center; gap: 14px; padding: 13px 18px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: left; width: 100%; transition: all 0.2s ease;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span class="sidebar-text" style="flex: 1;">Usuarios</span>
            <span class="count-badge" id="badge-count-usuarios" style="font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 9999px; background: var(--bg-card-secondary); color: var(--text-secondary);">
              {USUARIOS_AIRTABLE.length}
            </span>
          </button>
        </nav>
      </div>

      <!-- Bottom Card: Airtable Info -->
      <div class="sidebar-bottom-card" style="padding: 16px; border-top: 1px solid var(--border-main);">
        <div id="sidebar-airtable-card" title="Configurar o sincronizar Airtable en tiempo real" style="background: var(--bg-card-secondary); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 8px; cursor: pointer; border: 1px solid var(--border-main); transition: all 0.2s;">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span id="sidebar-sync-dot" style="width: 8px; height: 8px; border-radius: 50%; background: var(--success); box-shadow: 0 0 6px var(--success);"></span>
              <span id="sidebar-sync-status" style="font-size: 12px; font-weight: 700; color: var(--text-primary);">Airtable En Vivo</span>
            </div>
            <span style="font-size: 10px; font-weight: 700; color: var(--brand-primary); background: var(--brand-primary-light); padding: 2px 6px; border-radius: 6px;">Config</span>
          </div>
          <p style="margin: 0; font-size: 11px; color: var(--text-secondary); font-family: ui-monospace, monospace; word-break: break-all;">
            Base: appncUKgTkDojFj4B
          </p>
          <div style="display: flex; align-items: center; justify-content: space-between; font-size: 11px; color: var(--text-muted); border-top: 1px solid var(--border-main); padding-top: 8px;">
            <span id="sidebar-last-sync">Sincronizado</span>
            <span>v1.3.0</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- ============================================================== -->
    <!-- MAIN CONTENT AREA -->
    <!-- ============================================================== -->
    <main id="main-content" style="flex: 1; margin-left: 290px; padding: 30px; min-width: 0; transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
      
      <!-- ============================================================== -->
      <!-- TOP FLOATING NAVBAR (HORIZON UI EXACT TO DESIGN REFERENCE) -->
      <!-- ============================================================== -->
      <header class="horizon-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; padding: 4px 0;">
        <!-- Left: Toggle & Breadcrumb & Title -->
        <div style="display: flex; align-items: center; gap: 14px;">
          <!-- Mobile only menu button (oculto en PC) -->
          <button id="btn-navbar-sidebar-toggle" class="mobile-only-toggle" title="Alternar menú lateral" style="display: none; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--border-main); color: var(--text-secondary); cursor: pointer; box-shadow: var(--shadow-card); transition: all 0.2s;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div>
            <div style="font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 2px;">
              Pages / <span id="breadcrumb-title" style="color: var(--text-primary); font-weight: 600;">Dashboard</span>
            </div>
            <h1 id="page-heading" style="margin: 0; font-size: 32px; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); line-height: 1.15;">
              Panel Control
            </h1>
          </div>
        </div>

        <!-- Right: Floating Horizon Capsule Island -->
        <div class="horizon-capsule" style="display: flex; align-items: center; gap: 10px; background: var(--bg-card); border-radius: 35px; padding: 8px 14px; box-shadow: var(--shadow-nav); border: 1px solid var(--border-main);">
          
          <!-- Live Sync Button with Status Text -->
          <button id="btn-sync-now" title="Sincronizar con Airtable en tiempo real (Click para sincronizar)" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 20px; background: var(--bg-card-secondary); border: 1px solid var(--border-main); color: var(--text-primary); cursor: pointer; position: relative; transition: all 0.2s; font-size: 11px; font-weight: 700;">
            <svg id="sync-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-primary);">
              <polyline points="23 4 23 10 17 10"></polyline>
              <polyline points="1 20 1 14 7 14"></polyline>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            <span id="sync-text">En Vivo</span>
            <span id="sync-dot" style="width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 6px var(--success);"></span>
          </button>

          <!-- Airtable Token Config Button -->
          <button id="btn-open-airtable-config" title="Configurar Token PAT de Airtable" style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: transparent; border: none; color: var(--text-muted); cursor: pointer; transition: color 0.2s;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </button>

          <!-- Theme Toggle (Moon / Sun clean vector icons) -->
          <button id="btn-theme-toggle" title="Cambiar tema Claro / Oscuro" style="display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: transparent; border: none; color: var(--text-muted); cursor: pointer; transition: color 0.2s;">
            <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <!-- Info Icon -->
          <div title="Kaupaloki v1.0 • app.kaupaloki.co" style="display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; color: var(--text-muted); cursor: pointer;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
