    if (trigger) {
      const vouchersAttr = trigger.getAttribute('data-vouchers');
      const title = trigger.getAttribute('data-title') || 'Comprobante';
      if (vouchersAttr) {
        try {
          const parsed = JSON.parse(vouchersAttr);
          if (Array.isArray(parsed) && parsed.length > 0) {
            openLightboxWithVouchers(parsed, title);
            return;
          }
        } catch (e) {}
      }
      const url = trigger.getAttribute('data-url');
      if (url) openLightboxWithVouchers([{ url, nombre: title }], title);
    }
  });

