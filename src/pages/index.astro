          </div>
          <div style="overflow: hidden;">
            <div style="font-size: 11px; font-weight: 500; color: var(--text-muted); margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
              Saldo Pendiente
            </div>
            <div style="font-size: 18px; font-weight: 800; color: var(--warning); font-family: ui-monospace, monospace; line-height: 1.2; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
              {formatCop(metricas.saldoPendienteNeto)}
            </div>
          </div>
        </div>

        <!-- Card 4: USDT Comprado -->
        <div class="metric-card" style="background: var(--bg-card); border-radius: 18px; padding: 14px 16px; box-shadow: var(--shadow-card); display: flex; align-items: center; gap: 12px; border: 1px solid var(--border-main); min-height: 74px;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--info-light); color: var(--info); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <div style="overflow: hidden;">
            <div style="font-size: 11px; font-weight: 500; color: var(--text-muted); margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
              Compra USDT
            </div>
            <div style="font-size: 18px; font-weight: 800; color: var(--text-primary); font-family: ui-monospace, monospace; line-height: 1.2; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
              ${formatDecimal(metricas.totalUsdtComprado, 0)} <span style="font-size: 11px; font-weight: 600; color: var(--text-muted);">USDT</span>
            </div>
          </div>
        </div>

        <!-- Card 5: Operaciones -->
        <div class="metric-card" style="background: var(--bg-card); border-radius: 18px; padding: 14px 16px; box-shadow: var(--shadow-card); display: flex; align-items: center; gap: 12px; border: 1px solid var(--border-main); min-height: 74px;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--brand-primary-light); color: var(--brand-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div style="overflow: hidden;">
            <div style="font-size: 11px; font-weight: 500; color: var(--text-muted); margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
              Operaciones
            </div>
            <div style="font-size: 18px; font-weight: 800; color: var(--text-primary); font-family: ui-monospace, monospace; line-height: 1.2;">
              {metricas.numNegocios}
            </div>
          </div>
        </div>

      </section>

      <!-- ============================================================== -->
      <!-- DATA TABLE CARD (HORIZON UI "COMPLEX TABLE" STYLE) -->
      <!-- ============================================================== -->
      <div style="background: var(--bg-card); border-radius: 20px; border: 1px solid var(--border-main); box-shadow: var(--shadow-card); overflow: hidden;">
        
        <!-- Table Action Header -->
        <div style="padding: 22px 26px; border-bottom: 1px solid var(--border-main); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px;">
          <div>
            <h2 id="active-table-title" style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">
              Tabla Clientes
            </h2>
            <p style="margin: 3px 0 0 0; font-size: 12px; color: var(--text-muted);">
              Visualización contable sincronizada directamente desde Airtable
            </p>
          </div>

          <div style="display: flex; align-items: center; gap: 10px;">
            <button id="btn-export-csv" style="display: flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 12px; background: var(--bg-main); border: 1px solid var(--border-main); color: var(--text-primary); font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s ease;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Exportar CSV
            </button>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- TAB 1: CLIENTES -->
        <!-- ============================================================ -->
        <div id="tab-clientes" class="tab-pane active" style="overflow-x: auto;">
          <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-main);">
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Código</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Nombre</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Ingresos Totales (COP)</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Dispersado (COP)</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Saldo Pendiente (COP)</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Estado</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {CLIENTES.map((c) => {
                const tieneSaldo = c.pendienteCop > 0;
                const saldoAFavor = c.pendienteCop < 0;
                const clientSlug = `c-${c.codigo.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '')}`;
                return (
                  <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
                    <td style="padding: 16px 20px;">
                      <span style="font-size: 11px; font-weight: 700; font-family: ui-monospace, monospace; padding: 3px 8px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--brand-primary); border: 1px solid var(--border-main);">
                        {c.codigo}
                      </span>
                    </td>
                    <td style="padding: 16px 20px; font-weight: 600; color: var(--text-primary); font-size: 14px;">{c.nombre}</td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-primary); font-size: 14px;">{formatCop(c.ingresosCop)}</td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success); font-weight: 600; font-size: 14px;">{formatCop(c.pagadoCop)}</td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; font-size: 14px; color: {tieneSaldo ? 'var(--warning)' : saldoAFavor ? 'var(--info)' : 'var(--text-muted)'};">
                      {formatCop(c.pendienteCop)}
                    </td>
                    <td style="padding: 16px 20px; text-align: center;">
                      {tieneSaldo && (
                        <span class="status-pill status-warning">POR COBRAR</span>
                      )}
                      {saldoAFavor && (
                        <span class="status-pill status-info">SALDO A FAVOR</span>
                      )}
                      {!tieneSaldo && !saldoAFavor && (
                        <span class="status-pill status-success">AL DÍA</span>
                      )}
                    </td>
                    <td style="padding: 16px 20px; text-align: center;">
                      <div style="display: inline-flex; align-items: center; gap: 8px;">
                        <!-- Acción 1: Ver portal cliente /cliente/[id] -->
                        <a 
                          href={`/cliente/${clientSlug}`} 
                          class="btn-view-portal"
                          title={`Ver portal contable de ${c.nombre}`}
                          style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); cursor: pointer; transition: all 0.2s;"
                        >
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                          </svg>
                        </a>

                        <!-- Acción 2: Compartir con PIN de 4 dígitos -->
                        <button 
                          class="btn-share-client" 
                          data-codigo={c.codigo} 
                          data-nombre={c.nombre}
                          data-id={c.id}
                          title="Compartir enlace seguro con PIN de 4 dígitos"
                          style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--brand-primary-light); color: var(--brand-primary); cursor: pointer; transition: all 0.2s;"
                        >
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
            <tfoot>
              <tr style="background: var(--bg-card-secondary); font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary);">
                <td colspan="2" style="padding: 18px 20px; text-transform: uppercase; font-size: 12px; color: var(--text-muted);">TOTALES CONSOLIDADOS:</td>
                <td style="padding: 18px 20px; text-align: right; font-size: 14px;">{formatCop(CLIENTES.reduce((a, b) => a + b.ingresosCop, 0))}</td>
                <td style="padding: 18px 20px; text-align: right; color: var(--success); font-size: 14px;">{formatCop(CLIENTES.reduce((a, b) => a + b.pagadoCop, 0))}</td>
                <td style="padding: 18px 20px; text-align: right; color: var(--warning); font-size: 14px;">{formatCop(CLIENTES.reduce((a, b) => a + b.pendienteCop, 0))}</td>
                <td></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- ============================================================ -->
        <!-- TAB 2: NEGOCIOS -->
        <!-- ============================================================ -->
        <div id="tab-negocios" class="tab-pane" style="display: none; overflow-x: auto;">
          <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-main);">
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">#</th>
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Código</th>
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Fecha</th>
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Cliente</th>
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Divisa</th>
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Monto Divisa</th>
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Tasa</th>
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Ingreso (COP)</th>
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Compra Rel</th>
                <th style="padding: 14px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">USDT x Divisa</th>
              </tr>
            </thead>
            <tbody>
              {NEGOCIOS.map((n) => (
                <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
                  <td style="padding: 14px 18px; color: var(--text-muted); font-family: ui-monospace, monospace; font-size: 13px;">{n.numero}</td>
                  <td style="padding: 14px 18px; font-weight: 700; color: var(--brand-primary); font-family: ui-monospace, monospace; font-size: 14px;">{n.codigo}</td>
                  <td style="padding: 14px 18px; color: var(--text-secondary); font-family: ui-monospace, monospace; font-size: 13px;">{n.fechaRegistro}</td>
                  <td style="padding: 14px 18px; font-weight: 600; color: var(--text-primary); font-size: 14px;">{n.clienteNombre}</td>
                  <td style="padding: 14px 18px; text-align: center;">
                    <span style="font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--text-primary); border: 1px solid var(--border-main);">
                      {n.divisaCodigo}
                    </span>
                  </td>
                  <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-primary); font-size: 14px;">{formatDecimal(n.montoDivisa, 0)}</td>
                  <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-secondary); font-size: 14px;">${formatDecimal(n.tasa, 2)}</td>
                  <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; font-weight: 700; color: var(--success); font-size: 14px;">{formatCop(n.ingresoCop)}</td>
                  <td style="padding: 14px 18px; font-family: ui-monospace, monospace; color: var(--text-muted); font-size: 12px;">{n.compraRelCodigo || '—'}</td>
                  <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; font-weight: 600; color: var(--info); font-size: 14px;">
                    {n.usdtPorDivisa > 0 ? `${formatDecimal(n.usdtPorDivisa, 2)}` : '0'}
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr style="background: var(--bg-card-secondary); font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary);">
                <td colspan="7" style="padding: 18px 18px; text-transform: uppercase; font-size: 12px; color: var(--text-muted);">TOTALES CONSOLIDADOS:</td>
                <td style="padding: 18px 18px; text-align: right; color: var(--success); font-size: 14px;">{formatCop(NEGOCIOS.reduce((a, b) => a + b.ingresoCop, 0))}</td>
                <td></td>
                <td style="padding: 18px 18px; text-align: right; color: var(--info); font-size: 14px;">{formatDecimal(NEGOCIOS.reduce((a, b) => a + b.usdtPorDivisa, 0), 2)}</td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- ============================================================ -->
        <!-- TAB 3: DISPERSIONES -->
        <!-- ============================================================ -->
        <div id="tab-dispersiones" class="tab-pane" style="display: none; overflow-x: auto;">
          <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-main);">
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">#</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Código</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Cliente</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Monto Dispersado (COP)</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Estado</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Comprobante (9:16)</th>
              </tr>
            </thead>
            <tbody>
              {PAGOS.map((p) => {
                const esCompletado = p.estado === 'COMPLETADO';
                return (
                  <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
                    <td style="padding: 14px 20px; color: var(--text-muted); font-family: ui-monospace, monospace; font-size: 13px; vertical-align: middle;">{p.numero}</td>
                    <td style="padding: 14px 20px; font-weight: 700; color: var(--brand-primary); font-family: ui-monospace, monospace; font-size: 13px; vertical-align: middle;">{p.codigo}</td>
                    <td style="padding: 14px 20px; font-weight: 600; color: var(--text-primary); font-size: 14px; vertical-align: middle;">{p.clienteNombre}</td>
                    <td style="padding: 14px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; font-size: 14px; color: {esCompletado ? 'var(--success)' : 'var(--danger)'}; vertical-align: middle;">
                      {formatCop(p.montoCop)}
                    </td>
                    <td style="padding: 14px 20px; text-align: center; vertical-align: middle;">
                      {esCompletado ? (
                        <span class="status-pill status-success">COMPLETADO</span>
                      ) : (
                        <span class="status-pill status-danger">RECHAZADO</span>
                      )}
                    </td>
                    <td style="padding: 14px 20px; text-align: center; vertical-align: middle;">
                      {p.comprobanteUrl ? (
                        <div 
                          class="btn-open-lightbox" 
                          data-url={p.comprobanteUrl} 
                          data-title={`Comprobante ${p.codigo} - ${p.clienteNombre}`}
                          title="Click para ver comprobante en la misma pestaña"
                          style="cursor: pointer; display: inline-block; transition: transform 0.15s ease;"
                        >
                          <img 
                            src={p.comprobanteUrl} 
                            alt={`Comprobante ${p.codigo}`} 
                            loading="lazy"
                            style="width: 44px; height: 78px; aspect-ratio: 9/16; object-fit: cover; border-radius: 8px; border: 1.5px solid var(--border-main); box-shadow: 0 2px 8px rgba(0,0,0,0.12); display: block;" 
                          />
                        </div>
                      ) : (
                        <div class="upload-voucher-container" style="display: inline-block;">
                          <label 
                            class="btn-upload-voucher" 
                            title="Subir comprobante (formato 9:16)" 
                            style="display: inline-flex; flex-direction: column; align-items: center; justify-content: center; width: 44px; height: 78px; aspect-ratio: 9/16; border-radius: 8px; border: 1.5px dashed var(--brand-primary); background: var(--bg-card-secondary); cursor: pointer; color: var(--brand-primary); transition: all 0.2s;"
                          >
                            <input 
                              type="file" 
                              accept="image/*,application/pdf" 
                              class="voucher-upload-input" 
                              style="display: none;" 
                              data-pago-id={p.id} 
                              data-codigo={p.codigo} 
                            />
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                              <polyline points="17 8 12 3 7 8"></polyline>
                              <line x1="12" y1="3" x2="12" y2="15"></line>
                            </svg>
                            <span style="font-size: 8px; font-weight: 800; margin-top: 4px; text-transform: uppercase;">Subir</span>
                          </label>
                        </div>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
            <tfoot>
              <tr style="background: var(--bg-card-secondary); font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary);">
                <td colspan="3" style="padding: 18px 20px; text-transform: uppercase; font-size: 12px; color: var(--text-muted);">TOTAL DISPERSADO EN CAJA:</td>
                <td style="padding: 18px 20px; text-align: right; color: var(--success); font-size: 14px;">
