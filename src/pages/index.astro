      const divisasTbody = document.getElementById('divisas-table-tbody');
      if (divisasTbody) {
        divisasTbody.innerHTML = divisas.map((div: any) => {
          const code = div.codigo || div.divisa || '';
          const meta = AIRTABLE_CURRENCIES_META[code] || ({} as any);
          const totRec = Number(div.totalRecibido ?? div.ingresoEnDivisa) || 0;
          const totComp = Number(div.totalComprado ?? div.egresoEnDivisa) || 0;
          const totPend = Number(div.totalPendiente ?? div.saldo) || 0;
          const tienePendiente = totPend > 0;
          const flagImg = div.banderaUrl || meta.banderaUrl || meta.fallbackBanderaUrl || '';
          const fallbackImg = meta.fallbackBanderaUrl || '';
          const nombreDivisa = div.nombreDivisa || meta.name || '';
          const paisDivisa = div.pais || meta.pais || '';
          return `
            <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main);">
              <td style="padding: 14px 20px;">
                <div style="display: inline-flex; align-items: center; gap: 12px;">
                  <img 
                    src="${flagImg}" 
                    alt="${code}" 
                    onerror="this.onerror=null;this.src='${fallbackImg}';"
                    style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); flex-shrink: 0;"
                  />
                  <div>
                    <div style="display: flex; align-items: center; gap: 6px;">
                      <span style="font-weight: 800; color: var(--brand-primary); font-family: ui-monospace, monospace; font-size: 14px;">${code}</span>
                      ${nombreDivisa ? `<span style="font-size: 13px; font-weight: 700; color: var(--text-primary);">${nombreDivisa}</span>` : ''}
                    </div>
                    ${paisDivisa ? `<div style="font-size: 11px; color: var(--text-muted); font-weight: 600; margin-top: 1px;">${paisDivisa}</div>` : ''}
                  </div>
                </div>
              </td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-primary);">${fmtNumClient(totRec, 2)}</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success);">${fmtNumClient(totComp, 2)}</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: ${tienePendiente ? 'var(--warning)' : 'var(--text-muted)'};">${fmtNumClient(totPend, 2)}</td>
              <td style="padding: 16px 20px; text-align: center;">
                ${tienePendiente
                  ? '<span class="status-pill status-warning">COMPRA PENDIENTE</span>'
                  : '<span class="status-pill status-success">CUBIERTA 100%</span>'}
              </td>
            </tr>
          `;
        }).join('');
      }
    }
    updateOperatorViewMetrics();
  }

  async function syncAllFromAirtable(manual = false) {
    const savedPat = localStorage.getItem(PAT_STORAGE_KEY) || '';
    if (manual) {
      setSyncIndicator('syncing', 'Sincronizando con Airtable...');
      if (btnSyncNow) {
        btnSyncNow.disabled = true;
        btnSyncNow.style.opacity = '0.6';
      }
    }

    try {
      const res = await fetch(EDGE_SYNC_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pat: savedPat || undefined, baseId: AIRTABLE_BASE_ID }),
      });

      if (res.ok) {
        const data = await res.json();
        if (data?.snapshot) {
          applyAirtableSnapshot(data.snapshot);
          const timeStr = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          setSyncIndicator('live', `En vivo con Airtable • ${timeStr}`);
          return true;
        }
      } else {
        const errData = await res.json().catch(() => ({}));
        if (errData?.needsPat && manual) {
          setSyncIndicator('cached', 'Conecta tu PAT de Airtable');
          openAirtableModal();
          return false;
        }
      }
    } catch (err) {
      console.warn('Edge sync warning:', err);
    } finally {
      if (btnSyncNow) {
        btnSyncNow.disabled = false;
        btnSyncNow.style.opacity = '1';
      }
    }

    // Si no hay PAT en el servidor pero hay un snapshot guardado en Supabase, leerlo
    try {
      const { data: row } = await supabase
        .from('airtable_sync_state')
        .select('snapshot, updated_at, airtable_pat')
        .eq('id', 'main')
        .maybeSingle();

      if (row?.snapshot && Object.keys(row.snapshot).length > 0) {
        applyAirtableSnapshot(row.snapshot);
        const t = row.updated_at ? new Date(row.updated_at).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' }) : 'ahora';
        setSyncIndicator('live', `Sincronizado • ${t}`);
        return true;
      }
    } catch (_) {}

    return false;
  }

  airtablePatForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const patVal = airtablePatInput?.value.trim() || '';
    if (!patVal) return;
    localStorage.setItem(PAT_STORAGE_KEY, patVal);
    try {
      await supabase.from('airtable_sync_state').upsert({
        id: 'main',
        airtable_pat: patVal,
        base_id: AIRTABLE_BASE_ID,
        updated_at: new Date().toISOString()
      });
    } catch (_) {}
    closeAirtableModal();
    await syncAllFromAirtable(true);
  });

  btnSyncNow?.addEventListener('click', (e) => {
    e.stopPropagation();
    syncAllFromAirtable(true);
  });

  // Suscripción a Supabase Realtime para recibir cambios de Airtable al instante en todas las pestañas abiertas
  try {
    supabase
      .channel('public:airtable-sync-state')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'airtable_sync_state' }, (payload: any) => {
        const newSnap = payload?.new?.snapshot;
        if (newSnap && Object.keys(newSnap).length > 0) {
          applyAirtableSnapshot(newSnap);
          const timeStr = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          setSyncIndicator('live', `En vivo (Realtime) • ${timeStr}`);
        }
      })
      .subscribe();
  } catch (rtSyncErr) {
    console.warn('Realtime airtable_sync_state warning:', rtSyncErr);
  }

  // Sincronización inicial y polling automático cada 15 segundos + al enfocar ventana
  syncAllFromAirtable(false);
  setInterval(() => {
    if (document.visibilityState === 'visible') {
      syncAllFromAirtable(false);
    }
  }, 15000);
  window.addEventListener('focus', () => {
    syncAllFromAirtable(false);
  });

  // ==============================================================
  // INICIALIZACIÓN CONTROLADA (TODO EL SCRIPT ESTÁ TOTALMENTE DECLARADO)
  // ==============================================================
  await initCurrentUser();
  switchTab(initialTab, false);
  await loadUsersList();
</script>
