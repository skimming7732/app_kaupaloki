  function switchTab(targetId: string, updateUrl: boolean = true) {
    if (!targetId) return;
    
    links.forEach(l => {
      if (l.getAttribute('data-target') === targetId) {
        l.classList.add('active');
      } else {
        l.classList.remove('active');
      }
    });

    panes.forEach(p => {
      (p as HTMLElement).style.display = 'none';
      p.classList.remove('active');
    });

    const targetPane = document.getElementById(targetId);
    if (targetPane) {
      targetPane.style.display = 'block';
      targetPane.classList.add('active');
    }

    // Actualizar textos en Navbar y Header
    if (titlesMap[targetId]) {
      if (breadcrumbTitle) breadcrumbTitle.textContent = titlesMap[targetId].breadcrumb;
      if (pageHeading) pageHeading.textContent = titlesMap[targetId].heading;
      if (activeTableTitle) activeTableTitle.textContent = titlesMap[targetId].table;
    }

    if (targetId === 'tab-usuarios') {
      loadUsersList();
    }

    // Reiniciar búsqueda
    if (searchInput) {
      searchInput.value = '';
      filtrarTabla('');
    }

    // Sincronizar URL limpia en el historial (ej. /clientes, /dispersiones)
    if (updateUrl && tabToPathMap[targetId]) {
      const newPath = tabToPathMap[targetId];
      if (window.location.pathname !== newPath) {
        window.history.pushState({ tab: targetId }, '', newPath);
      }
    }
  }

  links.forEach(link => {
    link.addEventListener('click', () => {
      const targetId = link.getAttribute('data-target');
      if (targetId) switchTab(targetId, true);
    });
  });

  // Escuchar popstate para navegar con botones de atras/adelante del navegador
  window.addEventListener('popstate', () => {
    const slug = window.location.pathname.replace(/^\/|\/$/g, '').toLowerCase();
    const tab = pathToTabMap[slug] || 'tab-clientes';
    switchTab(tab, false);
  });

