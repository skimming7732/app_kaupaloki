  // --- Lógica del Selector / Modal de Divisa con Foto de Bandera de Airtable ---
  let isDivisaLockedSingle = false;

  function toggleDivisaPickerDropdown(forceOpen?: boolean) {
    if (!divisaPickerDropdown || isDivisaLockedSingle) return;
    const isOpen = forceOpen !== undefined ? forceOpen : divisaPickerDropdown.style.display === 'none';
    divisaPickerDropdown.style.display = isOpen ? 'block' : 'none';
    if (divisaPickerChevron) {
      divisaPickerChevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    }
    if (isOpen) {
      toggleCalendarPopover(false);
      toggleClientPickerDropdown(false);
      if (divisaPickerSearch) {
        divisaPickerSearch.value = '';
        filterDivisaPickerList('');
        setTimeout(() => divisaPickerSearch.focus(), 40);
      }
    }
  }

  function selectDivisaInPicker(code: string) {
    const meta = AIRTABLE_CURRENCIES_META[code];
    if (modalNegocioDivisa) {
      let existingOpt = Array.from(modalNegocioDivisa.options).find(o => o.value === code);
      if (!existingOpt && code) {
        existingOpt = document.createElement('option');
        existingOpt.value = code;
        existingOpt.textContent = code;
        modalNegocioDivisa.appendChild(existingOpt);
      }
      modalNegocioDivisa.value = code;
    }

    if (code && meta) {
      if (divisaPickerSelectedFlag) {
        divisaPickerSelectedFlag.src = meta.banderaUrl || meta.fallbackBanderaUrl;
        divisaPickerSelectedFlag.onerror = () => {
          divisaPickerSelectedFlag.onerror = null;
          divisaPickerSelectedFlag.src = meta.fallbackBanderaUrl;
        };
        divisaPickerSelectedFlag.style.display = 'block';
      }
      if (divisaPickerSelectedCode) {
        divisaPickerSelectedCode.textContent = code;
        divisaPickerSelectedCode.style.display = 'inline-block';
      }
      if (divisaPickerSelectedName) {
        divisaPickerSelectedName.textContent = meta.name || code;
        divisaPickerSelectedName.style.color = 'var(--text-primary)';
      }
      if (divisaPickerSelectedPais) {
        divisaPickerSelectedPais.textContent = meta.pais || '';
        divisaPickerSelectedPais.style.display = meta.pais ? 'block' : 'none';
      }
    } else {
      if (divisaPickerSelectedFlag) divisaPickerSelectedFlag.style.display = 'none';
      if (divisaPickerSelectedCode) divisaPickerSelectedCode.style.display = 'none';
      if (divisaPickerSelectedName) {
        divisaPickerSelectedName.textContent = 'Seleccionar divisa...';
        divisaPickerSelectedName.style.color = 'var(--text-muted)';
      }
      if (divisaPickerSelectedPais) divisaPickerSelectedPais.style.display = 'none';
    }

    document.querySelectorAll('.divisa-picker-option').forEach((el: any) => {
      const isMatch = el.getAttribute('data-code') === code;
      el.classList.toggle('selected', isMatch);
      const checkEl = el.querySelector('.divisa-check-indicator') as HTMLElement | null;
      if (checkEl) checkEl.textContent = isMatch ? '✓' : '';
    });

    toggleDivisaPickerDropdown(false);
  }

  function renderDivisaPickerOptions(allowedCodes: string[]) {
    if (!divisaPickerList) return;
    const currentVal = modalNegocioDivisa?.value || '';
    divisaPickerList.innerHTML = allowedCodes.map((code) => {
      const meta = AIRTABLE_CURRENCIES_META[code] || {
        id: code,
        name: code,
        pais: '',
        flag: '🌐',
        banderaUrl: '',
        fallbackBanderaUrl: 'https://flagcdn.com/w80/un.png'
      };
      const isSelected = code === currentVal;
      const imgSrc = meta.banderaUrl || meta.fallbackBanderaUrl;
      const fallbackSrc = meta.fallbackBanderaUrl;
      return `
        <button 
          type="button"
          class="client-picker-option divisa-picker-option ${isSelected ? 'selected' : ''}"
          data-code="${code}"
          data-name="${meta.name}"
          data-pais="${meta.pais}"
          style="width: 100%; padding: 9px 12px; border-radius: 12px; border: 1px solid transparent; background: transparent; color: var(--text-primary); display: flex; align-items: center; justify-content: space-between; gap: 10px; cursor: pointer; text-align: left; transition: all 0.15s;"
        >
          <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
            <img 
              src="${imgSrc}" 
              alt="${code}" 
              onerror="this.onerror=null;this.src='${fallbackSrc}';"
              style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); flex-shrink: 0;" 
            />
            <span style="font-size: 11px; font-weight: 800; font-family: ui-monospace, monospace; padding: 3px 8px; border-radius: 7px; background: var(--bg-card-secondary); color: var(--brand-primary); border: 1px solid var(--border-main); white-space: nowrap;">
              ${code}
            </span>
            <div style="min-width: 0;">
              <div style="font-size: 13px; font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                ${meta.name}
              </div>
              ${meta.pais ? `<div style="font-size: 10px; color: var(--text-muted); font-weight: 600;">${meta.pais}</div>` : ''}
            </div>
          </div>
          <span class="divisa-check-indicator" style="font-size: 12px; font-weight: 800; color: var(--brand-primary);">
            ${isSelected ? '✓' : ''}
          </span>
        </button>
      `;
    }).join('');
  }

  function filterDivisaPickerList(query: string) {
    const q = (query || '').toLowerCase().trim();
    const options = divisaPickerList?.querySelectorAll('.divisa-picker-option');
    if (!options) return;
    options.forEach((opt: any) => {
      const code = (opt.getAttribute('data-code') || '').toLowerCase();
      const name = (opt.getAttribute('data-name') || '').toLowerCase();
      const pais = (opt.getAttribute('data-pais') || '').toLowerCase();
      const match = !q || code.includes(q) || name.includes(q) || pais.includes(q);
      opt.style.display = match ? 'flex' : 'none';
    });
  }

  divisaPickerTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleDivisaPickerDropdown();
  });

  divisaPickerSearch?.addEventListener('input', (e) => {
    filterDivisaPickerList((e.target as HTMLInputElement).value);
