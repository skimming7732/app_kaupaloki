              </label>
              <input type="hidden" id="modal-user-role" name="role" value="operador" />
              
              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;" id="role-selector-container">
                <!-- Operador -->
                <div 
                  class="role-card-btn active" 
                  data-role="operador" 
                  style="padding: 12px 10px; border-radius: 14px; border: 2px solid var(--brand-primary); background: var(--brand-primary-light); cursor: pointer; text-align: center; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; gap: 6px;"
                >
                  <div class="role-icon-box" style="width: 34px; height: 34px; border-radius: 10px; background: var(--brand-primary); color: #fff; display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                  </div>
                  <div>
                    <div style="font-size: 12px; font-weight: 800; color: var(--text-primary); line-height: 1.2;">Operador</div>
                    <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">Registra negocios</div>
                  </div>
                </div>

                <!-- Administrador -->
                <div 
                  class="role-card-btn" 
                  data-role="administrador" 
                  style="padding: 12px 10px; border-radius: 14px; border: 1.5px solid var(--border-main); background: var(--bg-card); cursor: pointer; text-align: center; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; gap: 6px;"
                >
                  <div class="role-icon-box" style="width: 34px; height: 34px; border-radius: 10px; background: var(--bg-card-secondary); color: var(--text-secondary); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                  </div>
                  <div>
                    <div style="font-size: 12px; font-weight: 800; color: var(--text-primary); line-height: 1.2;">Administrador</div>
                    <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">Control total</div>
                  </div>
                </div>

                <!-- Cliente -->
                <div 
                  class="role-card-btn" 
                  data-role="client" 
                  style="padding: 12px 10px; border-radius: 14px; border: 1.5px solid var(--border-main); background: var(--bg-card); cursor: pointer; text-align: center; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; gap: 6px;"
                >
                  <div class="role-icon-box" style="width: 34px; height: 34px; border-radius: 10px; background: var(--bg-card-secondary); color: var(--text-secondary); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  </div>
                  <div>
                    <div style="font-size: 12px; font-weight: 800; color: var(--text-primary); line-height: 1.2;">Cliente</div>
                    <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">Portal contable</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Divisas Autorizadas para Registrar -->
            <div id="container-authorized-currencies" style="background: var(--bg-card-secondary); border: 1px solid var(--border-main); border-radius: 14px; padding: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-primary);">
                  Divisas Autorizadas para Operar
                </label>
                <button type="button" id="btn-toggle-all-currencies" style="background: none; border: none; font-size: 11px; font-weight: 700; color: var(--brand-primary); cursor: pointer;">
                  Seleccionar Todas
                </button>
              </div>
              <p style="margin: 0 0 10px 0; font-size: 11px; color: var(--text-muted);">
                Marca las divisas que este operador tiene permiso para registrar en negocios:
              </p>
              
              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                {['USD', 'USDT', 'COP', 'BRL', 'PEN', 'CLP', 'ARS', 'HNL', 'VES'].map((curr) => (
                  <label style="display: flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: 8px; border: 1px solid var(--border-main); background: var(--bg-card); cursor: pointer; font-size: 12px; font-weight: 700; font-family: ui-monospace, monospace; color: var(--text-primary);">
                    <input type="checkbox" name="authorized_currency" value={curr} checked style="accent-color: var(--brand-primary);" />
                    <span>{curr}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Status message -->
            <div id="modal-create-user-status" style="font-size: 12px; font-weight: 600; min-height: 18px;"></div>

            <!-- Success Box with Link & Actions (Hidden initially) -->
            <div id="modal-invitation-success-box" style="display: none; background: rgba(5, 205, 153, 0.08); border: 1.5px solid rgba(5, 205, 153, 0.3); border-radius: 16px; padding: 16px; flex-direction: column; gap: 12px;">
              <div style="display: flex; align-items: center; gap: 8px; color: var(--success); font-size: 13px; font-weight: 800;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>¡Invitación generada exitosamente!</span>
              </div>
              <p style="margin: 0; font-size: 12px; color: var(--text-secondary); line-height: 1.4;">
                El usuario puede ingresar de inmediato con el siguiente enlace directo a la plataforma:
              </p>
              
              <div style="display: flex; gap: 8px;">
                <input 
                  type="text" 
                  id="modal-invitation-link-input" 
                  readonly 
                  style="flex: 1; padding: 10px 12px; font-size: 12px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card); color: var(--text-primary); font-family: ui-monospace, monospace; outline: none;" 
                />
                <button 
                  type="button" 
                  id="btn-copy-invitation-link"
                  style="padding: 10px 16px; border-radius: 10px; border: none; background: var(--brand-primary); color: #fff; font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap; display: flex; align-items: center; gap: 6px;"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Copiar Enlace</span>
                </button>
              </div>

              <!-- Quick Share Channels -->
              <div style="display: flex; gap: 10px; padding-top: 4px;">
                <a 
                  id="btn-share-invite-whatsapp" 
                  href="#" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  style="flex: 1; padding: 10px 14px; border-radius: 10px; background: #25D366; color: #FFFFFF; font-size: 12px; font-weight: 700; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 2px 8px rgba(37, 211, 102, 0.3);"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.476-.15-.677.15-.2.301-.776.978-.952 1.179-.175.2-.351.226-.652.075-.301-.15-1.27-.468-2.42-1.493-.894-.799-1.498-1.786-1.674-2.087-.175-.3-.019-.462.132-.612.136-.135.301-.351.451-.527.151-.175.2-.3.301-.501.1-.2.05-.376-.025-.526-.075-.15-.677-1.632-.927-2.235-.244-.588-.492-.508-.677-.517-.175-.009-.376-.009-.577-.009-.2 0-.526.075-.802.376-.276.301-1.053 1.028-1.053 2.508 0 1.48 1.078 2.909 1.228 3.109.15.2 2.122 3.24 5.141 4.544.718.31 1.279.495 1.716.634.721.229 1.377.197 1.896.119.578-.087 1.78-.727 2.03-1.43.251-.703.251-1.304.175-1.43-.075-.125-.276-.2-.577-.35zM12.04 2C6.58 2 2.14 6.44 2.14 11.9c0 1.99.59 3.84 1.61 5.39L2 22l4.85-1.71c1.5 1 3.28 1.58 5.19 1.58 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2z"></path>
                  </svg>
                  <span>Enviar por WhatsApp</span>
                </a>

                <a 
                  id="btn-share-invite-mail" 
                  href="#" 
                  style="flex: 1; padding: 10px 14px; border-radius: 10px; background: var(--bg-card-secondary); color: var(--text-primary); border: 1px solid var(--border-main); font-size: 12px; font-weight: 700; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px;"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                  <span>Enviar por Correo</span>
                </a>
              </div>
            </div>

            <!-- Form Actions -->
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 6px;">
              <button 
                type="button" 
                id="btn-cancel-create-user" 
                style="padding: 10px 18px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); font-size: 13px; font-weight: 600; cursor: pointer;"
              >
                Cerrar
              </button>
              <button 
                type="submit" 
                id="btn-submit-create-user" 
                style="display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; border-radius: 10px; border: none; background: var(--brand-primary); color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 14px rgba(67, 24, 255, 0.35);"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                <span>Enviar Invitación</span>
              </button>
            </div>
          </form>

        </div>
      </div>

      <!-- ============================================================== -->
      <!-- MODAL: AGREGAR NEGOCIO -->
      <!-- ============================================================== -->
      <div id="modal-create-negocio-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(11, 20, 55, 0.75); backdrop-filter: blur(8px); z-index: 135; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 28px 30px; width: 100%; max-width: 500px; box-shadow: var(--shadow-card); position: relative;">
          
          <button id="btn-close-create-negocio-modal" type="button" style="position: absolute; top: 20px; right: 20px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 22px;">
            <div style="width: 46px; height: 46px; border-radius: 14px; background: rgba(67, 24, 255, 0.1); color: var(--brand-primary); display: flex; align-items: center; justify-content: center;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <div>
              <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">
                Agregar Negocio
              </h3>
              <p style="margin: 2px 0 0 0; font-size: 12px; color: var(--text-secondary);">
                Registra una nueva operación de divisa
              </p>
            </div>
          </div>

          <form id="form-modal-create-negocio" style="display: flex; flex-direction: column; gap: 16px;">
            <!-- Campo 1: Fecha -->
            <div>
              <label for="modal-negocio-fecha" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px; letter-spacing: 0.05em;">
                Fecha de Operación *
              </label>
              <input 
                type="date" 
                id="modal-negocio-fecha" 
                required 
                style="width: 100%; box-sizing: border-box; padding: 11px 14px; font-size: 13px; border-radius: 12px; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-family: inherit; outline: none; transition: all 0.2s;"
              />
            </div>

            <!-- Campo 2: Modal Cliente -->
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <label for="modal-negocio-cliente" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); letter-spacing: 0.05em;">
                  Cliente *
                </label>
                <button 
                  type="button" 
                  id="btn-negocio-open-add-client"
                  style="display: inline-flex; align-items: center; gap: 4px; border: none; background: transparent; color: var(--brand-primary); font-size: 11px; font-weight: 700; cursor: pointer; padding: 0;"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  <span>+ Agregar Cliente</span>
                </button>
              </div>
              <select 
                id="modal-negocio-cliente" 
                required 
                style="width: 100%; box-sizing: border-box; padding: 11px 14px; font-size: 13px; border-radius: 12px; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-family: inherit; outline: none; cursor: pointer; transition: all 0.2s;"
              >
                <option value="">-- Seleccionar Cliente --</option>
                {CLIENTES.map(c => (
                  <option value={c.id}>{c.nombre} ({c.codigo})</option>
                ))}
              </select>
            </div>

            <!-- Campo 3: Divisa (Solo las autorizadas, si es 1 bloqueado) -->
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <label for="modal-negocio-divisa" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); letter-spacing: 0.05em;">
                  Divisa Autorizada *
                </label>
                <span id="modal-negocio-divisa-hint" style="display: none; font-size: 10px; font-weight: 700; color: var(--brand-primary); background: var(--brand-primary-light); padding: 2px 6px; border-radius: 4px;">
                  🔒 Divisa única autorizada
                </span>
              </div>
              <select 
                id="modal-negocio-divisa" 
                required 
                style="width: 100%; box-sizing: border-box; padding: 11px 14px; font-size: 13px; border-radius: 12px; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-family: inherit; outline: none; cursor: pointer; transition: all 0.2s;"
              >
                <option value="">-- Seleccionar Divisa --</option>
              </select>
            </div>

            <!-- Campo 4: Monto -->
            <div>
              <label for="modal-negocio-monto" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px; letter-spacing: 0.05em;">
                Monto *
              </label>
              <input 
                type="number" 
                step="any" 
                min="0.01" 
                id="modal-negocio-monto" 
                placeholder="0.00" 
                required 
                style="width: 100%; box-sizing: border-box; padding: 11px 14px; font-size: 14px; font-weight: 700; border-radius: 12px; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-family: ui-monospace, monospace; outline: none; transition: all 0.2s;"
              />
            </div>

            <!-- Mensaje de estado -->
            <div id="modal-negocio-status" style="font-size: 12px; min-height: 18px; text-align: center; font-weight: 600;"></div>

            <!-- Botones de acción -->
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 8px;">
              <button 
                type="button" 
                id="btn-cancel-create-negocio" 
                style="padding: 10px 18px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); font-size: 13px; font-weight: 600; cursor: pointer;"
              >
                Cancelar
              </button>
              <button 
                type="submit" 
                id="btn-submit-create-negocio" 
                style="display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; border-radius: 10px; border: none; background: var(--brand-primary); color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 14px rgba(67, 24, 255, 0.35);"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Guardar Negocio</span>
              </button>
            </div>
          </form>

        </div>
      </div>

      <!-- ============================================================== -->
      <!-- MODAL: AGREGAR CLIENTE -->
      <!-- ============================================================== -->
      <div id="modal-create-client-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(11, 20, 55, 0.8); backdrop-filter: blur(10px); z-index: 150; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 28px 30px; width: 100%; max-width: 460px; box-shadow: var(--shadow-card); position: relative;">
          
          <button id="btn-close-create-client-modal" type="button" style="position: absolute; top: 20px; right: 20px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 22px;">
            <div style="width: 46px; height: 46px; border-radius: 14px; background: rgba(5, 205, 153, 0.12); color: var(--success); display: flex; align-items: center; justify-content: center;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
              </svg>
            </div>
            <div>
              <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">
                Agregar Cliente
              </h3>
              <p style="margin: 2px 0 0 0; font-size: 12px; color: var(--text-secondary);">
                Crea el perfil contable del cliente
              </p>
            </div>
          </div>

          <form id="form-modal-create-client" style="display: flex; flex-direction: column; gap: 16px;">
            <div>
              <label for="modal-client-name" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px; letter-spacing: 0.05em;">
                Nombre Completo o Razón Social *
              </label>
              <input 
                type="text" 
                id="modal-client-name" 
                required 
                placeholder="Ej: JUAN PEREZ o COMERCIALIZADORA SAS" 
                style="width: 100%; box-sizing: border-box; padding: 11px 14px; font-size: 13px; border-radius: 12px; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-family: inherit; outline: none; transition: all 0.2s;"
              />
            </div>

            <div>
              <label for="modal-client-country" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px; letter-spacing: 0.05em;">
                País de Residencia / Operación *
              </label>
              <select 
