  const btnSyncNow = document.getElementById('btn-sync-now') as HTMLButtonElement | null;
  const airtablePatForm = document.getElementById('airtable-pat-form') as HTMLFormElement | null;
  const airtablePatInput = (document.getElementById('input-airtable-pat') || document.getElementById('airtable-pat-input')) as HTMLInputElement | null;
  const btnClearPat = document.getElementById('btn-clear-pat');

  // Regla global de formato numérico: miles con coma (,) y decimales con punto (.)
  function fmtCopClient(val: number, decimals = 2): string {
    return '$' + new Intl.NumberFormat('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    }).format(Number(val) || 0);
  }

  function fmtNumClient(val: number, decimals = 2): string {
    return new Intl.NumberFormat('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    }).format(Number(val) || 0);
  }

  function setSyncIndicator(state: 'live' | 'syncing' | 'cached' | 'error', label: string) {
    if (syncDot) {
      if (state === 'live') {
        syncDot.style.background = 'var(--success)';
        syncDot.style.boxShadow = '0 0 8px var(--success)';
      } else if (state === 'syncing') {
        syncDot.style.background = '#3965FF';
        syncDot.style.boxShadow = '0 0 8px #3965FF';
      } else if (state === 'error') {
        syncDot.style.background = 'var(--danger)';
        syncDot.style.boxShadow = '0 0 8px var(--danger)';
      } else {
        syncDot.style.background = 'var(--warning)';
        syncDot.style.boxShadow = '0 0 8px var(--warning)';
      }
    }
    if (syncText) {
      syncText.textContent = label;
    }
  }

  function openAirtableModal() {
    if (airtablePatInput) {
      airtablePatInput.value = localStorage.getItem(PAT_STORAGE_KEY) || '';
    }
    if (modalAirtableBackdrop) {
      modalAirtableBackdrop.style.display = 'flex';
