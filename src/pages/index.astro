              </tr>
            </thead>
            <tbody>
              {ADMINS.map((a) => (
                <tr class="table-row" style="border-bottom: 1px solid #172033; transition: background 0.1s ease;">
                  <td style="padding: 12px 16px; color: #64748b; font-family: ui-monospace, monospace;">{a.numero}</td>
                  <td style="padding: 12px 16px; font-weight: 600; color: #38bdf8; font-family: ui-monospace, monospace;">{a.codigo}</td>
                  <td style="padding: 12px 16px; font-weight: 500; color: #f1f5f9;">{a.nombre}</td>
                  <td style="padding: 12px 16px; text-align: center;">
                    <span style="font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 4px; background: #0284c7; color: #f0f9ff;">
                      {a.pais}
