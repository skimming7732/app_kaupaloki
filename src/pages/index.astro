  // Guardar cambios en el perfil
  formEditProfile?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!editProfileName) return;

    const newName = editProfileName.value.trim();
    const newPwd = editProfilePassword?.value || '';
    const newPwdConf = editProfilePasswordConfirm?.value || '';

    if (!newName) {
      if (editProfileStatus) {
        editProfileStatus.style.color = 'var(--danger)';
        editProfileStatus.textContent = 'El nombre no puede estar vacío';
      }
      return;
    }

    if (newPwd) {
      if (newPwd.length < 6) {
        if (editProfileStatus) {
          editProfileStatus.style.color = 'var(--danger)';
          editProfileStatus.textContent = 'La contraseña debe tener al menos 6 caracteres';
        }
        return;
      }
      if (newPwd !== newPwdConf) {
        if (editProfileStatus) {
          editProfileStatus.style.color = 'var(--danger)';
          editProfileStatus.textContent = 'Las contraseñas no coinciden';
        }
        return;
      }
    }

    if (editProfileStatus) {
      editProfileStatus.style.color = 'var(--text-muted)';
      editProfileStatus.textContent = 'Guardando cambios...';
    }

    try {
      if (newPwd) {
        const { error: pwdErr } = await supabase.auth.updateUser({
          password: newPwd,
          data: { full_name: newName }
        });
        if (pwdErr) throw pwdErr;
      }

      // Actualizar en tabla profiles con código recalcula
      const newCode = computeUserAirtableCode(newName, currentUserProfile.role, currentUserProfile.pais || 'COL', 1);
      await supabase.from('profiles').update({
        full_name: newName,
        operator_code: newCode,
        updated_at: new Date().toISOString()
      }).eq('email', currentUserProfile.email);

      // Actualizar en Airtable si hay PAT
      const pat = getAirtableToken();
      if (pat) {
        try {
          let recId = currentUserProfile.airtableRecordId;
          if (!recId) {
            const sRes = await fetch(`https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb?filterByFormula=LOWER({EMAIL})='${encodeURIComponent(currentUserProfile.email)}'`, {
              headers: { 'Authorization': `Bearer ${pat}` }
            });
            if (sRes.ok) {
              const sJson = await sRes.json();
              if (sJson.records?.[0]) recId = sJson.records[0].id;
            }
          }
          if (recId) {
            await fetch(`https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb/${recId}`, {
              method: 'PATCH',
              headers: {
                'Authorization': `Bearer ${pat}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                fields: {
                  "NOMBRE": newName.toUpperCase()
                }
              })
            });
          }
        } catch (airtableErr) {
          console.warn('Error sincronizando nombre en Airtable:', airtableErr);
        }
      }

      currentUserProfile.full_name = newName;
      currentUserProfile.operator_code = newCode;
      updateHeaderProfileUI();

      if (editProfileStatus) {
        editProfileStatus.style.color = 'var(--success)';
        editProfileStatus.textContent = '¡Perfil actualizado con éxito!';
      }

      setTimeout(() => {
        closeEditProfileModal();
        loadUsersList();
      }, 1000);
    } catch (err: any) {
      if (editProfileStatus) {
        editProfileStatus.style.color = 'var(--danger)';
        editProfileStatus.textContent = err.message || 'Error al actualizar perfil';
      }
    }
