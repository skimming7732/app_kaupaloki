  async function syncAirtableUsers() {
    const pat = getAirtableToken();
    const deletedLocal = new Set(getDeletedUsers());
    if (!pat) {
      // Sin PAT: No bloquear con modal a otros administradores.
      // Sincronizar directamente con Supabase (fuente canónica en tiempo real).
      await loadUsersList();
      return;
    }

    let airtableRecords: any[] = [];
    try {
      const resp = await fetch('https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb', {
        headers: { 'Authorization': `Bearer ${pat}` }
      });
      if (resp.ok) {
        const json = await resp.json();
        airtableRecords = json.records || [];
      }
    } catch (err) {
      console.warn('Airtable API fetch error:', err);
    }

    // Obtener usuarios de Supabase
    const { data: supabaseProfiles } = await supabase.from('profiles').select('*');

    // 1. De Airtable a Supabase: Si hay registros en Airtable sin perfil en Supabase, crearlos
    if (airtableRecords.length > 0) {
      for (const rec of airtableRecords) {
        if ((rec.fields['ESTADO'] || '').toUpperCase() === 'INACTIVO') continue;
        const email = (rec.fields['EMAIL'] || '').toLowerCase().trim();
        if (email && !deletedLocal.has(email)) {
          const exists = supabaseProfiles?.some(p => p.email?.toLowerCase() === email);
          const airtableCurrCodes = mapAirtableDivisaIdsToCodesClient(
            rec.fields['DIVISAS RELACIONADAS'] || rec.fields['DIVISAS AUTORIZADAS'] || []
          );
          if (!exists) {
            await supabase.from('profiles').upsert({
              id: crypto.randomUUID(),
              email: email,
              full_name: rec.fields['NOMBRE'] || email.split('@')[0],
              role: (rec.fields['ROL'] || 'operador').toLowerCase().includes('admin') ? 'administrador' : ((rec.fields['ROL'] || '').toLowerCase().includes('client') ? 'client' : 'operador'),
              pais: rec.fields['PAIS'] || 'COL',
              authorized_currencies: airtableCurrCodes.length > 0 ? airtableCurrCodes : ['COP'],
              status: (rec.fields['ESTADO'] || 'ACTIVO').toLowerCase(),
              onboarding_completed: (rec.fields['ESTADO'] || '').toUpperCase() === 'ACTIVO',
              is_super_admin: isSuperAdminUser(email)
            }, { onConflict: 'email' });
          } else if (airtableCurrCodes.length > 0) {
            const matchProf = supabaseProfiles?.find(p => p.email?.toLowerCase() === email);
            if (matchProf && (!Array.isArray(matchProf.authorized_currencies) || matchProf.authorized_currencies.length === 0)) {
              await supabase.from('profiles').update({
                authorized_currencies: airtableCurrCodes
              }).ilike('email', email);
            }
          }
        }
      }
    }

    // 2. De Supabase a Airtable: Si hay perfiles en Supabase que no están en Airtable, crearlos en Airtable
    if (supabaseProfiles && supabaseProfiles.length > 0) {
      for (const prof of supabaseProfiles) {
        const pEmail = (prof.email || '').toLowerCase().trim();
        if (!pEmail || deletedLocal.has(pEmail) || (prof.status || '').toLowerCase() === 'inactivo') continue;
        const existsInAirtable = airtableRecords.some(r => (r.fields['EMAIL'] || '').toLowerCase() === pEmail);
        if (!existsInAirtable) {
          try {
            const profCurrencies: string[] = Array.isArray(prof.authorized_currencies) && prof.authorized_currencies.length > 0
              ? prof.authorized_currencies
              : getAllSystemCurrencies();
            const divisaRelIds = profCurrencies.map(c => AIRTABLE_CURRENCIES_META[c]?.id).filter(Boolean);
            const createResp = await fetch('https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb', {
              method: 'POST',
              headers: {
                'Authorization': `Bearer ${pat}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                fields: {
                  "NOMBRE": (prof.full_name || prof.email.split('@')[0]).toUpperCase(),
                  "EMAIL": prof.email,
                  "PAIS": prof.pais || "COL",
                  "ESTADO": (prof.status || 'ACTIVO').toUpperCase() === 'INVITADO' ? 'ACTIVO' : (prof.status || 'ACTIVO').toUpperCase(),
                  "ROL": isSuperAdminUser(pEmail) ? "SUPER ADMIN" : (prof.role === 'administrador' ? 'ADMINISTRADOR' : (prof.role === 'client' ? 'CLIENTE' : 'OPERADOR')),
                  "DIVISAS RELACIONADAS": divisaRelIds
                },
                typecast: true
              })
            });
            if (createResp.ok) {
              const newRec = await createResp.json();
              airtableRecords.push(newRec);
            }
          } catch (createErr) {
            console.warn('Error syncing profile to Airtable:', prof.email, createErr);
          }
        }
      }
    }

    await loadUsersList(airtableRecords);
  }

  async function loadUsersList(airtableRecordsOverride?: any[]) {
    const { data: users, error } = await supabase.from('profiles').select('*').order('created_at', { ascending: false });
    const deletedLocal = new Set(getDeletedUsers());
    
    // Obtener registros de Airtable (con token o fallback a Edge Function en vivo)
    let airtableRecords = airtableRecordsOverride;
    if (!airtableRecords) {
      const pat = getAirtableToken();
      if (pat) {
        try {
          const resp = await fetch('https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb', {
            headers: { 'Authorization': `Bearer ${pat}` }
          });
          if (resp.ok) {
            const json = await resp.json();
            airtableRecords = json.records || [];
          }
        } catch (e) {}
      }
      
      // Fallback a snapshot de Edge Function si no hay PAT o falló la conexión directa
      if (!airtableRecords || airtableRecords.length === 0) {
        try {
          const edgeResp = await fetch('https://tjuqludeduydarwzhbor.supabase.co/functions/v1/airtable-sync');
          if (edgeResp.ok) {
            const edgeData = await edgeResp.json();
            if (edgeData?.snapshot?.usuarios && Array.isArray(edgeData.snapshot.usuarios)) {
              airtableRecords = edgeData.snapshot.usuarios.map((u: any) => ({
                id: u.id,
                fields: {
                  'ADMINISTRADOR': u.codigo,
                  'NOMBRE': u.nombre,
                  'EMAIL': u.email,
                  'PAIS': u.pais,
                  'ESTADO': u.estado,
                  'ROL': u.rol,
                  'DIVISAS RELACIONADAS': u.divisasAutorizadas || []
                }
              }));
            }
          }
        } catch (edgeErr) {
          console.warn('Edge sync snapshot fallback warning:', edgeErr);
        }
      }
    }

    // Lista unificada (omitiendo eliminados o inactivos)
    const allUsers: any[] = [];

    // Priorizar perfiles de Supabase y vincular su registro de Airtable
    if (users && users.length > 0) {
      users.forEach((u: any, idx: number) => {
        const uEmail = (u.email || '').toLowerCase().trim();
        if (!uEmail || deletedLocal.has(uEmail)) return;
        if ((u.status || '').toLowerCase() === 'inactivo') return;

        const matchingAirtable = airtableRecords?.find((r: any) => 
          (r.fields['EMAIL'] || '').toLowerCase().trim() === uEmail
        );
        if (matchingAirtable && (matchingAirtable.fields['ESTADO'] || '').toUpperCase() === 'INACTIVO') return;

        const userNum = idx + 1;
        const resolvedPais = (u.pais || matchingAirtable?.fields['PAIS'] || 'COL').toUpperCase();
        const fallbackCode = u.operator_code || computeUserAirtableCode(u.full_name, u.role, resolvedPais, userNum);
        const resolvedCode = matchingAirtable?.fields['ADMINISTRADOR'] || fallbackCode;

        const supaCurrs = mapAirtableDivisaIdsToCodesClient(Array.isArray(u.authorized_currencies) ? u.authorized_currencies : []);
        const airtableCurrs = mapAirtableDivisaIdsToCodesClient(
          matchingAirtable?.fields['DIVISAS RELACIONADAS'] || matchingAirtable?.fields['DIVISAS AUTORIZADAS'] || []
        );
        const finalCurrencies = supaCurrs.length > 0 ? supaCurrs : airtableCurrs;

        allUsers.push({
          operatorCode: resolvedCode,
          airtableRecordId: matchingAirtable?.id || u.airtable_id || '',
          nombre: u.full_name || matchingAirtable?.fields['NOMBRE'] || 'Sin Nombre',
          email: u.email,
          role: u.role || 'operador',
          is_super_admin: isSuperAdminUser(u.email),
          pais: resolvedPais,
          authorized_currencies: finalCurrencies,
          status: u.onboarding_completed || u.status === 'activo' || matchingAirtable?.fields['ESTADO'] === 'ACTIVO' ? 'activo' : 'invitado',
          source: matchingAirtable ? 'Sincronizado (Supabase + Airtable)' : 'Supabase'
        });
      });
    }

    // Agregar registros de Airtable que no estén en Supabase
    if (airtableRecords && airtableRecords.length > 0) {
      airtableRecords.forEach((r: any, idx: number) => {
        if ((r.fields['ESTADO'] || '').toUpperCase() === 'INACTIVO') return;
        const rEmail = (r.fields['EMAIL'] || '').toLowerCase().trim();
        if (!rEmail || deletedLocal.has(rEmail)) return;
        if (!allUsers.some(u => (u.email || '').toLowerCase().trim() === rEmail)) {
          const airtableCurrs = mapAirtableDivisaIdsToCodesClient(
            r.fields['DIVISAS RELACIONADAS'] || r.fields['DIVISAS AUTORIZADAS'] || []
          );
          const rawRol = (r.fields['ROL'] || 'operador').toLowerCase();
          const normRole = rawRol.includes('admin') ? 'administrador' : (rawRol.includes('client') ? 'client' : 'operador');
          allUsers.push({
            operatorCode: r.fields['ADMINISTRADOR'] || computeUserAirtableCode(r.fields['NOMBRE'], r.fields['ROL'], r.fields['PAIS'], idx + 1),
            airtableRecordId: r.id,
            nombre: r.fields['NOMBRE'] || 'Sin Nombre',
            email: r.fields['EMAIL'] || 'sin-correo@kaupaloki.co',
            role: normRole,
            is_super_admin: isSuperAdminUser(rEmail),
            pais: (r.fields['PAIS'] || 'COL').toUpperCase(),
            authorized_currencies: airtableCurrs,
            status: (r.fields['ESTADO'] || 'ACTIVO').toLowerCase(),
            source: 'Airtable'
          });
        }
      });
    }

    if (badgeCountUsuarios) {
      badgeCountUsuarios.textContent = allUsers.length.toString();
    }

    // Actualizar contadores dinámicos del KPI de Usuarios
    const totalUsersCount = allUsers.length;
    const totalAdminsCount = allUsers.filter(u => u.role === 'administrador').length;
    const totalOperatorsCount = allUsers.filter(u => u.role === 'operador').length;

    document.querySelectorAll('.kpi-count-users-total').forEach(el => el.textContent = totalUsersCount.toString());
    document.querySelectorAll('.kpi-count-users-admins').forEach(el => el.textContent = totalAdminsCount.toString());
    document.querySelectorAll('.kpi-count-users-operators').forEach(el => el.textContent = totalOperatorsCount.toString());

    if (allUsers.length === 0) {
      const emptyHtml = error 
        ? `<tr><td colspan="8" style="padding: 24px; text-align: center; color: var(--danger);">Error al cargar usuarios: ${error?.message}</td></tr>`
        : `<tr>
            <td colspan="8" style="padding: 36px 20px; text-align: center; color: var(--text-muted);">
              <div style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--text-muted); opacity: 0.6;">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <line x1="19" y1="8" x2="19" y2="14"></line>
                  <line x1="22" y1="11" x2="16" y2="11"></line>
                </svg>
                <div style="font-size: 14px; font-weight: 700; color: var(--text-primary);">No hay usuarios registrados</div>
                <div style="font-size: 12px; color: var(--text-muted); max-width: 340px;">Crea o invita operadores para asignarles divisas autorizadas y permisos de acceso.</div>
                <button type="button" class="btn-open-add-user" style="margin-top: 6px; padding: 8px 16px; border-radius: 10px; background: var(--brand-primary); color: #fff; font-size: 12px; font-weight: 700; border: none; cursor: pointer;">
                  + Agregar Primer Usuario
                </button>
              </div>
            </td>
          </tr>`;
      if (usuariosViewTableBody) usuariosViewTableBody.innerHTML = emptyHtml;
      return;
    }

    // Permisos del usuario actual que está viendo la tabla (por defecto Super Admin mientras hidrata sesión)
    const isSuperAdmin = !currentUserProfile || isSuperAdminUser(currentUserProfile?.email) || Boolean(currentUserProfile?.is_super_admin);
    const isAdmin = isSuperAdmin || currentUserProfile?.role === 'administrador';

    if (usuariosViewTableBody) {
      usuariosViewTableBody.innerHTML = allUsers.map((u: any, idx: number) => {
        const isAdm = u.role === 'administrador';
        const isClient = u.role === 'client' || u.role === 'cliente';
        const isOp = u.role === 'operador';
        const isTargetSuperAdmin = isSuperAdminUser(u.email);
        const currentEmail = (currentUserProfile?.email || SUPER_ADMIN_EMAIL).toLowerCase().trim();
        const isSelf = Boolean(u.email && u.email.toLowerCase().trim() === currentEmail);

        // LÓGICA DE PERMISOS PARA ELIMINAR:
        // 1. Nadie puede eliminar al Super Admin (desarrollor@jeroallsolutions.com) ni a su propia cuenta
        // 2. Solo el Super Admin puede eliminar otros administradores
        // 3. Los administradores normales pueden eliminar operadores y clientes, pero NO a administradores
        let canDelete = false;
        let deleteTooltip = '';

        if (isSelf) {
          canDelete = false;
          deleteTooltip = 'No puedes eliminar tu propia cuenta';
        } else if (isTargetSuperAdmin) {
          canDelete = false;
          deleteTooltip = 'El Super Admin (desarrollor@jeroallsolutions.com) está protegido contra eliminación';
        } else if (isAdm) {
          if (isSuperAdmin) {
            canDelete = true;
            deleteTooltip = 'Eliminar administrador (permitido por Super Admin)';
          } else {
            canDelete = false;
            deleteTooltip = 'Solo el Super Admin (desarrollor@jeroallsolutions.com) puede eliminar otros administradores';
          }
        } else {
          // Es operador o cliente
          if (isAdmin) {
            canDelete = true;
            deleteTooltip = `Eliminar ${isClient ? 'cliente' : 'operador'}`;
          } else {
            canDelete = false;
            deleteTooltip = 'Se requieren permisos de administrador';
          }
        }

        // LÓGICA DE PERMISOS PARA EDITAR:
        // Super Admin puede editar a todos (excepto degradarse a sí mismo de Super Admin).
        // Admin normal puede editar operadores y clientes, y su propio perfil.
        const canEditPermissions = !isTargetSuperAdmin && (isSuperAdmin || (isAdmin && (!isAdm || isSelf)));

        const roleBg = isTargetSuperAdmin 
          ? 'linear-gradient(135deg, #FFB547 0%, #FF8500 100%)' 
          : (isAdm ? 'var(--brand-primary-light)' : (isClient ? 'rgba(67, 24, 255, 0.08)' : 'rgba(5, 205, 153, 0.12)'));
        const roleColor = isTargetSuperAdmin ? '#FFFFFF' : (isAdm ? 'var(--brand-primary)' : (isClient ? 'var(--brand-primary)' : 'var(--success)'));
        const currencies: string[] = Array.isArray(u.authorized_currencies) ? u.authorized_currencies : [];
        const isCompleted = u.status === 'activo';
        const inviteLink = `https://app.kaupaloki.co/onboarding?email=${encodeURIComponent(u.email)}`;

        // País siempre SIN emoji (solo código ISO limpio)
        const countryKey = String(u.pais || 'COL').replace(/[^a-zA-Z]/g, '').toUpperCase() || 'COL';
        const countryBadge = countryKey;
        const encodedCurrencies = encodeURIComponent(JSON.stringify(currencies));

        return `
          <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
            <td style="padding: 14px 18px; color: var(--text-muted); font-family: ui-monospace, monospace; font-size: 12px; vertical-align: middle;">
              ${idx + 1}
            </td>
            <td style="padding: 14px 18px; vertical-align: middle;">
              <span style="font-size: 11px; font-weight: 800; font-family: ui-monospace, monospace; padding: 4px 8px; border-radius: 6px; background: rgba(67, 24, 255, 0.12); color: var(--brand-primary); border: 1px solid rgba(67, 24, 255, 0.2);">
                ${u.operatorCode}
              </span>
            </td>
            <td style="padding: 14px 18px; vertical-align: middle;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 34px; height: 34px; border-radius: 50%; background: ${isTargetSuperAdmin ? 'linear-gradient(135deg, #FFB547 0%, #FF8500 100%)' : (isAdm ? 'linear-gradient(135deg, #868CFF 0%, #4318FF 100%)' : 'var(--bg-card-secondary)')}; color: ${(isTargetSuperAdmin || isAdm) ? '#fff' : 'var(--brand-primary)'}; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; flex-shrink: 0; box-shadow: ${(isTargetSuperAdmin || isAdm) ? '0 2px 8px rgba(67, 24, 255, 0.25)' : 'none'};">
                  ${(u.nombre || u.email || 'U').charAt(0).toUpperCase()}
                </div>
                <div>
                  <div style="font-weight: 700; color: var(--text-primary); font-size: 13px; display: flex; align-items: center; gap: 6px;">
                    <span>${u.nombre}</span>
                    ${isSelf ? '<span style="font-size: 9px; padding: 1px 6px; border-radius: 4px; background: var(--brand-primary-light); color: var(--brand-primary); font-weight: 800;">TÚ</span>' : ''}
                  </div>
                  <div style="font-size: 11px; color: var(--text-muted); font-family: ui-monospace, monospace;">${u.email}</div>
                </div>
              </div>
            </td>
            <td style="padding: 14px 18px; text-align: center; vertical-align: middle;">
              <span style="font-size: 10px; font-weight: 800; padding: 4px 10px; border-radius: 6px; background: ${roleBg}; color: ${roleColor}; text-transform: uppercase; letter-spacing: 0.03em;">
                ${isTargetSuperAdmin ? '⭐ Super Admin' : (isClient ? 'Cliente' : u.role)}
              </span>
            </td>
            <td style="padding: 14px 18px; text-align: center; vertical-align: middle;">
              <span style="font-size: 11px; font-weight: 800; font-family: ui-monospace, monospace; padding: 4px 9px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--text-primary); border: 1px solid var(--border-main); white-space: nowrap;">
                ${countryBadge}
              </span>
            </td>
            <td style="padding: 14px 18px; vertical-align: middle; position: relative; overflow: visible;">
              ${(isAdm || isTargetSuperAdmin) ? `
                <span style="font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 12px; background: var(--bg-card-secondary); color: var(--text-secondary); border: 1px solid var(--border-main); display: inline-flex; align-items: center; gap: 4px;">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Todas (Admin)
                </span>
              ` : (isClient ? `
                <span style="font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 12px; background: rgba(67, 24, 255, 0.08); color: var(--brand-primary); border: 1px solid rgba(67, 24, 255, 0.2); display: inline-flex; align-items: center; gap: 4px;">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Todas (Cliente)
                </span>
              ` : `
                <div style="position: relative; display: inline-block;">
                  <button 
                    type="button" 
                    class="btn-toggle-operator-currencies" 
                    data-popover-id="operator-curr-popover-${idx}"
                    title="Click para ver las divisas autorizadas"
                    style="cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 14px; border: 1.5px solid rgba(67, 24, 255, 0.25); background: var(--brand-primary-light); color: var(--brand-primary); font-size: 11px; font-weight: 700; transition: all 0.2s;"
                  >
                    <span>${currencies.length} ${currencies.length === 1 ? 'Divisa' : 'Divisas'}</span>
                    <svg class="chevron-currencies-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s ease;">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>

                  <div 
                    id="operator-curr-popover-${idx}" 
                    class="operator-currencies-popover" 
                    style="display: none; position: absolute; z-index: 60; top: calc(100% + 6px); left: 0; min-width: 210px; max-width: 260px; background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 14px; padding: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.18);"
                  >
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">
                      <span>Divisas Habilitadas</span>
                      <span style="background: var(--brand-primary-light); color: var(--brand-primary); padding: 1px 6px; border-radius: 4px; font-size: 9px; font-weight: 800;">${currencies.length}</span>
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: ${canEditPermissions ? '10px' : '0'};">
                      ${currencies.length > 0 ? currencies.map(c => `
                        <span style="font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--text-primary); border: 1px solid var(--border-main); font-family: ui-monospace, monospace; display: inline-flex; align-items: center; gap: 4px;">
                          <span style="width: 5px; height: 5px; border-radius: 50%; background: var(--brand-primary);"></span>
                          ${c}
                        </span>
                      `).join('') : '<span style="font-size: 11px; color: var(--text-muted);">Ninguna divisa asignada</span>'}
                    </div>
                    ${canEditPermissions ? `
                      <button
                        type="button"
                        class="btn-edit-user-permissions"
                        data-email="${u.email}"
                        data-nombre="${u.nombre}"
                        data-role="${u.role}"
                        data-pais="${countryKey}"
                        data-airtable-id="${u.airtableRecordId || ''}"
                        data-currencies="${encodedCurrencies}"
                        style="width: 100%; padding: 6px 10px; border-radius: 8px; border: 1px solid rgba(67, 24, 255, 0.25); background: var(--brand-primary-light); color: var(--brand-primary); font-size: 11px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 5px;"
                      >
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 20h9"></path>
                          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                        <span>Editar divisas / permisos</span>
                      </button>
                    ` : ''}
                  </div>
                </div>
              `)}
            </td>
            <td style="padding: 14px 18px; text-align: center; vertical-align: middle;">
              <span style="display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: ${isCompleted ? 'var(--success)' : 'var(--warning)'};">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span>
                ${isCompleted ? 'Activo' : 'Invitado'}
              </span>
            </td>
            <td style="padding: 14px 18px; text-align: center; vertical-align: middle;">
              <div style="display: inline-flex; align-items: center; gap: 6px;">
                <button 
                  class="btn-copy-user-invite" 
                  data-link="${inviteLink}" 
                  title="Copiar link de invitación"
                  style="padding: 6px 10px; border-radius: 8px; border: 1px solid var(--border-main); background: var(--bg-card); color: var(--text-primary); font-size: 11px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s;"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Link</span>
                </button>

                ${canEditPermissions ? `
                  <button 
                    type="button"
                    class="btn-edit-user-permissions" 
                    data-email="${u.email}" 
                    data-nombre="${u.nombre}" 
                    data-role="${u.role}"
                    data-pais="${countryKey}"
                    data-airtable-id="${u.airtableRecordId || ''}"
                    data-currencies="${encodedCurrencies}"
                    title="Editar permisos, rol, país y divisas autorizadas"
                    style="padding: 6px 10px; border-radius: 8px; border: 1px solid rgba(67, 24, 255, 0.28); background: var(--brand-primary-light); color: var(--brand-primary); font-size: 11px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s;"
                  >
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                    <span>Editar</span>
                  </button>
                ` : ''}

                ${canDelete ? `
                  <button 
                    class="btn-delete-user" 
                    data-email="${u.email}" 
                    data-nombre="${u.nombre}" 
                    data-role="${u.role}"
                    data-airtable-id="${u.airtableRecordId || ''}"
                    title="${deleteTooltip}"
                    style="padding: 6px 10px; border-radius: 8px; border: 1px solid rgba(238, 93, 80, 0.3); background: var(--danger-light); color: var(--danger); font-size: 11px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s;"
                  >
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    <span>Eliminar</span>
                  </button>
                ` : `
                  <span 
                    title="${deleteTooltip}" 
                    style="padding: 5px 8px; border-radius: 8px; background: var(--bg-card-secondary); color: var(--text-muted); font-size: 10px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; border: 1px solid var(--border-main); cursor: not-allowed;"
                  >
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>${isSelf ? 'Tú' : 'Protegido'}</span>
                  </span>
                `}
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }
  }

  // ==============================================================
  // MODAL: EDITAR PERMISOS Y DIVISAS DE USUARIO (ADMIN / SUPER ADMIN)
  // ==============================================================
  const modalEditUserPermissionsBackdrop = document.getElementById('modal-edit-user-permissions-backdrop');
  const formEditUserPermissions = document.getElementById('form-edit-user-permissions') as HTMLFormElement | null;
  const editUserEmailHidden = document.getElementById('edit-user-email-hidden') as HTMLInputElement | null;
  const editUserAirtableIdHidden = document.getElementById('edit-user-airtable-id-hidden') as HTMLInputElement | null;
  const editUserRoleHidden = document.getElementById('edit-user-role-hidden') as HTMLInputElement | null;
  const modalEditUserName = document.getElementById('modal-edit-user-name') as HTMLInputElement | null;
  const modalEditUserCountry = document.getElementById('modal-edit-user-country') as HTMLSelectElement | null;
  const editUserPermissionsSubtitle = document.getElementById('edit-user-permissions-subtitle');
  const editContainerAuthorizedCurrencies = document.getElementById('edit-container-authorized-currencies');
  const modalEditUserPermissionsStatus = document.getElementById('modal-edit-user-permissions-status');
  const btnEditToggleAllCurrencies = document.getElementById('btn-edit-toggle-all-currencies');

  function updateEditRoleSelection(selectedRole: string) {
    if (editUserRoleHidden) editUserRoleHidden.value = selectedRole;
    document.querySelectorAll('.edit-role-card-btn').forEach((card: any) => {
      const r = card.getAttribute('data-role');
      if (r === selectedRole) {
        card.classList.add('active');
        card.style.border = '2px solid var(--brand-primary)';
        card.style.background = 'var(--brand-primary-light)';
      } else {
        card.classList.remove('active');
        card.style.border = '1.5px solid var(--border-main)';
        card.style.background = 'var(--bg-card)';
      }
    });

    if (selectedRole === 'operador') {
      if (editContainerAuthorizedCurrencies) editContainerAuthorizedCurrencies.style.display = 'block';
    } else {
      if (editContainerAuthorizedCurrencies) editContainerAuthorizedCurrencies.style.display = 'none';
    }
  }

  document.querySelectorAll('.edit-role-card-btn').forEach((card) => {
    card.addEventListener('click', () => {
      const r = card.getAttribute('data-role');
      if (r) updateEditRoleSelection(r);
    });
  });

  btnEditToggleAllCurrencies?.addEventListener('click', () => {
    const checkboxes = Array.from(document.querySelectorAll('input[name="edit_authorized_currency"]')) as HTMLInputElement[];
    const allChecked = checkboxes.every(cb => cb.checked);
    checkboxes.forEach(cb => {
      cb.checked = !allChecked;
    });
  });

  function openEditUserPermissionsModal(data: {
    email: string;
    nombre: string;
    role: string;
    pais: string;
    airtableId: string;
    currencies: string[];
  }) {
    if (!modalEditUserPermissionsBackdrop) return;
    if (editUserEmailHidden) editUserEmailHidden.value = data.email;
    if (editUserAirtableIdHidden) editUserAirtableIdHidden.value = data.airtableId || '';
    if (editUserPermissionsSubtitle) editUserPermissionsSubtitle.textContent = data.email;
    if (modalEditUserName) modalEditUserName.value = data.nombre || '';
    if (modalEditUserCountry) {
      const cleanPais = (data.pais || 'COL').replace(/[^a-zA-Z]/g, '').toUpperCase() || 'COL';
      modalEditUserCountry.value = cleanPais;
    }
    if (modalEditUserPermissionsStatus) modalEditUserPermissionsStatus.textContent = '';

    const normalizedRole = data.role === 'administrador' ? 'administrador' : (data.role === 'client' || data.role === 'cliente' ? 'client' : 'operador');
    updateEditRoleSelection(normalizedRole);

    const currSet = new Set((data.currencies || []).map(c => String(c).toUpperCase().trim()));
    document.querySelectorAll('input[name="edit_authorized_currency"]').forEach((el: any) => {
      el.checked = normalizedRole !== 'operador' ? true : currSet.has(String(el.value).toUpperCase().trim());
    });

    // Cerrar cualquier popover de divisas abierto
    document.querySelectorAll('.operator-currencies-popover').forEach((p: any) => {
      p.style.display = 'none';
    });

    modalEditUserPermissionsBackdrop.style.display = 'flex';
  }

  function closeEditUserPermissionsModal() {
    if (modalEditUserPermissionsBackdrop) modalEditUserPermissionsBackdrop.style.display = 'none';
  }

  document.addEventListener('click', (e: any) => {
    const editBtn = e.target.closest('.btn-edit-user-permissions');
    if (editBtn) {
      e.preventDefault();
      e.stopPropagation();
      let parsedCurrencies: string[] = [];
      try {
        parsedCurrencies = JSON.parse(decodeURIComponent(editBtn.getAttribute('data-currencies') || '[]'));
      } catch (_) {}
      openEditUserPermissionsModal({
        email: editBtn.getAttribute('data-email') || '',
        nombre: editBtn.getAttribute('data-nombre') || '',
        role: editBtn.getAttribute('data-role') || 'operador',
        pais: editBtn.getAttribute('data-pais') || 'COL',
        airtableId: editBtn.getAttribute('data-airtable-id') || '',
        currencies: parsedCurrencies,
      });
      return;
    }

    if (e.target.closest('#btn-close-edit-user-permissions-modal, #btn-cancel-edit-user-permissions')) {
      e.preventDefault();
      closeEditUserPermissionsModal();
    }
  });

  modalEditUserPermissionsBackdrop?.addEventListener('click', (e) => {
    if (e.target === modalEditUserPermissionsBackdrop) closeEditUserPermissionsModal();
  });

  formEditUserPermissions?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const targetEmail = (editUserEmailHidden?.value || '').trim().toLowerCase();
    const targetAirtableId = (editUserAirtableIdHidden?.value || '').trim();
    const newName = (modalEditUserName?.value || '').trim();
    const newPais = (modalEditUserCountry?.value || 'COL').trim().toUpperCase();
    const newRole = (editUserRoleHidden?.value || 'operador').trim().toLowerCase();

    if (!targetEmail) return;

    const allCurrencies = getAllSystemCurrencies();
    let newCurrencies: string[] = [];
    if (newRole === 'administrador' || newRole === 'client') {
      newCurrencies = [...allCurrencies];
    } else {
      const checked = Array.from(document.querySelectorAll('input[name="edit_authorized_currency"]:checked')) as HTMLInputElement[];
      newCurrencies = checked.map(cb => cb.value);
      if (newCurrencies.length === 0) {
        if (modalEditUserPermissionsStatus) {
          modalEditUserPermissionsStatus.style.color = 'var(--danger)';
          modalEditUserPermissionsStatus.textContent = 'Selecciona al menos 1 divisa autorizada para el Operador.';
        }
        return;
      }
    }

    const saveBtn = document.getElementById('btn-save-edit-user-permissions') as HTMLButtonElement | null;
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando cambios...';
    }
    if (modalEditUserPermissionsStatus) {
      modalEditUserPermissionsStatus.style.color = 'var(--text-muted)';
      modalEditUserPermissionsStatus.textContent = 'Sincronizando permisos en Supabase y Airtable...';
    }

    try {
      const pat = getAirtableToken();

      // 1. Llamar a la Edge Function para actualizar en Supabase (service_role) y Airtable (DIVISAS RELACIONADAS)
      try {
        await fetch(EDGE_SYNC_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'update_user_permissions',
            email: targetEmail,
            fullName: newName,
            pais: newPais,
            role: newRole,
            authorizedCurrencies: newCurrencies,
            airtableRecordId: targetAirtableId || undefined,
            pat: pat || undefined
          })
        });
      } catch (edgeErr) {
        console.warn('Edge update_user_permissions warning:', edgeErr);
      }

      // 2. Asegurar actualización directa en Supabase profiles
      await supabase.from('profiles').update({
        full_name: newName,
        pais: newPais,
        role: newRole,
        authorized_currencies: newCurrencies
      }).ilike('email', targetEmail);

      // 3. Si el usuario editado es el usuario actual en sesión, refrescar sus permisos de divisas en el dashboard
      if (currentUserProfile && (currentUserProfile.email || '').toLowerCase().trim() === targetEmail) {
        currentUserProfile.full_name = newName;
        currentUserProfile.pais = newPais;
        currentUserProfile.role = newRole;
        currentUserProfile.authorized_currencies = newCurrencies;
        updateHeaderProfileUI();
      }

      if (modalEditUserPermissionsStatus) {
        modalEditUserPermissionsStatus.style.color = 'var(--success)';
        modalEditUserPermissionsStatus.textContent = '¡Permisos y divisas actualizados correctamente!';
      }

      await loadUsersList();
      setTimeout(() => {
