      const dispTfoot = document.getElementById('dispersiones-table-tfoot');
      if (dispTfoot) {
        const totDisp = dispersiones.reduce((acc: number, d: any) => acc + (Number(d.montoCop ?? d.valorTotalDispersion) || 0), 0);
        dispTfoot.innerHTML = `
          <tr style="background: var(--bg-main); border-top: 2px solid var(--border-main); font-weight: 800;">
            <td colspan="6" style="padding: 16px 20px;">TOTAL DISPERSADO</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--danger);">${fmtCopClient(totDisp, 2)}</td>
            <td></td>
            <td></td>
          </tr>
        `;
      }
    }

    // 10. Actualizar Compras USDT (Regla Airtable: VALOR COMPRADO = 2 dec, USDT COMPRADO / COSTO / TASA = 4 dec) y Ventas USDT (2 dec)
    if (comprasUsdt.length > 0) {
      const comprasTbody = document.getElementById('compras-table-tbody');
      if (comprasTbody) {
        comprasTbody.innerHTML = comprasUsdt.map((c: any) => {
          const code = c.codigo || c.idTransaccion || '';
          const divisa = c.divisa || c.divisaNombre || '';
          const valorComp = Number(c.valorComprado ?? c.montoDivisa) || 0;
          const usdtComp = Number(c.usdtComprado ?? c.totalRecibidoUsdt) || 0;
