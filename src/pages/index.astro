                : 'linear-gradient(135deg, #FFB547 0%, #A35D00 100%)';
              return (
                <div style={'position: relative; border-radius: 22px; padding: 24px; color: #ffffff; background: ' + bgGradient + '; box-shadow: 0 14px 28px rgba(0,0,0,0.15); display: flex; flex-direction: column; justify-content: space-between; min-height: 200px; overflow: hidden;'}>
