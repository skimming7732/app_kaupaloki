  // Submit creación/invitación de usuario
  formModalCreateUser?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nameInput = document.getElementById('modal-user-name') as HTMLInputElement;
    const emailInput = document.getElementById('modal-user-email') as HTMLInputElement;
    const currentRoleInput = document.getElementById('modal-user-role') as HTMLInputElement;
    const countrySelect = document.getElementById('modal-user-country') as HTMLSelectElement | null;

    const name = nameInput.value.trim();
    const email = emailInput.value.trim().toLowerCase();
    const rawRole = currentRoleInput?.value || 'operador';
    const role = (rawRole === 'client' || rawRole === 'cliente') ? 'cliente' : (rawRole === 'administrador' || rawRole === 'admin') ? 'administrador' : 'operador';
    const country = countrySelect ? countrySelect.value : 'COL';

    // Determinar divisas autorizadas: Si es admin o cliente, siempre todas las divisas sincronizadas con Airtable
    const allCurrencies = getAllSystemCurrencies();
    let authorizedCurrencies: string[];
    if (role === 'administrador' || role === 'client' || role === 'cliente') {
      authorizedCurrencies = [...allCurrencies];
    } else {
      const checkedBoxes = Array.from(document.querySelectorAll('input[name="authorized_currency"]:checked')) as HTMLInputElement[];
      authorizedCurrencies = checkedBoxes.map(cb => cb.value);
      if (authorizedCurrencies.length === 0) {
        if (modalCreateUserStatus) {
          modalCreateUserStatus.style.color = 'var(--danger)';
          modalCreateUserStatus.textContent = 'Selecciona al menos 1 divisa autorizada para el Operador.';
        }
        return;
      }
    }

    const btnSubmit = document.getElementById('btn-submit-create-user') as HTMLButtonElement | null;
    if (btnSubmit) {
      btnSubmit.disabled = true;
      btnSubmit.style.opacity = '0.7';
      btnSubmit.innerHTML = `
        <svg style="animation: spin 1s linear infinite;" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
          <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
        </svg>
        <span>Enviando Invitación...</span>
      `;
    }

    if (modalCreateUserStatus) {
      modalCreateUserStatus.style.color = 'var(--brand-primary)';
      modalCreateUserStatus.textContent = 'Enviando invitación y creando perfil...';
    }

    try {
      // URL de producción obligatoria (nunca localhost en invitaciones por correo)
      const PRODUCTION_APP_URL = 'https://app.kaupaloki.co';
      const inviteUrl = `${PRODUCTION_APP_URL}/onboarding?email=${encodeURIComponent(email)}`;

      // Si el usuario había sido eliminado previamente, quitarlo de la lista local de eliminados
      unmarkUserDeletedLocal(email);

      const pat = getAirtableToken();

      // 1. Pre-crear el usuario en auth.users con email_confirm: true desde la Edge Function
      // Esto evita que Supabase dispare el correo en inglés "Confirm your email address" (type=signup) hacia localhost
      // y sincroniza el perfil y las divisas en Supabase y Airtable
      let preparedUserId: string = crypto.randomUUID();
      try {
        const prepRes = await fetch('https://tjuqludeduydarwzhbor.supabase.co/functions/v1/airtable-sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'prepare_invited_user',
            email,
            fullName: name,
            role,
            pais: country,
            authorizedCurrencies,
            pat: pat || undefined
          })
        });
        if (prepRes.ok) {
          const prepData = await prepRes.json();
          if (prepData?.userId) preparedUserId = prepData.userId;
        }
      } catch (prepErr) {
        console.warn('Prepare invited user warning:', prepErr);
      }

      // 2. Enviar Magic Link (con el usuario ya confirmado en auth.users, usa la plantilla Magic Link y no Confirm Signup)
      try {
        await supabase.auth.signInWithOtp({
          email,
          options: {
            shouldCreateUser: false,
            emailRedirectTo: inviteUrl,
            data: {
              full_name: name,
              role: role,
              pais: country,
              country: country,
              authorized_currencies: authorizedCurrencies,
              onboarding_completed: false,
              app_url: PRODUCTION_APP_URL
            }
          }
        });
      } catch (_) {}

      // 3. Asegurar registro en tabla profiles de Supabase (por ID y por email)
      await supabase.from('profiles').upsert({
        id: preparedUserId,
        email: email,
        full_name: name,
        role: role,
        pais: country,
        authorized_currencies: authorizedCurrencies,
        status: 'invitado',
        onboarding_completed: false,
        is_super_admin: isSuperAdminUser(email)
      }, { onConflict: 'id' });

      await supabase.from('profiles').update({
        full_name: name,
        role: role,
        pais: country,
        authorized_currencies: authorizedCurrencies,
        status: 'invitado',
        is_super_admin: isSuperAdminUser(email)
      }).ilike('email', email);

      // Sincronizar inmediatamente a Airtable si hay PAT configurado en el navegador
      if (pat) {
        try {
          const divisaRelIds = authorizedCurrencies.map(c => AIRTABLE_CURRENCIES_META[c]?.id).filter(Boolean);
          // Buscar primero si existe el correo en Airtable (incluso si está INACTIVO) para reactivarlo
          const searchResp = await fetch(`https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb?filterByFormula=LOWER({EMAIL})='${encodeURIComponent(email)}'`, {
            headers: { 'Authorization': `Bearer ${pat}` }
          });
          let existingRecId: string | null = null;
          if (searchResp.ok) {
            const sJson = await searchResp.json();
            if (sJson.records && sJson.records.length > 0) {
              existingRecId = sJson.records[0].id;
            }
          }

          const airtableRole = isSuperAdminUser(email)
            ? 'SUPER ADMIN'
            : (role === 'administrador' ? 'ADMINISTRADOR' : (role === 'client' ? 'CLIENTE' : 'OPERADOR'));

          if (existingRecId) {
            // Reactivar usuario existente y actualizar rol y divisas relacionadas
            await fetch(`https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb/${existingRecId}`, {
              method: 'PATCH',
              headers: {
                'Authorization': `Bearer ${pat}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                fields: {
                  "NOMBRE": name.toUpperCase(),
                  "PAIS": country,
                  "ESTADO": "ACTIVO",
                  "ROL": airtableRole,
                  "DIVISAS RELACIONADAS": divisaRelIds
                },
                typecast: true
              })
            });
          } else {
            // Crear nuevo registro enlazando DIVISAS RELACIONADAS
            await fetch('https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb', {
              method: 'POST',
              headers: {
                'Authorization': `Bearer ${pat}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                fields: {
                  "NOMBRE": name.toUpperCase(),
                  "EMAIL": email,
                  "PAIS": country,
                  "ESTADO": "ACTIVO",
                  "ROL": airtableRole,
                  "DIVISAS RELACIONADAS": divisaRelIds
                },
                typecast: true
              })
            });
          }
        } catch (airtableErr) {
          console.warn('Airtable real-time user sync warning:', airtableErr);
        }
      }

      if (modalCreateUserStatus) {
        modalCreateUserStatus.style.color = 'var(--success)';
        modalCreateUserStatus.textContent = `¡Invitación creada con éxito para ${email}!`;
      }

      if (modalInvitationSuccessBox && modalInvitationLinkInput) {
        modalInvitationLinkInput.value = inviteUrl;

        const roleLabel = role === 'administrador' ? 'Administrador' : (role === 'client' ? 'Cliente' : 'Operador');
        const waMsg = `👋 Hola ${name},\n\nTe damos la bienvenida a *Kaupaloki*.\nHas sido registrado en la plataforma con el rol de *${roleLabel}*.\n\n👉 Para ingresar y configurar tu contraseña de acceso, haz clic aquí:\n${inviteUrl}\n\n¡Bienvenido al equipo!`;
        const waBtn = document.getElementById('btn-share-invite-whatsapp') as HTMLAnchorElement | null;
        if (waBtn) {
          waBtn.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(waMsg)}`;
        }

        const mailBtn = document.getElementById('btn-share-invite-mail') as HTMLAnchorElement | null;
        if (mailBtn) {
          const mailSubject = `Invitación a Kaupaloki - Acceso a la Plataforma (${name})`;
          const mailBody = `Hola ${name},\n\nTe damos la bienvenida a la plataforma de Kaupaloki.\nHas sido invitado con el rol de ${roleLabel}.\n\nPara activar tu cuenta y configurar tu contraseña de acceso, por favor ingresa al siguiente enlace seguro:\n${inviteUrl}\n\nSi tienes cualquier duda, contacta al administrador de la plataforma.\n\nAtentamente,\nEquipo Kaupaloki\nhttps://app.kaupaloki.co`;
          mailBtn.href = `mailto:${email}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
        }

        modalInvitationSuccessBox.style.display = 'flex';
      }

      loadUsersList();
    } catch (err: any) {
      const errMsg = err?.message || String(err);
      if (modalCreateUserStatus) {
        modalCreateUserStatus.style.color = 'var(--danger)';
        modalCreateUserStatus.textContent = 'Error al invitar usuario: ' + errMsg;
      }
      alert('Error al invitar usuario: ' + errMsg);
    } finally {
      const btnSubmit = document.getElementById('btn-submit-create-user') as HTMLButtonElement | null;
      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.style.opacity = '1';
        btnSubmit.innerHTML = `
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          <span>Enviar Invitación</span>
        `;
      }
    }
