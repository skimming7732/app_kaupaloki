  function updateOperatorViewMetrics() {
    if (!currentUserProfile) return;
    const opName = document.getElementById('op-welcome-name');
    if (opName) opName.textContent = currentUserProfile.full_name || currentUserProfile.email || 'Operador';

    const lastLoginEl = document.getElementById('op-kpi-last-login');
    if (lastLoginEl) {
      const now = new Date();
      lastLoginEl.textContent = `${now.toLocaleDateString('es-CO')} ${now.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })}`;
    }

    const authorizedCurrencies: string[] = Array.isArray(currentUserProfile.authorized_currencies) 
      ? currentUserProfile.authorized_currencies 
      : [];

    const chipsContainer = document.getElementById('op-authorized-currencies-chips');
    if (chipsContainer) {
      if (currentUserProfile.is_super_admin || currentUserProfile.role === 'administrador') {
        chipsContainer.innerHTML = '<span style="font-size: 11px; font-weight: 700; color: var(--brand-primary); background: var(--brand-primary-light); padding: 4px 10px; border-radius: 9999px;">Todas las divisas autorizadas (Acceso Total)</span>';
      } else if (authorizedCurrencies.length === 0) {
        chipsContainer.innerHTML = '<span style="font-size: 11px; color: var(--text-muted);">Sin divisas específicas asignadas (modo lectura general)</span>';
      } else {
        chipsContainer.innerHTML = authorizedCurrencies.map(currCode => {
          const meta = AIRTABLE_CURRENCIES_META[currCode] || {};
          const flag = meta.banderaUrl || meta.fallbackBanderaUrl || '';
          return `
            <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 9999px; background: var(--bg-card-secondary); border: 1px solid var(--border-main); font-size: 11px; font-weight: 700; color: var(--text-primary);">
              ${flag ? `<img src="${flag}" alt="${currCode}" style="width: 16px; height: 12px; object-fit: cover; border-radius: 3px;" />` : ''}
              <span>${currCode}</span>
            </div>
          `;
        }).join('');
      }
    }

    const opNegociosAutorizados = document.getElementById('op-kpi-negocios-autorizados');
    const opNegociosMios = document.getElementById('op-kpi-negocios-mios');
    
    const rows = document.querySelectorAll('#negocios-table-tbody tr');
    let totalAuth = 0;

    rows.forEach((r: any) => {
      const divisaCell = r.querySelector('td:nth-child(5)')?.textContent?.trim() || '';
      const isAuth = authorizedCurrencies.length === 0 || authorizedCurrencies.includes(divisaCell) || currentUserProfile.role === 'administrador' || currentUserProfile.is_super_admin;
      if (isAuth) totalAuth++;
    });

    if (opNegociosAutorizados) opNegociosAutorizados.textContent = `${totalAuth} Negocios`;
    if (opNegociosMios) opNegociosMios.textContent = `${totalAuth} Registrados`;
  }

  function updateHeaderProfileUI() {
    if (!currentUserProfile) return;
    const name = currentUserProfile.full_name || currentUserProfile.email || 'Admin';
