      // 2. Respaldo directo en Supabase profiles (marcar inactivo + eliminar)
      try {
        await supabase.from('profiles').update({ status: 'inactivo', onboarding_completed: false }).ilike('email', cleanEmail);
        await supabase.from('profiles').delete().ilike('email', cleanEmail);
      } catch (_) {}

      // 3. Respaldo directo en Airtable si hay PAT en cliente
      if (pat) {
        try {
          let recId = airtableId;
          if (!recId) {
            const searchResp = await fetch(`https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb?filterByFormula=LOWER({EMAIL})='${encodeURIComponent(cleanEmail)}'`, {
