  divisaPickerDropdown?.addEventListener('click', (e) => {
    e.stopPropagation();
  });

  divisaPickerList?.addEventListener('click', (e: any) => {
    const opt = e.target.closest('.divisa-picker-option');
    if (opt) {
      const code = opt.getAttribute('data-code') || '';
      if (code) selectDivisaInPicker(code);
    }
  });

  // Cerrar popovers de fecha, cliente y divisa al hacer clic fuera
  document.addEventListener('click', (e: any) => {
    if (customCalendarPopover && customCalendarPopover.style.display !== 'none') {
      if (!e.target.closest('#custom-calendar-popover') && !e.target.closest('#custom-date-picker-trigger')) {
        toggleCalendarPopover(false);
      }
    }
    if (clientPickerDropdown && clientPickerDropdown.style.display !== 'none') {
      if (!e.target.closest('#client-picker-dropdown') && !e.target.closest('#client-picker-trigger')) {
        toggleClientPickerDropdown(false);
      }
    }
    if (divisaPickerDropdown && divisaPickerDropdown.style.display !== 'none') {
      if (!e.target.closest('#divisa-picker-dropdown') && !e.target.closest('#divisa-picker-trigger')) {
        toggleDivisaPickerDropdown(false);
      }
    }
  });

  function openCreateNegocioModal() {
    if (!modalCreateNegocioBackdrop) return;

    // 1. Establecer fecha de hoy por defecto
    setNegocioDate(getLocalIsoDate(0));
    toggleCalendarPopover(false);
    toggleClientPickerDropdown(false);
    toggleDivisaPickerDropdown(false);

    // Reset cliente seleccionado si estaba vacío
    if (!modalNegocioCliente?.value) {
      selectClientInPicker('', '', '');
    }

    // 2. Filtrar divisas por divisas autorizadas del usuario logueado
    if (modalNegocioDivisa) {
      const isAdm = currentUserProfile?.role === 'administrador' || currentUserProfile?.is_super_admin;
      let allowed: string[] = currentUserProfile?.authorized_currencies;
      if (isAdm || !allowed || allowed.length === 0) {
        allowed = Object.keys(AIRTABLE_CURRENCIES_META);
      }

      modalNegocioDivisa.innerHTML = '<option value="">-- Seleccionar Divisa --</option>' + 
        allowed.map((code: string) => {
          const meta = AIRTABLE_CURRENCIES_META[code] || { flag: '🌐', name: code };
          return `<option value="${code}">${meta.flag} ${code} - ${meta.name}</option>`;
        }).join('');

      renderDivisaPickerOptions(allowed);

      // Si solo tiene una divisa asignada, queda preseleccionada y bloqueada
      if (allowed.length === 1) {
        isDivisaLockedSingle = true;
        selectDivisaInPicker(allowed[0]);
        if (modalNegocioDivisaHint) modalNegocioDivisaHint.style.display = 'inline-block';
        if (divisaPickerTrigger) divisaPickerTrigger.style.cursor = 'not-allowed';
      } else {
        isDivisaLockedSingle = false;
        selectDivisaInPicker(allowed[0] || 'USD');
        if (modalNegocioDivisaHint) modalNegocioDivisaHint.style.display = 'none';
        if (divisaPickerTrigger) divisaPickerTrigger.style.cursor = 'pointer';
      }
    }

    if (modalNegocioMonto) modalNegocioMonto.value = '';
    if (modalNegocioStatus) modalNegocioStatus.textContent = '';

    modalCreateNegocioBackdrop.style.display = 'flex';
  }

  function closeCreateNegocioModal() {
    if (modalCreateNegocioBackdrop) modalCreateNegocioBackdrop.style.display = 'none';
    toggleCalendarPopover(false);
    toggleClientPickerDropdown(false);
    toggleDivisaPickerDropdown(false);
  }

  btnOpenCreateNegocioModal?.addEventListener('click', openCreateNegocioModal);
  btnCloseCreateNegocioModal?.addEventListener('click', closeCreateNegocioModal);
  btnCancelCreateNegocio?.addEventListener('click', closeCreateNegocioModal);
  modalCreateNegocioBackdrop?.addEventListener('click', (e) => {
    if (e.target === modalCreateNegocioBackdrop) closeCreateNegocioModal();
  });

  formModalCreateNegocio?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!modalNegocioFecha || !modalNegocioCliente || !modalNegocioDivisa || !modalNegocioMonto) return;

    const fecha = modalNegocioFecha.value;
    const clienteId = modalNegocioCliente.value;
    const clienteSelectedOption = modalNegocioCliente.options[modalNegocioCliente.selectedIndex];
    const clienteNombre = clienteSelectedOption?.getAttribute('data-nombre') || (clienteSelectedOption ? clienteSelectedOption.text.split('(')[0].trim() : 'Cliente');
    const divisa = modalNegocioDivisa.value;
    const monto = parseFloat(modalNegocioMonto.value);
    const tasa = modalNegocioTasa ? parseFloat(modalNegocioTasa.value) : 0;

    if (!fecha || !clienteId || !divisa || isNaN(monto) || monto <= 0 || isNaN(tasa) || tasa <= 0) {
      if (modalNegocioStatus) {
        modalNegocioStatus.style.color = 'var(--danger)';
        modalNegocioStatus.textContent = 'Por favor selecciona cliente, divisa, monto y una tasa COP válida (> 0).';
      }
      return;
    }

    if (modalNegocioStatus) {
      modalNegocioStatus.style.color = 'var(--text-muted)';
      modalNegocioStatus.textContent = 'Guardando negocio en sistema y Airtable...';
    }

    const btnSubmit = document.getElementById('btn-submit-create-negocio');
    if (btnSubmit) {
      btnSubmit.setAttribute('disabled', 'true');
      btnSubmit.innerHTML = '<span>Guardando...</span>';
    }

    try {
      const pat = getAirtableToken();
      const divisaMeta = AIRTABLE_CURRENCIES_META[divisa];
      const divisaRecId = divisaMeta?.id;

      const edgeRes = await fetch(EDGE_SYNC_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'create_negocio',
          fecha,
          clienteId,
          divisaId: divisaRecId,
          monto,
          tasa,
          operadorEmail: currentUserProfile?.email,
          operadorId: currentUserProfile?.airtableRecordId,
          pat: pat || undefined,
        }),
      });

      const edgeData = await edgeRes.json().catch(() => ({}));
      if (!edgeRes.ok || !edgeData.ok) {
        throw new Error(edgeData.error || 'No se pudo guardar el negocio en Airtable. Verifica tu conexión o token.');
      }

      if (edgeData.snapshot) {
        applyAirtableSnapshot(edgeData.snapshot);
      }

      closeCreateNegocioModal();
      formModalCreateNegocio.reset();
      selectClientInPicker('', '', '');
      alert(`¡Negocio registrado exitosamente en Airtable!`);
    } catch (err: any) {
      if (modalNegocioStatus) {
        modalNegocioStatus.style.color = 'var(--danger)';
        modalNegocioStatus.textContent = err.message || 'Error al guardar negocio';
      }
    } finally {
      if (btnSubmit) {
        btnSubmit.removeAttribute('disabled');
        btnSubmit.innerHTML = `
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Guardar Negocio</span>
        `;
      }
    }
  });

  // ==============================================================
  // GESTIÓN DE DISPERSIONES (MODAL Y REGISTRO EN AIRTABLE)
