  const DELETED_USERS_STORAGE_KEY = 'kaupaloki_deleted_users';

  function getDeletedUsers(): string[] {
    try {
      const raw = localStorage.getItem(DELETED_USERS_STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed.map((e: string) => String(e).toLowerCase().trim()) : [];
    } catch (_) {
      return [];
    }
  }

  function markUserDeletedLocal(email: string) {
    const clean = (email || '').toLowerCase().trim();
    if (!clean) return;
    const list = new Set(getDeletedUsers());
    list.add(clean);
    try {
      localStorage.setItem(DELETED_USERS_STORAGE_KEY, JSON.stringify(Array.from(list)));
    } catch (_) {}
  }

  function unmarkUserDeletedLocal(email: string) {
    const clean = (email || '').toLowerCase().trim();
    if (!clean) return;
    const list = getDeletedUsers().filter(e => e !== clean);
    try {
      localStorage.setItem(DELETED_USERS_STORAGE_KEY, JSON.stringify(list));
    } catch (_) {}
  }

  async function initCurrentUser() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user) {
        currentAuthUser = session.user;
        const { data: profile } = await supabase
          .from('profiles')
          .select('*')
          .eq('email', session.user.email)
          .single();

        if (profile) {
          currentUserProfile = {
            ...profile,
            is_super_admin: isSuperAdminUser(profile.email)
          };
        } else {
          currentUserProfile = {
            id: session.user.id,
            email: session.user.email,
            full_name: session.user.user_metadata?.full_name || session.user.email?.split('@')[0],
            role: session.user.user_metadata?.role || (isSuperAdminUser(session.user.email) ? 'administrador' : 'operador'),
            is_super_admin: isSuperAdminUser(session.user.email)
          };
        }
      } else {
        window.location.replace('/login');
        return;
      }
    } catch (e) {
      window.location.replace('/login');
      return;
    }

    currentUserProfile.is_super_admin = isSuperAdminUser(currentUserProfile.email) || Boolean(currentUserProfile.is_super_admin);

    updateHeaderProfileUI();
    applyRolePermissions(currentUserProfile.role);
    loadUsersList();
  }

  function applyRolePermissions(rawRole: string) {
    const role = (rawRole || 'operador').toLowerCase().trim();
    const isSuperAdmin = currentUserProfile?.is_super_admin;
    const isAdmin = isSuperAdmin || role === 'administrador' || role === 'admin' || role === 'super admin';
    const isOperator = !isAdmin && (role === 'operador' || role === 'operator');
    const isDispersador = !isAdmin && (role === 'dispersador');

    const linkOperador = document.getElementById('sidebar-link-operador');
    const linkDashboard = document.getElementById('sidebar-link-dashboard');
    const linkClientes = document.getElementById('sidebar-link-clientes');
    const linkNegocios = document.getElementById('sidebar-link-negocios');
    const linkDispersiones = document.getElementById('sidebar-link-dispersiones');
    const linkCompras = document.getElementById('sidebar-link-compras');
    const linkVentas = document.getElementById('sidebar-link-ventas');
    const linkActivos = document.getElementById('sidebar-link-activos');
    const linkActivosDigitales = document.getElementById('sidebar-link-activos-digitales');
    const linkDivisas = document.getElementById('sidebar-link-divisas');
    const linkUsuarios = document.getElementById('sidebar-link-usuarios');
    const airtableCard = document.getElementById('sidebar-airtable-card');
    const dynamicKpis = document.getElementById('dynamic-kpis-wrapper');

    if (isOperator) {
      if (linkOperador) linkOperador.style.display = 'flex';
      if (linkDashboard) linkDashboard.style.display = 'none';
      if (linkClientes) linkClientes.style.display = 'flex';
      if (linkNegocios) linkNegocios.style.display = 'flex';
      if (linkDispersiones) linkDispersiones.style.display = 'none';
      if (linkCompras) linkCompras.style.display = 'none';
      if (linkVentas) linkVentas.style.display = 'none';
      if (linkActivos) linkActivos.style.display = 'none';
      if (linkActivosDigitales) linkActivosDigitales.style.display = 'none';
      if (linkDivisas) linkDivisas.style.display = 'none';
      if (linkUsuarios) linkUsuarios.style.display = 'none';
      if (airtableCard) airtableCard.style.display = 'none';
      if (dynamicKpis) dynamicKpis.style.display = 'none';

      const activePane = document.querySelector('.tab-content.active');
      const currentActiveId = activePane?.id;
      if (!currentActiveId || (currentActiveId !== 'tab-operador' && currentActiveId !== 'tab-negocios' && currentActiveId !== 'tab-clientes')) {
        switchTab('tab-operador', false);
      }
      updateOperatorViewMetrics();
    } else if (isDispersador) {
      if (linkOperador) linkOperador.style.display = 'none';
      if (linkDashboard) linkDashboard.style.display = 'none';
      if (linkClientes) linkClientes.style.display = 'none';
      if (linkNegocios) linkNegocios.style.display = 'none';
      if (linkDispersiones) linkDispersiones.style.display = 'flex';
      if (linkCompras) linkCompras.style.display = 'none';
      if (linkVentas) linkVentas.style.display = 'none';
      if (linkActivos) linkActivos.style.display = 'none';
      if (linkActivosDigitales) linkActivosDigitales.style.display = 'none';
      if (linkDivisas) linkDivisas.style.display = 'none';
      if (linkUsuarios) linkUsuarios.style.display = 'none';
      if (airtableCard) airtableCard.style.display = 'none';
      if (dynamicKpis) dynamicKpis.style.display = 'none';

      switchTab('tab-dispersiones', false);
    } else {
      if (linkOperador) linkOperador.style.display = 'flex';
      if (linkDashboard) linkDashboard.style.display = 'flex';
      if (linkClientes) linkClientes.style.display = 'flex';
      if (linkNegocios) linkNegocios.style.display = 'flex';
      if (linkDispersiones) linkDispersiones.style.display = 'flex';
      if (linkCompras) linkCompras.style.display = 'flex';
      if (linkVentas) linkVentas.style.display = 'flex';
      if (linkActivos) linkActivos.style.display = 'flex';
      if (linkActivosDigitales) linkActivosDigitales.style.display = 'flex';
      if (linkDivisas) linkDivisas.style.display = 'flex';
