  function setSyncIndicator(state: 'live' | 'syncing' | 'cached' | 'error', label: string) {
    if (syncDot) {
      if (state === 'live') {
        syncDot.style.background = 'var(--success)';
        syncDot.style.boxShadow = '0 0 8px var(--success)';
      } else if (state === 'syncing') {
        syncDot.style.background = '#3965FF';
        syncDot.style.boxShadow = '0 0 8px #3965FF';
      } else if (state === 'error') {
        syncDot.style.background = 'var(--danger)';
        syncDot.style.boxShadow = '0 0 8px var(--danger)';
      } else {
        syncDot.style.background = 'var(--warning)';
        syncDot.style.boxShadow = '0 0 8px var(--warning)';
      }
    }
    if (syncText) {
      syncText.textContent = label;
    }
  }

