            <thead>
              <tr style="background: #090e1a; border-bottom: 1px solid #1e293b; color: #94a3b8; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">
                <th style="padding: 12px 16px;">#</th>
