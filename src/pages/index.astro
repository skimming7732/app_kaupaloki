      const errHtml = `<tr><td colspan="7" style="padding: 18px; text-align: center; color: var(--danger);">Error al cargar usuarios: ${error?.message}</td></tr>`;
      if (usuariosViewTableBody) usuariosViewTableBody.innerHTML = errHtml;
      return;
