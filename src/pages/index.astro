                <td colspan="5" style="padding: 14px 16px; text-transform: uppercase; font-size: 12px; color: #94a3b8;">TOTAL USDT CONSOLIDADO:</td>
                <td style="padding: 14px 16px; text-align: right; color: #c084fc;">
                  {formatDecimal(COMPRAS_USDT.reduce((a, b) => a + b.usdtComprado, 0), 2)} USDT
