                  <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Institución</th>
                  <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Empresa</th>
                  <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); text-align: right;">Ingresos (COP)</th>
                  <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); text-align: right;">Egresos (COP)</th>
                  <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); text-align: right;">Saldo Actual (COP)</th>
                </tr>
              </thead>
              <tbody>
                {ACTIVOS_LIQUIDOS.map((a) => (
                  <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main);">
                    <td style="padding: 16px 20px; font-weight: 700; color: var(--text-primary);">{a.activo}</td>
                    <td style="padding: 16px 20px; color: var(--text-secondary);">{a.institucion}</td>
                    <td style="padding: 16px 20px; color: var(--text-secondary);">{a.empresa}</td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success); font-weight: 600;">{formatCop(a.ingresosCop)}</td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--danger); font-weight: 600;">{formatCop(a.egresosCop)}</td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--text-primary); font-size: 15px;">{formatCop(a.saldoCop)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

        </div>


        <!-- ============================================================ -->
        <!-- TAB 7: USUARIOS (SUPABASE AUTH & ROLES) -->
