                  <div style="border-top: 1px solid rgba(255,255,255,0.2); padding-top: 12px; display: flex; justify-content: space-between; align-items: flex-end; position: relative; z-index: 2; font-size: 11px;">
                    <div>
                      <div style="opacity: 0.75; font-size: 10px; text-transform: uppercase;">Empresa / Titular</div>
                      <div style="font-weight: 700; margin-top: 2px;">{a.empresa}</div>
                    </div>
                    <div style="text-align: right; font-family: ui-monospace, monospace;">
                      <div style="color: rgba(255,255,255,0.9); font-weight: 700;">+ {formatCop(a.ingresosCop)}</div>
                      <div style="opacity: 0.75; font-size: 10px;">- {formatCop(a.egresosCop)}</div>
                    </div>
                  </div>
                </div>
              );
