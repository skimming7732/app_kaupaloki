  // --- Lógica del Selector de Cliente Buscable ---
  function toggleClientPickerDropdown(forceOpen?: boolean) {
    if (!clientPickerDropdown) return;
    const isOpen = forceOpen !== undefined ? forceOpen : clientPickerDropdown.style.display === 'none';
    clientPickerDropdown.style.display = isOpen ? 'block' : 'none';
    if (clientPickerChevron) {
      clientPickerChevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    }
    if (isOpen) {
      toggleCalendarPopover(false);
      if (clientPickerSearch) {
        clientPickerSearch.value = '';
        filterClientPickerList('');
        setTimeout(() => clientPickerSearch.focus(), 40);
      }
    }
  }

  function selectClientInPicker(id: string, codigo: string, nombre: string) {
    if (modalNegocioCliente) {
      let existingOpt = Array.from(modalNegocioCliente.options).find(o => o.value === id);
      if (!existingOpt) {
        existingOpt = document.createElement('option');
        existingOpt.value = id;
        existingOpt.setAttribute('data-codigo', codigo);
        existingOpt.setAttribute('data-nombre', nombre);
        existingOpt.textContent = `${nombre} (${codigo})`;
        modalNegocioCliente.appendChild(existingOpt);
      }
      modalNegocioCliente.value = id;
    }

    if (clientPickerSelectedCode) {
      if (codigo) {
        clientPickerSelectedCode.textContent = codigo;
        clientPickerSelectedCode.style.display = 'inline-block';
      } else {
        clientPickerSelectedCode.style.display = 'none';
      }
    }
    if (clientPickerSelectedName) {
      clientPickerSelectedName.textContent = nombre || 'Seleccionar cliente por código o nombre...';
      clientPickerSelectedName.style.color = id ? 'var(--text-primary)' : 'var(--text-muted)';
    }

    // Marcar opción activa en la lista
    document.querySelectorAll('.client-picker-option').forEach((el: any) => {
      const isMatch = el.getAttribute('data-id') === id;
      el.classList.toggle('selected', isMatch);
      const checkEl = el.querySelector('.client-picker-check') as HTMLElement | null;
      if (checkEl) checkEl.style.opacity = isMatch ? '1' : '0';
    });

    toggleClientPickerDropdown(false);
  }

  function filterClientPickerList(query: string) {
    const q = (query || '').toLowerCase().trim();
    const options = clientPickerList?.querySelectorAll('.client-picker-option');
    if (!options) return;
    let visibleCount = 0;
    options.forEach((opt: any) => {
      const code = (opt.getAttribute('data-codigo') || '').toLowerCase();
      const name = (opt.getAttribute('data-nombre') || '').toLowerCase();
      const match = !q || code.includes(q) || name.includes(q);
      opt.style.display = match ? 'flex' : 'none';
      if (match) visibleCount++;
    });

    let emptyMsg = document.getElementById('client-picker-empty-msg');
    if (visibleCount === 0 && clientPickerList) {
      if (!emptyMsg) {
        emptyMsg = document.createElement('div');
        emptyMsg.id = 'client-picker-empty-msg';
        emptyMsg.style.cssText = 'padding: 14px 12px; text-align: center; font-size: 12px; color: var(--text-muted); font-weight: 600;';
        clientPickerList.appendChild(emptyMsg);
      }
      emptyMsg.textContent = `No se encontraron clientes para "${query}"`;
      emptyMsg.style.display = 'block';
    } else if (emptyMsg) {
      emptyMsg.style.display = 'none';
    }
  }

  clientPickerTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleClientPickerDropdown();
  });

  clientPickerSearch?.addEventListener('input', (e) => {
    filterClientPickerList((e.target as HTMLInputElement).value);
