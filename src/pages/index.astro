      if (btnLightboxPrev) btnLightboxPrev.style.display = 'flex';
      if (btnLightboxNext) btnLightboxNext.style.display = 'flex';

      if (lightboxStrip) {
        lightboxStrip.style.display = 'flex';
        lightboxStrip.innerHTML = activeLightboxVouchers.map((v, i) => `
          <div 
            class="lightbox-thumb-item" 
            data-index="${i}"
            style="cursor: pointer; border-radius: 6px; overflow: hidden; border: 2px solid ${i === activeLightboxIndex ? 'var(--brand-primary)' : 'transparent'}; opacity: ${i === activeLightboxIndex ? '1' : '0.55'}; width: 34px; height: 50px; flex-shrink: 0; transition: all 0.2s;"
          >
            <img src="${v.url}" alt="thumb" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
        `).join('');
      }
    } else {
      if (lightboxCounterBadge) lightboxCounterBadge.style.display = 'none';
      if (btnLightboxPrev) btnLightboxPrev.style.display = 'none';
      if (btnLightboxNext) btnLightboxNext.style.display = 'none';
      if (lightboxStrip) lightboxStrip.style.display = 'none';
    }
  }

