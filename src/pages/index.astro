  // Copiar Comprobante al Portapapeles (Imagen o enlace)
  btnCopyLightbox?.addEventListener('click', async () => {
    if (activeLightboxVouchers.length === 0) return;
    const current = activeLightboxVouchers[activeLightboxIndex];

    if (btnCopyLightboxText) btnCopyLightboxText.textContent = 'Copiando...';

    try {
      const response = await fetch(current.url);
      const blob = await response.blob();

      let pngBlob = blob;
      if (blob.type !== 'image/png') {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        await new Promise((resolve, reject) => {
          img.onload = resolve;
          img.onerror = reject;
          img.src = current.url;
        });
        const canvas = document.createElement('canvas');
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        const ctx = canvas.getContext('2d');
        ctx?.drawImage(img, 0, 0);
        pngBlob = await new Promise(r => canvas.toBlob(r as any, 'image/png')) as Blob;
      }

      await navigator.clipboard.write([
        new ClipboardItem({ 'image/png': pngBlob })
      ]);
      if (btnCopyLightboxText) btnCopyLightboxText.textContent = '¡Copiado! ✓';
    } catch (err) {
      try {
        await navigator.clipboard.writeText(current.url);
        if (btnCopyLightboxText) btnCopyLightboxText.textContent = '¡Link Copiado! ✓';
      } catch (e2) {
        if (btnCopyLightboxText) btnCopyLightboxText.textContent = 'Error';
      }
    }

    setTimeout(() => {
      if (btnCopyLightboxText) btnCopyLightboxText.textContent = 'Copiar';
    }, 2000);
  });

