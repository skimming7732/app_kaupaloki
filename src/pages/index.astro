  const calMonthYearLabel = document.getElementById('cal-month-year-label');
  const calDaysGrid = document.getElementById('cal-days-grid');
  const calBtnSelectToday = document.getElementById('cal-btn-select-today');
  const calBtnClose = document.getElementById('cal-btn-close');
  const btnDateQuickToday = document.getElementById('btn-date-quick-today');
  const btnDateQuickYesterday = document.getElementById('btn-date-quick-yesterday');

  // --- Elementos del Selector de Cliente con Buscador ---
  const clientPickerTrigger = document.getElementById('client-picker-trigger');
  const clientPickerSelectedCode = document.getElementById('client-picker-selected-code');
  const clientPickerSelectedName = document.getElementById('client-picker-selected-name');
  const clientPickerChevron = document.getElementById('client-picker-chevron');
  const clientPickerDropdown = document.getElementById('client-picker-dropdown');
  const clientPickerSearch = document.getElementById('client-picker-search') as HTMLInputElement | null;
  const clientPickerList = document.getElementById('client-picker-list');
  const btnInlinePickerAddClient = document.getElementById('btn-inline-picker-add-client');

  const MONTHS_ES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
  const MONTHS_SHORT_ES = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
  const DAYS_ES = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];

  let calViewYear = new Date().getFullYear();
  let calViewMonth = new Date().getMonth();

  function getLocalIsoDate(offsetDays = 0): string {
    const d = new Date();
    d.setDate(d.getDate() + offsetDays);
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return `${yyyy}-${mm}-${dd}`;
  }

  function formatIsoToHumanEs(isoStr: string): string {
    if (!isoStr) return 'Seleccionar fecha';
    const parts = isoStr.split('-').map(Number);
    if (parts.length !== 3) return isoStr;
    const [y, m, d] = parts;
    const dt = new Date(y, m - 1, d);
    const todayIso = getLocalIsoDate(0);
    const yesterdayIso = getLocalIsoDate(-1);
    const prefix = isoStr === todayIso ? 'Hoy, ' : (isoStr === yesterdayIso ? 'Ayer, ' : `${DAYS_ES[dt.getDay()]}, `);
    return `${prefix}${d} ${MONTHS_SHORT_ES[m - 1]} ${y}`;
  }

  function setNegocioDate(isoStr: string) {
    if (modalNegocioFecha) modalNegocioFecha.value = isoStr;
    if (customDateHuman) customDateHuman.textContent = formatIsoToHumanEs(isoStr);
    if (customDateIso) customDateIso.textContent = isoStr;

    const todayIso = getLocalIsoDate(0);
    const yesterdayIso = getLocalIsoDate(-1);
    btnDateQuickToday?.classList.toggle('active', isoStr === todayIso);
    btnDateQuickYesterday?.classList.toggle('active', isoStr === yesterdayIso);

    const parts = isoStr.split('-').map(Number);
    if (parts.length === 3) {
      calViewYear = parts[0];
      calViewMonth = parts[1] - 1;
    }
    renderCalendarMonth();
  }

  function renderCalendarMonth() {
    if (!calDaysGrid || !calMonthYearLabel) return;
    calMonthYearLabel.textContent = `${MONTHS_ES[calViewMonth]} ${calViewYear}`;

    const firstDayOfMonth = new Date(calViewYear, calViewMonth, 1);
    // Ajustar para que Lunes sea columna 0 (0=Lun .. 6=Dom)
    const startWeekday = (firstDayOfMonth.getDay() + 6) % 7;
    const daysInMonth = new Date(calViewYear, calViewMonth + 1, 0).getDate();
    const daysInPrevMonth = new Date(calViewYear, calViewMonth, 0).getDate();

    const selectedIso = modalNegocioFecha?.value || getLocalIsoDate(0);
    const todayIso = getLocalIsoDate(0);

    let html = '';
    // Días previos del mes anterior
    for (let i = startWeekday - 1; i >= 0; i--) {
      const dayNum = daysInPrevMonth - i;
      html += `<button type="button" class="cal-day-btn cal-outside" disabled>${dayNum}</button>`;
    }

    // Días del mes actual
    for (let d = 1; d <= daysInMonth; d++) {
      const iso = `${calViewYear}-${String(calViewMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      const isSelected = iso === selectedIso;
      const isToday = iso === todayIso;
      const classes = ['cal-day-btn'];
      if (isSelected) classes.push('cal-selected');
      else if (isToday) classes.push('cal-today');
      html += `<button type="button" class="${classes.join(' ')}" data-iso="${iso}">${d}</button>`;
    }

    calDaysGrid.innerHTML = html;
  }

  function toggleCalendarPopover(forceOpen?: boolean) {
    if (!customCalendarPopover) return;
    const isOpen = forceOpen !== undefined ? forceOpen : customCalendarPopover.style.display === 'none';
    customCalendarPopover.style.display = isOpen ? 'block' : 'none';
    if (customDateChevron) {
      customDateChevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    }
    if (isOpen) {
      toggleClientPickerDropdown(false);
      renderCalendarMonth();
    }
  }

  customDateTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleCalendarPopover();
  });

  calPrevMonthBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    calViewMonth--;
    if (calViewMonth < 0) {
      calViewMonth = 11;
      calViewYear--;
    }
    renderCalendarMonth();
  });

  calNextMonthBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    calViewMonth++;
    if (calViewMonth > 11) {
      calViewMonth = 0;
      calViewYear++;
    }
    renderCalendarMonth();
  });

  calDaysGrid?.addEventListener('click', (e: any) => {
    e.stopPropagation();
    const btn = e.target.closest('.cal-day-btn[data-iso]');
    if (btn) {
