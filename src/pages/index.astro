              <div style="display: flex; align-items: center; gap: 8px; min-width: 0;">
                <span style="font-size: 11px; font-weight: 800; font-family: ui-monospace, monospace; padding: 3px 7px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--brand-primary); border: 1px solid var(--border-main); flex-shrink: 0;">
