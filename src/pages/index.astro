            <td colspan="4" style="padding: 16px 20px;">TOTAL COMPRADO EN USDT (${comprasUsdt.length} OPERACIONES)</td>
            <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success);">+${fmtNumClient(totCompUsdt, 4)} USDT</td>
            <td colspan="2"></td>
          </tr>
        `;
      }
    }

    if (ventasUsdt.length > 0) {
      const ventasTbody = document.getElementById('ventas-table-tbody');
      if (ventasTbody) {
        ventasTbody.innerHTML = ventasUsdt.map((v: any) => {
          const nombre = v.nombre || v.idTransaccion || '';
          const usdtVend = Number(v.usdtVendido ?? v.cantidadUsdt) || 0;
          const tasaVal = Number(v.tasa ?? v.tasaVentaCop) || 0;
          const totalCopVal = Number(v.totalCop ?? v.montoNetoRecibidoCop) || 0;
          return `
            <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main);">
              <td style="padding: 16px 20px; font-weight: 700; font-family: ui-monospace, monospace; color: var(--brand-primary); font-size: 13px;">${nombre}</td>
              <td style="padding: 16px 20px; color: var(--text-secondary); font-size: 13px; font-family: ui-monospace, monospace;">${v.fecha || ''}</td>
