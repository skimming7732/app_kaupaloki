                <td style="padding: 18px 20px; text-align: right; color: var(--info); font-size: 14px;">
                  {formatDecimal(VENTAS_USDT.reduce((a, b) => a + b.usdtVendido, 0), 0)} USDT
                </td>
                <td colspan="2"></td>
                <td style="padding: 18px 20px; text-align: right; color: var(--success); font-size: 15px;">
                  {formatCop(VENTAS_USDT.reduce((a, b) => a + b.totalCop, 0))}
                </td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- ============================================================ -->
        <!-- TAB 6: ACTIVOS LIQUIDOS (TIPO TARJETAS) -->
