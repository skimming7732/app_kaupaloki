    </div>

    <!-- Pie Contable -->
    <footer style="margin-top: 32px; padding-top: 16px; border-top: 1px solid #1e293b; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; font-size: 12px; color: #64748b;">
      <div>
        Kaupaloki &bull; Sistema Contable y Cambiario &bull; Cloudflare Pages Deployment
      </div>
      <div style="font-family: ui-monospace, monospace;">
        Generado sin autenticación de usuario (Acceso de solo lectura público / interno)
      </div>
