          return `
            <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main);">
              <td style="padding: 16px 20px; font-weight: 700; font-family: ui-monospace, monospace; color: var(--brand-primary); font-size: 13px;">${code}</td>
              <td style="padding: 16px 20px; color: var(--text-secondary); font-size: 13px; font-family: ui-monospace, monospace;">${c.fecha || ''}</td>
              <td style="padding: 16px 20px; text-align: center;">
                <span style="font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: var(--bg-card-secondary); border: 1px solid var(--border-main);">${divisa}</span>
              </td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 600;">${fmtNumClient(valorComp, 2)}</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--success);">${fmtNumClient(usdtComp, 4)} USDT</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-secondary);">${fmtNumClient(costoVal, 4)}</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-secondary);">${fmtNumClient(tasaVal, 4)}</td>
            </tr>
          `;
        }).join('');
