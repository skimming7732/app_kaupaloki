<style>
  /* Sidebar styles Horizon */
  .sidebar-link {
    background: transparent;
    color: var(--text-secondary);
    position: relative;
  }
  .sidebar-link:hover {
    background: var(--bg-card-secondary);
    color: var(--text-primary);
  }
  .sidebar-link.active {
    background: var(--brand-primary-light);
    color: var(--brand-primary);
    font-weight: 700;
  }
  .sidebar-link.active::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 24px;
    background: var(--brand-primary);
    border-radius: 4px 0 0 4px;
  }

  /* Table styles */
  .horizon-row:hover {
    background: var(--bg-card-secondary);
  }

  /* Status Pills Horizon */
  .status-pill {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 9999px;
  }
  .status-success {
    background: var(--success-light);
    color: var(--success);
  }
  .status-warning {
    background: var(--warning-light);
    color: var(--warning);
  }
  .status-danger {
    background: var(--danger-light);
    color: var(--danger);
  }
  .status-info {
    background: var(--info-light);
    color: var(--info);
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin {
    animation: spin 0.8s linear infinite;
  }

  .theme-logo-light {
    display: none;
  }
  .theme-logo-dark {
    display: block;
  }
  :global(html:not(.dark)) .theme-logo-light {
    display: block !important;
  }
  :global(html:not(.dark)) .theme-logo-dark {
    display: none !important;
  }

  /* Collapsible Sidebar Horizon UI */
  #main-sidebar.collapsed {
    width: 80px !important;
  }
  #main-content.sidebar-collapsed {
    margin-left: 80px !important;
  }
  #main-sidebar.collapsed .sidebar-text,
  #main-sidebar.collapsed .count-badge,
  #main-sidebar.collapsed .sidebar-nav-title,
  #main-sidebar.collapsed .sidebar-bottom-card,
  #main-sidebar.collapsed .logo-full {
    display: none !important;
  }
  #main-sidebar.collapsed .logo-mini {
    display: flex !important;
  }
  #main-sidebar.collapsed .sidebar-logo-container {
    padding: 16px 8px !important;
    justify-content: center !important;
    flex-direction: column !important;
    gap: 12px !important;
  }
  #main-sidebar.collapsed .sidebar-link {
    justify-content: center !important;
    padding: 12px 0 !important;
    gap: 0 !important;
  }
  #main-sidebar.collapsed .sidebar-link svg {
    margin: 0 auto;
  }
  #main-sidebar.collapsed .sidebar-link.active::after {
    height: 18px;
    width: 3px;
  }

  @media (max-width: 900px) {
    #main-sidebar {
      transform: translateX(-100%);
      width: 290px !important;
    }
    #main-sidebar.mobile-open {
      transform: translateX(0);
    }
    #main-content {
      margin-left: 0 !important;
      padding: 16px !important;
    }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { supabase, SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase';
  const ENV_PAT = import.meta.env.PUBLIC_AIRTABLE_PAT || "";
  const BASE_ID = "appncUKgTkDojFj4B";
  const TABLE_CLIENTES_ID = "tblfEL6ENM3N5g89d";

  function getAirtableToken(): string {
    return localStorage.getItem('kaupaloki_airtable_pat') || ENV_PAT;
  }

  // Manejo de cambio de pestañas (Sidebar Links)
  const links = document.querySelectorAll('.sidebar-link');
  const panes = document.querySelectorAll('.tab-pane');
  const searchInput = document.getElementById('table-search') as HTMLInputElement | null;
  const btnExport = document.getElementById('btn-export-csv');
  const btnSync = document.getElementById('btn-sync-now');
  const syncIcon = document.getElementById('sync-icon');
  const syncText = document.getElementById('sync-text');
  const syncDot = document.getElementById('sync-dot');
  const breadcrumbTitle = document.getElementById('breadcrumb-title');
  const pageHeading = document.getElementById('page-heading');
  const activeTableTitle = document.getElementById('active-table-title');
  const themeToggle = document.getElementById('btn-theme-toggle');

  // ==========================================
  // SIDEBAR COLLAPSE / EXPAND LOGIC
  // ==========================================
  const sidebar = document.getElementById('main-sidebar');
  const mainContent = document.getElementById('main-content');
  const btnToggleSidebar = document.getElementById('btn-toggle-sidebar');
  const btnNavbarSidebarToggle = document.getElementById('btn-navbar-sidebar-toggle');
  const collapseChevron = document.getElementById('collapse-chevron');

  function updateSidebarState(collapsed: boolean) {
    if (collapsed) {
      sidebar?.classList.add('collapsed');
      mainContent?.classList.add('sidebar-collapsed');
      if (collapseChevron) {
        collapseChevron.innerHTML = '<polyline points="9 18 15 12 9 6"></polyline>';
      }
      btnToggleSidebar?.setAttribute('title', 'Expandir menú');
    } else {
      sidebar?.classList.remove('collapsed');
      mainContent?.classList.remove('sidebar-collapsed');
      if (collapseChevron) {
        collapseChevron.innerHTML = '<polyline points="15 18 9 12 15 6"></polyline>';
      }
      btnToggleSidebar?.setAttribute('title', 'Comprimir menú');
    }
    try {
      localStorage.setItem('kaupaloki_sidebar_collapsed', collapsed ? 'true' : 'false');
    } catch (e) {}
  }

  // Restore saved state
  if (localStorage.getItem('kaupaloki_sidebar_collapsed') === 'true') {
    updateSidebarState(true);
  }

  function handleToggleSidebar() {
    if (window.innerWidth <= 900) {
      sidebar?.classList.toggle('mobile-open');
    } else {
      const isCurrentlyCollapsed = sidebar?.classList.contains('collapsed');
      updateSidebarState(!isCurrentlyCollapsed);
    }
  }

  btnToggleSidebar?.addEventListener('click', handleToggleSidebar);
  btnNavbarSidebarToggle?.addEventListener('click', handleToggleSidebar);

  const titlesMap: Record<string, { breadcrumb: string, heading: string, table: string }> = {
    'tab-clientes': {
      breadcrumb: 'Clientes',
      heading: 'Control de Clientes & Balances',
      table: 'Tabla de Clientes'
    },
    'tab-negocios': {
      breadcrumb: 'Negocios',
      heading: 'Operaciones Cambiarias & Tasas',
      table: 'Libro Diario de Negocios'
    },
    'tab-dispersiones': {
      breadcrumb: 'Dispersiones',
      heading: 'Control de Dispersiones & Comprobantes',
      table: 'Registro de Dispersiones'
    },
    'tab-divisas': {
      breadcrumb: 'Divisas',
      heading: 'Inventario de Monedas Extranjeras',
      table: 'Balance Consolidado de Divisas'
    },
    'tab-compras': {
      breadcrumb: 'Compra USDT',
      heading: 'Adquisición de Cripto & Tasas de Cambio',
      table: 'Historial de Compras USDT'
    },
    'tab-admins': {
      breadcrumb: 'Administradores',
      heading: 'Gestores por Territorio',
      table: 'Directorio de Administradores'
    }
  };

  links.forEach(link => {
    link.addEventListener('click', () => {
      const targetId = link.getAttribute('data-target');
      if (!targetId) return;
      
      links.forEach(l => l.classList.remove('active'));
      panes.forEach(p => {
        (p as HTMLElement).style.display = 'none';
        p.classList.remove('active');
      });

      link.classList.add('active');
      const targetPane = document.getElementById(targetId);
      if (targetPane) {
        targetPane.style.display = 'block';
        targetPane.classList.add('active');
      }

      // Actualizar textos en Navbar y Header
      if (titlesMap[targetId]) {
        if (breadcrumbTitle) breadcrumbTitle.textContent = titlesMap[targetId].breadcrumb;
        if (pageHeading) pageHeading.textContent = titlesMap[targetId].heading;
        if (activeTableTitle) activeTableTitle.textContent = titlesMap[targetId].table;
      }

      // Reiniciar búsqueda
      if (searchInput) {
        searchInput.value = '';
        filtrarTabla('');
      }
    });
  });

  // Tema Claro / Oscuro
  const sunIcon = document.querySelector('.sun-icon') as HTMLElement | null;
  const moonIcon = document.querySelector('.moon-icon') as HTMLElement | null;

  function updateThemeToggleIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon && moonIcon) {
      if (isDark) {
        sunIcon.style.display = 'block';
        moonIcon.style.display = 'none';
      } else {
        sunIcon.style.display = 'none';
        moonIcon.style.display = 'block';
      }
    }
  }
  updateThemeToggleIcons();

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('kaupaloki_theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('kaupaloki_theme', 'dark');
      }
      updateThemeToggleIcons();
    });
  }

  // Filtro de búsqueda en tiempo real
  function filtrarTabla(query: string) {
    const q = query.toLowerCase().trim();
    const activePane = document.querySelector('.tab-pane.active');
    if (!activePane) return;

    const rows = activePane.querySelectorAll('tbody tr');
    rows.forEach(row => {
      const text = row.textContent?.toLowerCase() || '';
      if (text.includes(q)) {
        (row as HTMLElement).style.display = '';
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      filtrarTabla(val);
    });
  }

  // Exportar la tabla activa a CSV
  if (btnExport) {
    btnExport.addEventListener('click', () => {
      const activePane = document.querySelector('.tab-pane.active');
      if (!activePane) return;

      const table = activePane.querySelector('table');
      if (!table) return;

      const rows = Array.from(table.querySelectorAll('tr'));
      const csvContent = rows
        .filter(r => (r as HTMLElement).style.display !== 'none')
        .map(row => {
          const cells = Array.from(row.querySelectorAll('th, td'));
          return cells
            .map(cell => {
              const text = cell.textContent?.trim().replace(/"/g, '""') || '';
              return `"${text}"`;
            })
            .join(',');
        })
        .join('\n');

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const activeName = breadcrumbTitle?.textContent?.trim() || 'tabla';
      const a = document.createElement('a');
      a.href = url;
      a.download = `kaupaloki-${activeName.toLowerCase()}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  // Formateador moneda
  function formatMoney(amount: number) {
    return new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: 'COP',
      maximumFractionDigits: 0
    }).format(amount);
  }

  // Sincronización en tiempo real directa con Airtable API
  async function sincronizarAirtableEnVivo() {
    if (!btnSync || !syncIcon || !syncText || !syncDot) return;

    const token = getAirtableToken();
    if (!token) {
      syncText.textContent = 'En vivo: Clic en Sincronizar';
      return;
    }

    try {
      syncIcon.classList.add('animate-spin');
      syncText.textContent = 'Actualizando...';
      syncDot.style.background = '#38bdf8';
      syncDot.style.boxShadow = '0 0 8px #38bdf8';

      const response = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${TABLE_CLIENTES_ID}`, {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (!response.ok) {
        throw new Error(`Airtable API error: ${response.status}`);
      }

      const data = await response.json();
      const records = data.records || [];

      // Actualizar tabla CLIENTES
      const clientesTbody = document.querySelector('#tab-clientes tbody');
      if (clientesTbody && records.length > 0) {
        let totalIngresos = 0;
        let totalPagado = 0;
        let totalPendiente = 0;

        clientesTbody.innerHTML = records.map((r: any) => {
          const f = r.fields || {};
          const num = f['#'] || '';
          const codigo = f['Cliente'] || f['NOMBRE'] || r.id;
          const nombre = f['NOMBRE'] || '—';
          const ingresos = Number(f['INGRESOS'] || 0);
          const pagado = Number(f['PAGADO'] || 0);
          const pendiente = Number(f['PENDIENTE'] || (ingresos - pagado));

          totalIngresos += ingresos;
          totalPagado += pagado;
          totalPendiente += pendiente;

          const tieneSaldo = pendiente > 0;
          const saldoAFavor = pendiente < 0;
          const colorSaldo = tieneSaldo ? 'var(--warning)' : saldoAFavor ? 'var(--info)' : 'var(--text-muted)';

          let badgeHtml = '';
          if (tieneSaldo) {
            badgeHtml = `<span class="status-pill status-warning">POR COBRAR</span>`;
          } else if (saldoAFavor) {
            badgeHtml = `<span class="status-pill status-info">SALDO A FAVOR</span>`;
          } else {
            badgeHtml = `<span class="status-pill status-success">AL DÍA</span>`;
          }

          return `
            <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
              <td style="padding: 16px 20px; color: var(--text-muted); font-family: ui-monospace, monospace; font-size: 13px;">${num}</td>
              <td style="padding: 16px 20px; font-weight: 700; color: var(--brand-primary); font-family: ui-monospace, monospace; font-size: 14px;">${codigo}</td>
              <td style="padding: 16px 20px; font-weight: 600; color: var(--text-primary); font-size: 14px;">${nombre}</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-primary); font-size: 14px;">${formatMoney(ingresos)}</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success); font-weight: 600; font-size: 14px;">${formatMoney(pagado)}</td>
              <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; font-size: 14px; color: ${colorSaldo};">${formatMoney(pendiente)}</td>
              <td style="padding: 16px 20px; text-align: center;">${badgeHtml}</td>
              <td style="padding: 16px 20px; text-align: center;">
                <button 
                  class="btn-share-client" 
                  data-codigo="${codigo}" 
                  data-nombre="${nombre}"
                  data-id="${r.id}"
                  title="Compartir enlace seguro con PIN de 4 dígitos"
                  style="display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--brand-primary-light); color: var(--brand-primary); font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s;"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="18" cy="5" r="3"></circle>
                    <circle cx="6" cy="12" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                  </svg>
                  <span>Compartir</span>
                </button>
              </td>
            </tr>
          `;
        }).join('');

        // Actualizar totales tfoot
        const tfoot = document.querySelector('#tab-clientes tfoot');
        if (tfoot) {
          tfoot.innerHTML = `
            <tr style="background: var(--bg-card-secondary); font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary);">
              <td colspan="3" style="padding: 18px 20px; text-transform: uppercase; font-size: 12px; color: var(--text-muted);">TOTALES CONSOLIDADOS:</td>
              <td style="padding: 18px 20px; text-align: right; font-size: 14px;">${formatMoney(totalIngresos)}</td>
              <td style="padding: 18px 20px; text-align: right; color: var(--success); font-size: 14px;">${formatMoney(totalPagado)}</td>
              <td style="padding: 18px 20px; text-align: right; color: var(--warning); font-size: 14px;">${formatMoney(totalPendiente)}</td>
              <td></td>
              <td></td>
            </tr>
          `;
        }

        // Actualizar contador del sidebar
        const badgeClientes = document.getElementById('badge-count-clientes');
        if (badgeClientes) {
          badgeClientes.textContent = String(records.length);
        }
      }

      const hora = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      syncText.textContent = `En vivo: ${hora}`;
      syncDot.style.background = 'var(--success)';
      syncDot.style.boxShadow = '0 0 8px var(--success)';
    } catch (err) {
      console.error('Error al sincronizar con Airtable:', err);
      syncText.textContent = 'En vivo: Datos en caché';
      syncDot.style.background = 'var(--warning)';
      syncDot.style.boxShadow = '0 0 8px var(--warning)';
    } finally {
      syncIcon.classList.remove('animate-spin');
    }
  }

  // Event listener para el botón manual
  if (btnSync) {
    btnSync.addEventListener('click', () => {
      let token = getAirtableToken();
      if (!token) {
        const input = prompt("Ingresa tu Personal Access Token (PAT) de Airtable para conectar en tiempo real:");
        if (input && input.trim()) {
          localStorage.setItem('kaupaloki_airtable_pat', input.trim());
          sincronizarAirtableEnVivo();
        }
        return;
      }
      sincronizarAirtableEnVivo();
    });
  }

  // Sincronización inicial y polling cada 30 segundos
  sincronizarAirtableEnVivo();
  setInterval(sincronizarAirtableEnVivo, 30000);

  // ==============================================================
  // AUTH GUARD & RBAC SUPABASE
  // ==============================================================
  let currentUserProfile: any = null;

  async function checkAuthAndRBAC() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) {
      window.location.href = '/login';
      return;
    }

    const { data: profile } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', session.user.id)
      .single();

    if (profile && !profile.onboarding_completed) {
      window.location.href = '/onboarding';
      return;
    }

    currentUserProfile = profile || {
      id: session.user.id,
      email: session.user.email,
      full_name: session.user.email,
      role: 'operador'
    };

    // Update UI elements in Navbar
    const userNameDisplay = document.getElementById('user-name-display');
    const userRoleBadge = document.getElementById('user-role-badge');
    const userAvatarInitials = document.getElementById('user-avatar-initials');
    const btnOpenUsersModal = document.getElementById('btn-open-users-modal');

    if (userNameDisplay) userNameDisplay.textContent = currentUserProfile.full_name || currentUserProfile.email;
    if (userRoleBadge) {
      userRoleBadge.textContent = currentUserProfile.role.toUpperCase();
      if (currentUserProfile.role === 'administrador') {
        userRoleBadge.style.color = 'var(--brand-primary)';
      }
    }
    if (userAvatarInitials) {
      const name = currentUserProfile.full_name || currentUserProfile.email || 'A';
      userAvatarInitials.textContent = name.charAt(0).toUpperCase();
    }

    // Si es administrador, permitir abrir gestión de usuarios
    if (currentUserProfile.role === 'administrador') {
      const btnOpenUsers = document.getElementById('btn-open-users-modal');
      if (btnOpenUsers) btnOpenUsers.style.display = 'flex';
    }
  }

  checkAuthAndRBAC();

  // User Avatar Popover Menu Toggle
  const userAvatarBtn = document.getElementById('user-avatar-btn');
  const userDropdownMenu = document.getElementById('user-dropdown-menu');

  userAvatarBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (userDropdownMenu) {
      userDropdownMenu.style.display = userDropdownMenu.style.display === 'block' ? 'none' : 'block';
    }
  });

  document.addEventListener('click', (e: any) => {
    if (userDropdownMenu && !userDropdownMenu.contains(e.target) && !userAvatarBtn?.contains(e.target)) {
      userDropdownMenu.style.display = 'none';
    }
  });

  // Sign out listener
  const btnLogout = document.getElementById('btn-logout');
  btnLogout?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/login';
  });

  // ==============================================================
  // GESTIÓN DE USUARIOS (SOLO ADMINISTRADOR)
  // ==============================================================
  const btnOpenUsersModal = document.getElementById('btn-open-users-modal');
  const btnCloseUsersModal = document.getElementById('btn-close-users-modal');
  const modalUsersBackdrop = document.getElementById('modal-users-backdrop');
  const createUserForm = document.getElementById('create-user-form');
  const createUserStatus = document.getElementById('create-user-status');
  const usersTableBody = document.getElementById('users-table-body');

  btnOpenUsersModal?.addEventListener('click', () => {
    if (userDropdownMenu) userDropdownMenu.style.display = 'none';
    if (modalUsersBackdrop) modalUsersBackdrop.style.display = 'flex';
    loadUsersList();
  });

  btnCloseUsersModal?.addEventListener('click', () => {
    if (modalUsersBackdrop) modalUsersBackdrop.style.display = 'none';
  });

  async function loadUsersList() {
    if (!usersTableBody) return;
    const { data: users, error } = await supabase.from('profiles').select('*').order('created_at', { ascending: false });
    if (error || !users) {
      usersTableBody.innerHTML = `<tr><td colspan="4" style="padding: 16px; text-align: center; color: var(--danger);">Error cargando usuarios: ${error?.message}</td></tr>`;
      return;
    }
    usersTableBody.innerHTML = users.map((u: any) => `
      <tr style="border-bottom: 1px solid var(--border-main);">
        <td style="padding: 10px 14px; font-weight: 600; color: var(--text-primary);">${u.full_name || '—'}</td>
        <td style="padding: 10px 14px; font-family: ui-monospace, monospace; color: var(--text-secondary);">${u.email}</td>
        <td style="padding: 10px 14px;">
          <span style="font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 6px; background: ${u.role === 'administrador' ? 'var(--brand-primary-light)' : 'var(--bg-main)'}; color: ${u.role === 'administrador' ? 'var(--brand-primary)' : 'var(--text-secondary)'}; text-transform: uppercase;">
            ${u.role}
          </span>
        </td>
        <td style="padding: 10px 14px;">
          <span style="font-size: 11px; font-weight: 700; color: ${u.onboarding_completed ? 'var(--success)' : 'var(--warning)'};">
            ${u.onboarding_completed ? 'Completado' : 'Pendiente'}
          </span>
        </td>
      </tr>
    `).join('');
  }

  createUserForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!createUserStatus) return;
    const name = (document.getElementById('new-user-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('new-user-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('new-user-password') as HTMLInputElement).value;
    const role = (document.getElementById('new-user-role') as HTMLSelectElement).value;

    createUserStatus.style.color = 'var(--text-muted)';
    createUserStatus.textContent = 'Creando usuario...';

    try {
      // Cliente no persistente para no desloguear al admin
      const tempAuthClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        auth: { persistSession: false, autoRefreshToken: false }
      });
      const { data, error } = await tempAuthClient.auth.signUp({
        email,
        password,
        options: {
          data: {
            full_name: name,
            role: role,
            onboarding_completed: false
          }
        }
      });

      if (error) {
        createUserStatus.style.color = 'var(--danger)';
        createUserStatus.textContent = error.message;
        return;
      }

      createUserStatus.style.color = 'var(--success)';
      createUserStatus.textContent = '¡Usuario creado exitosamente!';
      (createUserForm as HTMLFormElement).reset();
      setTimeout(loadUsersList, 600);
    } catch (err: any) {
      createUserStatus.style.color = 'var(--danger)';
      createUserStatus.textContent = err.message || 'Error al crear usuario';
    }
  });

  // ==============================================================
  // MODAL: COMPARTIR PORTAL DE CLIENTE
  // ==============================================================
  const modalShareBackdrop = document.getElementById('modal-share-backdrop');
  const btnCloseShareModal = document.getElementById('btn-close-share-modal');
  const shareClientName = document.getElementById('share-client-name');
  const shareClientCode = document.getElementById('share-client-code');
  const sharePinInput = document.getElementById('share-pin-input') as HTMLInputElement;
  const shareLinkInput = document.getElementById('share-link-input') as HTMLInputElement;
  const btnRegenPin = document.getElementById('btn-regen-pin');
  const btnSavePin = document.getElementById('btn-save-pin');
  const pinSaveStatus = document.getElementById('pin-save-status');
  const btnCopyLink = document.getElementById('btn-copy-link');
  const btnCopyFullMsg = document.getElementById('btn-copy-full-msg');
  const copyMsgText = document.getElementById('copy-msg-text');

  let activeSharingClient: any = null;

  function generateRandomPin(): string {
    return Math.floor(1000 + Math.random() * 9000).toString();
  }

  function slugify(text: string): string {
    return text.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
  }

  async function openShareModalForClient(clientCodigo: string, clientNombre: string, clientId?: string) {
    activeSharingClient = { codigo: clientCodigo, nombre: clientNombre, id: clientId || clientCodigo };
    if (modalShareBackdrop) modalShareBackdrop.style.display = 'flex';
    if (shareClientName) shareClientName.textContent = clientNombre;
    if (shareClientCode) shareClientCode.textContent = clientCodigo;
    if (pinSaveStatus) {
      pinSaveStatus.style.color = 'var(--text-muted)';
      pinSaveStatus.textContent = 'Verificando enlace...';
    }

    const slug = `c-${slugify(clientCodigo)}`;
    const baseUrl = window.location.hostname.includes('localhost') 
      ? window.location.origin 
      : 'https://app.kaupaloki.co';
    const portalUrl = `${baseUrl}/cliente?ref=${slug}`;
    if (shareLinkInput) shareLinkInput.value = portalUrl;

    try {
      const { data: existingLink } = await supabase
        .from('client_shared_links')
        .select('*')
        .eq('slug', slug)
        .single();

      if (existingLink) {
        if (sharePinInput) sharePinInput.value = existingLink.pin;
        if (pinSaveStatus) {
          pinSaveStatus.style.color = 'var(--success)';
          pinSaveStatus.textContent = 'Enlace activo existente';
        }
      } else {
        const pin = generateRandomPin();
        if (sharePinInput) sharePinInput.value = pin;
        await supabase.from('client_shared_links').insert({
          client_id: clientCodigo,
          client_name: clientNombre,
          slug: slug,
          pin: pin,
          created_by: currentUserProfile?.id,
          is_active: true
        });
        if (pinSaveStatus) {
          pinSaveStatus.style.color = 'var(--success)';
          pinSaveStatus.textContent = 'Nuevo enlace y PIN generados con éxito';
        }
      }
    } catch (err: any) {
      const pin = generateRandomPin();
      if (sharePinInput) sharePinInput.value = pin;
      if (pinSaveStatus) {
        pinSaveStatus.style.color = 'var(--text-muted)';
        pinSaveStatus.textContent = 'PIN temporal listo';
      }
    }
  }

  // Delegación de eventos para botones de compartir
  document.addEventListener('click', (e: any) => {
    const btn = e.target.closest('.btn-share-client');
    if (btn) {
      const codigo = btn.getAttribute('data-codigo') || '';
      const nombre = btn.getAttribute('data-nombre') || '';
      const id = btn.getAttribute('data-id') || codigo;
      openShareModalForClient(codigo, nombre, id);
    }
  });

  btnCloseShareModal?.addEventListener('click', () => {
    if (modalShareBackdrop) modalShareBackdrop.style.display = 'none';
  });

  btnRegenPin?.addEventListener('click', () => {
    if (sharePinInput) sharePinInput.value = generateRandomPin();
    if (pinSaveStatus) {
      pinSaveStatus.style.color = 'var(--warning)';
      pinSaveStatus.textContent = 'Nuevo PIN asignado. Haz clic en Guardar.';
    }
  });

  btnSavePin?.addEventListener('click', async () => {
    if (!activeSharingClient || !sharePinInput) return;
    const pin = sharePinInput.value.trim();
    if (pin.length !== 4) {
      if (pinSaveStatus) {
        pinSaveStatus.style.color = 'var(--danger)';
        pinSaveStatus.textContent = 'El PIN debe ser exactamente de 4 dígitos.';
      }
      return;
    }

    const slug = `c-${slugify(activeSharingClient.codigo)}`;
    pinSaveStatus!.style.color = 'var(--text-muted)';
    pinSaveStatus!.textContent = 'Guardando en base de datos...';

    const { error } = await supabase.from('client_shared_links').upsert({
      client_id: activeSharingClient.codigo,
      client_name: activeSharingClient.nombre,
      slug: slug,
      pin: pin,
      created_by: currentUserProfile?.id,
      is_active: true
    }, { onConflict: 'slug' });

    if (error) {
      pinSaveStatus!.style.color = 'var(--danger)';
      pinSaveStatus!.textContent = `Error: ${error.message}`;
    } else {
      pinSaveStatus!.style.color = 'var(--success)';
      pinSaveStatus!.textContent = '¡PIN y enlace guardados con éxito!';
    }
  });

  btnCopyLink?.addEventListener('click', () => {
    if (shareLinkInput) {
      navigator.clipboard.writeText(shareLinkInput.value);
      btnCopyLink.innerHTML = `<polyline points="20 6 9 17 4 12"></polyline><span>¡Copiado!</span>`;
      setTimeout(() => {
        btnCopyLink.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copiar Link</span>`;
      }, 2000);
    }
  });

  btnCopyFullMsg?.addEventListener('click', () => {
    if (!activeSharingClient || !shareLinkInput || !sharePinInput) return;
    const msg = `Hola ${activeSharingClient.nombre}, aquí puedes consultar tu contabilidad y movimientos contables en tiempo real en Kaupaloki:\n\n` +
      `🔗 Enlace: ${shareLinkInput.value}\n` +
      `🔐 PIN de acceso: ${sharePinInput.value}\n\n` +
      `Acceso confidencial protegido.`;
    navigator.clipboard.writeText(msg);
    if (copyMsgText) copyMsgText.textContent = '¡Mensaje Copiado al Portapapeles!';
    setTimeout(() => {
      if (copyMsgText) copyMsgText.textContent = 'Copiar Mensaje Completo (Link + PIN)';
    }, 2500);
  });
</script>
