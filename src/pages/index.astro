  // ==============================================================
  // GESTIÓN DE ELIMINACIÓN DE USUARIOS CON REGLAS DE PERMISO
  // ==============================================================
  const modalDeleteUserConfirm = document.getElementById('modal-delete-user-confirm');
  const deleteUserConfirmMsg = document.getElementById('delete-user-confirm-msg');
  const btnCancelDeleteUser = document.getElementById('btn-cancel-delete-user');
  const btnConfirmDeleteUser = document.getElementById('btn-confirm-delete-user');

  let pendingDeleteUser: { email: string; nombre: string; role: string; airtableId?: string } | null = null;

  function openDeleteConfirmModal(user: { email: string; nombre: string; role: string; airtableId?: string }) {
    pendingDeleteUser = user;
    if (deleteUserConfirmMsg) {
      deleteUserConfirmMsg.innerHTML = `¿Estás seguro de que deseas eliminar a <strong>${user.nombre}</strong> (${user.email}) con rol <strong>${user.role.toUpperCase()}</strong>?<br/><br/><span style="color: var(--danger); font-size: 11px;">Esta acción revocará todos sus accesos al sistema.</span>`;
    }
    if (modalDeleteUserConfirm) modalDeleteUserConfirm.style.display = 'flex';
  }

  function closeDeleteConfirmModal() {
    if (modalDeleteUserConfirm) modalDeleteUserConfirm.style.display = 'none';
    pendingDeleteUser = null;
  }

  btnCancelDeleteUser?.addEventListener('click', closeDeleteConfirmModal);
  modalDeleteUserConfirm?.addEventListener('click', (e) => {
    if (e.target === modalDeleteUserConfirm) closeDeleteConfirmModal();
  });

  btnConfirmDeleteUser?.addEventListener('click', async () => {
    if (!pendingDeleteUser) return;
    const { email, airtableId } = pendingDeleteUser;

    if (btnConfirmDeleteUser) {
      btnConfirmDeleteUser.textContent = 'Eliminando...';
      btnConfirmDeleteUser.setAttribute('disabled', 'true');
    }

    try {
      // 1. Eliminar de Supabase profiles
      await supabase.from('profiles').delete().eq('email', email);

      // 2. En Airtable: Cambiar ESTADO a "INACTIVO" para preservar registros y relaciones
      const pat = getAirtableToken();
      if (pat) {
        try {
          let recId = airtableId;
          if (!recId) {
            const searchResp = await fetch(`https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb?filterByFormula=LOWER({EMAIL})='${encodeURIComponent(email)}'`, {
              headers: { 'Authorization': `Bearer ${pat}` }
            });
            if (searchResp.ok) {
              const sJson = await searchResp.json();
              if (sJson.records?.[0]) recId = sJson.records[0].id;
            }
          }
          if (recId) {
            await fetch(`https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb/${recId}`, {
              method: 'PATCH',
              headers: {
                'Authorization': `Bearer ${pat}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                fields: {
                  "ESTADO": "INACTIVO"
                }
              })
            });
          }
        } catch (airtableErr) {
          console.warn('Error inactivando usuario en Airtable:', airtableErr);
        }
      }

      closeDeleteConfirmModal();
      await loadUsersList();
    } catch (err: any) {
      alert('Error al eliminar usuario: ' + (err?.message || err));
    } finally {
      if (btnConfirmDeleteUser) {
        btnConfirmDeleteUser.textContent = 'Sí, Eliminar';
        btnConfirmDeleteUser.removeAttribute('disabled');
      }
    }
  });

  // Delegación de clic para eliminar usuario desde la tabla
  document.addEventListener('click', (e: any) => {
