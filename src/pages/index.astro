  function getAllSystemCurrencies(): string[] {
    const keys = Object.keys(AIRTABLE_CURRENCIES_META);
    return keys.length > 0
      ? keys
      : ['BRL', 'PEN', 'USD-EC', 'HNL', 'VES', 'USDT', 'USD-PY', 'USD', 'ARS', 'UYU', 'CLP', 'COP', 'MXN'];
  }
  const ALL_SYSTEM_CURRENCIES = getAllSystemCurrencies();

  function mapAirtableDivisaIdsToCodesClient(rawList: any): string[] {
    if (!Array.isArray(rawList)) return [];
    const idToCode: Record<string, string> = {};
    Object.entries(AIRTABLE_CURRENCIES_META).forEach(([code, meta]: [string, any]) => {
      if (meta?.id) idToCode[meta.id] = code;
    });
    return rawList
      .map((item: any) => {
        const val = String(item || '').trim();
        if (!val) return '';
        if (idToCode[val]) return idToCode[val];
        const up = val.toUpperCase();
        if (AIRTABLE_CURRENCIES_META[up]) return up;
        return val;
      })
      .filter((v: string) => Boolean(v) && !v.startsWith('rec'));
  }

  const SUPER_ADMIN_EMAIL = 'desarrollor@jeroallsolutions.com';

  function isSuperAdminUser(email?: string): boolean {
    return (email || '').toLowerCase().trim() === SUPER_ADMIN_EMAIL;
  }

  function computeUserAirtableCode(name: string, role: string, country: string, num: number = 1): string {
    let rolePrefix = 'OP';
    const r = (role || '').toUpperCase();
    if (r.includes('SUPER') || r === 'SUPER ADMIN') {
      rolePrefix = 'SA';
    } else if (r.includes('ADMIN') || r === 'ADMINISTRADOR') {
      rolePrefix = 'AD';
    } else if (r.includes('CLIENT') || r === 'CLIENTE') {
      rolePrefix = 'CL';
    } else {
      rolePrefix = 'OP';
    }
    const paddedNum = String(num || 1).padStart(3, '0');
    const firstWord = (name || 'USR').trim().split(/\s+/)[0].replace(/[^a-zA-Z0-9]/g, '').toUpperCase() || 'USR';
    const cleanCountry = (country || 'COL').trim().slice(0, 3).toUpperCase();
    return `U${rolePrefix}${paddedNum}-${firstWord}-${cleanCountry}`;
  }


  function updateRoleSelection(selectedRole: string) {
    const raw = (selectedRole || 'operador').toLowerCase();
    const normRole = (raw === 'client' || raw === 'cliente') ? 'cliente' : (raw === 'administrador' || raw === 'admin') ? 'administrador' : 'operador';

    if (roleInput) roleInput.value = normRole;
    if (roleBadgeIndicator) {
      roleBadgeIndicator.textContent = normRole.toUpperCase();
      if (normRole === 'administrador') {
        roleBadgeIndicator.style.background = 'rgba(67, 24, 255, 0.15)';
        roleBadgeIndicator.style.color = 'var(--brand-primary)';
      } else if (normRole === 'cliente') {
        roleBadgeIndicator.style.background = 'rgba(5, 205, 153, 0.15)';
        roleBadgeIndicator.style.color = '#05CD99';
      } else {
        roleBadgeIndicator.style.background = 'var(--brand-primary-light)';
        roleBadgeIndicator.style.color = 'var(--brand-primary)';
      }
    }

    document.querySelectorAll('.role-card-btn').forEach((card: any) => {
      const cardRole = (card.getAttribute('data-role') || '').toLowerCase();
      const cardNorm = (cardRole === 'client' || cardRole === 'cliente') ? 'cliente' : cardRole;
      const isSelected = cardNorm === normRole;
      const iconBox = card.querySelector('.role-icon-box');
      if (isSelected) {
        card.classList.add('active');
        card.style.border = '2px solid var(--brand-primary)';
        card.style.background = 'var(--brand-primary-light)';
        if (iconBox) {
          iconBox.style.background = 'var(--brand-primary)';
          iconBox.style.color = '#FFFFFF';
        }
      } else {
        card.classList.remove('active');
        card.style.border = '1.5px solid var(--border-main)';
        card.style.background = 'var(--bg-card)';
        if (iconBox) {
          iconBox.style.background = 'var(--bg-card-secondary)';
          iconBox.style.color = 'var(--text-secondary)';
        }
      }
    });

    // Para Administrador y Cliente NO se muestran las divisas (se seleccionan todas automáticamente)
    // Solo para Operador se muestran
    if (normRole === 'operador') {
      if (containerAuthorizedCurrencies) containerAuthorizedCurrencies.style.display = 'block';
