<script>
  import { createClient } from '@supabase/supabase-js';
  import { supabase, SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase';
  const ENV_PAT = import.meta.env.PUBLIC_AIRTABLE_PAT || "";
  const BASE_ID = "appncUKgTkDojFj4B";
  const AIRTABLE_BASE_ID = 'appncUKgTkDojFj4B';
  const TABLE_CLIENTES_ID = "tblfEL6ENM3N5g89d";
  const EDGE_SYNC_URL = 'https://tjuqludeduydarwzhbor.supabase.co/functions/v1/airtable-sync';
  const PAT_STORAGE_KEY = 'kaupaloki_airtable_pat';

  let currentAuthUser: any = null;
  let currentUserProfile: any = null;

  // ==============================================================
  // AUTH GUARD: Verificar sesión autenticada con Supabase
  // Si no está iniciado sesión en la plataforma, redirigir a /login
  // ==============================================================
  const { data: authSessionData } = await supabase.auth.getSession();
  const activeUser = authSessionData?.session?.user;
  if (!activeUser) {
    const currentTarget = window.location.pathname + window.location.search;
    window.location.replace(`/login?redirect=${encodeURIComponent(currentTarget)}`);
    await new Promise(() => {}); // Detener ejecución subsecuente en este módulo
  }

  // Quitar overlay de verificación una vez confirmada la sesión activa
  const authOverlay = document.getElementById('auth-cloak-overlay');
  if (authOverlay) {
    authOverlay.style.opacity = '0';
    setTimeout(() => authOverlay.remove(), 250);
  }

  // Escuchar si la sesión expira o el usuario cierra sesión
  supabase.auth.onAuthStateChange((event, session) => {
    if (event === 'SIGNED_OUT' || !session) {
      window.location.replace('/login');
    }
  });

  function getAirtableToken(): string {
    return localStorage.getItem('kaupaloki_airtable_pat') || ENV_PAT;
  }

  // Manejo de cambio de pestañas (Sidebar Links)
  const links = document.querySelectorAll('.sidebar-link');
  const panes = document.querySelectorAll('.tab-pane');
  const searchInput = document.getElementById('table-search') as HTMLInputElement | null;
  const btnExport = document.getElementById('btn-export-csv');

  function filtrarTabla(query: string) {
    const q = (query || '').toLowerCase().trim();
    const activePane = document.querySelector('.tab-pane.active');
    if (!activePane) return;
    const rows = activePane.querySelectorAll('tbody tr');
    rows.forEach((row) => {
      const text = row.textContent?.toLowerCase() || '';
      if (!q || text.includes(q)) {
        (row as HTMLElement).style.display = '';
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });
  }

  searchInput?.addEventListener('input', (e) => {
    filtrarTabla((e.target as HTMLInputElement).value);
  });
  const btnSync = document.getElementById('btn-sync-now');
  const syncIcon = document.getElementById('sync-icon');
  const syncText = document.getElementById('sync-text');
  const syncDot = document.getElementById('sync-dot');
  const breadcrumbTitle = document.getElementById('breadcrumb-title');
  const pageHeading = document.getElementById('page-heading');
  const activeTableTitle = document.getElementById('active-table-title');
  const themeToggle = document.getElementById('btn-theme-toggle');

  // ==========================================
  // THEME TOGGLE (DARK / LIGHT MODE)
  // ==========================================
  const sunIcon = themeToggle?.querySelector('.sun-icon') as HTMLElement | null;
  const moonIcon = themeToggle?.querySelector('.moon-icon') as HTMLElement | null;

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon) sunIcon.style.display = isDark ? 'block' : 'none';
    if (moonIcon) moonIcon.style.display = isDark ? 'none' : 'block';
  }

  syncThemeIcons();

  themeToggle?.addEventListener('click', (e) => {
    e.preventDefault();
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('kaupaloki_theme', isDark ? 'dark' : 'light');
    } catch (err) {}
    syncThemeIcons();
  });

  // ==========================================
  // EXPORTAR CSV DE LA TABLA ACTIVA
  // ==========================================
  btnExport?.addEventListener('click', (e) => {
    e.preventDefault();
    const activePane = document.querySelector('.tab-pane.active') as HTMLElement | null;
    const table = activePane?.querySelector('table') as HTMLTableElement | null;
    if (!table) {
      alert('No hay una tabla de datos activa para exportar en esta vista.');
      return;
    }

    const rows = Array.from(table.querySelectorAll('tr'));
    const csvContent = rows.map(r => {
      const cells = Array.from(r.querySelectorAll('th, td'));
      return cells.map(c => {
        let text = (c.textContent || '').trim().replace(/\s+/g, ' ');
        if (text.includes('"') || text.includes(',') || text.includes('\n')) {
          text = `"${text.replace(/"/g, '""')}"`;
        }
        return text;
      }).join(',');
    }).join('\n');

    const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const titleSlug = (activeTableTitle?.textContent || 'tabla').toLowerCase().replace(/[^a-z0-9]/g, '_');
    link.href = URL.createObjectURL(blob);
    link.download = `kaupaloki_${titleSlug}_${new Date().toISOString().slice(0, 10)}.csv`;
    link.click();
    URL.revokeObjectURL(link.href);
  });

  // ==========================================
  // SIDEBAR COLLAPSE / EXPAND LOGIC
  // ==========================================
  const sidebar = document.getElementById('main-sidebar');
  const mainContent = document.getElementById('main-content');
  const btnToggleSidebar = document.getElementById('btn-toggle-sidebar');
  const btnNavbarSidebarToggle = document.getElementById('btn-navbar-sidebar-toggle');
  const collapseChevron = document.getElementById('collapse-chevron');

  function updateSidebarState(collapsed: boolean) {
    if (collapsed) {
      sidebar?.classList.add('collapsed');
      mainContent?.classList.add('sidebar-collapsed');
      if (collapseChevron) {
        collapseChevron.innerHTML = '<polyline points="9 18 15 12 9 6"></polyline>';
      }
      btnToggleSidebar?.setAttribute('title', 'Expandir menú');
    } else {
      sidebar?.classList.remove('collapsed');
      mainContent?.classList.remove('sidebar-collapsed');
      if (collapseChevron) {
        collapseChevron.innerHTML = '<polyline points="15 18 9 12 15 6"></polyline>';
      }
      btnToggleSidebar?.setAttribute('title', 'Comprimir menú');
    }
    try {
      localStorage.setItem('kaupaloki_sidebar_collapsed', collapsed ? 'true' : 'false');
    } catch (e) {}
  }

  // Restore saved state
  if (localStorage.getItem('kaupaloki_sidebar_collapsed') === 'true') {
    updateSidebarState(true);
  }

  function handleToggleSidebar() {
    if (window.innerWidth <= 900) {
      sidebar?.classList.toggle('mobile-open');
    } else {
      const isCurrentlyCollapsed = sidebar?.classList.contains('collapsed');
      updateSidebarState(!isCurrentlyCollapsed);
    }
  }

  btnToggleSidebar?.addEventListener('click', handleToggleSidebar);
  btnNavbarSidebarToggle?.addEventListener('click', handleToggleSidebar);

  const titlesMap: Record<string, { breadcrumb: string, heading: string, table: string }> = {
    'tab-dashboard': {
      breadcrumb: 'Dashboard',
      heading: 'Panel Control',
      table: 'Panel Control Financiero'
    },
    'tab-clientes': {
      breadcrumb: 'Clientes',
      heading: 'Control Clientes',
      table: 'Tabla Clientes'
    },
    'tab-negocios': {
      breadcrumb: 'Negocios',
      heading: 'Operaciones Negocios',
      table: 'Tabla Negocios'
    },
    'tab-compras': {
      breadcrumb: 'Compra USDT',
      heading: 'Compra USDT',
      table: 'Tabla Compra USDT'
    },
    'tab-ventas': {
      breadcrumb: 'Venta USDT',
      heading: 'Venta USDT',
      table: 'Tabla Venta USDT'
    },
    'tab-activos': {
      breadcrumb: 'Activos Líquidos',
      heading: 'Activos Líquidos',
      table: 'Cuentas y Caja Empresa'
    },
    'tab-activos-digitales': {
      breadcrumb: 'Activos Digitales',
      heading: 'Activos Digitales',
      table: 'Wallets y Custodia USDT'
    },
    'tab-divisas': {
      breadcrumb: 'Divisas',
      heading: 'Control Divisas',
      table: 'Balance de Divisas'
    },
    'tab-usuarios': {
      breadcrumb: 'Usuarios',
      heading: 'Gestión Usuarios',
      table: 'Directorio de Usuarios'
    },
    'tab-dispersiones': {
      breadcrumb: 'Dispersiones',
      heading: 'Control Dispersiones',
      table: 'Tabla Dispersiones'
    },
    'tab-operador': {
      breadcrumb: 'Operador',
      heading: 'Panel Operador',
      table: 'Resumen Operativo'
    }
  };

  const tabToPathMap: Record<string, string> = {
    'tab-dashboard': '/',
    'tab-clientes': '/clientes',
    'tab-negocios': '/negocios',
    'tab-compras': '/compras',
    'tab-ventas': '/ventas',
    'tab-activos': '/activos',
    'tab-activos-digitales': '/activos-digitales',
    'tab-divisas': '/divisas',
    'tab-usuarios': '/usuarios',
    'tab-dispersiones': '/dispersiones',
    'tab-operador': '/operador'
  };

  const pathToTabMap: Record<string, string> = {
    '': 'tab-dashboard',
    'dashboard': 'tab-dashboard',
    'panel-control': 'tab-dashboard',
    'clientes': 'tab-clientes',
    'negocios': 'tab-negocios',
    'compras': 'tab-compras',
    'compra-usdt': 'tab-compras',
    'ventas': 'tab-ventas',
    'venta-usdt': 'tab-ventas',
    'activos': 'tab-activos',
    'activos-liquidos': 'tab-activos',
    'activos-digitales': 'tab-activos-digitales',
    'divisas': 'tab-divisas',
    'usuarios': 'tab-usuarios',
    'dispersiones': 'tab-dispersiones',
    'gestores': 'tab-usuarios',
    'operador': 'tab-operador'
  };

  const tabActionsMap: Record<string, { label: string, action: 'user' | 'client' | 'negocio' | 'dispersion' } | null> = {
    'tab-dashboard': null,
    'tab-operador': { label: '+ Agregar Negocio', action: 'negocio' },
    'tab-clientes': { label: '+ Agregar Cliente', action: 'client' },
    'tab-negocios': { label: '+ Agregar Negocio', action: 'negocio' },
    'tab-compras': null,
    'tab-ventas': null,
    'tab-activos': null,
    'tab-activos-digitales': null,
    'tab-divisas': null,
    'tab-usuarios': { label: '+ Agregar Usuario', action: 'user' },
    'tab-dispersiones': { label: '+ Nueva Dispersión', action: 'dispersion' }
  };

  const btnHeaderAction = document.getElementById('btn-header-action');
  const btnHeaderActionText = document.getElementById('btn-header-action-text');

  function updateHeaderActionButton(targetId: string) {
    if (!btnHeaderAction || !btnHeaderActionText) return;
    const actionConfig = tabActionsMap[targetId];
    if (actionConfig) {
      btnHeaderAction.style.display = 'inline-flex';
      btnHeaderActionText.textContent = actionConfig.label;
      btnHeaderAction.setAttribute('data-action', actionConfig.action);
      btnHeaderAction.setAttribute('title', actionConfig.label);
    } else {
      btnHeaderAction.style.display = 'none';
      btnHeaderAction.removeAttribute('data-action');
    }
  }

  const handleHeaderAction = (e: Event) => {
    e.preventDefault();
    const action = btnHeaderAction?.getAttribute('data-action');
    if (action === 'user') {
      openCreateUserModal();
    } else if (action === 'client') {
      openCreateClientModal();
    } else if (action === 'negocio') {
      openCreateNegocioModal();
    } else if (action === 'dispersion') {
      openCreateDispersionModal();
    }
  };
  btnHeaderAction?.addEventListener('click', handleHeaderAction);
  btnHeaderAction?.addEventListener('touchend', handleHeaderAction);

  function switchTab(targetId: string, updateUrl: boolean = true) {
    if (!targetId) return;
    
    links.forEach(l => {
      if (l.getAttribute('data-target') === targetId) {
        l.classList.add('active');
      } else {
        l.classList.remove('active');
      }
    });

    panes.forEach(p => {
      (p as HTMLElement).style.display = 'none';
      p.classList.remove('active');
    });

    const targetPane = document.getElementById(targetId);
    if (targetPane) {
      targetPane.style.display = 'block';
      targetPane.classList.add('active');
    }

    // Alternar grupo de métricas minimalistas según la pestaña activa
    document.querySelectorAll('.kpis-view-group').forEach((group: any) => {
      group.style.display = 'none';
    });
    const targetKpis = document.getElementById(`kpis-${targetId}`) || document.getElementById('kpis-tab-dashboard');
    if (targetKpis) {
      targetKpis.style.display = 'grid';
    }

    // Actualizar textos en Navbar y Header
    if (titlesMap[targetId]) {
      if (breadcrumbTitle) breadcrumbTitle.textContent = titlesMap[targetId].breadcrumb;
      if (pageHeading) pageHeading.textContent = titlesMap[targetId].heading;
      if (activeTableTitle) activeTableTitle.textContent = titlesMap[targetId].table;
    }

    // Actualizar el único botón de acción contextual de la cabecera
    updateHeaderActionButton(targetId);

    if (targetId === 'tab-usuarios') {
      loadUsersList();
    }

    // Reiniciar búsqueda
    if (searchInput) {
      searchInput.value = '';
      filtrarTabla('');
    }

    // Sincronizar URL limpia en el historial (ej. /clientes, /dispersiones)
    if (updateUrl && tabToPathMap[targetId]) {
      const newPath = tabToPathMap[targetId];
      if (window.location.pathname !== newPath) {
        window.history.pushState({ tab: targetId }, '', newPath);
      }
    }
  }

  links.forEach(link => {
    const handleLinkClick = () => {
      const targetId = link.getAttribute('data-target');
      if (targetId) {
        switchTab(targetId, true);
        if (window.innerWidth <= 900) {
          sidebar?.classList.remove('mobile-open');
        }
      }
    };
    link.addEventListener('click', handleLinkClick);
    link.addEventListener('touchend', handleLinkClick);
  });

  // Close sidebar on tap outside on mobile
  document.addEventListener('click', (e: any) => {
    if (window.innerWidth <= 900 && sidebar?.classList.contains('mobile-open')) {
      if (!sidebar.contains(e.target) && !e.target.closest('#btn-navbar-sidebar-toggle') && !e.target.closest('.mobile-only-toggle')) {
        sidebar.classList.remove('mobile-open');
      }
    }
  });

  // Escuchar popstate para navegar con botones de atras/adelante del navegador
  window.addEventListener('popstate', () => {
    const slug = window.location.pathname.replace(/^\/|\/$/g, '').toLowerCase();
    const tab = pathToTabMap[slug] || 'tab-dashboard';
    switchTab(tab, false);
  });

  // Activar tab inicial según la URL actual
  const initialSlug = window.location.pathname.replace(/^\/|\/$/g, '').toLowerCase();
  const initialTab = pathToTabMap[initialSlug] || 'tab-dashboard';
  
  // Atajos dentro de las tarjetas del panel de control
  document.querySelectorAll('.btn-switch-tab-shortcut').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = (e.currentTarget as HTMLElement).getAttribute('data-shortcut');
      if (target) {
        switchTab(target, true);
      }
    });
  });

  // (switchTab y loadUsersList se ejecutan al final del script tras cargar todas las funciones)

  // ==============================================================
  // COMPROBANTE LIGHTBOX MODAL (MISMA PESTAÑA, SIN NUEVA VENTANA)
  // ==============================================================
  // ==============================================================
  // COMPROBANTE LIGHTBOX MODAL (MULTI-COMPROBANTE + COPIAR IMAGEN)
  // ==============================================================
  const lightboxModal = document.getElementById('comprobante-lightbox-modal');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxSubtitle = document.getElementById('lightbox-subtitle');
  const lightboxCounterBadge = document.getElementById('lightbox-counter-badge');
  const lightboxDownloadBtn = document.getElementById('lightbox-download-btn') as HTMLAnchorElement | null;
  const btnCloseLightbox = document.getElementById('btn-close-lightbox');
  const btnLightboxPrev = document.getElementById('btn-lightbox-prev');
  const btnLightboxNext = document.getElementById('btn-lightbox-next');
  const lightboxStrip = document.getElementById('lightbox-thumbnails-strip');
  const btnCopyLightbox = document.getElementById('btn-copy-lightbox');
  const btnCopyLightboxText = document.getElementById('btn-copy-lightbox-text');

  let activeLightboxVouchers: Array<{ url: string; nombre?: string }> = [];
  let activeLightboxIndex = 0;
  let activeLightboxTitle = '';

  function renderLightboxVoucher() {
    if (!lightboxImage || activeLightboxVouchers.length === 0) return;
    const current = activeLightboxVouchers[activeLightboxIndex];
    lightboxImage.src = current.url;

    if (lightboxTitle) lightboxTitle.textContent = activeLightboxTitle || current.nombre || 'Comprobante de Dispersión';
    if (lightboxSubtitle) {
      lightboxSubtitle.textContent = current.nombre ? `${current.nombre} • Formato Vertical 9:16` : 'Formato Vertical 9:16';
    }

    if (lightboxDownloadBtn) {
      lightboxDownloadBtn.href = current.url;
      lightboxDownloadBtn.setAttribute('download', (current.nombre || 'comprobante').replace(/[^a-z0-9.]/gi, '_'));
    }

    if (activeLightboxVouchers.length > 1) {
      if (lightboxCounterBadge) {
        lightboxCounterBadge.style.display = 'inline-block';
        lightboxCounterBadge.textContent = `${activeLightboxIndex + 1} de ${activeLightboxVouchers.length}`;
      }
      if (btnLightboxPrev) btnLightboxPrev.style.display = 'flex';
      if (btnLightboxNext) btnLightboxNext.style.display = 'flex';

      if (lightboxStrip) {
        lightboxStrip.style.display = 'flex';
        lightboxStrip.innerHTML = activeLightboxVouchers.map((v, i) => `
          <div 
            class="lightbox-thumb-item" 
            data-index="${i}"
            style="cursor: pointer; border-radius: 6px; overflow: hidden; border: 2px solid ${i === activeLightboxIndex ? 'var(--brand-primary)' : 'transparent'}; opacity: ${i === activeLightboxIndex ? '1' : '0.55'}; width: 34px; height: 50px; flex-shrink: 0; transition: all 0.2s;"
          >
            <img src="${v.url}" alt="thumb" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
        `).join('');
      }
    } else {
      if (lightboxCounterBadge) lightboxCounterBadge.style.display = 'none';
      if (btnLightboxPrev) btnLightboxPrev.style.display = 'none';
      if (btnLightboxNext) btnLightboxNext.style.display = 'none';
      if (lightboxStrip) lightboxStrip.style.display = 'none';
    }
  }

  function openLightboxWithVouchers(vouchers: Array<{ url: string; nombre?: string }>, title: string = 'Comprobante de Dispersión') {
    if (!vouchers || vouchers.length === 0) return;
    activeLightboxVouchers = vouchers;
    activeLightboxIndex = 0;
    activeLightboxTitle = title;
    renderLightboxVoucher();
    if (lightboxModal) lightboxModal.style.display = 'flex';
  }

  function closeLightbox() {
    if (lightboxModal) {
      lightboxModal.style.display = 'none';
      if (lightboxImage) lightboxImage.src = '';
      activeLightboxVouchers = [];
      activeLightboxIndex = 0;
    }
  }

  btnCloseLightbox?.addEventListener('click', closeLightbox);
  lightboxModal?.addEventListener('click', (e) => {
    if (e.target === lightboxModal) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightboxModal && lightboxModal.style.display === 'flex') {
      closeLightbox();
    }
    if (lightboxModal && lightboxModal.style.display === 'flex' && activeLightboxVouchers.length > 1) {
      if (e.key === 'ArrowLeft') {
        activeLightboxIndex = (activeLightboxIndex - 1 + activeLightboxVouchers.length) % activeLightboxVouchers.length;
        renderLightboxVoucher();
      } else if (e.key === 'ArrowRight') {
        activeLightboxIndex = (activeLightboxIndex + 1) % activeLightboxVouchers.length;
        renderLightboxVoucher();
      }
    }
  });

  btnLightboxPrev?.addEventListener('click', () => {
    if (activeLightboxVouchers.length <= 1) return;
    activeLightboxIndex = (activeLightboxIndex - 1 + activeLightboxVouchers.length) % activeLightboxVouchers.length;
    renderLightboxVoucher();
  });

  btnLightboxNext?.addEventListener('click', () => {
    if (activeLightboxVouchers.length <= 1) return;
    activeLightboxIndex = (activeLightboxIndex + 1) % activeLightboxVouchers.length;
    renderLightboxVoucher();
