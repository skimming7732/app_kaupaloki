  function applyAirtableSnapshot(snapshot: any) {
    if (!snapshot || typeof snapshot !== 'object') return;

    const clientes = Array.isArray(snapshot.clientes) ? snapshot.clientes : [];
    const negocios = Array.isArray(snapshot.negocios) ? snapshot.negocios : [];
    const comprasUsdt = Array.isArray(snapshot.comprasUsdt) ? snapshot.comprasUsdt : [];
    const ventasUsdt = Array.isArray(snapshot.ventasUsdt) ? snapshot.ventasUsdt : [];
    const dispersiones = Array.isArray(snapshot.pagos)
      ? snapshot.pagos
      : (Array.isArray(snapshot.dispersiones) ? snapshot.dispersiones : []);
    const activosLiq = Array.isArray(snapshot.activosLiquidos) ? snapshot.activosLiquidos : [];
    const activosDig = Array.isArray(snapshot.activosDigitales) ? snapshot.activosDigitales : [];
    const divisas = Array.isArray(snapshot.divisas) ? snapshot.divisas : [];

    // 1. Actualizar arrays en memoria para los extractos bancarios y cripto
    if (activosLiq.length > 0) {
      activosData.splice(0, activosData.length, ...activosLiq);
      if (currentExtractActivo) {
        const updated = activosData.find((a: any) => a.id === currentExtractActivo.id);
        if (updated && extractView && extractView.style.display !== 'none') {
          openActivoExtract(updated.id);
        }
      }
    }
    if (activosDig.length > 0) {
      digitalData.splice(0, digitalData.length, ...activosDig);
      if (currentDigitalActivo) {
        const updated = digitalData.find((d: any) => d.id === currentDigitalActivo.id);
        if (updated && digitalExtractView && digitalExtractView.style.display !== 'none') {
          openDigitalExtract(updated.id);
        }
      }
    }

    // 2. Actualizar contadores del sidebar
    const setBadge = (id: string, count: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(count);
    };
    if (clientes.length) setBadge('badge-count-clientes', clientes.length);
    if (negocios.length) setBadge('badge-count-negocios', negocios.length);
    if (comprasUsdt.length) setBadge('badge-count-compras', comprasUsdt.length);
    if (ventasUsdt.length) setBadge('badge-count-ventas', ventasUsdt.length);
    if (dispersiones.length) setBadge('badge-count-dispersiones', dispersiones.length);
    if (activosLiq.length) setBadge('badge-count-activos', activosLiq.length);
    if (activosDig.length) setBadge('badge-count-activos-digitales', activosDig.length);
    if (divisas.length) setBadge('badge-count-divisas', divisas.length);

    // 3. Calcular métricas globales
    const totalLiquidezCop = activosLiq.reduce((acc: number, a: any) => acc + (Number(a.saldoCop) || 0), 0);
    const totalIngresosLiq = activosLiq.reduce((acc: number, a: any) => acc + (Number(a.ingresosCop) || 0), 0);
    const totalEgresosLiq = activosLiq.reduce((acc: number, a: any) => acc + (Number(a.egresosCop) || 0), 0);
    const totalUsdtCustodia = activosDig.reduce((acc: number, d: any) => acc + (Number(d.saldoUsdt) || 0), 0);
    const totalPasivoClientes = clientes.reduce((acc: number, c: any) => acc + (Number(c.pendienteCop ?? c.pendientePorPagarCop) || 0), 0);
    const totalIngresosClientes = clientes.reduce((acc: number, c: any) => acc + (Number(c.ingresosCop) || 0), 0);
    const totalPagadoClientes = clientes.reduce((acc: number, c: any) => acc + (Number(c.pagadoCop) || 0), 0);
    const totalVolumenCop = negocios.reduce((acc: number, n: any) => acc + (Number(n.ingresoCop ?? n.montoCop) || 0), 0);
    const totalComisionesCop = negocios.reduce((acc: number, n: any) => acc + (Number(n.totalRevenue) || 0), 0);

    // 4. Actualizar KPIs del Dashboard y Sección Liquidación
    const totalActivosDigitalesUsdt = snapshot.resumenLiquidacion?.totalActivosDigitalesUsdt ?? activosDig.reduce((acc: number, d: any) => acc + (Number(d.saldoUsdt) || 0), 0);
    const totalActivosLiquidosCop = snapshot.resumenLiquidacion?.totalActivosLiquidosCop ?? totalLiquidezCop;
    const totalSaldoPendienteClientesCop = snapshot.resumenLiquidacion?.totalSaldoPendienteClientesCop ?? totalPasivoClientes;

    const totalNegocioCop = snapshot.resumenLiquidacion?.totalNegocioCop ?? negocios.reduce((acc: number, n: any) => acc + (Number(n.ingresoCop ?? n.montoCop) || 0), 0);
    const totalVentasUsdtCop = snapshot.resumenLiquidacion?.totalVentasUsdtCop ?? ventasUsdt.reduce((acc: number, v: any) => acc + (Number(v.totalCop) || 0), 0);
    const totalLiquidezEsperadaCop = snapshot.resumenLiquidacion?.totalLiquidezEsperadaCop ?? activosDig.reduce((acc: number, a: any) => acc + (Number(a.liquidezEsperadaCop) || ((Number(a.rateFinal) || 3200) * (Number(a.saldoUsdt) || 0))), 0);
    const gananciaEsperadaCop = snapshot.resumenLiquidacion?.gananciaEsperadaCop ?? ((totalVentasUsdtCop + totalLiquidezEsperadaCop) - totalNegocioCop);

