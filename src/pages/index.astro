  // Submit creación/invitación de usuario
  formModalCreateUser?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nameInput = document.getElementById('modal-user-name') as HTMLInputElement;
    const emailInput = document.getElementById('modal-user-email') as HTMLInputElement;
    const currentRoleInput = document.getElementById('modal-user-role') as HTMLInputElement;
    const countrySelect = document.getElementById('modal-user-country') as HTMLSelectElement | null;

    const name = nameInput.value.trim();
    const email = emailInput.value.trim().toLowerCase();
    const role = currentRoleInput ? currentRoleInput.value : 'operador';
    const country = countrySelect ? countrySelect.value : 'COL';

    // Determinar divisas autorizadas: Si es admin o cliente, siempre todas
    let authorizedCurrencies: string[];
    if (role === 'administrador' || role === 'client') {
      authorizedCurrencies = [...ALL_SYSTEM_CURRENCIES];
    } else {
      const checkedBoxes = Array.from(document.querySelectorAll('input[name="authorized_currency"]:checked')) as HTMLInputElement[];
      authorizedCurrencies = checkedBoxes.map(cb => cb.value);
      if (authorizedCurrencies.length === 0) authorizedCurrencies = [...ALL_SYSTEM_CURRENCIES];
    }

    if (modalCreateUserStatus) {
      modalCreateUserStatus.style.color = 'var(--text-muted)';
      modalCreateUserStatus.textContent = 'Enviando invitación y creando perfil...';
    }

    try {
      // URL de producción obligatoria (nunca localhost en invitaciones por correo)
      const PRODUCTION_APP_URL = 'https://app.kaupaloki.co';
      const inviteUrl = `${PRODUCTION_APP_URL}/onboarding?email=${encodeURIComponent(email)}`;

      // Enviar enlace de invitación / OTP con Supabase
      const { error: otpError } = await supabase.auth.signInWithOtp({
        email,
        options: {
          emailRedirectTo: inviteUrl,
          data: {
            full_name: name,
            role: role,
            pais: country,
            country: country,
            authorized_currencies: authorizedCurrencies,
            onboarding_completed: false,
            app_url: PRODUCTION_APP_URL
          }
        }
      });

      // Registrar perfil en tabla profiles de Supabase
      const { error: profileError } = await supabase.from('profiles').upsert({
        id: crypto.randomUUID(),
        email: email,
        full_name: name,
        role: role,
        pais: country,
        authorized_currencies: authorizedCurrencies,
        status: 'invitado',
        onboarding_completed: false,
        is_super_admin: isSuperAdminUser(email)
      }, { onConflict: 'email' });

      // Sincronizar inmediatamente a Airtable si hay PAT configurado
      const pat = getAirtableToken();
      if (pat) {
        try {
          const divisaRelIds = authorizedCurrencies.map(c => AIRTABLE_CURRENCIES_META[c]?.id).filter(Boolean);
          // Buscar primero si existe el correo en Airtable (incluso si está INACTIVO) para reactivarlo
          const searchResp = await fetch(`https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb?filterByFormula=LOWER({EMAIL})='${encodeURIComponent(email)}'`, {
            headers: { 'Authorization': `Bearer ${pat}` }
          });
          let existingRecId: string | null = null;
          if (searchResp.ok) {
            const sJson = await searchResp.json();
            if (sJson.records && sJson.records.length > 0) {
              existingRecId = sJson.records[0].id;
            }
          }

          if (existingRecId) {
            // Reactivar usuario existente y actualizar rol y divisas relacionadas
            await fetch(`https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb/${existingRecId}`, {
              method: 'PATCH',
              headers: {
                'Authorization': `Bearer ${pat}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                fields: {
                  "NOMBRE": name.toUpperCase(),
                  "PAIS": country,
                  "ESTADO": "ACTIVO",
                  "ROL": role === 'administrador' ? 'ADMINISTRADOR' : (role === 'client' ? 'CLIENTE' : 'OPERADOR'),
                  "DIVISAS AUTORIZADAS": authorizedCurrencies,
                  "DIVISAS RELACIONADAS": divisaRelIds
                }
              })
            });
          } else {
            // Crear nuevo registro enlazando DIVISAS RELACIONADAS
            await fetch('https://api.airtable.com/v0/appncUKgTkDojFj4B/tbljfI9AsgpOsfzPb', {
              method: 'POST',
              headers: {
                'Authorization': `Bearer ${pat}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                fields: {
                  "NOMBRE": name.toUpperCase(),
                  "EMAIL": email,
                  "PAIS": country,
                  "ESTADO": "ACTIVO",
                  "ROL": role === 'administrador' ? 'ADMINISTRADOR' : (role === 'client' ? 'CLIENTE' : 'OPERADOR'),
                  "DIVISAS AUTORIZADAS": authorizedCurrencies,
                  "DIVISAS RELACIONADAS": divisaRelIds
                }
              })
            });
          }
        } catch (airtableErr) {
          console.warn('Airtable real-time user sync warning:', airtableErr);
        }
      }

      if (modalCreateUserStatus) {
        modalCreateUserStatus.style.color = 'var(--success)';
        modalCreateUserStatus.textContent = `¡Invitación creada con éxito para ${email}!`;
      }

      if (modalInvitationSuccessBox && modalInvitationLinkInput) {
        modalInvitationLinkInput.value = inviteUrl;

        const roleLabel = role === 'administrador' ? 'Administrador' : (role === 'client' ? 'Cliente' : 'Operador');
        const waMsg = `👋 Hola ${name},\n\nTe damos la bienvenida a *Kaupaloki*.\nHas sido registrado en la plataforma con el rol de *${roleLabel}*.\n\n👉 Para ingresar y configurar tu contraseña de acceso, haz clic aquí:\n${inviteUrl}\n\n¡Bienvenido al equipo!`;
        const waBtn = document.getElementById('btn-share-invite-whatsapp') as HTMLAnchorElement | null;
        if (waBtn) {
          waBtn.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(waMsg)}`;
        }

        const mailBtn = document.getElementById('btn-share-invite-mail') as HTMLAnchorElement | null;
        if (mailBtn) {
          const mailSubject = `Invitación a Kaupaloki - Acceso a la Plataforma (${name})`;
          const mailBody = `Hola ${name},\n\nTe damos la bienvenida a la plataforma de Kaupaloki.\nHas sido invitado con el rol de ${roleLabel}.\n\nPara activar tu cuenta y configurar tu contraseña de acceso, por favor ingresa al siguiente enlace seguro:\n${inviteUrl}\n\nSi tienes cualquier duda, contacta al administrador de la plataforma.\n\nAtentamente,\nEquipo Kaupaloki\nhttps://app.kaupaloki.co`;
          mailBtn.href = `mailto:${email}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
        }

        modalInvitationSuccessBox.style.display = 'flex';
      }

      loadUsersList();
    } catch (err: any) {
      if (modalCreateUserStatus) {
        modalCreateUserStatus.style.color = 'var(--danger)';
        modalCreateUserStatus.textContent = err.message || 'Error al invitar usuario';
      }
    }
  });

  // ==============================================================
  // GESTIÓN DE PERFIL DEL USUARIO ACTUAL (HEADER & DROPDOWN)
  // ==============================================================
  let currentAuthUser: any = null;
  let currentUserProfile: any = null;

  const userAvatarBtn = document.getElementById('user-avatar-btn');
  const userAvatarInitials = document.getElementById('user-avatar-initials');
  const userDropdownMenu = document.getElementById('user-dropdown-menu');
  const userNameDisplay = document.getElementById('user-name-display');
  const userEmailDisplay = document.getElementById('user-email-display');
  const userRoleBadge = document.getElementById('user-role-badge');
  const btnOpenEditProfile = document.getElementById('btn-open-edit-profile-modal');
  const btnMenuGotoUsuarios = document.getElementById('btn-menu-goto-usuarios');
  const btnLogout = document.getElementById('btn-logout');

  const modalEditProfileBackdrop = document.getElementById('modal-edit-profile-backdrop');
  const btnCloseEditProfileModal = document.getElementById('btn-close-edit-profile-modal');
  const btnCancelEditProfile = document.getElementById('btn-cancel-edit-profile');
  const formEditProfile = document.getElementById('form-edit-profile') as HTMLFormElement | null;
  const editProfileName = document.getElementById('edit-profile-name') as HTMLInputElement | null;
  const editProfilePassword = document.getElementById('edit-profile-password') as HTMLInputElement | null;
  const editProfilePasswordConfirm = document.getElementById('edit-profile-password-confirm') as HTMLInputElement | null;
  const editProfileStatus = document.getElementById('edit-profile-status');
  const editProfileAvatarLetter = document.getElementById('edit-profile-avatar-letter');
  const editProfileEmailSubtitle = document.getElementById('edit-profile-email-subtitle');

  async function initCurrentUser() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user) {
        currentAuthUser = session.user;
        const { data: profile } = await supabase
          .from('profiles')
          .select('*')
          .eq('email', session.user.email)
          .single();

        if (profile) {
          currentUserProfile = {
            ...profile,
            is_super_admin: isSuperAdminUser(profile.email)
          };
        } else {
          currentUserProfile = {
            id: session.user.id,
            email: session.user.email,
            full_name: session.user.user_metadata?.full_name || session.user.email?.split('@')[0],
            role: session.user.user_metadata?.role || (isSuperAdminUser(session.user.email) ? 'administrador' : 'operador'),
            is_super_admin: isSuperAdminUser(session.user.email)
          };
        }
      } else {
        // Fallback admin activo por defecto en sesión local (Franz Rueda es Administrador, no Super Admin)
        currentUserProfile = {
          id: 'admin-franz',
          email: 'franzruedab@gmail.com',
          full_name: 'Franz Rueda',
          role: 'administrador',
          is_super_admin: false
        };
      }
    } catch (e) {
      currentUserProfile = {
        id: 'admin-franz',
        email: 'franzruedab@gmail.com',
        full_name: 'Franz Rueda',
        role: 'administrador',
        is_super_admin: false
      };
    }

    // Regla estricta: Únicamente desarrollor@jeroallsolutions.com es Super Admin
    currentUserProfile.is_super_admin = isSuperAdminUser(currentUserProfile.email);

    updateHeaderProfileUI();
    loadUsersList();
  }

  function updateHeaderProfileUI() {
    if (!currentUserProfile) return;
    const name = currentUserProfile.full_name || currentUserProfile.email || 'Admin';
    const initial = name.charAt(0).toUpperCase();

    if (userAvatarInitials) userAvatarInitials.textContent = initial;
    if (userNameDisplay) userNameDisplay.textContent = name;
    if (userEmailDisplay) userEmailDisplay.textContent = currentUserProfile.email || '';

    if (userRoleBadge) {
      if (isSuperAdminUser(currentUserProfile.email) || currentUserProfile.is_super_admin) {
        userRoleBadge.textContent = '⭐ SUPER ADMIN';
        userRoleBadge.style.background = 'linear-gradient(135deg, #FFB547 0%, #FF8500 100%)';
        userRoleBadge.style.color = '#FFFFFF';
        userRoleBadge.style.border = 'none';
      } else if (currentUserProfile.role === 'administrador') {
        userRoleBadge.textContent = 'ADMINISTRADOR';
        userRoleBadge.style.background = 'var(--brand-primary-light)';
        userRoleBadge.style.color = 'var(--brand-primary)';
      } else if (currentUserProfile.role === 'client') {
