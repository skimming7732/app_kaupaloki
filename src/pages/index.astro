  function renderLightboxVoucher() {
    if (!lightboxImage || activeLightboxVouchers.length === 0) return;
    const current = activeLightboxVouchers[activeLightboxIndex];
    lightboxImage.src = current.url;

    if (lightboxTitle) lightboxTitle.textContent = activeLightboxTitle || current.nombre || 'Comprobante de Dispersión';
