---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Redireccionando...">
  <script is:inline>
    (function() {
      var path = window.location.pathname || '';
      var search = window.location.search || '';
      
      // Manejo inteligente de rutas dinámicas de cliente (/cliente/:slug)
      if (path.indexOf('/cliente/') === 0) {
        var cleanPath = path.replace(/^\/cliente\/?/, '').replace(/\/$/, '');
        var slug = cleanPath.split('/')[0] || '';
        
        if (slug) {
          var params = new URLSearchParams(search);
          if (!params.has('ref')) {
            params.set('ref', slug);
          }
          window.location.replace('/cliente/?' + params.toString());
          return;
        }
      }
      
      // Si no es cliente, redirigir a dashboard
      window.location.replace('/');
    })();
  </script>

  <div style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--bg-main); color: var(--text-primary); font-family: system-ui, sans-serif; text-align: center; padding: 20px;">
    <div style="width: 44px; height: 44px; border-radius: 50%; border: 3px solid var(--border-main); border-top-color: var(--brand-primary); animation: spin 0.8s linear infinite; margin-bottom: 16px;"></div>
    <h2 style="font-size: 18px; font-weight: 700; margin: 0 0 8px 0;">Cargando Portal...</h2>
    <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">Redirigiendo a tu información contable en tiempo real.</p>
  </div>
</Layout>

<style>
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>
