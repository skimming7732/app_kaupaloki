---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Configuración de Perfil - Kaupaloki">
  <div class="auth-container" style="min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px;">
    
    <!-- Onboarding Card -->
    <div class="auth-card" style="width: 100%; max-width: 500px; background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 40px; box-shadow: var(--shadow-card);">
      
      <!-- Brand Logo -->
      <div style="text-align: center; margin-bottom: 28px;">
        <img src="/logo.png" alt="Kaupaloki" class="theme-logo-dark" style="max-height: 40px; margin: 0 auto; object-fit: contain;" />
        <img src="/logo-blue.png" alt="Kaupaloki" class="theme-logo-light" style="max-height: 40px; margin: 0 auto; object-fit: contain;" />
        <h2 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin: 18px 0 6px 0;">
          Bienvenido a Kaupaloki
        </h2>
        <p style="font-size: 13px; color: var(--text-secondary); margin: 0; line-height: 1.5;">
          Completa tu perfil para ingresar al panel de control de operaciones.
        </p>
      </div>

      <!-- Alert Box -->
      <div id="alert-box" style="display: none; padding: 12px 16px; border-radius: 12px; font-size: 13px; font-weight: 600; margin-bottom: 20px; align-items: center; gap: 10px;">
        <svg id="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></svg>
        <span id="alert-text"></span>
      </div>

      <!-- Form -->
      <form id="onboarding-form" style="display: flex; flex-direction: column; gap: 18px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Correo de la Cuenta
          </label>
          <input type="email" id="email-display" readonly style="width: 100%; padding: 13px 16px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-muted); font-size: 14px; font-weight: 500; outline: none; cursor: not-allowed;" />
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Nombre Completo
          </label>
          <div style="position: relative;">
            <input type="text" id="name-input" required placeholder="Ej. Juan Pérez" style="width: 100%; padding: 13px 16px 13px 42px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.2s;" />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 14px; color: var(--text-muted);">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Rol Asignado
          </label>
          <input type="text" id="role-display" readonly style="width: 100%; padding: 13px 16px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-secondary); font-size: 14px; font-weight: 700; text-transform: uppercase; outline: none; cursor: not-allowed;" />
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Crea tu Contraseña *
          </label>
          <div style="position: relative;">
            <input 
              type="password" 
              id="password-input" 
              required 
              minlength="6" 
              placeholder="Mínimo 6 caracteres" 
              style="width: 100%; padding: 13px 16px 13px 42px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.2s; box-sizing: border-box;" 
            />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 14px; color: var(--text-muted);">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Confirmar Contraseña *
          </label>
          <div style="position: relative;">
            <input 
              type="password" 
              id="password-confirm" 
              required 
              minlength="6" 
              placeholder="Repite tu contraseña" 
              style="width: 100%; padding: 13px 16px 13px 42px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.2s; box-sizing: border-box;" 
            />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 14px; color: var(--text-muted);">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>

        <button type="submit" id="btn-submit" style="margin-top: 10px; width: 100%; padding: 14px; border-radius: 12px; border: none; background: var(--brand-primary); color: #FFFFFF; font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0px 8px 16px rgba(67, 24, 255, 0.25); transition: opacity 0.2s;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Activar Cuenta y Entrar</span>
        </button>
      </form>

    </div>
  </div>

  <style>
    .theme-logo-light {
      display: none;
    }
    .theme-logo-dark {
      display: block;
    }
    :global(html:not(.dark)) .theme-logo-light {
      display: block !important;
    }
    :global(html:not(.dark)) .theme-logo-dark {
      display: none !important;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase';

    let currentUserId = '';
    let userEmail = '';
    let userRole = 'operador';

    const emailDisplay = document.getElementById('email-display') as HTMLInputElement;
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const roleDisplay = document.getElementById('role-display') as HTMLInputElement;
    const passwordInput = document.getElementById('password-input') as HTMLInputElement;
    const passwordConfirm = document.getElementById('password-confirm') as HTMLInputElement;
    const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;
    const form = document.getElementById('onboarding-form');

    const alertBox = document.getElementById('alert-box');
    const alertText = document.getElementById('alert-text');
    const alertIcon = document.getElementById('alert-icon');

    function showAlert(message: string, type: 'error' | 'success') {
      if (!alertBox || !alertText || !alertIcon) return;
      alertBox.style.display = 'flex';
      alertText.textContent = message;
      if (type === 'error') {
        alertBox.style.background = 'var(--danger-light)';
        alertBox.style.color = 'var(--danger)';
        alertBox.style.border = '1px solid var(--danger)';
        alertIcon.innerHTML = '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>';
      } else {
        alertBox.style.background = 'var(--success-light)';
        alertBox.style.color = 'var(--success)';
        alertBox.style.border = '1px solid var(--success)';
        alertIcon.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
      }
    }

    async function loadUserProfile() {
      // 1. Obtener email y token_hash de los parámetros de URL si viene por invitación o magic link
      const urlParams = new URLSearchParams(window.location.search);
      const emailParam = urlParams.get('email');
      const tokenHash = urlParams.get('token_hash') || urlParams.get('token');
      const otpType = (urlParams.get('type') as any) || 'magiclink';

      if (tokenHash) {
        try {
          await supabase.auth.verifyOtp({
            token_hash: tokenHash,
            type: otpType
          });
        } catch (_) {}
      }

      // 2. Comprobar sesión de Supabase Auth
      const { data: { session } } = await supabase.auth.getSession();
      
      if (session?.user) {
        currentUserId = session.user.id;
        userEmail = (session.user.email || emailParam || '').toLowerCase().trim();
      } else if (emailParam) {
        userEmail = emailParam.toLowerCase().trim();
      }

      if (emailDisplay && userEmail) {
        emailDisplay.value = userEmail;
      }

      // 3. Consultar perfil en Supabase primero por Email y luego por ID
      let profile: any = null;
      if (userEmail) {
        const { data } = await supabase.from('profiles').select('*').eq('email', userEmail).maybeSingle();
        profile = data;
      }
      if (!profile && currentUserId) {
        const { data } = await supabase.from('profiles').select('*').eq('id', currentUserId).maybeSingle();
        profile = data;
      }
      if (!userEmail && !currentUserId) {
        window.location.href = '/login';
        return;
      }

      if (profile) {
        if (!currentUserId && profile.id) currentUserId = profile.id;
        userRole = profile.role || 'operador';
        if (nameInput && !nameInput.value) nameInput.value = profile.full_name || '';
        if (roleDisplay) roleDisplay.value = (userRole === 'client' ? 'Cliente' : userRole).toUpperCase();
        if (profile.onboarding_completed) {
          showAlert('Tu perfil ya está configurado. Redirigiendo...', 'success');
          setTimeout(() => { window.location.href = '/'; }, 1000);
        }
      } else {
        if (roleDisplay) roleDisplay.value = 'OPERADOR';
      }
    }

    // Escuchar cambios de estado auth (tokens en URL hash)
    supabase.auth.onAuthStateChange(async (event, session) => {
      if (session?.user) {
        currentUserId = session.user.id;
        userEmail = session.user.email || userEmail;
        if (emailDisplay) emailDisplay.value = userEmail;
      }
    });

    loadUserProfile();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fullName = nameInput.value.trim();
      const pwd = passwordInput.value;
      const pwdConf = passwordConfirm.value;

      if (!fullName) {
        showAlert('Por favor ingresa tu nombre completo', 'error');
        return;
      }

      if (!pwd || pwd.length < 6) {
        showAlert('La contraseña debe tener al menos 6 caracteres', 'error');
        return;
      }

      if (pwd !== pwdConf) {
        showAlert('Las contraseñas no coinciden', 'error');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.6';

      try {
        // Establecer o actualizar contraseña
        const { data: { session } } = await supabase.auth.getSession();
        
        if (session?.user) {
          const { error: pwdErr } = await supabase.auth.updateUser({
            password: pwd,
            data: {
              full_name: fullName,
              role: userRole,
              onboarding_completed: true
            }
          });
          if (pwdErr) {
            showAlert('Error al crear contraseña: ' + pwdErr.message, 'error');
            return;
          }
        } else if (userEmail) {
          // Si llegó por enlace directo sin sesión iniciada aún, registramos / actualizamos credenciales
          const { error: signErr } = await supabase.auth.signUp({
            email: userEmail,
            password: pwd,
            options: {
              data: {
                full_name: fullName,
                role: userRole,
                onboarding_completed: true
              }
            }
          });
          if (signErr && !signErr.message.includes('already registered')) {
            showAlert('Error de autenticación: ' + signErr.message, 'error');
            return;
          }
        }

        // Actualizar tabla profiles
        const updatePayload: any = {
          full_name: fullName,
          status: 'activo',
          onboarding_completed: true,
          updated_at: new Date().toISOString()
        };

        if (currentUserId) {
          await supabase.from('profiles').update(updatePayload).eq('id', currentUserId);
        } else if (userEmail) {
          await supabase.from('profiles').update(updatePayload).eq('email', userEmail);
        }

        showAlert('¡Cuenta activada y contraseña configurada con éxito! Redirigiendo...', 'success');
        setTimeout(() => {
          window.location.href = '/';
        }, 1200);
      } catch (err: any) {
        showAlert(err.message || 'Error al completar configuración', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });
  </script>
</Layout>
