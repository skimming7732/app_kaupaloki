---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Configuración de Perfil - Kaupaloki">
  <div class="auth-container" style="min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px;">
    
    <!-- Onboarding Card -->
    <div class="auth-card" style="width: 100%; max-width: 500px; background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 40px; box-shadow: var(--shadow-card);">
      
      <!-- Brand Logo -->
      <div style="text-align: center; margin-bottom: 28px;">
        <img src="/logo.png" alt="Kaupaloki" class="theme-logo-dark" style="max-height: 40px; margin: 0 auto; object-fit: contain;" />
        <img src="/logo-blue.png" alt="Kaupaloki" class="theme-logo-light" style="max-height: 40px; margin: 0 auto; object-fit: contain;" />
        <h2 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin: 18px 0 6px 0;">
          Bienvenido a Kaupaloki
        </h2>
        <p style="font-size: 13px; color: var(--text-secondary); margin: 0; line-height: 1.5;">
          Completa tu perfil para ingresar al panel de control de operaciones.
        </p>
      </div>

      <!-- Alert Box -->
      <div id="alert-box" style="display: none; padding: 12px 16px; border-radius: 12px; font-size: 13px; font-weight: 600; margin-bottom: 20px; align-items: center; gap: 10px;">
        <svg id="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></svg>
        <span id="alert-text"></span>
      </div>

      <!-- Form -->
      <form id="onboarding-form" style="display: flex; flex-direction: column; gap: 18px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Correo de la Cuenta
          </label>
          <input type="email" id="email-display" readonly style="width: 100%; padding: 13px 16px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-muted); font-size: 14px; font-weight: 500; outline: none; cursor: not-allowed;" />
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Nombre Completo
          </label>
          <div style="position: relative;">
            <input type="text" id="name-input" required placeholder="Ej. Juan Pérez" style="width: 100%; padding: 13px 16px 13px 42px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.2s;" />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 14px; color: var(--text-muted);">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
            Rol Asignado
          </label>
          <input type="text" id="role-display" readonly style="width: 100%; padding: 13px 16px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-secondary); font-size: 14px; font-weight: 700; text-transform: uppercase; outline: none; cursor: not-allowed;" />
        </div>

        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em;">
              Crea tu Contraseña *
            </label>
            <span id="pwd-strength-badge" style="font-size: 11px; font-weight: 800; padding: 3px 10px; border-radius: 999px; background: var(--bg-card-secondary); color: var(--text-muted); transition: all 0.2s;">
              Sin evaluar
            </span>
          </div>
          <div style="position: relative;">
            <input 
              type="password" 
              id="password-input" 
              required 
              minlength="8" 
              placeholder="Mínimo 8 caracteres recomendados" 
              autocomplete="new-password"
              style="width: 100%; padding: 13px 44px 13px 42px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.2s, box-shadow 0.2s; box-sizing: border-box;" 
            />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 14px; color: var(--text-muted); pointer-events: none;">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <button type="button" id="toggle-pwd-1" aria-label="Mostrar u ocultar contraseña" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: var(--text-muted); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>

          <!-- Medidor visual de 4 niveles + Checklist de sugerencias -->
          <div id="pwd-Feedback-panel" style="margin-top: 10px; padding: 12px 14px; border-radius: 12px; background: var(--bg-card-secondary); border: 1px solid var(--border-main);">
            <!-- Barras de fortaleza -->
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 10px;">
              <div id="pwd-bar-1" style="height: 5px; border-radius: 999px; background: var(--border-main); transition: background 0.25s;"></div>
              <div id="pwd-bar-2" style="height: 5px; border-radius: 999px; background: var(--border-main); transition: background 0.25s;"></div>
              <div id="pwd-bar-3" style="height: 5px; border-radius: 999px; background: var(--border-main); transition: background 0.25s;"></div>
              <div id="pwd-bar-4" style="height: 5px; border-radius: 999px; background: var(--border-main); transition: background 0.25s;"></div>
            </div>

            <div id="pwd-suggestion-text" style="font-size: 11.5px; font-weight: 700; color: var(--text-secondary); margin-bottom: 8px; line-height: 1.4;">
              Sugerencia: combina letras mayúsculas, minúsculas, números y símbolos.
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; font-size: 11.5px; font-weight: 600;">
              <div id="req-length" class="pwd-req-item" style="display: flex; align-items: center; gap: 6px; color: var(--text-muted); transition: color 0.2s;">
                <span class="req-dot" style="width: 15px; height: 15px; border-radius: 50%; border: 1.5px solid currentColor; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0;">•</span>
                <span>Mín. 8 caracteres</span>
              </div>
              <div id="req-cases" class="pwd-req-item" style="display: flex; align-items: center; gap: 6px; color: var(--text-muted); transition: color 0.2s;">
                <span class="req-dot" style="width: 15px; height: 15px; border-radius: 50%; border: 1.5px solid currentColor; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0;">•</span>
                <span>Mayúscula y minúscula</span>
              </div>
              <div id="req-number" class="pwd-req-item" style="display: flex; align-items: center; gap: 6px; color: var(--text-muted); transition: color 0.2s;">
                <span class="req-dot" style="width: 15px; height: 15px; border-radius: 50%; border: 1.5px solid currentColor; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0;">•</span>
                <span>Al menos 1 número (0-9)</span>
              </div>
              <div id="req-symbol" class="pwd-req-item" style="display: flex; align-items: center; gap: 6px; color: var(--text-muted); transition: color 0.2s;">
                <span class="req-dot" style="width: 15px; height: 15px; border-radius: 50%; border: 1.5px solid currentColor; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0;">•</span>
                <span>Símbolo (@, #, $, !, *)</span>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em;">
              Confirmar Contraseña *
            </label>
            <span id="pwd-match-hint" style="font-size: 11px; font-weight: 700; color: var(--text-muted);"></span>
          </div>
          <div style="position: relative;">
            <input 
              type="password" 
              id="password-confirm" 
              required 
              minlength="6" 
              placeholder="Repite tu contraseña" 
              autocomplete="new-password"
              style="width: 100%; padding: 13px 44px 13px 42px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.2s, box-shadow 0.2s; box-sizing: border-box;" 
            />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 14px; color: var(--text-muted); pointer-events: none;">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <button type="button" id="toggle-pwd-2" aria-label="Mostrar u ocultar confirmación" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: var(--text-muted); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" id="btn-submit" style="margin-top: 10px; width: 100%; padding: 14px; border-radius: 12px; border: none; background: var(--brand-primary); color: #FFFFFF; font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0px 8px 16px rgba(67, 24, 255, 0.25); transition: opacity 0.2s;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Activar Cuenta y Entrar</span>
        </button>
      </form>

    </div>
  </div>

  <style>
    .theme-logo-light {
      display: none;
    }
    .theme-logo-dark {
      display: block;
    }
    :global(html:not(.dark)) .theme-logo-light {
      display: block !important;
    }
    :global(html:not(.dark)) .theme-logo-dark {
      display: none !important;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase';

    let currentUserId = '';
    let userEmail = '';
    let userRole = 'operador';

    const emailDisplay = document.getElementById('email-display') as HTMLInputElement;
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const roleDisplay = document.getElementById('role-display') as HTMLInputElement;
    const passwordInput = document.getElementById('password-input') as HTMLInputElement;
    const passwordConfirm = document.getElementById('password-confirm') as HTMLInputElement;
    const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;
    const form = document.getElementById('onboarding-form');

    const strengthBadge = document.getElementById('pwd-strength-badge');
    const suggestionText = document.getElementById('pwd-suggestion-text');
    const matchHint = document.getElementById('pwd-match-hint');
    const bars = [
      document.getElementById('pwd-bar-1'),
      document.getElementById('pwd-bar-2'),
      document.getElementById('pwd-bar-3'),
      document.getElementById('pwd-bar-4'),
    ];
    const reqLength = document.getElementById('req-length');
    const reqCases = document.getElementById('req-cases');
    const reqNumber = document.getElementById('req-number');
    const reqSymbol = document.getElementById('req-symbol');

    function setReqState(el: HTMLElement | null, met: boolean) {
      if (!el) return;
      const dot = el.querySelector('.req-dot') as HTMLElement | null;
      if (met) {
        el.style.color = '#05CD99';
        if (dot) {
          dot.textContent = '✓';
          dot.style.background = 'rgba(5, 205, 153, 0.14)';
          dot.style.borderColor = '#05CD99';
          dot.style.fontWeight = '900';
        }
      } else {
        el.style.color = 'var(--text-muted)';
        if (dot) {
          dot.textContent = '•';
          dot.style.background = 'transparent';
          dot.style.borderColor = 'currentColor';
          dot.style.fontWeight = '600';
        }
      }
    }

    function evaluatePasswordStrength() {
      const val = passwordInput?.value || '';
      const conf = passwordConfirm?.value || '';

      const hasLen8 = val.length >= 8;
      const hasCases = /[a-z]/.test(val) && /[A-Z]/.test(val);
      const hasNum = /[0-9]/.test(val);
      const hasSym = /[^A-Za-z0-9]/.test(val);

      setReqState(reqLength, hasLen8);
      setReqState(reqCases, hasCases);
      setReqState(reqNumber, hasNum);
      setReqState(reqSymbol, hasSym);

      const score = [hasLen8, hasCases, hasNum, hasSym].filter(Boolean).length;

      const palette: Record<number, { color: string; bg: string; label: string }> = {
        0: { color: 'var(--text-muted)', bg: 'var(--bg-card-secondary)', label: 'Sin evaluar' },
        1: { color: '#EE5D50', bg: 'rgba(238, 93, 80, 0.14)', label: 'Contraseña Débil' },
        2: { color: '#FFB547', bg: 'rgba(255, 181, 71, 0.16)', label: 'Seguridad Media' },
        3: { color: '#3B82F6', bg: 'rgba(59, 130, 246, 0.15)', label: 'Contraseña Segura' },
        4: { color: '#05CD99', bg: 'rgba(5, 205, 153, 0.15)', label: '¡Muy Segura!' },
      };

      const activeState = val.length === 0 ? palette[0] : palette[Math.max(1, score)];

      bars.forEach((bar, idx) => {
        if (!bar) return;
        if (val.length > 0 && idx < Math.max(1, score)) {
          bar.style.background = activeState.color;
        } else {
          bar.style.background = 'var(--border-main)';
        }
      });

      if (strengthBadge) {
        strengthBadge.textContent = activeState.label;
        strengthBadge.style.color = activeState.color;
        strengthBadge.style.background = activeState.bg;
      }

      if (suggestionText) {
        if (val.length === 0) {
          suggestionText.textContent = 'Sugerencia: combina letras mayúsculas, minúsculas, números y símbolos.';
          suggestionText.style.color = 'var(--text-secondary)';
        } else if (!hasLen8) {
          suggestionText.textContent = `Sugerencia: te faltan ${8 - val.length} caracteres más para alcanzar los 8 recomendados.`;
          suggestionText.style.color = '#FFB547';
        } else if (!hasCases) {
          suggestionText.textContent = 'Sugerencia: incluye al menos una letra MAYÚSCULA y una minúscula.';
          suggestionText.style.color = '#FFB547';
        } else if (!hasNum) {
          suggestionText.textContent = 'Sugerencia: agrega al menos un número (0-9) para reforzar tu clave.';
          suggestionText.style.color = '#3B82F6';
        } else if (!hasSym) {
          suggestionText.textContent = 'Sugerencia: agrega un carácter especial (@, #, $, !, *, .) para nivel máximo.';
          suggestionText.style.color = '#3B82F6';
        } else {
          suggestionText.textContent = 'Excelente: tu contraseña cumple todos los estándares de seguridad de Kaupaloki.';
          suggestionText.style.color = '#05CD99';
        }
      }

      if (matchHint) {
        if (!conf) {
          matchHint.textContent = '';
          if (passwordConfirm) passwordConfirm.style.borderColor = 'var(--border-main)';
        } else if (val === conf) {
          matchHint.textContent = '✓ Las contraseñas coinciden';
          matchHint.style.color = '#05CD99';
          if (passwordConfirm) passwordConfirm.style.borderColor = '#05CD99';
        } else {
          matchHint.textContent = '✕ No coinciden todavía';
          matchHint.style.color = '#EE5D50';
          if (passwordConfirm) passwordConfirm.style.borderColor = '#EE5D50';
        }
      }

      return { score, hasLen8, hasCases, hasNum, hasSym };
    }

    passwordInput?.addEventListener('input', evaluatePasswordStrength);
    passwordConfirm?.addEventListener('input', evaluatePasswordStrength);

    function bindPasswordToggle(btnId: string, inputEl: HTMLInputElement | null) {
      const btn = document.getElementById(btnId);
      btn?.addEventListener('click', () => {
        if (!inputEl) return;
        const isPwd = inputEl.type === 'password';
        inputEl.type = isPwd ? 'text' : 'password';
        btn.style.color = isPwd ? 'var(--brand-primary)' : 'var(--text-muted)';
      });
    }
    bindPasswordToggle('toggle-pwd-1', passwordInput);
    bindPasswordToggle('toggle-pwd-2', passwordConfirm);

    const alertBox = document.getElementById('alert-box');
    const alertText = document.getElementById('alert-text');
    const alertIcon = document.getElementById('alert-icon');

    function showAlert(message: string, type: 'error' | 'success') {
      if (!alertBox || !alertText || !alertIcon) return;
      alertBox.style.display = 'flex';
      alertText.textContent = message;
      if (type === 'error') {
        alertBox.style.background = 'var(--danger-light)';
        alertBox.style.color = 'var(--danger)';
        alertBox.style.border = '1px solid var(--danger)';
        alertIcon.innerHTML = '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>';
      } else {
        alertBox.style.background = 'var(--success-light)';
        alertBox.style.color = 'var(--success)';
        alertBox.style.border = '1px solid var(--success)';
        alertIcon.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
      }
    }

    async function loadUserProfile() {
      // 1. Obtener email y token_hash de los parámetros de URL si viene por invitación o magic link
      const urlParams = new URLSearchParams(window.location.search);
      const emailParam = urlParams.get('email');
      const tokenHash = urlParams.get('token_hash') || urlParams.get('token');
      const otpType = (urlParams.get('type') as any) || 'magiclink';

      if (tokenHash) {
        try {
          await supabase.auth.verifyOtp({
            token_hash: tokenHash,
            type: otpType
          });
        } catch (_) {}
      }

      // 2. Comprobar sesión de Supabase Auth
      const { data: { session } } = await supabase.auth.getSession();
      
      if (session?.user) {
        currentUserId = session.user.id;
        userEmail = (session.user.email || emailParam || '').toLowerCase().trim();
      } else if (emailParam) {
        userEmail = emailParam.toLowerCase().trim();
      }

      if (emailDisplay && userEmail) {
        emailDisplay.value = userEmail;
      }

      // 3. Consultar perfil en Supabase primero por Email y luego por ID
      let profile: any = null;
      if (userEmail) {
        const { data } = await supabase.from('profiles').select('*').eq('email', userEmail).maybeSingle();
        profile = data;
      }
      if (!profile && currentUserId) {
        const { data } = await supabase.from('profiles').select('*').eq('id', currentUserId).maybeSingle();
        profile = data;
      }
      if (!userEmail && !currentUserId) {
        window.location.href = '/login';
        return;
      }

      if (profile) {
        if (!currentUserId && profile.id) currentUserId = profile.id;
        userRole = profile.role || 'operador';
        if (nameInput && !nameInput.value) nameInput.value = profile.full_name || '';
        if (roleDisplay) roleDisplay.value = (userRole === 'client' ? 'Cliente' : userRole).toUpperCase();
        if (profile.onboarding_completed) {
          showAlert('Tu perfil ya está configurado. Redirigiendo...', 'success');
          setTimeout(() => { window.location.href = '/'; }, 1000);
        }
      } else {
        if (roleDisplay) roleDisplay.value = 'OPERADOR';
      }
    }

    // Escuchar cambios de estado auth (tokens en URL hash)
    supabase.auth.onAuthStateChange(async (event, session) => {
      if (session?.user) {
        currentUserId = session.user.id;
        userEmail = session.user.email || userEmail;
        if (emailDisplay) emailDisplay.value = userEmail;
      }
    });

    loadUserProfile();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fullName = nameInput.value.trim();
      const pwd = passwordInput.value;
      const pwdConf = passwordConfirm.value;

      if (!fullName) {
        showAlert('Por favor ingresa tu nombre completo', 'error');
        return;
      }

      if (!pwd || pwd.length < 8) {
        showAlert('La contraseña debe tener al menos 8 caracteres para ser segura', 'error');
        return;
      }

      const { score } = evaluatePasswordStrength();
      if (score < 3) {
        showAlert('Por seguridad, tu contraseña debe cumplir al menos 3 de las 4 recomendaciones indicadas abajo', 'error');
        return;
      }

      if (pwd !== pwdConf) {
        showAlert('Las contraseñas no coinciden', 'error');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.6';

      try {
        // 1. Activar usuario y establecer contraseña directamente vía Edge Function (service_role con email_confirm: true)
        // Así no se dispara ningún correo de confirmación a localhost:3000 y la cuenta queda lista al instante
        if (userEmail) {
          const edgeRes = await fetch('https://tjuqludeduydarwzhbor.supabase.co/functions/v1/airtable-sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'complete_onboarding',
              email: userEmail,
              fullName,
              password: pwd,
              role: userRole
            })
          });
          const edgeData = await edgeRes.json().catch(() => ({}));
          if (!edgeRes.ok || edgeData?.ok === false) {
            showAlert('Error al configurar contraseña: ' + (edgeData?.error || 'Intenta nuevamente'), 'error');
            return;
          }

          // Iniciar sesión inmediatamente con la nueva contraseña
          await supabase.auth.signInWithPassword({
            email: userEmail,
            password: pwd
          });
        } else {
          const { data: { session } } = await supabase.auth.getSession();
          if (session?.user) {
            const { error: pwdErr } = await supabase.auth.updateUser({
              password: pwd,
              data: {
                full_name: fullName,
                role: userRole,
                onboarding_completed: true
              }
            });
            if (pwdErr) {
              showAlert('Error al crear contraseña: ' + pwdErr.message, 'error');
              return;
            }
          }
        }

        // 2. Actualizar tabla profiles como respaldo
        const updatePayload: any = {
          full_name: fullName,
          status: 'activo',
          onboarding_completed: true,
          updated_at: new Date().toISOString()
        };

        if (currentUserId) {
          await supabase.from('profiles').update(updatePayload).eq('id', currentUserId);
        } else if (userEmail) {
          await supabase.from('profiles').update(updatePayload).eq('email', userEmail);
        }

        showAlert('¡Contraseña guardada! Ahora configuremos tu autenticación 2FA obligatoria...', 'success');
        setTimeout(() => {
          window.location.href = '/2fa?mode=setup';
        }, 1200);
      } catch (err: any) {
        showAlert(err.message || 'Error al completar configuración', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });
  </script>
</Layout>
