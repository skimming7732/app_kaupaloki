---
import Layout from '../../layouts/Layout.astro';
import { CLIENTES, NEGOCIOS, PAGOS } from '../../data/airtableData';
---

<Layout title="Portal de Cliente - Kaupaloki">
  <div style="min-height: 100vh; display: flex; flex-direction: column;">
    
    <!-- Top Bar -->
    <header style="background: var(--bg-card); border-bottom: 1px solid var(--border-main); padding: 16px 28px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 30; box-shadow: var(--shadow-nav);">
      <div style="display: flex; align-items: center; gap: 16px;">
        <img src="/logo.png" alt="Kaupaloki" class="theme-logo-dark" style="max-height: 34px; object-fit: contain;" />
        <img src="/logo-blue.png" alt="Kaupaloki" class="theme-logo-light" style="max-height: 34px; object-fit: contain;" />
        <div style="height: 20px; width: 1px; background: var(--border-main);"></div>
        <span style="font-size: 13px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em;">
          Portal Contable Privado
        </span>
      </div>

      <!-- Right controls: Theme Switch -->
      <div style="display: flex; align-items: center; gap: 12px;">
        <button id="theme-toggle-btn" title="Cambiar tema" style="width: 38px; height: 38px; border-radius: 10px; background: var(--bg-card-secondary); border: 1px solid var(--border-main); color: var(--text-primary); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">
          <svg id="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg id="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- MAIN BODY -->
    <main style="flex: 1; padding: 28px; max-width: 1400px; width: 100%; margin: 0 auto;">
      
      <!-- STEP 1: PIN CHALLENGE SCREEN (Default visible until PIN is verified) -->
      <div id="pin-challenge-container" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; text-align: center;">
        <div style="width: 100%; max-width: 440px; background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 36px; box-shadow: var(--shadow-card);">
          
          <div style="width: 56px; height: 56px; border-radius: 18px; background: var(--brand-primary-light); color: var(--brand-primary); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>

          <h1 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin: 0 0 8px 0;">
            Portal Contable
          </h1>
          <p id="portal-client-subtitle" style="font-size: 13px; color: var(--text-secondary); margin: 0 0 24px 0; line-height: 1.5;">
            Ingresa el PIN de seguridad de 4 dígitos para consultar tus movimientos contables.
          </p>

          <form id="pin-form" style="display: flex; flex-direction: column; gap: 16px;">
            <div style="display: flex; justify-content: center; gap: 10px; margin-bottom: 8px;">
              <input type="password" inputmode="numeric" maxlength="1" class="pin-digit" id="pin-1" required style="width: 52px; height: 60px; text-align: center; font-size: 24px; font-weight: 800; border-radius: 14px; border: 2px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); outline: none;" />
              <input type="password" inputmode="numeric" maxlength="1" class="pin-digit" id="pin-2" required style="width: 52px; height: 60px; text-align: center; font-size: 24px; font-weight: 800; border-radius: 14px; border: 2px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); outline: none;" />
              <input type="password" inputmode="numeric" maxlength="1" class="pin-digit" id="pin-3" required style="width: 52px; height: 60px; text-align: center; font-size: 24px; font-weight: 800; border-radius: 14px; border: 2px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); outline: none;" />
              <input type="password" inputmode="numeric" maxlength="1" class="pin-digit" id="pin-4" required style="width: 52px; height: 60px; text-align: center; font-size: 24px; font-weight: 800; border-radius: 14px; border: 2px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); outline: none;" />
            </div>

            <!-- PIN Error Alert -->
            <div id="pin-error" style="display: none; padding: 10px 14px; border-radius: 10px; background: var(--danger-light); color: var(--danger); font-size: 13px; font-weight: 600; text-align: center;">
              PIN incorrecto o enlace inactivo.
            </div>

            <button type="submit" id="btn-verify-pin" style="padding: 14px; border-radius: 12px; border: none; background: var(--brand-primary); color: #FFFFFF; font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0px 8px 16px rgba(67, 24, 255, 0.25); transition: opacity 0.2s;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Ver Mis Operaciones</span>
            </button>
          </form>

          <p style="font-size: 11px; color: var(--text-muted); margin-top: 24px; font-weight: 500;">
            Si no tienes tu PIN de 4 dígitos, contacta a tu operador de cuenta.
          </p>
        </div>
      </div>

      <!-- STEP 2: DASHBOARD VIEW (Shown when PIN is verified) -->
      <div id="portal-dashboard" style="display: none; flex-direction: column; gap: 24px;">
        
        <!-- Header Client Profile Info -->
        <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 20px; padding: 24px 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; box-shadow: var(--shadow-card);">
          <div style="display: flex; align-items: center; gap: 18px;">
            <div style="width: 54px; height: 54px; border-radius: 16px; background: var(--brand-primary-light); color: var(--brand-primary); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800;">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <div>
              <div style="display: flex; align-items: center; gap: 10px;">
                <h2 id="client-name-title" style="font-size: 22px; font-weight: 800; color: var(--text-primary); margin: 0;">
                  CLIENTE
                </h2>
                <span id="client-code-badge" style="font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 8px; background: var(--brand-primary-light); color: var(--brand-primary);" class="font-mono">
                  COD
                </span>
                <span style="display: flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 8px; background: var(--success-light); color: var(--success);">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Verificado</span>
                </span>
              </div>
              <p style="font-size: 13px; color: var(--text-secondary); margin: 4px 0 0 0;">
                Extracto contable y movimientos en tiempo real
              </p>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 12px;">
            <button id="btn-lock-portal" style="padding: 10px 18px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-secondary); font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Bloquear / Salir</span>
            </button>
          </div>
        </div>

        <!-- KPIS CARDS (4 CARDS: COMPACT EXACT TO HORIZON UI DESIGN) -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px;">
          
          <!-- KPI 1: NUMERO DE NEGOCIOS -->
          <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 18px; padding: 14px 16px; box-shadow: var(--shadow-card); display: flex; align-items: center; gap: 12px; min-height: 74px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--brand-primary-light); color: var(--brand-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <div style="overflow: hidden;">
              <div style="font-size: 11px; font-weight: 500; color: var(--text-muted); margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
                Número de Negocios
              </div>
              <div id="kpi-num-negocios" style="font-size: 19px; font-weight: 800; color: var(--text-primary); line-height: 1.2;" class="font-mono">
                0
              </div>
            </div>
          </div>

          <!-- KPI 2: TOTAL INGRESOS COP -->
          <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 18px; padding: 14px 16px; box-shadow: var(--shadow-card); display: flex; align-items: center; gap: 12px; min-height: 74px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--info-light); color: var(--info); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <div style="overflow: hidden;">
              <div style="font-size: 11px; font-weight: 500; color: var(--text-muted); margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
                Total Ingresos COP
              </div>
              <div id="kpi-total-ingreso-cop" style="font-size: 18px; font-weight: 800; color: var(--text-primary); line-height: 1.2; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;" class="font-mono">
                $0
              </div>
            </div>
          </div>

          <!-- KPI 3: TOTAL DISPERSADO COP -->
          <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 18px; padding: 14px 16px; box-shadow: var(--shadow-card); display: flex; align-items: center; gap: 12px; min-height: 74px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--success-light); color: var(--success); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <div style="overflow: hidden;">
              <div style="font-size: 11px; font-weight: 500; color: var(--text-muted); margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
                Total Dispersado COP
              </div>
              <div id="kpi-total-dispersado-cop" style="font-size: 18px; font-weight: 800; color: var(--success); line-height: 1.2; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;" class="font-mono">
                $0
              </div>
            </div>
          </div>

          <!-- KPI 4: TOTAL PENDIENTE COP -->
          <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 18px; padding: 14px 16px; box-shadow: var(--shadow-card); display: flex; align-items: center; gap: 12px; min-height: 74px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--warning-light); color: var(--warning); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <div style="overflow: hidden;">
              <div style="font-size: 11px; font-weight: 500; color: var(--text-muted); margin-bottom: 2px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
                Total Pendiente COP
              </div>
              <div id="kpi-total-pendiente-cop" style="font-size: 18px; font-weight: 800; color: var(--warning); line-height: 1.2; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;" class="font-mono">
                $0
              </div>
            </div>
          </div>

        </div>

        <!-- FILTROS (FECHA Y DIVISA) -->
        <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 18px; padding: 18px 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;">
          <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: var(--text-primary);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-primary);">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <span>Filtros de Búsqueda</span>
          </div>

          <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px;">
            <!-- Filtro Fecha Desde -->
            <div style="display: flex; align-items: center; gap: 8px;">
              <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary);">Desde:</label>
              <input type="date" id="filter-date-from" style="padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 12px; outline: none;" />
            </div>

            <!-- Filtro Fecha Hasta -->
            <div style="display: flex; align-items: center; gap: 8px;">
              <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary);">Hasta:</label>
              <input type="date" id="filter-date-to" style="padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 12px; outline: none;" />
            </div>

            <!-- Filtro Divisa -->
            <div style="display: flex; align-items: center; gap: 8px;">
              <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary);">Divisa:</label>
              <select id="filter-currency" style="padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 12px; font-weight: 600; outline: none;">
                <option value="ALL">Todas las divisas</option>
              </select>
            </div>

            <!-- Reset btn -->
            <button id="btn-reset-filters" style="padding: 8px 14px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-secondary); font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="1 4 1 10 7 10"></polyline>
                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
              </svg>
              <span>Limpiar</span>
            </button>
          </div>
        </div>

        <!-- CONTABLE TABLE WITH SUB-TABS (NEGOCIOS Y DISPERSIONES) -->
        <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-card);">
          
          <!-- Subtabs Header -->
          <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-main); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <!-- Subtabs pill switch -->
              <div style="display: flex; align-items: center; gap: 4px; background: var(--bg-card-secondary); padding: 4px; border-radius: 12px; border: 1px solid var(--border-main);">
                <button 
                  id="subtab-btn-negocios" 
                  class="client-subtab-btn active"
                  style="display: flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 9px; border: none; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s; background: var(--brand-primary); color: #fff;"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                  </svg>
                  <span>Negocios</span>
                  <span id="badge-count-subtab-negocios" style="font-size: 11px; padding: 2px 7px; border-radius: 9999px; background: rgba(255,255,255,0.25); color: #fff;">0</span>
                </button>

                <button 
                  id="subtab-btn-dispersiones" 
                  class="client-subtab-btn"
                  style="display: flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 9px; border: none; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; background: transparent; color: var(--text-secondary);"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                    <line x1="1" y1="10" x2="23" y2="10"></line>
                  </svg>
                  <span>Dispersiones</span>
                  <span id="badge-count-subtab-dispersiones" style="font-size: 11px; padding: 2px 7px; border-radius: 9999px; background: var(--bg-card); color: var(--text-secondary);">0</span>
                </button>
              </div>

              <span id="filtered-records-count" style="font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 9999px; background: var(--bg-card-secondary); color: var(--text-muted); border: 1px solid var(--border-main);">
                0 registros
              </span>
            </div>
          </div>

          <!-- SUB-VIEW 1: NEGOCIOS -->
          <div id="subtab-content-negocios" class="subtab-content" style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
              <thead>
                <tr style="border-bottom: 1px solid var(--border-main); background: var(--bg-card-secondary);">
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px;">Negocio</th>
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px;">Fecha de Registro</th>
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px;">Divisa</th>
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px; text-align: right;">Monto</th>
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px; text-align: right;">Tasa</th>
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px; text-align: right;">Ingreso COP</th>
                </tr>
              </thead>
              <tbody id="operations-table-body">
                <!-- Rows injected dynamically via JS -->
              </tbody>
              <tfoot id="operations-table-foot">
                <!-- Totales consolidados -->
              </tfoot>
            </table>
          </div>

          <!-- SUB-VIEW 2: DISPERSIONES -->
          <div id="subtab-content-dispersiones" class="subtab-content" style="display: none; overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
              <thead>
                <tr style="border-bottom: 1px solid var(--border-main); background: var(--bg-card-secondary);">
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px;">Código (Dispersión)</th>
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px;">Fecha Creación</th>
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px;">Referencia</th>
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px; text-align: right;">Monto</th>
                  <th style="padding: 14px 20px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px; text-align: center;">Estado</th>
                </tr>
              </thead>
              <tbody id="dispersiones-table-body">
                <!-- Dispersiones injected dynamically via JS -->
              </tbody>
              <tfoot id="dispersiones-table-foot">
                <!-- Totales consolidados -->
              </tfoot>
            </table>
          </div>

        </div>

      </div>

    </main>

    <!-- Footer -->
    <footer style="padding: 20px 28px; text-align: center; border-top: 1px solid var(--border-main); font-size: 12px; color: var(--text-muted); background: var(--bg-card);">
      Kaupaloki © {new Date().getFullYear()} — Plataforma Contable y Cambiaria. Acceso confidencial.
    </footer>

  </div>

  <style>
    .pin-digit:focus {
      border-color: var(--brand-primary) !important;
      box-shadow: 0 0 0 3px var(--brand-primary-light);
    }
    .theme-logo-light {
      display: none;
    }
    .theme-logo-dark {
      display: block;
    }
    :global(html:not(.dark)) .theme-logo-light {
      display: block !important;
    }
    :global(html:not(.dark)) .theme-logo-dark {
      display: none !important;
    }
  </style>

  <script define:vars={{ initialClientes: CLIENTES, initialNegocios: NEGOCIOS, initialPagos: PAGOS }}>
    window.INITIAL_CLIENTES = initialClientes;
    window.INITIAL_NEGOCIOS = initialNegocios;
    window.INITIAL_PAGOS = initialPagos;
  </script>

  <script>
    import { supabase } from '../../lib/supabase';

    // Theme Toggle
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function updateThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (sunIcon && moonIcon) {
        if (isDark) {
          sunIcon.style.display = 'block';
          moonIcon.style.display = 'none';
        } else {
          sunIcon.style.display = 'none';
          moonIcon.style.display = 'block';
        }
      }
    }
    updateThemeIcons();

    themeBtn?.addEventListener('click', () => {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('kaupaloki_theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('kaupaloki_theme', 'dark');
      }
      updateThemeIcons();
    });

    // Elements
    const pinInputs = [
      document.getElementById('pin-1') as HTMLInputElement,
      document.getElementById('pin-2') as HTMLInputElement,
      document.getElementById('pin-3') as HTMLInputElement,
      document.getElementById('pin-4') as HTMLInputElement
    ];
    const pinForm = document.getElementById('pin-form');
    const pinError = document.getElementById('pin-error');
    const pinChallengeContainer = document.getElementById('pin-challenge-container');
    const portalDashboard = document.getElementById('portal-dashboard');

    // Dashboard info elements
    const clientNameTitle = document.getElementById('client-name-title');
    const clientCodeBadge = document.getElementById('client-code-badge');
    const kpiNumNegocios = document.getElementById('kpi-num-negocios');
    const kpiTotalIngresoCop = document.getElementById('kpi-total-ingreso-cop');
    const kpiTotalDispersadoCop = document.getElementById('kpi-total-dispersado-cop');
    const kpiTotalPendienteCop = document.getElementById('kpi-total-pendiente-cop');
    const operationsTableBody = document.getElementById('operations-table-body');
    const operationsTableFoot = document.getElementById('operations-table-foot');
    const dispersionesTableBody = document.getElementById('dispersiones-table-body');
    const dispersionesTableFoot = document.getElementById('dispersiones-table-foot');
    const filteredRecordsCount = document.getElementById('filtered-records-count');

    // Subtabs elements
    const subtabBtnNegocios = document.getElementById('subtab-btn-negocios');
    const subtabBtnDispersiones = document.getElementById('subtab-btn-dispersiones');
    const subtabContentNegocios = document.getElementById('subtab-content-negocios');
    const subtabContentDispersiones = document.getElementById('subtab-content-dispersiones');
    const badgeCountSubtabNegocios = document.getElementById('badge-count-subtab-negocios');
    const badgeCountSubtabDispersiones = document.getElementById('badge-count-subtab-dispersiones');

    // Filter elements
    const filterDateFrom = document.getElementById('filter-date-from') as HTMLInputElement;
    const filterDateTo = document.getElementById('filter-date-to') as HTMLInputElement;
    const filterCurrency = document.getElementById('filter-currency') as HTMLSelectElement;
    const btnResetFilters = document.getElementById('btn-reset-filters');
    const btnLockPortal = document.getElementById('btn-lock-portal');

    // PIN auto advance
    pinInputs.forEach((input, index) => {
      if (!input) return;
      input.addEventListener('input', (e: any) => {
        if (e.target.value.length === 1 && index < 3) {
          pinInputs[index + 1]?.focus();
        }
      });
      input.addEventListener('keydown', (e: any) => {
        if (e.key === 'Backspace' && !e.target.value && index > 0) {
          pinInputs[index - 1]?.focus();
        }
      });
    });

    // Read slug from URL query params or path (supports /cliente/[id] and /cliente/?ref=...)
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const pathSlug = pathParts[0] === 'cliente' && pathParts[1] ? pathParts[1] : '';
    const urlParams = new URLSearchParams(window.location.search);
    const slug = urlParams.get('ref') || urlParams.get('id') || urlParams.get('link') || pathSlug || '';

    let currentClient: any = null;
    let clientNegocios: any[] = [];
    let clientDispersiones: any[] = [];
    let activeSubtab: 'negocios' | 'dispersiones' = 'negocios';

    // Helper formatters
    function formatCop(amount: number): string {
      return new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: 'COP',
        maximumFractionDigits: 0
      }).format(amount);
    }

    function formatNumber(amount: number, digits = 2): string {
      return new Intl.NumberFormat('es-CO', {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits
      }).format(amount);
    }

    // Subtab switcher
    function setSubtab(tab: 'negocios' | 'dispersiones') {
      activeSubtab = tab;
      if (tab === 'negocios') {
        subtabBtnNegocios?.style.setProperty('background', 'var(--brand-primary)');
        subtabBtnNegocios?.style.setProperty('color', '#fff');
        subtabBtnDispersiones?.style.setProperty('background', 'transparent');
        subtabBtnDispersiones?.style.setProperty('color', 'var(--text-secondary)');
        if (subtabContentNegocios) subtabContentNegocios.style.display = 'block';
        if (subtabContentDispersiones) subtabContentDispersiones.style.display = 'none';
        if (filteredRecordsCount) filteredRecordsCount.textContent = `${clientNegocios.length} operaciones`;
      } else {
        subtabBtnDispersiones?.style.setProperty('background', 'var(--brand-primary)');
        subtabBtnDispersiones?.style.setProperty('color', '#fff');
        subtabBtnNegocios?.style.setProperty('background', 'transparent');
        subtabBtnNegocios?.style.setProperty('color', 'var(--text-secondary)');
        if (subtabContentDispersiones) subtabContentDispersiones.style.display = 'block';
        if (subtabContentNegocios) subtabContentNegocios.style.display = 'none';
        if (filteredRecordsCount) filteredRecordsCount.textContent = `${clientDispersiones.length} dispersiones`;
      }
    }

    subtabBtnNegocios?.addEventListener('click', () => setSubtab('negocios'));
    subtabBtnDispersiones?.addEventListener('click', () => setSubtab('dispersiones'));

    // Lock portal
    btnLockPortal?.addEventListener('click', () => {
      sessionStorage.removeItem(`kaupaloki_portal_${slug}`);
      if (portalDashboard) portalDashboard.style.display = 'none';
      if (pinChallengeContainer) pinChallengeContainer.style.display = 'flex';
      pinInputs.forEach(i => i && (i.value = ''));
      pinInputs[0]?.focus();
    });

    // Handle PIN Verification
    pinForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (pinError) pinError.style.display = 'none';

      const enteredPin = pinInputs.map(i => i?.value || '').join('');
      if (enteredPin.length !== 4) {
        if (pinError) {
          pinError.textContent = 'Por favor ingresa los 4 dígitos del PIN.';
          pinError.style.display = 'block';
        }
        return;
      }

      if (!slug) {
        if (pinError) {
          pinError.textContent = 'Enlace de cliente inválido o ausente.';
          pinError.style.display = 'block';
        }
        return;
      }

      try {
        // Query Supabase client_shared_links
        const { data: linkRecord, error } = await supabase
          .from('client_shared_links')
          .select('*')
          .eq('slug', slug)
          .eq('is_active', true)
          .single();

        if (error || !linkRecord) {
          if (pinError) {
            pinError.textContent = 'Este enlace no existe o ha sido desactivado.';
            pinError.style.display = 'block';
          }
          return;
        }

        if (linkRecord.pin !== enteredPin) {
          if (pinError) {
            pinError.textContent = 'PIN de seguridad incorrecto.';
            pinError.style.display = 'block';
          }
          return;
        }

        // Save session
        sessionStorage.setItem(`kaupaloki_portal_${slug}`, enteredPin);

        // Unlocked!
        loadClientPortalData(linkRecord);

      } catch (err: any) {
        if (pinError) {
          pinError.textContent = err.message || 'Error verificando PIN';
          pinError.style.display = 'block';
        }
      }
    });

    function loadClientPortalData(linkRecord: any) {
      if (pinChallengeContainer) pinChallengeContainer.style.display = 'none';
      if (portalDashboard) portalDashboard.style.display = 'flex';

      const clientes: any[] = (window as any).INITIAL_CLIENTES || [];
      const negocios: any[] = (window as any).INITIAL_NEGOCIOS || [];
      const pagos: any[] = (window as any).INITIAL_PAGOS || [];

      // Find client by client_id or code or name
      currentClient = clientes.find(c => 
        c.codigo === linkRecord.client_id || 
        c.id === linkRecord.client_id || 
        c.nombre === linkRecord.client_name ||
        c.codigo.toLowerCase().includes(linkRecord.client_name.toLowerCase())
      ) || {
        codigo: linkRecord.client_id,
        nombre: linkRecord.client_name
      };

      if (clientNameTitle) clientNameTitle.textContent = currentClient.nombre || linkRecord.client_name;
      if (clientCodeBadge) clientCodeBadge.textContent = currentClient.codigo || linkRecord.client_id;

      // Filter all businesses for this client
      clientNegocios = negocios.filter(n => 
        n.clienteCodigo === currentClient.codigo || 
        n.clienteNombre === currentClient.nombre ||
        n.clienteCodigo === linkRecord.client_id
      );

      // Filter all dispersiones for this client
      clientDispersiones = pagos.filter(p => 
        p.clienteCodigo === currentClient.codigo || 
        p.clienteNombre === currentClient.nombre ||
        p.clienteCodigo === linkRecord.client_id ||
        (currentClient.nombre && p.clienteNombre && p.clienteNombre.toLowerCase() === currentClient.nombre.toLowerCase())
      );

      // Update Subtabs Badges
      if (badgeCountSubtabNegocios) badgeCountSubtabNegocios.textContent = clientNegocios.length.toString();
      if (badgeCountSubtabDispersiones) badgeCountSubtabDispersiones.textContent = clientDispersiones.length.toString();

      // Populate currency filter options
      const currencies = Array.from(new Set(clientNegocios.map(n => n.divisaCodigo).filter(Boolean)));
      if (filterCurrency) {
        filterCurrency.innerHTML = '<option value="ALL">Todas las divisas</option>';
        currencies.forEach(curr => {
          const opt = document.createElement('option');
          opt.value = curr;
          opt.textContent = curr;
          filterCurrency.appendChild(opt);
        });
      }

      applyFiltersAndRender();
      renderDispersiones();
    }

    function applyFiltersAndRender() {
      const fromDate = filterDateFrom?.value || '';
      const toDate = filterDateTo?.value || '';
      const selectedCurrency = filterCurrency?.value || 'ALL';

      let filtered = [...clientNegocios];

      if (fromDate) {
        filtered = filtered.filter(n => n.fechaRegistro >= fromDate);
      }
      if (toDate) {
        filtered = filtered.filter(n => n.fechaRegistro <= toDate);
      }
      if (selectedCurrency !== 'ALL') {
        filtered = filtered.filter(n => n.divisaCodigo === selectedCurrency);
      }

      // Compute 4 KPIs (Negocios, Ingresos, Dispersado, Pendiente) - Stay identical for both subtabs
      const numNegocios = filtered.length;
      const totalIngresoCop = (currentClient && currentClient.ingresosCop !== undefined) 
        ? currentClient.ingresosCop 
        : filtered.reduce((acc, n) => acc + (Number(n.ingresoCop) || 0), 0);
      const totalDispersadoCop = (currentClient && currentClient.pagadoCop !== undefined)
        ? currentClient.pagadoCop
        : 0;
      const totalPendienteCop = (currentClient && currentClient.pendienteCop !== undefined)
        ? currentClient.pendienteCop
        : (totalIngresoCop - totalDispersadoCop);

      if (kpiNumNegocios) kpiNumNegocios.textContent = numNegocios.toString();
      if (kpiTotalIngresoCop) kpiTotalIngresoCop.textContent = formatCop(totalIngresoCop);
      if (kpiTotalDispersadoCop) kpiTotalDispersadoCop.textContent = formatCop(totalDispersadoCop);
      if (kpiTotalPendienteCop) {
        kpiTotalPendienteCop.textContent = formatCop(totalPendienteCop);
        if (totalPendienteCop > 0) {
          kpiTotalPendienteCop.style.color = 'var(--warning)';
        } else if (totalPendienteCop < 0) {
          kpiTotalPendienteCop.style.color = 'var(--info)';
        } else {
          kpiTotalPendienteCop.style.color = 'var(--success)';
        }
      }

      if (filteredRecordsCount && activeSubtab === 'negocios') {
        filteredRecordsCount.textContent = `${numNegocios} operaciones`;
      }

      // Render table rows
      if (operationsTableBody) {
        if (filtered.length === 0) {
          operationsTableBody.innerHTML = `
            <tr>
              <td colspan="6" style="padding: 36px; text-align: center; color: var(--text-muted); font-size: 13px;">
                No se encontraron operaciones para los filtros seleccionados.
              </td>
            </tr>
          `;
          if (operationsTableFoot) operationsTableFoot.innerHTML = '';
          return;
        }

        operationsTableBody.innerHTML = filtered.map(item => `
          <tr style="border-bottom: 1px solid var(--border-main); transition: background-color 0.15s ease;">
            <td style="padding: 14px 20px; font-weight: 700; color: var(--text-primary);" class="font-mono">
              ${item.codigo || '-'}
            </td>
            <td style="padding: 14px 20px; color: var(--text-secondary);">
              ${item.fechaRegistro || '-'}
            </td>
            <td style="padding: 14px 20px;">
              <span style="font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--text-primary); border: 1px solid var(--border-main);" class="font-mono">
                ${item.divisaCodigo || '-'}
              </span>
            </td>
            <td style="padding: 14px 20px; font-weight: 700; color: var(--text-primary); text-align: right;" class="font-mono">
              ${formatNumber(item.montoDivisa)}
            </td>
            <td style="padding: 14px 20px; color: var(--text-secondary); text-align: right;" class="font-mono">
              ${formatNumber(item.tasa)}
            </td>
            <td style="padding: 14px 20px; font-weight: 800; color: var(--success); text-align: right;" class="font-mono">
              ${formatCop(item.ingresoCop)}
            </td>
          </tr>
        `).join('');

        // Fila de TOTALES al final de la tabla
        if (operationsTableFoot) {
          const totalMontoVisible = filtered.reduce((acc, n) => acc + (Number(n.montoDivisa) || 0), 0);
          const totalIngresoVisible = filtered.reduce((acc, n) => acc + (Number(n.ingresoCop) || 0), 0);
          
          operationsTableFoot.innerHTML = `
            <tr style="background: var(--bg-card-secondary); font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary); border-top: 2px solid var(--border-main);">
              <td colspan="3" style="padding: 18px 20px; text-transform: uppercase; font-size: 12px; color: var(--text-secondary);">
                TOTALES CONSOLIDADOS (${numNegocios} OPS):
              </td>
              <td style="padding: 18px 20px; text-align: right; font-size: 14px; color: var(--text-primary);">
                ${formatNumber(totalMontoVisible)}
              </td>
              <td style="padding: 18px 20px; text-align: right; color: var(--text-muted); font-size: 12px;">
                —
              </td>
              <td style="padding: 18px 20px; text-align: right; color: var(--success); font-size: 15px;">
                ${formatCop(totalIngresoVisible)}
              </td>
            </tr>
          `;
        }
      }
    }

    // Render Dispersiones Table (Sin comprobantes en portal público)
    function renderDispersiones() {
      if (!dispersionesTableBody) return;
      if (clientDispersiones.length === 0) {
        dispersionesTableBody.innerHTML = `
          <tr>
            <td colspan="5" style="padding: 36px; text-align: center; color: var(--text-muted); font-size: 13px;">
              No hay dispersiones registradas para este cliente.
            </td>
          </tr>
        `;
        if (dispersionesTableFoot) dispersionesTableFoot.innerHTML = '';
        return;
      }

      dispersionesTableBody.innerHTML = clientDispersiones.map(p => {
        const esCompletado = p.estado === 'COMPLETADO';
        const fechaDisplay = p.fechaCreacion ? (p.fechaCreacion.includes('T') ? p.fechaCreacion.split('T')[0] : p.fechaCreacion) : (p.fecha || '-');
        const referenciaDisplay = p.referencia || '—';
        return `
          <tr style="border-bottom: 1px solid var(--border-main); transition: background-color 0.15s ease;">
            <td style="padding: 14px 20px; font-weight: 700; color: var(--brand-primary); font-family: ui-monospace, monospace; vertical-align: middle;">
              ${p.codigo || '-'}
            </td>
            <td style="padding: 14px 20px; color: var(--text-secondary); vertical-align: middle;">
              ${fechaDisplay}
            </td>
            <td style="padding: 14px 20px; color: var(--text-primary); font-weight: 600; vertical-align: middle;">
              ${referenciaDisplay}
            </td>
            <td style="padding: 14px 20px; font-weight: 800; color: ${esCompletado ? 'var(--success)' : 'var(--danger)'}; text-align: right; font-family: ui-monospace, monospace; font-size: 14px; vertical-align: middle;">
              ${formatCop(p.montoCop)}
            </td>
            <td style="padding: 14px 20px; text-align: center; vertical-align: middle;">
              <span class="status-pill ${esCompletado ? 'status-success' : 'status-danger'}">
                ${p.estado || 'COMPLETADO'}
              </span>
            </td>
          </tr>
        `;
      }).join('');

      if (dispersionesTableFoot) {
        const totalDispersado = clientDispersiones.filter(p => p.estado === 'COMPLETADO').reduce((acc, p) => acc + (Number(p.montoCop) || 0), 0);
        dispersionesTableFoot.innerHTML = `
          <tr style="background: var(--bg-card-secondary); font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary); border-top: 2px solid var(--border-main);">
            <td colspan="3" style="padding: 18px 20px; text-transform: uppercase; font-size: 12px; color: var(--text-secondary);">
              TOTAL DISPERSADO (${clientDispersiones.length} DISPERSIONES):
            </td>
            <td style="padding: 18px 20px; text-align: right; color: var(--success); font-size: 15px;">
              ${formatCop(totalDispersado)}
            </td>
            <td style="padding: 18px 20px; text-align: center; color: var(--text-muted); font-size: 12px;">
              —
            </td>
          </tr>
        `;
      }
    }

    // Filter listeners
    filterDateFrom?.addEventListener('change', applyFiltersAndRender);
    filterDateTo?.addEventListener('change', applyFiltersAndRender);
    filterCurrency?.addEventListener('change', applyFiltersAndRender);

    btnResetFilters?.addEventListener('click', () => {
      if (filterDateFrom) filterDateFrom.value = '';
      if (filterDateTo) filterDateTo.value = '';
      if (filterCurrency) filterCurrency.value = 'ALL';
      applyFiltersAndRender();
    });

    // Check existing session
    const savedPin = sessionStorage.getItem(`kaupaloki_portal_${slug}`);
    if (savedPin && slug) {
      supabase
        .from('client_shared_links')
        .select('*')
        .eq('slug', slug)
        .eq('is_active', true)
        .single()
        .then(({ data }) => {
          if (data && data.pin === savedPin) {
            loadClientPortalData(data);
          }
        });
    }
  </script>
</Layout>
