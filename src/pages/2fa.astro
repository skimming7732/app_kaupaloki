---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Autenticación de Dos Factores (2FA) - Kaupaloki">
  <div style="min-height: 100vh; background: var(--bg-main); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 30px 20px; box-sizing: border-box;">
    
    <!-- Logo & Back Link -->
    <div style="margin-bottom: 24px; text-align: center;">
      <img src="/logo.png" alt="Kaupaloki" class="theme-logo-dark" style="max-height: 38px; object-fit: contain; margin: 0 auto 8px auto;" />
      <img src="/logo-blue.png" alt="Kaupaloki" class="theme-logo-light" style="max-height: 38px; object-fit: contain; margin: 0 auto 8px auto;" />
      <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em;">
        Seguridad de Acceso • 2FA Obligatorio
      </div>
    </div>

    <!-- MAIN CONTAINER -->
    <div style="width: 100%; max-width: 480px; background: var(--bg-card); border-radius: 24px; border: 1px solid var(--border-main); padding: 36px 32px; box-shadow: var(--shadow-card); box-sizing: border-box;">
      
      <!-- MODE 1: VERIFY (Pedir código al iniciar sesión) -->
      <div id="container-verify" style="display: none; flex-direction: column; gap: 20px;">
        <div style="text-align: center;">
          <div style="width: 56px; height: 56px; border-radius: 16px; background: var(--brand-primary-light); color: var(--brand-primary); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h2 style="margin: 0 0 6px 0; font-size: 22px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">
            Verificación en Dos Pasos
          </h2>
          <p style="margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.5;">
            Ingresa el código de 6 dígitos de tu app de autenticación (Google Authenticator, Authy o 1Password).
          </p>
        </div>

        <form id="form-verify-2fa" style="display: flex; flex-direction: column; gap: 18px;">
          <div>
            <label for="input-verify-code" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 8px; text-align: center;">
              Código de Seguridad (6 Dígitos)
            </label>
            <input 
              type="text" 
              id="input-verify-code" 
              inputmode="numeric" 
              maxlength="9" 
              placeholder="000 000" 
              required 
              autofocus 
              style="width: 100%; box-sizing: border-box; height: 56px; text-align: center; font-size: 24px; font-weight: 800; font-family: ui-monospace, monospace; letter-spacing: 0.25em; border-radius: 14px; border: 2px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); outline: none; transition: border-color 0.2s;"
            />
          </div>

          <div id="verify-error-msg" style="display: none; padding: 10px 14px; border-radius: 10px; background: var(--danger-light); color: var(--danger); font-size: 12px; font-weight: 700; text-align: center;"></div>

          <button 
            type="submit" 
            id="btn-submit-verify" 
            style="width: 100%; padding: 14px; border-radius: 14px; border: none; background: var(--brand-primary); color: #fff; font-size: 14px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 14px rgba(67, 24, 255, 0.3); transition: all 0.2s;"
          >
            Verificar y Entrar
          </button>
        </form>

        <div style="text-align: center; border-top: 1px solid var(--border-main); padding-top: 16px;">
          <button 
            type="button" 
            id="btn-toggle-backup-mode" 
            style="background: none; border: none; font-size: 12px; font-weight: 700; color: var(--brand-primary); cursor: pointer;"
          >
            ¿No tienes acceso a tu app? Usar código de respaldo
          </button>
        </div>
      </div>

      <!-- MODE 2: SETUP (Configuración en 2 Pantallas / Pasos) -->
      <div id="container-setup" style="display: none; flex-direction: column; gap: 20px;">
        
        <!-- PANTALLA 1: Escanear QR y Verificar Código -->
        <div id="setup-step-1" style="display: flex; flex-direction: column; gap: 20px;">
          <div style="text-align: center;">
            <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; background: rgba(67, 24, 255, 0.1); color: var(--brand-primary); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
              <span>Paso 1 de 2: Vincular App</span>
            </div>
            <h2 style="margin: 0 0 6px 0; font-size: 22px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">
              Configurar Autenticador
            </h2>
            <p style="margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.5;">
              Escanea el código QR con Google Authenticator, Authy o 1Password e ingresa el código generado.
            </p>
          </div>

          <!-- QR Code Box -->
          <div style="background: var(--bg-card-secondary); border-radius: 16px; padding: 20px; border: 1px solid var(--border-main); text-align: center;">
            <div style="display: flex; justify-content: center; margin-bottom: 14px;">
              <div style="padding: 10px; background: #fff; border-radius: 14px; box-shadow: 0 4px 14px rgba(0,0,0,0.08); display: inline-block;">
                <img id="setup-qr-img" src="" alt="Código QR 2FA" style="width: 170px; height: 170px; display: block;" />
              </div>
            </div>

            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">
              ¿No puedes escanear? Copia esta clave secreta:
            </div>
            <div style="display: inline-flex; align-items: center; gap: 8px; background: var(--bg-card); padding: 7px 14px; border-radius: 10px; border: 1px solid var(--border-main);">
              <code id="setup-secret-text" style="font-size: 13px; font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary); letter-spacing: 0.08em;">
                Cargando...
              </code>
              <button type="button" id="btn-copy-secret" title="Copiar clave secreta" style="background: none; border: none; cursor: pointer; color: var(--brand-primary); display: flex; align-items: center; padding: 2px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>
            </div>
          </div>

          <!-- Verification Input Form -->
          <form id="form-setup-step-1" style="display: flex; flex-direction: column; gap: 16px;">
            <div>
              <label for="input-setup-code" style="display: block; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 8px; text-align: center;">
                Ingresa el código de 6 dígitos que muestra tu app
              </label>
              <input 
                type="text" 
                id="input-setup-code" 
                inputmode="numeric" 
                maxlength="6" 
                placeholder="000000" 
                required 
                autofocus
                style="width: 100%; box-sizing: border-box; height: 54px; text-align: center; font-size: 24px; font-weight: 800; font-family: ui-monospace, monospace; letter-spacing: 0.25em; border-radius: 14px; border: 2px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); outline: none; transition: border-color 0.2s;"
              />
            </div>

            <div id="setup-error-msg-1" style="display: none; padding: 10px 14px; border-radius: 10px; background: var(--danger-light); color: var(--danger); font-size: 12px; font-weight: 700; text-align: center;"></div>

            <button 
              type="submit" 
              id="btn-submit-step-1" 
              style="width: 100%; padding: 14px; border-radius: 14px; border: none; background: var(--brand-primary); color: #fff; font-size: 14px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 14px rgba(67, 24, 255, 0.3); transition: all 0.2s; display: inline-flex; align-items: center; justify-content: center; gap: 8px;"
            >
              <span>Verificar y Continuar</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </form>
        </div>

        <!-- PANTALLA 2: Códigos de Respaldo y Descargar TXT -->
        <div id="setup-step-2" style="display: none; flex-direction: column; gap: 20px;">
          <div style="text-align: center;">
            <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; background: rgba(5, 205, 153, 0.15); color: var(--success); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
              <span>Paso 2 de 2: Códigos de Emergencia</span>
            </div>
            <h2 style="margin: 0 0 6px 0; font-size: 22px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">
              Guarda tus Códigos de Respaldo
            </h2>
            <p style="margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.5;">
              ¡Tu aplicación autenticadora ha sido verificada! Si alguna vez pierdes acceso a tu teléfono, necesitarás estos códigos para ingresar.
            </p>
          </div>

          <!-- Backup Codes Container -->
          <div style="background: var(--bg-card-secondary); border-radius: 16px; padding: 20px; border: 1.5px solid var(--border-main);">
            <div id="setup-backup-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-family: ui-monospace, monospace; font-size: 13px; font-weight: 800; color: var(--text-primary); margin-bottom: 16px;">
              <!-- Generated backup codes -->
            </div>

            <!-- Action Buttons for Backup Codes -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
              <button 
                type="button" 
                id="btn-download-backup-txt" 
                style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s;"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Descargar (.txt)</span>
              </button>

              <button 
                type="button" 
                id="btn-copy-backup-codes" 
                style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s;"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="btn-copy-backup-text">Copiar Todos</span>
              </button>
            </div>
          </div>

          <div style="background: rgba(255, 181, 71, 0.1); border-left: 3px solid #FFB547; border-radius: 8px; padding: 10px 14px;">
            <p style="margin: 0; font-size: 12px; color: var(--text-secondary); line-height: 1.5;">
              ⚠️ Cada código es de un solo uso. Guárdalos en tu administrador de contraseñas o en un archivo seguro.
            </p>
          </div>

          <div id="setup-error-msg-2" style="display: none; padding: 10px 14px; border-radius: 10px; background: var(--danger-light); color: var(--danger); font-size: 12px; font-weight: 700; text-align: center;"></div>

          <!-- Final Submit Button -->
          <button 
            type="button" 
            id="btn-finalize-setup" 
            style="width: 100%; padding: 14px; border-radius: 14px; border: none; background: #05CD99; color: #fff; font-size: 14px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 14px rgba(5, 205, 153, 0.35); transition: all 0.2s;"
          >
            He Guardado mis Códigos · Entrar al Dashboard
          </button>
        </div>

      </div>

    </div>

    <!-- Security footnote -->
    <div style="margin-top: 24px; font-size: 12px; color: var(--text-muted); text-align: center;">
      Kaupaloki © {new Date().getFullYear()} — Plataforma Contable y Cambiaria Privada.
    </div>

  </div>

  <style>
    .theme-logo-light {
      display: none;
    }
    .theme-logo-dark {
      display: block;
    }
    :global(html:not(.dark)) .theme-logo-light {
      display: block !important;
    }
    :global(html:not(.dark)) .theme-logo-dark {
      display: none !important;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase';
    import { 
      generateBase32Secret, 
      generateBackupCodes, 
      verifyTotpCode, 
      buildOtpAuthUri 
    } from '../utils/totp';

    const urlParams = new URLSearchParams(window.location.search);
    const modeParam = urlParams.get('mode') || '';

    const containerVerify = document.getElementById('container-verify');
    const containerSetup = document.getElementById('container-setup');

    // Verify elements
    const formVerify = document.getElementById('form-verify-2fa');
    const inputVerifyCode = document.getElementById('input-verify-code') as HTMLInputElement | null;
    const verifyErrorMsg = document.getElementById('verify-error-msg');
    const btnSubmitVerify = document.getElementById('btn-submit-verify') as HTMLButtonElement | null;
    const btnToggleBackupMode = document.getElementById('btn-toggle-backup-mode');

    // Setup elements
    const setupStep1 = document.getElementById('setup-step-1');
    const setupStep2 = document.getElementById('setup-step-2');
    const formSetupStep1 = document.getElementById('form-setup-step-1');
    const setupQrImg = document.getElementById('setup-qr-img') as HTMLImageElement | null;
    const setupSecretText = document.getElementById('setup-secret-text');
    const btnCopySecret = document.getElementById('btn-copy-secret');
    const inputSetupCode = document.getElementById('input-setup-code') as HTMLInputElement | null;
    const setupErrorMsg1 = document.getElementById('setup-error-msg-1');
    const setupErrorMsg2 = document.getElementById('setup-error-msg-2');
    const btnSubmitStep1 = document.getElementById('btn-submit-step-1') as HTMLButtonElement | null;
    const setupBackupGrid = document.getElementById('setup-backup-grid');
    const btnCopyBackupCodes = document.getElementById('btn-copy-backup-codes');
    const btnCopyBackupText = document.getElementById('btn-copy-backup-text');
    const btnDownloadBackupTxt = document.getElementById('btn-download-backup-txt');
    const btnFinalizeSetup = document.getElementById('btn-finalize-setup') as HTMLButtonElement | null;

    let currentUserProfile: any = null;
    let currentUserEmail = '';
    let generatedSecret = '';
    let generatedBackupCodes: string[] = [];

    async function init2FA() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.replace('/login');
        return;
      }

      currentUserEmail = session.user.email?.toLowerCase().trim() || 'usuario@kaupaloki.co';
      const { data: profile } = await supabase
        .from('profiles')
        .select('*')
        .ilike('email', currentUserEmail)
        .maybeSingle();

      currentUserProfile = profile;

      // Determine mode:
      const has2FA = profile?.two_factor_enabled && profile?.two_factor_secret;

      if (has2FA && modeParam !== 'setup') {
        // Mode Verify
        if (containerVerify) containerVerify.style.display = 'flex';
        if (containerSetup) containerSetup.style.display = 'none';
      } else {
        // Mode Setup (Mandatory 2-step enrollment)
        if (containerSetup) containerSetup.style.display = 'flex';
        if (containerVerify) containerVerify.style.display = 'none';
        initSetupMode(currentUserEmail);
      }
    }

    function initSetupMode(email: string) {
      generatedSecret = currentUserProfile?.two_factor_secret || generateBase32Secret(16);
      generatedBackupCodes = (Array.isArray(currentUserProfile?.two_factor_backup_codes) && currentUserProfile.two_factor_backup_codes.length > 0)
        ? currentUserProfile.two_factor_backup_codes
        : generateBackupCodes(8);

      if (setupSecretText) setupSecretText.textContent = generatedSecret;

      const otpUri = buildOtpAuthUri(email, generatedSecret, 'Kaupaloki');
      const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(otpUri)}`;
      if (setupQrImg) setupQrImg.src = qrUrl;

      // Always show Step 1 initially
      if (setupStep1) setupStep1.style.display = 'flex';
      if (setupStep2) setupStep2.style.display = 'none';
    }

    function populateBackupCodesGrid() {
      if (setupBackupGrid) {
        setupBackupGrid.innerHTML = generatedBackupCodes.map(code => `
          <div style="background: var(--bg-card); padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border-main); text-align: center; letter-spacing: 0.05em; font-weight: 800;">
            ${code}
          </div>
        `).join('');
      }
    }

    // Copy secret
    btnCopySecret?.addEventListener('click', () => {
      navigator.clipboard.writeText(generatedSecret);
      alert('Clave secreta copiada al portapapeles');
    });

    // Step 1 Submission: Validate code & proceed to Step 2
    formSetupStep1?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!inputSetupCode) return;
      const code = inputSetupCode.value.trim();

      if (setupErrorMsg1) setupErrorMsg1.style.display = 'none';

      const isValid = await verifyTotpCode(generatedSecret, code);
      if (!isValid) {
        if (setupErrorMsg1) {
          setupErrorMsg1.textContent = 'Código incorrecto. Revisa la hora de tu dispositivo e ingresa el código actual de 6 dígitos.';
          setupErrorMsg1.style.display = 'block';
        }
        return;
      }

      // Validated! Move to Step 2
      if (setupStep1) setupStep1.style.display = 'none';
      if (setupStep2) setupStep2.style.display = 'flex';
      populateBackupCodesGrid();
    });

    // Download TXT file with backup codes
    btnDownloadBackupTxt?.addEventListener('click', () => {
      const now = new Date();
      const txtContent = `=====================================================
KAUPALOKI - CÓDIGOS DE RECUPERACIÓN DE EMERGENCIA (2FA)
=====================================================
Usuario: ${currentUserEmail}
Fecha de emisión: ${now.toLocaleDateString()} ${now.toLocaleTimeString()}

IMPORTANTE:
- Cada uno de estos 8 códigos puede utilizarse UNA SOLA VEZ.
- Si pierdes acceso a tu teléfono o a tu aplicación de autenticación,
  estos códigos son tu único método para recuperar el acceso.
- Guárdalos en tu gestor de contraseñas o en una ubicación segura y confidencial.

TUS CÓDIGOS DE RESPALDO:
-----------------------------------------------------
${generatedBackupCodes.map((c, i) => `  [${i + 1}]  ${c}`).join('\n')}
-----------------------------------------------------

Plataforma de Finanzas y Operaciones Kaupaloki
https://app.kaupaloki.co
=====================================================
`;
      const blob = new Blob([txtContent], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      const userPrefix = (currentUserEmail.split('@')[0] || 'usuario').replace(/[^a-zA-Z0-9_-]/g, '_');
      link.href = url;
      link.download = `kaupaloki-codigos-respaldo-2fa-${userPrefix}.txt`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });

    // Copy backup codes to clipboard
    btnCopyBackupCodes?.addEventListener('click', () => {
      navigator.clipboard.writeText(generatedBackupCodes.join('\n'));
      if (btnCopyBackupText) {
        const prevText = btnCopyBackupText.textContent;
        btnCopyBackupText.textContent = '¡Copiados!';
        setTimeout(() => {
          if (btnCopyBackupText) btnCopyBackupText.textContent = prevText;
        }, 2000);
      }
    });

    // Finalize Step 2 & Save to Supabase
    btnFinalizeSetup?.addEventListener('click', async () => {
      if (btnFinalizeSetup) {
        btnFinalizeSetup.disabled = true;
        btnFinalizeSetup.textContent = 'Guardando configuración 2FA...';
      }

      if (setupErrorMsg2) setupErrorMsg2.style.display = 'none';

      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          await supabase.from('profiles').update({
            two_factor_enabled: true,
            two_factor_secret: generatedSecret,
            two_factor_backup_codes: generatedBackupCodes
          }).ilike('email', session.user.email || '');
        }

        sessionStorage.setItem('kaupaloki_2fa_verified', 'true');
        window.location.replace('/');
      } catch (err: any) {
        if (setupErrorMsg2) {
          setupErrorMsg2.textContent = 'Error al registrar 2FA: ' + (err?.message || err);
          setupErrorMsg2.style.display = 'block';
        }
        if (btnFinalizeSetup) {
          btnFinalizeSetup.disabled = false;
          btnFinalizeSetup.textContent = 'He Guardado mis Códigos · Entrar al Dashboard';
        }
      }
    });

    // Handle Verify Submission
    formVerify?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!inputVerifyCode) return;
      const entered = inputVerifyCode.value.trim().toUpperCase();

      const secret = currentUserProfile?.two_factor_secret;
      const backupCodes: string[] = Array.isArray(currentUserProfile?.two_factor_backup_codes) 
        ? currentUserProfile.two_factor_backup_codes 
        : [];

      // Check TOTP code
      let isMatch = false;
      let usedBackupCode = false;

      if (entered.length === 6 && /^\d+$/.test(entered) && secret) {
        isMatch = await verifyTotpCode(secret, entered);
      }

      // Check Backup code
      if (!isMatch && backupCodes.includes(entered)) {
        isMatch = true;
        usedBackupCode = true;
      }

      if (!isMatch) {
        if (verifyErrorMsg) {
          verifyErrorMsg.textContent = 'Código de seguridad incorrecto o expirado.';
          verifyErrorMsg.style.display = 'block';
        }
        return;
      }

      if (btnSubmitVerify) {
        btnSubmitVerify.disabled = true;
        btnSubmitVerify.textContent = 'Acceso concedido...';
      }

      // If used backup code, remove it from list
      if (usedBackupCode && currentUserProfile?.email) {
        const updatedCodes = backupCodes.filter(c => c !== entered);
        await supabase.from('profiles').update({
          two_factor_backup_codes: updatedCodes
        }).ilike('email', currentUserProfile.email);
      }

      sessionStorage.setItem('kaupaloki_2fa_verified', 'true');
      window.location.replace('/');
    });

    btnToggleBackupMode?.addEventListener('click', () => {
      if (!inputVerifyCode) return;
      inputVerifyCode.value = '';
      inputVerifyCode.maxLength = 12;
      inputVerifyCode.placeholder = 'XXXX-XXXX';
      inputVerifyCode.focus();
      alert('Ingresa uno de tus códigos de respaldo de 8 caracteres (formato XXXX-XXXX)');
    });

    init2FA();
  </script>
</Layout>
