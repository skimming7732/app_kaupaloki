---
---

<div id="modal-edit-profile-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(11, 20, 55, 0.75); backdrop-filter: blur(8px); z-index: 140; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 28px 30px; width: 100%; max-width: 480px; box-shadow: var(--shadow-card); position: relative;">
          
          <button id="btn-close-edit-profile-modal" style="position: absolute; top: 20px; right: 20px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 22px;">
            <div style="width: 46px; height: 46px; border-radius: 14px; background: var(--brand-primary-light); color: var(--brand-primary); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800;">
              <span id="edit-profile-avatar-letter">F</span>
            </div>
            <div>
              <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-primary);">
                Editar Mi Perfil
              </h3>
              <p style="margin: 2px 0 0 0; font-size: 12px; color: var(--text-secondary);" id="edit-profile-email-subtitle">
                Actualiza tu nombre y credenciales
              </p>
            </div>
          </div>

          <form id="form-edit-profile" style="display: flex; flex-direction: column; gap: 16px;">
            <div>
              <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px;">
                Nombre Completo *
              </label>
              <input 
                type="text" 
                id="edit-profile-name" 
                required 
                style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; outline: none; box-sizing: border-box;" 
              />
            </div>

            <div>
              <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px;">
                Nueva Contraseña (opcional)
              </label>
              <input 
                type="password" 
                id="edit-profile-password" 
                placeholder="Dejar vacío para mantener la actual" 
                minlength="6"
                style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; outline: none; box-sizing: border-box;" 
              />
            </div>

            <div>
              <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px;">
                Confirmar Nueva Contraseña
              </label>
              <input 
                type="password" 
                id="edit-profile-password-confirm" 
                placeholder="Repite la contraseña" 
                minlength="6"
                style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; outline: none; box-sizing: border-box;" 
              />
            </div>

            <div id="edit-profile-status" style="font-size: 12px; font-weight: 600; min-height: 18px;"></div>

            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 6px;">
              <button 
                type="button" 
                id="btn-cancel-edit-profile" 
                style="padding: 10px 18px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); font-size: 13px; font-weight: 600; cursor: pointer;"
              >
                Cancelar
              </button>
              <button 
                type="submit" 
                id="btn-save-edit-profile" 
                style="padding: 11px 22px; border-radius: 10px; border: none; background: var(--brand-primary); color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 14px rgba(67, 24, 255, 0.35);"
              >
                Guardar Cambios
              </button>
            </div>
          </form>

        </div>
      </div>
