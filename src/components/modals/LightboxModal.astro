---
---

<div id="comprobante-lightbox-modal" style="display: none; position: fixed; inset: 0; background: rgba(11, 20, 55, 0.85); backdrop-filter: blur(8px); z-index: 120; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 22px 24px; width: 100%; max-width: 500px; max-height: 94vh; display: flex; flex-direction: column; gap: 14px; box-shadow: var(--shadow-card); position: relative;">
          
          <!-- Close button -->
          <button id="btn-close-lightbox" style="position: absolute; top: 16px; right: 16px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <!-- Header -->
          <div style="display: flex; align-items: center; justify-content: space-between; padding-right: 36px;">
            <div style="display: flex; align-items: center; gap: 12px; overflow: hidden;">
              <div style="width: 38px; height: 38px; border-radius: 12px; background: var(--brand-primary-light); color: var(--brand-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
              </div>
              <div style="overflow: hidden;">
                <h3 id="lightbox-title" style="margin: 0; font-size: 15px; font-weight: 800; color: var(--text-primary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                  Comprobante de Dispersión
                </h3>
                <p style="margin: 2px 0 0 0; font-size: 11px; color: var(--text-muted);">
                  Formato Vertical 9:16
                </p>
              </div>
            </div>

            <span id="lightbox-counter-badge" style="display: none; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 9999px; background: var(--bg-main); color: var(--brand-primary); border: 1px solid var(--border-main); white-space: nowrap;">
              1 de 1
            </span>
          </div>

          <!-- 9:16 Preview Container with Prev/Next buttons -->
          <div style="position: relative; display: flex; align-items: center; justify-content: center; background: var(--bg-main); border: 1px solid var(--border-main); border-radius: 16px; padding: 12px; max-height: 56vh; overflow: hidden;">
            <button id="btn-lightbox-prev" title="Comprobante anterior" style="display: none; position: absolute; left: 10px; z-index: 10; width: 34px; height: 34px; border-radius: 50%; background: rgba(0,0,0,0.6); color: #fff; border: none; cursor: pointer; align-items: center; justify-content: center; transition: all 0.2s;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>

            <img 
              id="lightbox-image" 
              src="" 
              alt="Comprobante" 
              style="max-height: 52vh; max-width: 100%; aspect-ratio: 9/16; object-fit: contain; border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.25);" 
            />

            <button id="btn-lightbox-next" title="Siguiente comprobante" style="display: none; position: absolute; right: 10px; z-index: 10; width: 34px; height: 34px; border-radius: 50%; background: rgba(0,0,0,0.6); color: #fff; border: none; cursor: pointer; align-items: center; justify-content: center; transition: all 0.2s;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>

          <!-- Strip for multiple vouchers thumbnails -->
          <div id="lightbox-thumbnails-strip" style="display: none; gap: 8px; overflow-x: auto; padding: 4px 2px; justify-content: center;"></div>

          <!-- Actions: Copiar + Descargar -->
          <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; padding-top: 4px;">
            <span style="font-size: 11px; color: var(--text-muted); font-weight: 500;">
              Presiona ESC para cerrar
            </span>
            <div style="display: flex; align-items: center; gap: 8px;">
              <!-- Botón Copiar Comprobante -->
              <button 
                id="btn-copy-lightbox" 
                type="button"
                title="Copiar imagen al portapapeles"
                style="display: inline-flex; align-items: center; gap: 6px; padding: 9px 15px; border-radius: 10px; background: var(--bg-main); border: 1px solid var(--border-main); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="btn-copy-lightbox-text">Copiar</span>
              </button>

              <!-- Botón Descargar -->
              <a 
                id="lightbox-download-btn" 
                href="" 
                download="comprobante.png" 
                target="_blank" 
                style="display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: 10px; background: var(--brand-primary); color: #fff; font-size: 12px; font-weight: 700; text-decoration: none; cursor: pointer;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Descargar
              </a>
            </div>
          </div>

        </div>
      </div>
