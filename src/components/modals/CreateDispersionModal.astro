---
import { formatCop } from '../../utils/formatters';

interface Props {
  CLIENTES: any[];
  ACTIVOS_LIQUIDOS: any[];
}

const { CLIENTES = [], ACTIVOS_LIQUIDOS = [] } = Astro.props;
const todayIso = new Date().toISOString().slice(0, 10);
---

<!-- Modal: Registrar Nueva Dispersión -->
<div 
  id="modal-create-dispersion-backdrop" 
  style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(5px); z-index: 9999; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box;"
>
  <div 
    style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 20px; width: 100%; max-width: 540px; box-shadow: var(--shadow-card); overflow: hidden; animation: modalFadeIn 0.2s ease-out; max-height: 90vh; display: flex; flex-direction: column;"
  >
    <!-- Modal Header -->
    <div style="padding: 18px 24px; border-bottom: 1px solid var(--border-main); display: flex; align-items: center; justify-content: space-between; background: var(--bg-card-secondary);">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(5, 205, 153, 0.15); color: var(--success); display: flex; align-items: center; justify-content: center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </div>
        <div>
          <h3 style="margin: 0; font-size: 15px; font-weight: 800; color: var(--text-primary);">
            Registrar Dispersión
          </h3>
          <p style="margin: 2px 0 0 0; font-size: 11px; color: var(--text-muted);">
            Registra una orden de pago/dispersión y sincronízala en Airtable
          </p>
        </div>
      </div>
      <button 
        type="button" 
        id="btn-close-create-dispersion-modal" 
        style="background: transparent; border: none; color: var(--text-muted); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; border-radius: 8px; transition: color 0.15s;"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Modal Form -->
    <form id="form-modal-create-dispersion" style="padding: 22px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px;">
      
      <!-- Campo 1: Fecha -->
      <div>
        <label for="modal-dispersion-fecha" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Fecha de Dispersión *
        </label>
        <input 
          type="date" 
          id="modal-dispersion-fecha" 
          required 
          value={todayIso}
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box;"
        />
      </div>

      <!-- Campo 2: Cliente -->
      <div>
        <label for="modal-dispersion-cliente" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Cliente Beneficiario *
        </label>
        <select 
          id="modal-dispersion-cliente" 
          required 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box; cursor: pointer;"
        >
          <option value="" disabled selected>— Selecciona el Cliente —</option>
          {CLIENTES.map(c => (
            <option value={c.id} data-codigo={c.codigo} data-nombre={c.nombre}>
              {c.codigo} • {c.nombre} (Pendiente: {formatCop(c.pendienteCop || c.pendientePorPagarCop || 0)})
            </option>
          ))}
        </select>
      </div>

      <!-- Campo 3: Monto en COP -->
      <div>
        <label for="modal-dispersion-monto" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Monto a Dispersar (COP) *
        </label>
        <div style="position: relative;">
          <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 800; color: var(--text-muted); font-size: 14px;">$</span>
          <input 
            type="number" 
            id="modal-dispersion-monto" 
            required 
            min="1" 
            step="any"
            placeholder="0.00" 
            style="width: 100%; padding: 11px 14px 11px 28px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 14px; font-weight: 700; font-family: ui-monospace, monospace; outline: none; box-sizing: border-box;"
          />
        </div>
      </div>

      <!-- Campo 4: Origen de Fondos -->
      <div>
        <label for="modal-dispersion-origen" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Origen de Fondos (Activo Líquido) *
        </label>
        <select 
          id="modal-dispersion-origen" 
          required 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box; cursor: pointer;"
        >
          <option value="" disabled selected>— Selecciona Cuenta de Origen —</option>
          {ACTIVOS_LIQUIDOS.map(a => (
            <option value={a.id}>
              {a.activo} • {a.institucion} (Saldo: {formatCop(a.saldoCop || 0)})
            </option>
          ))}
        </select>
      </div>

      <!-- Campo 5: Referencia / Concepto -->
      <div>
        <label for="modal-dispersion-referencia" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Referencia / Beneficiario *
        </label>
        <input 
          type="text" 
          id="modal-dispersion-referencia" 
          required 
          placeholder="Ej. BANCOLOMBIA AHORROS #12345678 - NOMBRE TITULAR" 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 500; outline: none; box-sizing: border-box;"
        />
      </div>

      <!-- Estado / Feedback -->
      <div id="modal-dispersion-status" style="font-size: 12px; font-weight: 700; min-height: 18px; text-align: center;"></div>

      <!-- Botones de Acción -->
      <div style="display: flex; gap: 10px; margin-top: 6px;">
        <button 
          type="button" 
          id="btn-cancel-create-dispersion" 
          style="flex: 1; padding: 12px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.15s;"
        >
          Cancelar
        </button>
        <button 
          type="submit" 
          id="btn-submit-create-dispersion" 
          style="flex: 2; padding: 12px; border-radius: 12px; border: none; background: var(--brand-primary); color: #fff; font-size: 13px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 12px rgba(67, 24, 255, 0.25); transition: opacity 0.15s;"
        >
          <span>Registrar Dispersión</span>
        </button>
      </div>

    </form>
  </div>
</div>
