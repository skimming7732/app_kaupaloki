---
import { fallbackBanderaUrl } from '../../utils/formatters';

interface Props {
  DIVISAS?: any[];
}

const { DIVISAS = [] } = Astro.props;
---

<div id="modal-edit-user-permissions-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(11, 20, 55, 0.72); backdrop-filter: blur(8px); z-index: 155; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 28px 30px; width: 100%; max-width: 560px; box-shadow: var(--shadow-card); position: relative; max-height: 92vh; overflow-y: auto;">
          <!-- Close Button -->
          <button id="btn-close-edit-user-permissions-modal" type="button" style="position: absolute; top: 20px; right: 20px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <!-- Header -->
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px;">
            <div style="width: 46px; height: 46px; border-radius: 14px; background: var(--brand-primary-light); color: var(--brand-primary); display: flex; align-items: center; justify-content: center;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
            </div>
            <div>
              <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-primary);">
                Editar Permisos y Divisas
              </h3>
              <p id="edit-user-permissions-subtitle" style="margin: 3px 0 0 0; font-size: 12px; color: var(--text-muted); font-family: ui-monospace, monospace;">
                usuario@kaupaloki.co
              </p>
            </div>
          </div>

          <form id="form-edit-user-permissions" style="display: flex; flex-direction: column; gap: 16px;">
            <input type="hidden" id="edit-user-email-hidden" value="" />
            <input type="hidden" id="edit-user-airtable-id-hidden" value="" />
            <input type="hidden" id="edit-user-role-hidden" value="operador" />

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div>
                <label for="modal-edit-user-name" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
                  Nombre Completo
                </label>
                <input
                  type="text"
                  id="modal-edit-user-name"
                  required
                  style="width: 100%; box-sizing: border-box; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none;"
                />
              </div>
              <div>
                <label for="modal-edit-user-country" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
                  País (Sin Emoji)
                </label>
                <select
                  id="modal-edit-user-country"
                  style="width: 100%; box-sizing: border-box; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; cursor: pointer;"
                >
                  <option value="COL">Colombia (COL)</option>
                  <option value="BRA">Brasil (BRA)</option>
                  <option value="PER">Perú (PER)</option>
                  <option value="ECU">Ecuador (ECU)</option>
                  <option value="CHL">Chile (CHL)</option>
                  <option value="ARG">Argentina (ARG)</option>
                  <option value="URY">Uruguay (URY)</option>
                  <option value="PRY">Paraguay (PRY)</option>
                  <option value="MEX">México (MEX)</option>
                  <option value="USA">Estados Unidos (USA)</option>
                  <option value="HND">Honduras (HND)</option>
                  <option value="VEN">Venezuela (VEN)</option>
                  <option value="PAN">Panamá (PAN)</option>
                  <option value="ESP">España (ESP)</option>
                  <option value="OTRO">Otro País (OTRO)</option>
                </select>
              </div>
            </div>

            <!-- Selector de Rol -->
            <div>
              <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 8px;">
                Rol de Acceso en la Plataforma
              </label>
              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                <button type="button" class="edit-role-card-btn" data-role="administrador" style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 10px 12px; border-radius: 12px; border: 1.5px solid var(--border-main); background: var(--bg-card); cursor: pointer; text-align: left; transition: all 0.2s;">
                  <span style="font-size: 12px; font-weight: 800; color: var(--text-primary);">Administrador</span>
                  <span style="font-size: 10px; color: var(--text-muted);">Todas las divisas</span>
                </button>
                <button type="button" class="edit-role-card-btn active" data-role="operador" style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 10px 12px; border-radius: 12px; border: 2px solid var(--brand-primary); background: var(--brand-primary-light); cursor: pointer; text-align: left; transition: all 0.2s;">
                  <span style="font-size: 12px; font-weight: 800; color: var(--text-primary);">Operador</span>
                  <span style="font-size: 10px; color: var(--text-muted);">Divisas asignadas</span>
                </button>
                <button type="button" class="edit-role-card-btn" data-role="client" style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 10px 12px; border-radius: 12px; border: 1.5px solid var(--border-main); background: var(--bg-card); cursor: pointer; text-align: left; transition: all 0.2s;">
                  <span style="font-size: 12px; font-weight: 800; color: var(--text-primary);">Cliente</span>
                  <span style="font-size: 10px; color: var(--text-muted);">Solo consulta</span>
                </button>
              </div>
            </div>

            <!-- Divisas Autorizadas Sincronizadas con Airtable -->
            <div id="edit-container-authorized-currencies" style="display: block;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">
                  Divisas Autorizadas (Sincronizadas con Airtable)
                </label>
                <button type="button" id="btn-edit-toggle-all-currencies" style="background: none; border: none; color: var(--brand-primary); font-size: 11px; font-weight: 700; cursor: pointer; padding: 0;">
                  Seleccionar / Deseleccionar Todas
                </button>
              </div>
              <div id="edit-user-currencies-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 8px; background: var(--bg-card-secondary); padding: 12px; border-radius: 12px; border: 1px solid var(--border-main); max-height: 220px; overflow-y: auto;">
                {DIVISAS.map((d) => (
                  <label class="currency-check-chip" style="display: flex; align-items: center; gap: 7px; padding: 7px 9px; border-radius: 9px; background: var(--bg-card); border: 1px solid var(--border-main); cursor: pointer; font-size: 12px; font-weight: 700; color: var(--text-primary); user-select: none;">
                    <input type="checkbox" name="edit_authorized_currency" value={d.codigo} style="accent-color: var(--brand-primary); width: 14px; height: 14px; cursor: pointer; flex-shrink: 0;" />
                    <img
                      src={d.banderaUrl || d.fallbackBanderaUrl}
                      alt={d.codigo}
                      onerror={`this.onerror=null;this.src='${d.fallbackBanderaUrl}';`}
                      style="width: 18px; height: 18px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border-main); flex-shrink: 0;"
                    />
                    <div style="display: flex; flex-direction: column; line-height: 1.1; overflow: hidden;">
                      <span style="font-family: ui-monospace, monospace; font-size: 11.5px; font-weight: 800;">{d.codigo}</span>
                      <span style="font-size: 9px; color: var(--text-muted); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{d.nombreDivisa}</span>
                    </div>
                  </label>
                ))}
              </div>
            </div>

            <div id="modal-edit-user-permissions-status" style="font-size: 12px; font-weight: 700; text-align: center; min-height: 18px;"></div>

            <div style="display: flex; gap: 10px; margin-top: 4px;">
              <button
                type="button"
                id="btn-cancel-edit-user-permissions"
                style="flex: 1; padding: 12px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); font-size: 13px; font-weight: 700; cursor: pointer;"
              >
                Cancelar
              </button>
              <button
                type="submit"
                id="btn-save-edit-user-permissions"
                style="flex: 1.4; padding: 12px; border-radius: 12px; border: none; background: var(--brand-primary); color: #FFFFFF; font-size: 13px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 12px rgba(67, 24, 255, 0.25);"
              >
                Guardar Permisos y Divisas
              </button>
            </div>
          </form>
        </div>
      </div>
