---
---

<div id="modal-create-client-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(11, 20, 55, 0.8); backdrop-filter: blur(10px); z-index: 150; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 28px 30px; width: 100%; max-width: 460px; box-shadow: var(--shadow-card); position: relative;">
          
          <button id="btn-close-create-client-modal" type="button" style="position: absolute; top: 20px; right: 20px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 22px;">
            <div style="width: 46px; height: 46px; border-radius: 14px; background: rgba(5, 205, 153, 0.12); color: var(--success); display: flex; align-items: center; justify-content: center;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
              </svg>
            </div>
            <div>
              <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">
                Agregar Cliente
              </h3>
              <p style="margin: 2px 0 0 0; font-size: 12px; color: var(--text-secondary);">
                Crea el perfil contable del cliente
              </p>
            </div>
          </div>

          <form id="form-modal-create-client" style="display: flex; flex-direction: column; gap: 16px;">
            <div>
              <label for="modal-client-name" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px; letter-spacing: 0.05em;">
                Nombre Completo o Razón Social *
              </label>
              <input 
                type="text" 
                id="modal-client-name" 
                required 
                placeholder="Ej: JUAN PEREZ o COMERCIALIZADORA SAS" 
                style="width: 100%; box-sizing: border-box; padding: 11px 14px; font-size: 13px; border-radius: 12px; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-family: inherit; outline: none; transition: all 0.2s;"
              />
            </div>

            <div>
              <label for="modal-client-country" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px; letter-spacing: 0.05em;">
                País de Residencia / Operación *
              </label>
              <select 
                id="modal-client-country" 
                required 
                style="width: 100%; box-sizing: border-box; padding: 11px 14px; font-size: 13px; border-radius: 12px; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-family: inherit; outline: none; cursor: pointer; transition: all 0.2s;"
              >
                <option value="COL">Colombia (COL)</option>
                <option value="BRA">Brasil (BRA)</option>
                <option value="PER">Perú (PER)</option>
                <option value="ECU">Ecuador (ECU)</option>
                <option value="PAN">Panamá (PAN)</option>
                <option value="CHL">Chile (CHL)</option>
                <option value="ARG">Argentina (ARG)</option>
                <option value="HND">Honduras (HND)</option>
                <option value="VEN">Venezuela (VEN)</option>
                <option value="MEX">México (MEX)</option>
                <option value="URY">Uruguay (URY)</option>
                <option value="USA">Estados Unidos (USA)</option>
                <option value="ESP">España (ESP)</option>
                <option value="OTR">Otro País (OTR)</option>
              </select>
            </div>

            <!-- Mensaje de estado -->
            <div id="modal-client-status" style="font-size: 12px; min-height: 18px; text-align: center; font-weight: 600;"></div>

            <!-- Botones de acción -->
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 8px;">
              <button 
                type="button" 
                id="btn-cancel-create-client" 
                style="padding: 10px 18px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); font-size: 13px; font-weight: 600; cursor: pointer;"
              >
                Cancelar
              </button>
              <button 
                type="submit" 
                id="btn-submit-create-client" 
                style="display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; border-radius: 10px; border: none; background: var(--brand-primary); color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 14px rgba(67, 24, 255, 0.35);"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Guardar Cliente</span>
              </button>
            </div>
          </form>

        </div>
      </div>
