---
import { formatCop } from '../../utils/formatters';

interface Props {
  CLIENTES: any[];
  DIVISAS: any[];
}

const { CLIENTES = [], DIVISAS = [] } = Astro.props;
---

<!-- Modal: Editar Negocio -->
<div 
  id="modal-edit-negocio-backdrop" 
  style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(5px); z-index: 9999; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box;"
>
  <div 
    style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 20px; width: 100%; max-width: 540px; box-shadow: var(--shadow-card); overflow: hidden; animation: modalFadeIn 0.2s ease-out; max-height: 90vh; display: flex; flex-direction: column;"
  >
    <!-- Modal Header -->
    <div style="padding: 18px 24px; border-bottom: 1px solid var(--border-main); display: flex; align-items: center; justify-content: space-between; background: var(--bg-card-secondary);">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(67, 24, 255, 0.12); color: var(--brand-primary); display: flex; align-items: center; justify-content: center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <h3 style="margin: 0; font-size: 15px; font-weight: 800; color: var(--text-primary);">
              Editar Negocio
            </h3>
            <span id="modal-edit-negocio-badge-id" style="font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 6px; background: var(--brand-primary-light); color: var(--brand-primary); font-family: ui-monospace, monospace;">
              N0000
            </span>
          </div>
          <p style="margin: 2px 0 0 0; font-size: 11px; color: var(--text-muted);">
            Modifica los valores del negocio y sincronízalos con Airtable
          </p>
        </div>
      </div>
      <button 
        type="button" 
        id="btn-close-edit-negocio-modal" 
        style="background: transparent; border: none; color: var(--text-muted); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; border-radius: 8px; transition: color 0.15s;"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="18" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Modal Form -->
    <form id="form-modal-edit-negocio" style="padding: 22px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px;">
      <input type="hidden" id="modal-edit-negocio-record-id" />
      <input type="hidden" id="modal-edit-negocio-codigo" />

      <!-- Campo 1: Fecha -->
      <div>
        <label for="modal-edit-negocio-fecha" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Fecha de Registro *
        </label>
        <input 
          type="date" 
          id="modal-edit-negocio-fecha" 
          required 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box;"
        />
      </div>

      <!-- Campo 2: Cliente -->
      <div>
        <label for="modal-edit-negocio-cliente" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Cliente *
        </label>
        <select 
          id="modal-edit-negocio-cliente" 
          required 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box; cursor: pointer;"
        >
          <option value="" disabled selected>— Selecciona Cliente —</option>
          {CLIENTES.map(c => (
            <option value={c.id} data-codigo={c.codigo}>
              {c.codigo} • {c.nombre}
            </option>
          ))}
        </select>
      </div>

      <!-- Campo 3: Divisa -->
      <div>
        <label for="modal-edit-negocio-divisa" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Divisa *
        </label>
        <select 
          id="modal-edit-negocio-divisa" 
          required 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box; cursor: pointer;"
        >
          {DIVISAS.map(d => (
            <option value={d.codigo} data-id={d.id}>
              {d.codigo} — {d.nombreDivisa}
            </option>
          ))}
        </select>
      </div>

      <!-- Cuadrícula 2 Columnas: Monto Divisa + Tasa COP -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <!-- Campo 4: Monto Divisa -->
        <div>
          <label for="modal-edit-negocio-monto" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
            Monto Divisa *
          </label>
          <input 
            type="number" 
            id="modal-edit-negocio-monto" 
            required 
            min="0.01" 
            step="any" 
            placeholder="0.00" 
            style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 700; font-family: ui-monospace, monospace; outline: none; box-sizing: border-box;"
          />
        </div>

        <!-- Campo 5: Tasa (COP) -->
        <div>
          <label for="modal-edit-negocio-tasa" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
            Tasa (COP) *
          </label>
          <input 
            type="number" 
            id="modal-edit-negocio-tasa" 
            required 
            min="0.0001" 
            step="any" 
            placeholder="Ej. 3200" 
            style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 700; font-family: ui-monospace, monospace; outline: none; box-sizing: border-box;"
          />
        </div>
      </div>

      <!-- Previsualización en Vivo de Ingreso COP -->
      <div style="background: var(--bg-card-secondary); border: 1px solid var(--border-main); border-radius: 12px; padding: 12px 14px; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">
          Ingreso Estimado (COP):
        </span>
        <span id="modal-edit-negocio-calculo-cop" style="font-size: 16px; font-weight: 800; color: var(--success); font-family: ui-monospace, monospace;">
          $0.00
        </span>
      </div>

      <!-- Estado / Feedback -->
      <div id="modal-edit-negocio-status" style="font-size: 12px; font-weight: 700; min-height: 18px; text-align: center;"></div>

      <!-- Botones de Acción -->
      <div style="display: flex; gap: 10px; margin-top: 6px;">
        <button 
          type="button" 
          id="btn-cancel-edit-negocio" 
          style="flex: 1; padding: 12px; border-radius: 12px; border: 1px solid var(--border-main); background: var(--bg-main); color: var(--text-secondary); font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.15s;"
        >
          Cancelar
        </button>
        <button 
          type="submit" 
          id="btn-submit-edit-negocio" 
          style="flex: 2; padding: 12px; border-radius: 12px; border: none; background: var(--brand-primary); color: #fff; font-size: 13px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 12px rgba(67, 24, 255, 0.25); transition: opacity 0.15s;"
        >
          <span>Guardar Cambios</span>
        </button>
      </div>

    </form>
  </div>
</div>
