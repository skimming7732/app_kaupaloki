---
import { formatCop } from '../../utils/formatters';

interface Props {
  CLIENTES?: any[];
  ACTIVOS_LIQUIDOS?: any[];
}

const { CLIENTES = [], ACTIVOS_LIQUIDOS = [] } = Astro.props;

// Filter cash accounts or fallback
const cashAccounts = ACTIVOS_LIQUIDOS.filter(a => 
  (a.institucion && a.institucion.toLowerCase().includes('efectivo')) ||
  (a.activo && a.activo.toLowerCase().includes('efectivo')) ||
  (a.cuenta && a.cuenta.toLowerCase().includes('caja'))
);
---

<!-- Modal: Registrar Movimiento en Efectivo -->
<div 
  id="modal-create-movimiento-efectivo-backdrop" 
  style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(5px); z-index: 9999; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box;"
>
  <div 
    style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 20px; width: 100%; max-width: 540px; box-shadow: var(--shadow-card); overflow: hidden; animation: modalFadeIn 0.2s ease-out; max-height: 90vh; display: flex; flex-direction: column;"
  >
    <!-- Modal Header -->
    <div style="padding: 18px 24px; border-bottom: 1px solid var(--border-main); display: flex; align-items: center; justify-content: space-between; background: var(--bg-card-secondary);">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(67, 24, 255, 0.12); color: var(--brand-primary); display: flex; align-items: center; justify-content: center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M6 12h.01M18 12h.01"></path>
          </svg>
        </div>
        <div>
          <h3 style="margin: 0; font-size: 15px; font-weight: 800; color: var(--text-primary);">
            Registrar Movimiento de Efectivo
          </h3>
          <p style="margin: 2px 0 0 0; font-size: 11px; color: var(--text-muted);">
            Registra una entrada o pago en efectivo físico y sincronízalo en Airtable
          </p>
        </div>
      </div>
      <button 
        type="button" 
        id="btn-close-create-movimiento-efectivo-modal" 
        style="background: transparent; border: none; color: var(--text-muted); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; border-radius: 8px; transition: color 0.15s;"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Modal Form -->
    <form id="form-modal-create-movimiento-efectivo" style="padding: 22px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px;">
      
      <!-- Campo 1: Selector de Tipo (INGRESO vs PAGO) -->
      <div>
        <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 8px;">
          Tipo de Movimiento *
        </label>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <label 
            id="lbl-tipo-ingreso"
            style="border: 2px solid var(--success); background: rgba(5, 205, 153, 0.08); border-radius: 12px; padding: 12px; display: flex; align-items: center; gap: 10px; cursor: pointer; transition: all 0.2s;"
          >
            <input type="radio" name="modal-efectivo-tipo" value="INGRESO" checked style="accent-color: var(--success); width: 16px; height: 16px;" />
            <div>
              <div style="font-size: 13px; font-weight: 800; color: var(--success);">+ INGRESO</div>
              <div style="font-size: 10px; color: var(--text-muted);">Entrada a caja</div>
            </div>
          </label>

          <label 
            id="lbl-tipo-pago"
            style="border: 2px solid var(--border-main); background: var(--bg-main); border-radius: 12px; padding: 12px; display: flex; align-items: center; gap: 10px; cursor: pointer; transition: all 0.2s;"
          >
            <input type="radio" name="modal-efectivo-tipo" value="PAGO" style="accent-color: var(--warning); width: 16px; height: 16px;" />
            <div>
              <div style="font-size: 13px; font-weight: 800; color: var(--text-primary);">- PAGO / SALIDA</div>
              <div style="font-size: 10px; color: var(--text-muted);">Entrega / Egreso</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Campo 2: Monto en COP -->
      <div>
        <label for="modal-efectivo-monto" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Monto en Efectivo (COP) *
        </label>
        <div style="position: relative;">
          <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 800; color: var(--text-muted); font-size: 14px;">$</span>
          <input 
            type="number" 
            id="modal-efectivo-monto" 
            required 
            min="1" 
            step="any"
            placeholder="0" 
            style="width: 100%; padding: 11px 14px 11px 32px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 15px; font-weight: 700; font-family: ui-monospace, monospace; outline: none; box-sizing: border-box;"
          />
        </div>
        <div id="modal-efectivo-monto-preview" style="font-size: 11px; color: var(--success); font-weight: 700; margin-top: 4px; font-family: ui-monospace, monospace;">
          $ 0 COP
        </div>
      </div>

      <!-- Campo 3: Cliente (Opcional) -->
      <div>
        <label for="modal-efectivo-cliente" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Cliente Vinculado (Opcional)
        </label>
        <select 
          id="modal-efectivo-cliente" 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box; cursor: pointer;"
        >
          <option value="" selected>— Sin cliente (Operación general de caja) —</option>
          {CLIENTES.map(c => (
            <option value={c.id} data-codigo={c.codigo} data-nombre={c.nombre}>
              {c.codigo} • {c.nombre} (Pendiente: {formatCop(c.pendienteCop || c.pendientePorPagarCop || 0)})
            </option>
          ))}
        </select>
      </div>

      <!-- Campo 4: Caja / Origen de Fondos -->
      <div>
        <label for="modal-efectivo-origen" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Caja / Cuenta de Efectivo *
        </label>
        <select 
          id="modal-efectivo-origen" 
          required 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box; cursor: pointer;"
        >
          {cashAccounts.length > 0 ? (
            cashAccounts.map(a => (
              <option value={a.id} selected={a.activo.includes('Dosquebradas')}>
                {a.activo} (Saldo: {formatCop(a.saldoCop || 0)})
              </option>
            ))
          ) : (
            <option value="recdOSGJZMR2xqUFq" selected>
              EFECTIVO-Dosquebradas (Caja Principal)
            </option>
          )}
          {ACTIVOS_LIQUIDOS.filter(a => !cashAccounts.some(ca => ca.id === a.id)).map(a => (
            <option value={a.id}>
              {a.activo} ({a.institucion})
            </option>
          ))}
        </select>
      </div>

      <!-- Campo 5: Referencia / Concepto -->
      <div>
        <label for="modal-efectivo-referencia" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Referencia / Beneficiario / Detalle *
        </label>
        <input 
          type="text" 
          id="modal-efectivo-referencia" 
          required 
          placeholder="Ej: HERMAN, ALEJANDRO, Pago USDT..." 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box;"
        />
      </div>

      <!-- Campo 6: Código / ID Movimiento -->
      <div>
        <label for="modal-efectivo-codigo" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 6px;">
          Código de Movimiento (Opcional)
        </label>
        <input 
          type="text" 
          id="modal-efectivo-codigo" 
          placeholder="Ej: EF-05 (Autogenerado si se deja en blanco)" 
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border-main); background: var(--bg-main); color: var(--text-primary); font-size: 13px; font-weight: 600; outline: none; box-sizing: border-box;"
        />
      </div>

      <!-- Feedback y Alertas -->
      <div id="modal-efectivo-feedback" style="display: none; padding: 10px 14px; border-radius: 10px; font-size: 12px; font-weight: 600;"></div>

      <!-- Botones de Acción -->
      <div style="display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin-top: 8px; padding-top: 14px; border-top: 1px solid var(--border-main);">
        <button 
          type="button" 
          id="btn-cancel-create-movimiento-efectivo"
          style="padding: 10px 18px; border-radius: 10px; border: 1px solid var(--border-main); background: transparent; color: var(--text-secondary); font-size: 13px; font-weight: 700; cursor: pointer; transition: background 0.15s;"
        >
          Cancelar
        </button>
        <button 
          type="submit" 
          id="btn-submit-create-movimiento-efectivo"
          style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px; border-radius: 10px; border: none; background: linear-gradient(135deg, #4318FF 0%, #3311CC 100%); color: #ffffff; font-size: 13px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 12px rgba(67, 24, 255, 0.25); transition: opacity 0.15s;"
        >
          <span id="btn-submit-create-movimiento-efectivo-text">Guardar Movimiento</span>
          <svg id="btn-submit-create-movimiento-efectivo-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display: none; animation: spin 1s linear infinite;">
            <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
            <path d="M12 2a10 10 0 0 1 10 10"></path>
          </svg>
        </button>
      </div>

    </form>
  </div>
</div>
