---
interface Props {
  NEGOCIOS?: any[];
  DIVISAS?: any[];
  CLIENTES?: any[];
}

const { NEGOCIOS = [], DIVISAS = [], CLIENTES = [] } = Astro.props;
---

<div id="tab-operador" class="tab-pane" style="display: none; padding: 32px 24px;">
  
  <!-- Contenedor Central de Bienvenida Minimalista -->
  <div style="max-width: 760px; margin: 40px auto; background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 26px; padding: 48px 40px; box-shadow: var(--shadow-card); text-align: center;">
    
    <!-- Icono de Bienvenida con Destello de Marca -->
    <div style="width: 72px; height: 72px; border-radius: 22px; background: linear-gradient(135deg, rgba(67, 24, 255, 0.15) 0%, rgba(57, 101, 255, 0.25) 100%); color: var(--brand-primary); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px auto; box-shadow: 0 10px 24px rgba(67, 24, 255, 0.15);">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
    </div>

    <!-- Título y Mensaje de Bienvenida para Todos los Usuarios -->
    <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; background: var(--brand-primary-light); color: var(--brand-primary); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 12px;">
      <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--brand-primary);"></span>
      <span>Portal Operativo Kaupaloki</span>
    </div>

    <h1 style="margin: 0 0 10px 0; font-size: 28px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em; line-height: 1.2;">
      ¡Bienvenido, <span id="op-welcome-name">Usuario</span>! 👋
    </h1>

    <p style="margin: 0 auto 36px auto; font-size: 15px; color: var(--text-secondary); max-width: 520px; line-height: 1.6;">
      Selecciona el módulo al que deseas ingresar para comenzar tus operaciones de gestión cambiaria y contable.
    </p>

    <!-- ÚNICOS DOS BOTONES PARA IR A VISTAS -->
    <div style="display: flex; justify-content: center; align-items: center; gap: 16px; flex-wrap: wrap;">
      
      <!-- Botón 1: Ir a Negocios -->
      <button 
        type="button" 
        class="btn-switch-tab-shortcut" 
        data-shortcut="tab-negocios" 
        style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 200px; padding: 16px 26px; border-radius: 16px; background: var(--brand-primary); color: #ffffff; border: none; font-size: 14px; font-weight: 800; cursor: pointer; box-shadow: 0 8px 20px rgba(67, 24, 255, 0.3); transition: all 0.2s ease;"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
          <polyline points="17 6 23 6 23 12"></polyline>
        </svg>
        <span>Ir a Negocios</span>
      </button>

      <!-- Botón 2: Ir a Clientes -->
      <button 
        type="button" 
        class="btn-switch-tab-shortcut" 
        data-shortcut="tab-clientes" 
        style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 200px; padding: 16px 26px; border-radius: 16px; background: var(--bg-card-secondary); color: var(--text-primary); border: 1.5px solid var(--border-main); font-size: 14px; font-weight: 800; cursor: pointer; transition: all 0.2s ease;"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span>Ir a Clientes</span>
      </button>

    </div>

  </div>

</div>
