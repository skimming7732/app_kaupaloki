---
import { formatDecimal } from '../../utils/formatters';
import { getCurrencyFlag } from '../../data/airtableData';

interface Props {
  COMPRAS_USDT: any[];
}

const { COMPRAS_USDT = [] } = Astro.props;
---

<div id="tab-compras" class="tab-pane" style="display: none; overflow-x: auto;">
          <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-main);">
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">#</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Código</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Fecha</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Divisa</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Valor Comprado</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">USDT Obtenido</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Costo</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Tasa</th>
              </tr>
            </thead>
            <tbody id="compras-table-tbody">
              {COMPRAS_USDT.map((c) => (
                <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
                  <td style="padding: 16px 20px; color: var(--text-muted); font-family: ui-monospace, monospace; font-size: 13px;">{c.numero}</td>
                  <td style="padding: 16px 20px; font-weight: 700; color: var(--brand-primary); font-family: ui-monospace, monospace; font-size: 14px;">{c.codigo}</td>
                  <td style="padding: 16px 20px; color: var(--text-secondary); font-family: ui-monospace, monospace; font-size: 13px;">{c.fechaCompra}</td>
                  <td style="padding: 16px 20px; text-align: center;">
                    <span style="font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--text-primary); border: 1px solid var(--border-main); display: inline-flex; align-items: center; gap: 4px;">
                      <span>{getCurrencyFlag(c.divisaCodigo)}</span>
                      <span>{c.divisaCodigo}</span>
                    </span>
                  </td>
                  <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-primary); font-size: 14px;">{formatDecimal(c.valorComprado, 2)}</td>
                  <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--info); font-size: 14px;">{formatDecimal(c.usdtComprado, 4)} USDT</td>
                  <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-secondary); font-size: 13px;">${formatDecimal(c.costo, 4)}</td>
                  <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 600; color: var(--brand-primary); font-size: 13px;">${formatDecimal(c.tasa, 4)}</td>
                </tr>
              ))}
            </tbody>
            <tfoot id="compras-table-tfoot">
              <tr style="background: var(--bg-card-secondary); font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary);">
                <td colspan="5" style="padding: 18px 20px; text-transform: uppercase; font-size: 12px; color: var(--text-muted);">TOTAL USDT CONSOLIDADO:</td>
                <td style="padding: 18px 20px; text-align: right; color: var(--info); font-size: 14px;">
                  {formatDecimal(COMPRAS_USDT.reduce((a, b) => a + b.usdtComprado, 0), 4)} USDT
                </td>
                <td colspan="2"></td>
              </tr>
            </tfoot>
          </table>
        </div>
