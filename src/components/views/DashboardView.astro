---
import { formatCop, formatDecimal } from '../../utils/formatters';

interface Props {
  ACTIVOS_LIQUIDOS: any[];
  DIVISAS: any[];
  CLIENTES: any[];
  COMPRAS_USDT: any[];
  VENTAS_USDT: any[];
  ACTIVOS_DIGITALES?: any[];
  NEGOCIOS?: any[];
  metricas?: any;
}

const {
  ACTIVOS_LIQUIDOS = [],
  DIVISAS = [],
  CLIENTES = [],
  COMPRAS_USDT = [],
  VENTAS_USDT = [],
  ACTIVOS_DIGITALES = [],
  NEGOCIOS = [],
  metricas = {}
} = Astro.props;

const totalNegocioCop = metricas.totalNegocioCop ?? NEGOCIOS.reduce((acc: number, n: any) => acc + (n.ingresoCop || 0), 0);
const totalVentasUsdtCop = metricas.totalVentasUsdtCop ?? VENTAS_USDT.reduce((acc: number, v: any) => acc + (v.totalCop || 0), 0);
const totalLiquidezEsperadaCop = metricas.totalLiquidezEsperadaCop ?? ACTIVOS_DIGITALES.reduce((acc: number, a: any) => acc + (a.liquidezEsperadaCop ?? ((a.rateFinal ?? 3200) * (a.saldoUsdt || 0))), 0);
const gananciaEsperadaCop = metricas.gananciaEsperadaCop ?? ((totalVentasUsdtCop + totalLiquidezEsperadaCop) - totalNegocioCop);
const totalActivosDigitalesUsdt = metricas.totalActivosDigitalesUsdt ?? ACTIVOS_DIGITALES.reduce((acc: number, a: any) => acc + (a.saldoUsdt || 0), 0);
---

<div id="tab-dashboard" class="tab-pane active" style="padding: 24px;">

          <!-- Section 0: Liquidación y Ganancia Esperada -->
          <div style="margin-bottom: 28px; background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 20px; padding: 22px; box-shadow: var(--shadow-card);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 8px;">
              <div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span style="font-size: 11px; font-weight: 800; padding: 3px 9px; border-radius: 6px; background: rgba(67, 24, 255, 0.12); color: var(--brand-primary); text-transform: uppercase; letter-spacing: 0.05em;">
                    Contabilidad Oficial
                  </span>
                  <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.03em;">
                    Liquidación
                  </h3>
                </div>
                <p style="margin: 4px 0 0 0; font-size: 12px; color: var(--text-muted);">
                  Cálculo de ganancia esperada: (Ventas USDT + Liquidez Esperada) − Total Negocio
                </p>
              </div>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 11px; font-weight: 700; color: var(--text-secondary); background: var(--bg-card-secondary); padding: 5px 12px; border-radius: 20px; border: 1px solid var(--border-main);">
                  Rate Valoración: 3,200 COP
                </span>
              </div>
            </div>

            <!-- Grid de 4 Bloques de Liquidación -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
              
              <!-- 1. TOTAL NEGOCIO -->
              <div style="background: var(--bg-card-secondary); border: 1px solid var(--border-main); border-radius: 16px; padding: 16px;">
                <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); margin-bottom: 6px;">
                  Total Negocio {`{INGRESO (COP)}`}
                </div>
                <div id="dash-liq-total-negocio" style="font-size: 20px; font-weight: 800; color: var(--text-primary); font-family: ui-monospace, monospace; line-height: 1.2;">
                  {formatCop(totalNegocioCop)}
                </div>
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 6px;">
                  Suma total ingresos pactados
                </div>
              </div>

              <!-- 2. TOTAL VENTAS USDT -->
              <div style="background: var(--bg-card-secondary); border: 1px solid var(--border-main); border-radius: 16px; padding: 16px;">
                <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--brand-primary); margin-bottom: 6px;">
                  Total Ventas USDT {`{TOTAL (COP)}`}
                </div>
                <div id="dash-liq-total-ventas" style="font-size: 20px; font-weight: 800; color: var(--brand-primary); font-family: ui-monospace, monospace; line-height: 1.2;">
                  {formatCop(totalVentasUsdtCop)}
                </div>
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 6px;">
                  Monetización USDT realizada
                </div>
              </div>

              <!-- 3. LIQUIDEZ ESPERADA -->
              <div style="background: var(--bg-card-secondary); border: 1px solid var(--border-main); border-radius: 16px; padding: 16px;">
                <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--info); margin-bottom: 6px;">
                  Liquidez Esperada {`{LIQUIDEZ ESP. (COP)}`}
                </div>
                <div id="dash-liq-total-liquidez-esp" style="font-size: 20px; font-weight: 800; color: var(--info); font-family: ui-monospace, monospace; line-height: 1.2;">
                  {formatCop(totalLiquidezEsperadaCop)}
                </div>
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 6px;">
                  {formatDecimal(totalActivosDigitalesUsdt, 0)} USDT en wallets @ 3,200
                </div>
              </div>

              <!-- 4. GANANCIA ESPERADA -->
              <div style="background: rgba(5, 205, 153, 0.08); border: 1.5px solid rgba(5, 205, 153, 0.4); border-radius: 16px; padding: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <span style="font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--success);">
                    Ganancia Esperada
                  </span>
                  <span style="font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 4px; background: rgba(5, 205, 153, 0.2); color: var(--success);">
                    COP
                  </span>
                </div>
                <div id="dash-liq-ganancia-esperada" style="font-size: 22px; font-weight: 800; color: var(--success); font-family: ui-monospace, monospace; line-height: 1.2;">
                  {formatCop(gananciaEsperadaCop)}
                </div>
                <div style="font-size: 11px; font-weight: 600; color: var(--success); margin-top: 6px;">
                  Rendimiento estimado de la operación
                </div>
              </div>

            </div>
          </div>
          
          <!-- Section 1: Posición de Activos Líquidos (Caja y Bancos) -->
          <div style="margin-bottom: 26px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
              <div>
                <h3 style="margin: 0; font-size: 15px; font-weight: 800; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.04em;">
                  Activos Líquidos en Custodia (Caja y Bancos)
                </h3>
                <p style="margin: 2px 0 0 0; font-size: 12px; color: var(--text-muted);">
                  Total de dinero disponible en cuentas institucionales y efectivo
                </p>
              </div>
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-activos"
                style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--brand-primary); background: transparent; border: none; cursor: pointer;"
              >
                Ver tarjetas de activos →
              </button>
            </div>

            <!-- Mini Horizon Cards Grid -->
            <div id="dashboard-activos-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px;">
              {ACTIVOS_LIQUIDOS.map((a) => (
                <div class="btn-open-activo-extract" data-activo-id={a.id} style="background: var(--bg-card-secondary); border: 1px solid var(--border-main); border-radius: 18px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; cursor: pointer;">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                      <span style="font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 3px 8px; border-radius: 6px; background: rgba(67, 24, 255, 0.12); color: var(--brand-primary);">
                        {a.institucion}
                      </span>
                      <div style="font-size: 14px; font-weight: 800; color: var(--text-primary); margin-top: 6px;">
                        {a.activo}
                      </div>
                      <div style="font-size: 11px; color: var(--text-muted);">
                        Titular: {a.empresa}
                      </div>
                    </div>
                    <div style="width: 36px; height: 36px; border-radius: 10px; background: var(--bg-card); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-main); color: var(--success);">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        <line x1="6" y1="12" x2="18" y2="12"></line>
                        <circle cx="12" cy="12" r="2"></circle>
                      </svg>
                    </div>
                  </div>

                  <div style="border-top: 1px solid var(--border-main); padding-top: 10px;">
                    <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 2px;">
                      Saldo Disponible (COP)
                    </div>
                    <div style="font-size: 20px; font-weight: 800; color: var(--success); font-family: ui-monospace, monospace;">
                      {formatCop(a.saldoCop)}
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 10px; color: var(--text-muted); margin-top: 6px; font-family: ui-monospace, monospace;">
                      <span>+ {formatCop(a.ingresosCop)}</span>
                      <span>- {formatCop(a.egresosCop)}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Section 2: Custodia de Divisas & Falta por Liquidar -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 24px;">
            
            <!-- Box 1: Custodia Divisas & USDT -->
            <div style="border: 1px solid var(--border-main); border-radius: 18px; padding: 20px; background: var(--bg-card);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(67, 24, 255, 0.12); color: var(--brand-primary); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="2" y1="12" x2="22" y2="12"></line>
                    </svg>
                  </div>
                  <div>
                    <h4 style="margin: 0; font-size: 14px; font-weight: 800; color: var(--text-primary);">
                      Custodia de Divisas y USDT
                    </h4>
                    <p style="margin: 0; font-size: 11px; color: var(--text-muted);">
                      Saldo retenido para cobertura y arbitraje
                    </p>
                  </div>
                </div>
                <button 
                  type="button"
                  class="btn-switch-tab-shortcut" 
                  data-shortcut="tab-divisas"
                  style="font-size: 11px; font-weight: 700; color: var(--brand-primary); background: transparent; border: none; cursor: pointer;"
                >
                  Ver todas →
                </button>
              </div>

              <div id="dashboard-divisas-list" style="display: flex; flex-direction: column; gap: 8px;">
                {DIVISAS.map((d) => (
                  <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-radius: 12px; background: var(--bg-card-secondary); border: 1px solid var(--border-main);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                      <span style="font-size: 12px; font-weight: 800; padding: 2px 7px; border-radius: 6px; background: var(--bg-card); color: var(--brand-primary); border: 1px solid var(--border-main);">
                        {d.codigo}
                      </span>
                      <span style="font-size: 12px; color: var(--text-secondary); font-family: ui-monospace, monospace;">
                        Recibido: {formatDecimal(d.totalRecibido, 2)}
                      </span>
                    </div>
                    <div style="text-align: right;">
                      <div style="font-size: 13px; font-weight: 800; font-family: ui-monospace, monospace; color: {d.totalPendiente > 0 ? 'var(--warning)' : 'var(--text-muted)'};">
                        {formatDecimal(d.totalPendiente, 2)} <span style="font-size: 10px;">en custodia</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Box 2: Cuánto Falta Liquidar a Clientes -->
            <div style="border: 1px solid var(--border-main); border-radius: 18px; padding: 20px; background: var(--bg-card);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div style="width: 36px; height: 36px; border-radius: 10px; background: var(--warning-light); color: var(--warning); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="12" y1="8" x2="12" y2="12"></line>
                    </svg>
                  </div>
                  <div>
                    <h4 style="margin: 0; font-size: 14px; font-weight: 800; color: var(--text-primary);">
                      Clientes por Liquidar
                    </h4>
                    <p style="margin: 0; font-size: 11px; color: var(--text-muted);">
                      Saldos COP pendientes de dispersión
                    </p>
                  </div>
                </div>
                <button 
                  type="button"
                  class="btn-switch-tab-shortcut" 
                  data-shortcut="tab-clientes"
                  style="font-size: 11px; font-weight: 700; color: var(--brand-primary); background: transparent; border: none; cursor: pointer;"
                >
                  Ver clientes →
                </button>
              </div>

              <div id="dashboard-clientes-list" style="display: flex; flex-direction: column; gap: 8px;">
                {CLIENTES.filter(c => c.pendienteCop > 0).slice(0, 5).map((c) => (
                  <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-radius: 12px; background: var(--bg-card-secondary); border: 1px solid var(--border-main);">
                    <div>
                      <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">
                        {c.nombre}
                      </div>
                      <span style="font-size: 10px; font-family: ui-monospace, monospace; color: var(--text-muted);">
                        {c.codigo}
                      </span>
                    </div>
                    <div style="text-align: right;">
                      <div style="font-size: 13px; font-weight: 800; font-family: ui-monospace, monospace; color: var(--warning);">
                        {formatCop(c.pendienteCop)}
                      </div>
                      <span style="font-size: 10px; color: var(--text-muted);">
                        Pendiente
                      </span>
                    </div>
                  </div>
                ))}
              </div>

              <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border-main); display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">
                  Total Pasivo Clientes:
                </span>
                <span id="dashboard-total-pasivo-clientes" style="font-size: 16px; font-weight: 800; color: var(--warning); font-family: ui-monospace, monospace;">
                  {formatCop(metricas.totalFaltaLiquidarClientes)}
                </span>
              </div>
            </div>

          </div>

          <!-- Section 3: Accesos Rápidos Contables -->
          <div style="background: var(--bg-card-secondary); border: 1px solid var(--border-main); border-radius: 18px; padding: 18px 22px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px;">
            <div>
              <div style="font-size: 14px; font-weight: 800; color: var(--text-primary);">
                Módulos Operativos y Cambiarios
              </div>
              <div style="font-size: 12px; color: var(--text-muted);">
                Accede rápidamente a las tablas transaccionales de compra, venta y control de usuarios
              </div>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 10px;">
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-compras"
                style="padding: 8px 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border-main); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer;"
              >
                Compra USDT ({COMPRAS_USDT.length})
              </button>
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-ventas"
                style="padding: 8px 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border-main); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer;"
              >
                Venta USDT ({VENTAS_USDT.length})
              </button>
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-activos"
                style="padding: 8px 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border-main); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer;"
              >
                Activos Líquidos ({ACTIVOS_LIQUIDOS.length})
              </button>
              <button 
                type="button"
                class="btn-switch-tab-shortcut" 
                data-shortcut="tab-usuarios"
                style="padding: 8px 14px; border-radius: 10px; background: var(--brand-primary); color: #fff; border: none; font-size: 12px; font-weight: 700; cursor: pointer;"
              >
                Usuarios & Divisas
              </button>
            </div>
          </div>

        </div>
