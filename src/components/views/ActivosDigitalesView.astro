---
import { formatDecimal } from '../../utils/formatters';

interface Props {
  ACTIVOS_DIGITALES: any[];
}

const { ACTIVOS_DIGITALES = [] } = Astro.props;
---

<div id="tab-activos-digitales" class="tab-pane" style="display: none; padding: 24px;">
          
          <!-- CONTENEDOR 1: RESUMEN GENERAL Y TARJETAS DIGITALES -->
          <div id="digitales-overview-container">
            <!-- Banner Resumen de Activos Digitales -->
            <div style="background: linear-gradient(135deg, #05CD99 0%, #11047A 100%); border-radius: 20px; padding: 26px 30px; margin-bottom: 24px; color: #ffffff; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; box-shadow: 0 10px 25px rgba(5, 205, 153, 0.2);">
              <div>
                <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.85; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                  <span>🟢</span>
                  <span>Custodia y Balances Cripto</span>
                </div>
                <div id="digitales-banner-total" style="font-size: 32px; font-weight: 800; font-family: ui-monospace, monospace; letter-spacing: -0.02em;">
                  54,974.00 <span style="font-size: 20px; opacity: 0.9;">USDT</span>
                </div>
                <div style="font-size: 12px; color: #E0E5F2; margin-top: 4px;">
                  Total consolidado en billeteras USDT (Red TRON TRC-20)
                </div>
              </div>
              <div style="display: flex; gap: 12px;">
                <div style="background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); padding: 12px 18px; border-radius: 14px; text-align: center; border: 1px solid rgba(255,255,255,0.2);">
                  <div style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.8;">Billeteras</div>
                  <div id="digitales-banner-count" style="font-size: 18px; font-weight: 800; font-family: ui-monospace, monospace;">{ACTIVOS_DIGITALES.length}</div>
                </div>
                <div style="background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); padding: 12px 18px; border-radius: 14px; text-align: center; border: 1px solid rgba(255,255,255,0.2);">
                  <div style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.8;">Red Principal</div>
                  <div style="font-size: 16px; font-weight: 800; font-family: ui-monospace, monospace;">TRC20</div>
                </div>
              </div>
            </div>

            <!-- Grid de Tarjetas de Wallets Digitales -->
            <div id="digitales-cards-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 20px; margin-bottom: 28px;">
              {ACTIVOS_DIGITALES.map((d, index) => {
                const gradients = [
                  'linear-gradient(135deg, #05CD99 0%, #0369a1 100%)',
                  'linear-gradient(135deg, #4318FF 0%, #1e1b4b 100%)',
                  'linear-gradient(135deg, #868CFF 0%, #312e81 100%)'
                ];
                const bgGradient = gradients[index % gradients.length];
                const shortWallet = d.wallet.length > 18 ? (d.wallet.slice(0, 10) + '...' + d.wallet.slice(-8)) : d.wallet;

                return (
                  <div 
                    class="btn-open-digital-extract"
                    data-digital-id={d.id}
                    title="Click para abrir extracto cripto de esta wallet"
                    style={'position: relative; border-radius: 22px; padding: 24px; color: #ffffff; background: ' + bgGradient + '; box-shadow: 0 14px 28px rgba(0,0,0,0.15); display: flex; flex-direction: column; justify-content: space-between; min-height: 200px; overflow: hidden; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease; user-select: none;'}
                  >
                    <div style="position: absolute; right: -20px; top: -20px; width: 140px; height: 140px; border-radius: 50%; background: rgba(255,255,255,0.12); pointer-events: none;"></div>

                    <!-- Fila Superior: Badge Red + Icono -->
                    <div style="display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 1;">
                      <div style="font-size: 11px; font-weight: 800; letter-spacing: 0.05em; background: rgba(0,0,0,0.25); padding: 4px 10px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.2);">
                        <span>🟢</span>
                        <span>{d.red || 'TRC20'}</span>
                      </div>
                      <div style="display: flex; align-items: center; gap: 6px;">
                        <span style="font-size: 10px; font-weight: 700; background: rgba(255,255,255,0.2); padding: 3px 8px; border-radius: 6px; backdrop-filter: blur(4px);">
                          Ver Extracto →
                        </span>
                        <div style="width: 38px; height: 38px; border-radius: 12px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
                            <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
                            <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path>
                          </svg>
                        </div>
                      </div>
                    </div>

                    <!-- Nombre de la Wallet y Dirección -->
                    <div style="margin: 18px 0; position: relative; z-index: 1;">
                      <div style="font-size: 20px; font-weight: 800; letter-spacing: -0.01em; text-shadow: 0 2px 4px rgba(0,0,0,0.15);">
                        {d.idWallet || d.activo}
                      </div>
                      <div style="font-size: 11px; opacity: 0.85; font-family: ui-monospace, monospace; margin-top: 4px; display: flex; align-items: center; gap: 6px;">
                        <span>{shortWallet}</span>
                      </div>
                    </div>

                    <!-- Fila Inferior: Saldo USDT -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-end; position: relative; z-index: 1; border-top: 1px solid rgba(255,255,255,0.18); padding-top: 12px;">
                      <div>
                        <div style="font-size: 10px; font-weight: 700; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.05em;">Saldo Disponible</div>
                        <div style="font-size: 22px; font-weight: 800; font-family: ui-monospace, monospace; line-height: 1.1; margin-top: 2px;">
                          {formatDecimal(d.saldoUsdt, 2)} <span style="font-size: 13px; opacity: 0.85;">USDT</span>
                        </div>
                      </div>
                      <div style="text-align: right;">
                        <span style="font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: rgba(255,255,255,0.25);">
                          Activa ✓
                        </span>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>

            <!-- Tabla de Detalle de Activos Digitales -->
            <div style="background: var(--bg-card); border-radius: 20px; border: 1px solid var(--border-main); overflow: hidden; box-shadow: var(--shadow-card);">
              <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-main); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <h3 style="margin: 0; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-primary);">
                  Detalle de Custodia en Billeteras (Airtable: ACTIVOS DIGITALES)
                </h3>
                <span style="font-size: 11px; color: var(--text-muted);">
                  Clic en fila para abrir extracto cripto
                </span>
              </div>
              <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                  <tr style="border-bottom: 1px solid var(--border-main);">
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">ID Wallet / Nombre</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Dirección</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Red</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Ingresos (USDT)</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Egresos (USDT)</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Saldo (USDT)</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Extracto</th>
                  </tr>
                </thead>
                <tbody id="digitales-table-tbody">
                  {ACTIVOS_DIGITALES.map((d) => (
                    <tr 
                      class="horizon-row row-open-digital-extract" 
                      data-digital-id={d.id}
                      title="Click para ver extracto de esta wallet"
                      style="border-bottom: 1px solid var(--border-main); cursor: pointer;"
                    >
                      <td style="padding: 16px 20px; font-weight: 700; color: var(--text-primary);">{d.idWallet || d.activo}</td>
                      <td style="padding: 16px 20px; font-family: ui-monospace, monospace; font-size: 12px; color: var(--text-secondary);">{d.wallet}</td>
                      <td style="padding: 16px 20px; text-align: center;">
                        <span style="font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 6px; background: rgba(5, 205, 153, 0.12); color: var(--success);">
                          {d.red || 'TRC20'}
                        </span>
                      </td>
                      <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-primary); font-size: 13px;">{formatDecimal(d.ingresosUsdt, 2)} USDT</td>
                      <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--danger); font-size: 13px;">{formatDecimal(d.egresosUsdt, 2)} USDT</td>
                      <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--success); font-size: 14px;">{formatDecimal(d.saldoUsdt, 2)} USDT</td>
                      <td style="padding: 16px 20px; text-align: center;">
                        <span style="font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 8px; background: var(--bg-card-secondary); color: var(--brand-primary); border: 1px solid var(--border-main);">
                          Ver Extracto →
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- CONTENEDOR 2: EXTRACTO CRIPTO DE WALLET -->
          <div id="digitales-extract-view" style="display: none; flex-direction: column; gap: 24px;">
            <!-- Header Bar -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
              <div style="display: flex; align-items: center; gap: 14px;">
                <button 
                  id="btn-back-digitales-list" 
                  type="button"
                  title="Volver al resumen de activos digitales" 
                  style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-main); background: var(--bg-card); color: var(--text-primary); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease; box-shadow: var(--shadow-nav);"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                  </svg>
                </button>

                <div style="width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #05CD99 0%, #11047A 100%); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 12px rgba(5, 205, 153, 0.25);">
                  <span style="font-size: 18px;">🟢</span>
                </div>

                <div>
                  <h2 id="digital-extract-header-title" style="margin: 0; font-size: 20px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em; text-transform: uppercase;">
                    BETO WALLET
                  </h2>
                  <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 3px;">
                    EXTRACTO CRIPTO • <span id="digital-extract-header-currency">USDT</span>
                  </div>
                </div>
              </div>

              <!-- Descargar CSV -->
              <div>
                <button 
                  id="btn-digital-extract-download-csv" 
                  type="button"
                  title="Descargar extracto en CSV" 
                  style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card); color: var(--text-secondary); font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s ease;"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>Exportar CSV</span>
                </button>
              </div>
            </div>

            <!-- Tarjeta Principal del Extracto Cripto -->
            <div style="background: #0B1426; border: 1px solid #1E293B; border-radius: 24px; padding: 32px 36px; color: #FFFFFF; box-shadow: 0 18px 36px rgba(0,0,0,0.25);">
              
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 36px;">
                <div>
                  <div style="font-size: 11px; font-weight: 700; color: #8A92A6; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">
                    SALDO DISPONIBLE
                  </div>
                  <div id="digital-extract-card-saldo-disp" style="font-size: 42px; font-weight: 800; font-family: ui-monospace, monospace; line-height: 1; letter-spacing: -0.02em; color: #05CD99;">
                    0 USDT
                  </div>
                </div>

                <div style="text-align: right;">
                  <div style="font-size: 11px; font-weight: 700; color: #8A92A6; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">
                    SALDO TOTAL
                  </div>
                  <div id="digital-extract-card-saldo-total" style="font-size: 26px; font-weight: 800; font-family: ui-monospace, monospace; color: #FFFFFF;">
                    0 USDT
                  </div>
                </div>
              </div>

              <!-- Metadatos de la Wallet -->
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 24px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 24px;">
                <div>
                  <div style="font-size: 10px; font-weight: 700; color: #8A92A6; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
                    WALLET / TITULAR
                  </div>
                  <div id="digital-extract-card-titular" style="font-size: 13px; font-weight: 700; color: #FFFFFF;">
                    BETO WALLET
                  </div>
                </div>

                <div>
                  <div style="font-size: 10px; font-weight: 700; color: #8A92A6; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
                    RED / PROTOCOLO
                  </div>
                  <div id="digital-extract-card-red" style="font-size: 13px; font-weight: 700; color: #FFFFFF;">
                    TRON (TRC20)
                  </div>
                </div>

                <div>
                  <div style="font-size: 10px; font-weight: 700; color: #8A92A6; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
                    DIRECCIÓN PÚBLICA
                  </div>
                  <div id="digital-extract-card-wallet" style="font-size: 12px; font-weight: 700; font-family: ui-monospace, monospace; color: #868CFF; word-break: break-all;">
                    -
                  </div>
                </div>

                <div>
                  <div style="font-size: 10px; font-weight: 700; color: #8A92A6; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
                    TARIFAS
                  </div>
                  <div id="digital-extract-card-tarifas" style="font-size: 11px; font-weight: 700; color: #05CD99; background: rgba(5, 205, 153, 0.12); padding: 4px 8px; border-radius: 6px; display: inline-block;">
                    RED TRON • 1 USDT
                  </div>
                </div>
              </div>

            </div>

            <!-- Tabla de Movimientos del Extracto Cripto -->
            <div style="background: var(--bg-card); border-radius: 20px; border: 1px solid var(--border-main); overflow: hidden; box-shadow: var(--shadow-card);">
              <div style="padding: 18px 22px; border-bottom: 1px solid var(--border-main); display: flex; align-items: center; gap: 10px;">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: #05CD99; box-shadow: 0 0 8px #05CD99;"></span>
                <h3 style="margin: 0; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-primary);">
                  Historial de Movimientos
                </h3>
              </div>

              <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                  <tr style="border-bottom: 1px solid var(--border-main); background: var(--bg-card-secondary);">
                    <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Fecha</th>
                    <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Hash / TxID</th>
                    <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Concepto</th>
                    <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Monto (USDT)</th>
                    <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Balance (USDT)</th>
                  </tr>
                </thead>
                <tbody id="digital-extract-movements-tbody">
                  <!-- Llenado dinámico -->
                </tbody>
              </table>
            </div>

          </div>

          <!-- Script Tag con datos completos de Activos Digitales y sus Movimientos -->
          <script id="activos-digitales-json" type="application/json" set:html={JSON.stringify(ACTIVOS_DIGITALES)} />

        </div>
