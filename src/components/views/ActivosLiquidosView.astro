---
import { formatCop } from '../../utils/formatters';

interface Props {
  ACTIVOS_LIQUIDOS: any[];
  metricas?: any;
}

const { ACTIVOS_LIQUIDOS = [], metricas = {} } = Astro.props;
---

<div id="tab-activos" class="tab-pane" style="display: none; padding: 24px;">
          
          <!-- CONTENEDOR 1: VISTA GENERAL (RESUMEN + TARJETAS HORIZON UI + TABLA) -->
          <div id="activos-overview-container">
            <!-- Consolidated Summary Banner -->
            <div style="background: linear-gradient(135deg, #1B254B 0%, #0B1437 100%); border-radius: 20px; padding: 24px 28px; margin-bottom: 24px; color: #fff; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; box-shadow: 0 10px 30px rgba(11, 20, 55, 0.2);">
              <div>
                <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #868CFF; margin-bottom: 4px;">
                  Tesorería y Liquidez Consolidada
                </div>
                <div id="activos-banner-total" style="font-size: 30px; font-weight: 800; font-family: ui-monospace, monospace; letter-spacing: -0.02em;">
                  {formatCop(metricas.totalActivosLiquidosCop)}
                </div>
                <div style="font-size: 12px; color: #A3AED0; margin-top: 4px;">
                  Dinero total disponible en cuentas operativas y efectivo (Haz clic en una tarjeta para ver su extracto)
                </div>
              </div>
              <div style="display: flex; gap: 12px;">
                <div style="background: rgba(255, 255, 255, 0.08); border-radius: 14px; padding: 12px 18px; text-align: right; border: 1px solid rgba(255, 255, 255, 0.1);">
                  <div style="font-size: 10px; font-weight: 700; color: #A3AED0; text-transform: uppercase;">Total Ingresos</div>
                  <div id="activos-banner-ingresos" style="font-size: 16px; font-weight: 800; color: #05CD99; font-family: ui-monospace, monospace;">
                    {formatCop(ACTIVOS_LIQUIDOS.reduce((acc, a) => acc + a.ingresosCop, 0))}
                  </div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.08); border-radius: 14px; padding: 12px 18px; text-align: right; border: 1px solid rgba(255, 255, 255, 0.1);">
                  <div style="font-size: 10px; font-weight: 700; color: #A3AED0; text-transform: uppercase;">Total Egresos</div>
                  <div id="activos-banner-egresos" style="font-size: 16px; font-weight: 800; color: #EE5D50; font-family: ui-monospace, monospace;">
                    {formatCop(ACTIVOS_LIQUIDOS.reduce((acc, a) => acc + a.egresosCop, 0))}
                  </div>
                </div>
              </div>
            </div>

            <!-- GRID TIPO TARJETAS (HORIZON UI BANK CARDS) -->
            <div id="activos-cards-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 28px;">
              {ACTIVOS_LIQUIDOS.map((a, idx) => {
                const bgGradient = idx === 0 
                  ? 'linear-gradient(135deg, #4318FF 0%, #2B3674 100%)' 
                  : idx === 1 
                  ? 'linear-gradient(135deg, #05CD99 0%, #007554 100%)' 
                  : 'linear-gradient(135deg, #FFB547 0%, #A35D00 100%)';
                return (
                  <div 
                    class="btn-open-activo-extract"
                    data-activo-id={a.id}
                    title="Click para abrir extracto bancario detallado"
                    style={'position: relative; border-radius: 22px; padding: 24px; color: #ffffff; background: ' + bgGradient + '; box-shadow: 0 14px 28px rgba(0,0,0,0.15); display: flex; flex-direction: column; justify-content: space-between; min-height: 200px; overflow: hidden; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease; user-select: none;'}
                  >
                    <div style="position: absolute; right: -20px; top: -20px; width: 140px; height: 140px; border-radius: 50%; background: rgba(255,255,255,0.12); pointer-events: none;"></div>
                    
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 2;">
                      <div>
                        <span style="font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; background: rgba(255,255,255,0.2); padding: 4px 10px; border-radius: 8px; backdrop-filter: blur(4px);">
                          {a.institucion}
                        </span>
                        <div style="font-size: 16px; font-weight: 800; margin-top: 8px; letter-spacing: -0.01em;">
                          {a.activo}
                        </div>
                      </div>
                      <div style="display: flex; align-items: center; gap: 6px;">
                        <span style="font-size: 10px; font-weight: 700; background: rgba(255,255,255,0.2); padding: 3px 8px; border-radius: 6px; backdrop-filter: blur(4px);">
                          Ver Extracto →
                        </span>
                        <div style="width: 38px; height: 38px; border-radius: 12px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                          </svg>
                        </div>
                      </div>
                    </div>

                    <div style="margin: 18px 0; position: relative; z-index: 2;">
                      <div style="font-size: 11px; font-weight: 600; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.05em;">
                        Saldo en Cuenta
                      </div>
                      <div style="font-size: 26px; font-weight: 800; font-family: ui-monospace, monospace; margin-top: 2px;">
                        {formatCop(a.saldoCop)}
                      </div>
                    </div>

                    <div style="border-top: 1px solid rgba(255,255,255,0.2); padding-top: 12px; display: flex; justify-content: space-between; align-items: flex-end; position: relative; z-index: 2; font-size: 11px;">
                      <div>
                        <div style="opacity: 0.75; font-size: 10px; text-transform: uppercase;">Empresa / Titular</div>
                        <div style="font-weight: 700; margin-top: 2px;">{a.empresa}</div>
                      </div>
                      <div style="text-align: right; font-family: ui-monospace, monospace;">
                        <div style="color: rgba(255,255,255,0.9); font-weight: 700;">+ {formatCop(a.ingresosCop)}</div>
                        <div style="opacity: 0.75; font-size: 10px;">- {formatCop(a.egresosCop)}</div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>

            <!-- Tabla de Detalle de Cuentas -->
            <div style="background: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-main); overflow: hidden;">
              <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-main); background: var(--bg-card-secondary); display: flex; justify-content: space-between; align-items: center;">
                <h4 style="margin: 0; font-size: 13px; font-weight: 800; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em;">
                  Detalle Contable de Cuentas
                </h4>
                <span style="font-size: 11px; color: var(--text-muted);">
                  Sincronizado con Airtable (ACTIVOS LIQUIDOS) • Clic en fila para ver extracto
                </span>
              </div>
              <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                  <tr style="border-bottom: 1px solid var(--border-main);">
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Activo</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Institución</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Empresa</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); text-align: right;">Ingresos (COP)</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); text-align: right;">Egresos (COP)</th>
                    <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); text-align: right;">Saldo Actual (COP)</th>
                  </tr>
                </thead>
                <tbody id="activos-table-tbody">
                  {ACTIVOS_LIQUIDOS.map((a) => (
                    <tr 
                      class="horizon-row row-open-activo-extract" 
                      data-activo-id={a.id}
                      title="Click para ver extracto bancario de esta cuenta"
                      style="border-bottom: 1px solid var(--border-main); cursor: pointer;"
                    >
                      <td style="padding: 16px 20px; font-weight: 700; color: var(--text-primary);">{a.activo}</td>
                      <td style="padding: 16px 20px; color: var(--text-secondary);">{a.institucion}</td>
                      <td style="padding: 16px 20px; color: var(--text-secondary);">{a.empresa}</td>
                      <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success); font-weight: 600;">{formatCop(a.ingresosCop)}</td>
                      <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--danger); font-weight: 600;">{formatCop(a.egresosCop)}</td>
                      <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--text-primary); font-size: 15px;">{formatCop(a.saldoCop)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- CONTENEDOR 2: EXTRACTO BANCARIO (IDÉNTICO A LA FOTO) -->
          <div id="activos-extract-view" style="display: none; flex-direction: column; gap: 24px;">
            
            <!-- Extract Header Bar -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
              <div style="display: flex; align-items: center; gap: 14px;">
                <!-- Botón Atrás Circular -->
                <button 
                  id="btn-back-activos-list" 
                  type="button"
                  title="Volver al resumen de activos líquidos" 
                  style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-main); background: var(--bg-card); color: var(--text-primary); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease; box-shadow: var(--shadow-nav);"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                  </svg>
                </button>

                <!-- Icono Circular de la Institución / Empresa -->
                <div style="width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #4318FF 0%, #2B3674 100%); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 12px rgba(67, 24, 255, 0.25);">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                  </svg>
                </div>

                <!-- Título y Subtítulo -->
                <div>
                  <h2 id="extract-header-title" style="margin: 0; font-size: 20px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em; text-transform: uppercase;">
                    Coinsenda-Kaupaloki
                  </h2>
                  <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 3px;">
                    EXTRACTO BANCARIO • <span id="extract-header-currency">COP</span>
                  </div>
                </div>
              </div>

              <!-- Acciones Superiores Derechas (Editar Nota + Descargar CSV) -->
              <div style="display: flex; align-items: center; gap: 8px;">
                <button 
                  id="btn-extract-notes" 
                  type="button"
                  title="Detalles y notas contables" 
                  style="width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease;"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                  </svg>
                </button>

                <button 
                  id="btn-extract-download-csv" 
                  type="button"
                  title="Descargar extracto en CSV" 
                  style="height: 36px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--border-main); background: var(--bg-card); color: var(--text-secondary); display: flex; align-items: center; gap: 6px; cursor: pointer; transition: all 0.2s ease;"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
              </div>
            </div>

            <!-- TARJETA PRINCIPAL DEL EXTRACTO (DISEÑO ADAPTABLE A TEMA CLARO Y OSCURO) -->
            <div style="background: var(--bg-card); border: 1px solid var(--border-main); border-radius: 24px; padding: 32px 36px; color: var(--text-primary); box-shadow: var(--shadow-card);">
              
              <!-- Fila Superior: SALDO DISPONIBLE (izquierda) y SALDO TOTAL (derecha) -->
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 36px;">
                <div>
                  <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">
                    SALDO DISPONIBLE
                  </div>
                  <div id="extract-card-saldo-disp" style="font-size: 42px; font-weight: 800; font-family: ui-monospace, monospace; line-height: 1; letter-spacing: -0.02em; color: var(--text-primary);">
                    0
                  </div>
                </div>

                <div style="text-align: right;">
                  <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">
                    SALDO TOTAL
                  </div>
                  <div id="extract-card-saldo-total" style="font-size: 26px; font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary);">
                    839
                  </div>
                </div>
              </div>

              <!-- Fila Inferior: 4 Columnas (TITULAR, INSTITUCIÓN, CUENTA, TARIFAS) -->
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 20px; border-top: 1px solid var(--border-main); padding-top: 24px;">
                <div>
                  <div style="font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
                    TITULAR
                  </div>
                  <div id="extract-card-titular" style="font-size: 13px; font-weight: 700; color: var(--text-primary);">
                    Coinsenda-Kaupaloki
                  </div>
                </div>

                <div>
                  <div style="font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
                    INSTITUCIÓN
                  </div>
                  <div id="extract-card-institucion" style="font-size: 13px; font-weight: 700; color: var(--text-primary); text-transform: uppercase;">
                    COINSENDA
                  </div>
                </div>

                <div>
                  <div style="font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
                    CUENTA
                  </div>
                  <div id="extract-card-cuenta" style="font-size: 13px; font-weight: 700; color: var(--text-primary); font-family: ui-monospace, monospace;">
                    N/A
                  </div>
                </div>

                <div style="text-align: right;">
                  <div style="font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
                    TARIFAS
                  </div>
                  <span id="extract-card-tarifas" style="display: inline-block; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 8px; background: var(--bg-card-secondary); border: 1px solid var(--border-main); color: var(--text-secondary); font-family: ui-monospace, monospace;">
                    % FEE $1000 COP
                  </span>
                </div>
              </div>
            </div>

            <!-- SECCIÓN HISTORIAL DE MOVIMIENTOS CON PUNTO AZUL -->
            <div>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px;">
                <span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #3965FF; box-shadow: 0 0 6px #3965FF;"></span>
                <h3 style="margin: 0; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-primary);">
                  HISTORIAL DE MOVIMIENTOS
                </h3>
              </div>

              <!-- Tabla de Movimientos -->
              <div style="background: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-main); overflow-x: auto; box-shadow: var(--shadow-card);">
                <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                  <thead>
                    <tr style="border-bottom: 1px solid var(--border-main); background: var(--bg-card-secondary);">
                      <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); white-space: nowrap;">FECHA</th>
                      <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); white-space: nowrap;">ORIGEN</th>
                      <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">CONCEPTO</th>
                      <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right; white-space: nowrap;">MONTO</th>
                      <th style="padding: 14px 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right; white-space: nowrap;">BALANCE</th>
                    </tr>
                  </thead>
                  <tbody id="extract-movements-tbody">
                    <!-- Filas pobladas dinámicamente -->
                  </tbody>
                </table>
              </div>
            </div>

          </div>

          <!-- Script Tag con datos completos de Activos Líquidos y sus Movimientos -->
          <script id="activos-liquidos-json" type="application/json" set:html={JSON.stringify(ACTIVOS_LIQUIDOS)} />

        </div>
