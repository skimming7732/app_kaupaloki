---
import { formatDecimal, fallbackBanderaUrl } from '../../utils/formatters';

interface Props {
  DIVISAS: any[];
}

const { DIVISAS = [] } = Astro.props;
---

<div id="tab-divisas" class="tab-pane" style="display: none; overflow-x: auto;">
          <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-main);">
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Divisa / País</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Total Recibido</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Total Comprado</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Total Pendiente</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Estado</th>
              </tr>
            </thead>
            <tbody id="divisas-table-tbody">
              {DIVISAS.map((d) => {
                const tienePendiente = d.totalPendiente > 0;
                const flagImg = d.banderaUrl || d.fallbackBanderaUrl || '';
                const fallbackImg = d.fallbackBanderaUrl || '';
                return (
                  <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
                    <td style="padding: 14px 20px;">
                      <div style="display: inline-flex; align-items: center; gap: 12px;">
                        <img 
                          src={flagImg} 
                          alt={d.codigo}
                          onerror={fallbackImg ? `this.onerror=null;this.src="${fallbackImg}";` : undefined}
                          style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--border-main); background: var(--bg-card-secondary); flex-shrink: 0;"
                        />
                        <div>
                          <div style="display: flex; align-items: center; gap: 6px;">
                            <span style="font-weight: 800; color: var(--brand-primary); font-family: ui-monospace, monospace; font-size: 14px;">{d.codigo}</span>
                            {d.nombreDivisa && (
                              <span style="font-size: 13px; font-weight: 700; color: var(--text-primary);">{d.nombreDivisa}</span>
                            )}
                          </div>
                          {d.pais && (
                            <div style="font-size: 11px; color: var(--text-muted); font-weight: 600; margin-top: 1px;">{d.pais}</div>
                          )}
                        </div>
                      </div>
                    </td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-primary); font-size: 14px;">
                      {formatDecimal(d.totalRecibido, 2)}
                    </td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--success); font-weight: 600; font-size: 14px;">
                      {formatDecimal(d.totalComprado, 2)}
                    </td>
                    <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; font-size: 14px; color: {tienePendiente ? 'var(--warning)' : 'var(--text-muted)'};">
                      {formatDecimal(d.totalPendiente, 2)}
                    </td>
                    <td style="padding: 16px 20px; text-align: center;">
                      {tienePendiente ? (
                        <span class="status-pill status-warning">COMPRA PENDIENTE</span>
                      ) : (
                        <span class="status-pill status-success">CUBIERTA 100%</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
