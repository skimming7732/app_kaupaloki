---
import { formatCop, formatDecimal } from '../../utils/formatters';
import { getCurrencyFlag } from '../../data/airtableData';

interface Props {
  NEGOCIOS: any[];
  DIVISAS?: any[];
}

const { NEGOCIOS = [], DIVISAS = [] } = Astro.props;
---

<div id="tab-negocios" class="tab-pane" style="display: none; overflow-x: auto;">
  <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead>
      <tr style="border-bottom: 1px solid var(--border-main);">
        <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">#</th>
        <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">ID Negocio</th>
        <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Fecha</th>
        <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Cliente</th>
        <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Divisa</th>
        <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Monto Divisa</th>
        <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Tasa</th>
        <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Ingreso (COP)</th>
        <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: center;">Acciones</th>
      </tr>
    </thead>
    <tbody id="negocios-table-tbody">
      {NEGOCIOS.map((n) => (
        <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
          <td style="padding: 14px 18px; color: var(--text-muted); font-family: ui-monospace, monospace; font-size: 13px;">{n.numero}</td>
          <td style="padding: 14px 18px; font-weight: 800; color: var(--brand-primary); font-family: ui-monospace, monospace; font-size: 14px;">{n.codigo}</td>
          <td style="padding: 14px 18px; color: var(--text-secondary); font-family: ui-monospace, monospace; font-size: 13px;">{n.fechaRegistro}</td>
          <td style="padding: 14px 18px; font-weight: 700; color: var(--text-primary); font-size: 14px;">{n.clienteNombre}</td>
          <td style="padding: 14px 18px; text-align: center;">
            <span style="font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--text-primary); border: 1px solid var(--border-main); display: inline-flex; align-items: center; gap: 4px;">
              <span>{getCurrencyFlag(n.divisaCodigo)}</span>
              <span>{n.divisaCodigo}</span>
            </span>
          </td>
          <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; font-weight: 600; color: var(--text-primary); font-size: 14px;">{formatDecimal(n.montoDivisa, 2)}</td>
          <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; font-weight: 600; color: var(--text-secondary); font-size: 14px;">${formatDecimal(n.tasa, 2)}</td>
          <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--success); font-size: 14px;">{formatCop(n.ingresoCop)}</td>
          <td style="padding: 14px 18px; text-align: center;">
            <button 
              type="button" 
              class="btn-open-edit-negocio" 
              data-id={n.id} 
              data-codigo={n.codigo}
              data-fecha={n.fechaRegistro}
              data-cliente-id={n.clienteRecordId || ''}
              data-cliente-nombre={n.clienteNombre}
              data-divisa={n.divisaCodigo}
              data-monto={n.montoDivisa}
              data-tasa={n.tasa}
              title={`Editar Negocio ${n.codigo}`}
              style="display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--border-main); background: var(--bg-card-secondary); color: var(--text-primary); font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.15s;"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-primary);">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
              <span>Editar</span>
            </button>
          </td>
        </tr>
      ))}
    </tbody>
    <tfoot id="negocios-table-tfoot">
      <tr style="background: var(--bg-card-secondary); font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary);">
        <td colspan="5" style="padding: 16px 18px; text-transform: uppercase; font-size: 12px; color: var(--text-muted);">TOTALES CONSOLIDADOS:</td>
        <td style="padding: 16px 18px; text-align: right; color: var(--text-primary); font-size: 14px;">{formatDecimal(NEGOCIOS.reduce((a, b) => a + (b.montoDivisa || 0), 0), 2)}</td>
        <td style="padding: 16px 18px; text-align: right; color: var(--text-muted); font-size: 12px;">—</td>
        <td style="padding: 16px 18px; text-align: right; color: var(--success); font-size: 15px;">{formatCop(NEGOCIOS.reduce((a, b) => a + (b.ingresoCop || 0), 0))}</td>
        <td></td>
      </tr>
    </tfoot>
  </table>
</div>
