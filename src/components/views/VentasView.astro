---
import { formatCop, formatDecimal } from '../../utils/formatters';

interface Props {
  VENTAS_USDT: any[];
}

const { VENTAS_USDT = [] } = Astro.props;
---

<div id="tab-ventas" class="tab-pane" style="display: none; overflow-x: auto;">
          <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-main);">
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Código</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Fecha</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Concepto</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">USDT Vendido</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Tasa</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Destino Fondos</th>
                <th style="padding: 14px 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Total (COP)</th>
              </tr>
            </thead>
            <tbody id="ventas-table-tbody">
              {VENTAS_USDT.map((v) => (
                <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
                  <td style="padding: 16px 20px; font-weight: 700; color: var(--brand-primary); font-family: ui-monospace, monospace; font-size: 14px;">{v.nombre}</td>
                  <td style="padding: 16px 20px; color: var(--text-secondary); font-family: ui-monospace, monospace; font-size: 13px;">{v.fecha}</td>
                  <td style="padding: 16px 20px; font-weight: 600; color: var(--text-primary); font-size: 14px;">{v.concepto}</td>
                  <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--info); font-size: 14px;">{formatDecimal(v.usdtVendido, 2)} USDT</td>
                  <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-secondary); font-size: 13px;">${formatDecimal(v.tasa, 2)}</td>
                  <td style="padding: 16px 20px;">
                    <span style="font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 6px; background: var(--bg-card-secondary); color: var(--text-primary); border: 1px solid var(--border-main);">
                      {v.destinoFondosNombre}
                    </span>
                  </td>
                  <td style="padding: 16px 20px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: var(--success); font-size: 15px;">{formatCop(v.totalCop)}</td>
                </tr>
              ))}
            </tbody>
            <tfoot id="ventas-table-tfoot">
              <tr style="background: var(--bg-card-secondary); font-weight: 800; font-family: ui-monospace, monospace; color: var(--text-primary);">
                <td colspan="3" style="padding: 18px 20px; text-transform: uppercase; font-size: 12px; color: var(--text-muted);">TOTALES VENTAS USDT:</td>
                <td style="padding: 18px 20px; text-align: right; color: var(--info); font-size: 14px;">
                  {formatDecimal(VENTAS_USDT.reduce((a, b) => a + b.usdtVendido, 0), 2)} USDT
                </td>
                <td colspan="2"></td>
                <td style="padding: 18px 20px; text-align: right; color: var(--success); font-size: 15px;">
                  {formatCop(VENTAS_USDT.reduce((a, b) => a + b.totalCop, 0))}
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
