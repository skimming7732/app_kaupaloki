---
import { formatCop } from '../../utils/formatters';
import type { MovimientoEfectivo, Cliente, ActivoLiquido } from '../../data/airtableData';

interface Props {
  EFECTIVO_MOVIMIENTOS?: MovimientoEfectivo[];
  CLIENTES?: Cliente[];
  ACTIVOS_LIQUIDOS?: ActivoLiquido[];
  saldoEfectivo?: number;
}

const { 
  EFECTIVO_MOVIMIENTOS = [],
  CLIENTES = [],
  ACTIVOS_LIQUIDOS = [],
  saldoEfectivo = 279351330
} = Astro.props;

const totalIngresos = EFECTIVO_MOVIMIENTOS.filter(m => m.tipo === 'INGRESO').reduce((acc, m) => acc + (m.montoCop || 0), 0);
const totalPagos = EFECTIVO_MOVIMIENTOS.filter(m => m.tipo === 'PAGO').reduce((acc, m) => acc + (m.montoCop || 0), 0);
---

<div id="tab-efectivo" class="tab-pane" style="display: none;">
  <!-- Tabla de Movimientos en Efectivo -->
  <div style="overflow-x: auto;">
    <table class="horizon-table" style="width: 100%; border-collapse: collapse; text-align: left;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border-main); background: var(--bg-card-secondary);">
          <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">#</th>
          <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Código</th>
          <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Tipo</th>
          <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Cliente</th>
          <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Referencia / Detalle</th>
          <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Caja / Origen Fondos</th>
          <th style="padding: 14px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: right;">Monto (COP)</th>
        </tr>
      </thead>
      <tbody id="efectivo-table-tbody">
        {EFECTIVO_MOVIMIENTOS.map((m, idx) => {
          const esIngreso = m.tipo === 'INGRESO';
          return (
            <tr class="horizon-row" style="border-bottom: 1px solid var(--border-main); transition: background 0.15s ease;">
              <td style="padding: 14px 18px; color: var(--text-muted); font-family: ui-monospace, monospace; font-size: 12px; vertical-align: middle;">
                {idx + 1}
              </td>
              <td style="padding: 14px 18px; font-weight: 700; color: var(--brand-primary); font-family: ui-monospace, monospace; font-size: 13px; vertical-align: middle;">
                {m.codigo || `EF-0${idx + 1}`}
              </td>
              <td style="padding: 14px 18px; vertical-align: middle;">
                {esIngreso ? (
                  <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 6px; background: rgba(5, 205, 153, 0.12); color: var(--success); font-weight: 800; font-size: 11px; text-transform: uppercase;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <line x1="12" y1="19" x2="12" y2="5"></line>
                      <polyline points="5 12 12 5 19 12"></polyline>
                    </svg>
                    INGRESO
                  </span>
                ) : (
                  <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 6px; background: rgba(255, 181, 71, 0.15); color: var(--warning); font-weight: 800; font-size: 11px; text-transform: uppercase;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <polyline points="19 12 12 19 5 12"></polyline>
                    </svg>
                    PAGO
                  </span>
                )}
              </td>
              <td style="padding: 14px 18px; font-weight: 600; color: var(--text-primary); font-size: 13px; vertical-align: middle;">
                {m.clienteCodigo ? (
                  <span style="display: inline-flex; align-items: center; gap: 6px;">
                    <span style="font-family: ui-monospace, monospace; font-weight: 700; color: var(--brand-primary);">{m.clienteCodigo}</span>
                    {m.clienteNombre && m.clienteNombre !== m.clienteCodigo && (
                      <span style="color: var(--text-secondary); font-size: 12px;">• {m.clienteNombre}</span>
                    )}
                  </span>
                ) : (
                  <span style="color: var(--text-muted); font-style: italic;">Sin cliente asignado</span>
                )}
              </td>
              <td style="padding: 14px 18px; color: var(--text-primary); font-weight: 600; font-size: 13px; vertical-align: middle;">
                {m.referencia || '—'}
              </td>
              <td style="padding: 14px 18px; color: var(--text-secondary); font-size: 12px; vertical-align: middle;">
                <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 6px; background: var(--bg-card-secondary); border: 1px solid var(--border-main); font-family: ui-monospace, monospace; font-size: 11px;">
                  {m.origenFondosNombre || 'EFECTIVO-Dosquebradas'}
                </span>
              </td>
              <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; font-size: 14px; color: {esIngreso ? 'var(--success)' : 'var(--warning)'}; vertical-align: middle;">
                {esIngreso ? '+' : '-'}{formatCop(m.montoCop)}
              </td>
            </tr>
          );
        })}
      </tbody>
      <tfoot id="efectivo-tfoot">
        <tr style="background: var(--bg-card-secondary); border-top: 2px solid var(--border-main); font-weight: 800;">
          <td colspan="4" style="padding: 14px 18px; text-transform: uppercase; font-size: 12px; color: var(--text-muted);">
            TOTALES CONSOLIDADOS ({EFECTIVO_MOVIMIENTOS.length} MOVIMIENTOS):
          </td>
          <td colspan="2" style="padding: 14px 18px; text-align: right; font-size: 12px; color: var(--text-secondary);">
            INGRESOS: <span style="color: var(--success); font-family: ui-monospace, monospace;">+{formatCop(totalIngresos)}</span> | 
            PAGOS: <span style="color: var(--warning); font-family: ui-monospace, monospace;">-{formatCop(totalPagos)}</span>
          </td>
          <td style="padding: 14px 18px; text-align: right; font-family: ui-monospace, monospace; color: var(--text-primary); font-size: 15px;">
            {formatCop(totalIngresos - totalPagos)}
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
